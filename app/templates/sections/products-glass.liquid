{%- comment -%} CF Visual Builder — Glass Product Cards — Electronics {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-prods-gl{--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};--accent:{{ section.settings.accent }};--glass:{{ section.settings.glass_bg }};--glass-b:{{ section.settings.glass_border }};font-family:'Inter',sans-serif;background:var(--bg);padding:clamp(3rem,7vw,6rem) clamp(1.5rem,4vw,4rem)}
.myapp-prods-gl__header{text-align:center;max-width:560px;margin:0 auto clamp(2rem,4vw,3.5rem)}
.myapp-prods-gl__title{font-size:clamp(1.6rem,3vw,{{ section.settings.title_size }}px);font-weight:800;color:var(--txt);margin:0 0 10px;letter-spacing:-.02em}
.myapp-prods-gl__sub{font-size:14px;color:var(--muted)}
.myapp-prods-gl__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:20px;max-width:1200px;margin:0 auto}
.myapp-prods-gl__card{background:var(--glass);backdrop-filter:blur(16px);border:1px solid var(--glass-b);border-radius:{{ section.settings.card_radius }}px;overflow:hidden;transition:all .3s;cursor:pointer}
.myapp-prods-gl__card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.2);border-color:var(--accent)}
.myapp-prods-gl__img-wrap{position:relative;overflow:hidden;aspect-ratio:1;background:rgba(255,255,255,.03)}
.myapp-prods-gl__img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.myapp-prods-gl__card:hover .myapp-prods-gl__img{transform:scale(1.06)}
.myapp-prods-gl__badge{position:absolute;top:12px;left:12px;padding:4px 10px;background:var(--accent);color:var(--bg);font-size:10px;font-weight:700;border-radius:6px;text-transform:uppercase;letter-spacing:.06em}
.myapp-prods-gl__quick{position:absolute;bottom:0;left:0;right:0;padding:12px;background:linear-gradient(transparent,rgba(0,0,0,.6));transform:translateY(100%);transition:transform .3s}
.myapp-prods-gl__card:hover .myapp-prods-gl__quick{transform:translateY(0)}
.myapp-prods-gl__quick-btn{width:100%;padding:10px;background:var(--accent);color:#fff;font-size:12px;font-weight:700;border:none;border-radius:8px;cursor:pointer;font-family:'Inter',sans-serif}
.myapp-prods-gl__info{padding:16px}
.myapp-prods-gl__name{font-size:14px;font-weight:600;color:var(--txt);margin:0 0 6px}
.myapp-prods-gl__price{font-size:16px;font-weight:800;color:var(--accent)}
.myapp-prods-gl__price-old{font-size:13px;color:var(--muted);text-decoration:line-through;margin-left:8px;font-weight:400}
@media(max-width:768px){.myapp-prods-gl__grid{grid-template-columns:repeat(2,1fr);gap:12px}}
{%- endstyle -%}
<section class="myapp-prods-gl" id="myapp-prods-gl-{{ section.id }}">
  <div class="myapp-prods-gl__header">
    <h2 class="myapp-prods-gl__title">{{ section.settings.title }}</h2>
    {% if section.settings.subtitle != blank %}<p class="myapp-prods-gl__sub">{{ section.settings.subtitle }}</p>{% endif %}
  </div>
  <div class="myapp-prods-gl__grid">
    {% for block in section.blocks %}
    <div class="myapp-prods-gl__card" {{ block.shopify_attributes }}>
      <div class="myapp-prods-gl__img-wrap">
        {% if block.settings.image != blank %}<img class="myapp-prods-gl__img" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" loading="lazy">{% endif %}
        {% if block.settings.badge != blank %}<span class="myapp-prods-gl__badge">{{ block.settings.badge }}</span>{% endif %}
        <div class="myapp-prods-gl__quick"><button class="myapp-prods-gl__quick-btn">{{ section.settings.quick_add_text }}</button></div>
      </div>
      <div class="myapp-prods-gl__info">
        <h3 class="myapp-prods-gl__name">{{ block.settings.name }}</h3>
        <div><span class="myapp-prods-gl__price">{{ block.settings.price }}</span>{% if block.settings.compare_price != blank %}<span class="myapp-prods-gl__price-old">{{ block.settings.compare_price }}</span>{% endif %}</div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"CF Products — Glass Grid","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#0a0a0f"},{"type":"color","id":"text_color","label":"Text","default":"#f0f0f5"},{"type":"color","id":"muted","label":"Muted","default":"#8b8b9e"},{"type":"color","id":"accent","label":"Accent","default":"#635bff"},{"type":"text","id":"glass_bg","label":"Glass BG","default":"rgba(255,255,255,0.04)"},{"type":"text","id":"glass_border","label":"Glass Border","default":"rgba(255,255,255,0.08)"},{"type":"text","id":"title","label":"Title","default":"Featured Products"},{"type":"range","id":"title_size","label":"Title Size","min":24,"max":48,"step":2,"default":38,"unit":"px"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Our most popular picks"},{"type":"range","id":"columns","label":"Columns","min":2,"max":4,"step":1,"default":3},{"type":"range","id":"card_radius","label":"Card Radius","min":8,"max":24,"step":4,"default":16,"unit":"px"},{"type":"text","id":"quick_add_text","label":"Quick Add Text","default":"Quick Add"}],"blocks":[{"type":"product","name":"Product Card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"name","label":"Name","default":"Product Name"},{"type":"text","id":"price","label":"Price","default":"$299"},{"type":"text","id":"compare_price","label":"Compare Price"},{"type":"text","id":"badge","label":"Badge","default":"NEW"}]}],"presets":[{"name":"CF Products — Glass Grid","blocks":[{"type":"product","settings":{"name":"Pro Wireless Earbuds","price":"$299","badge":"NEW"}},{"type":"product","settings":{"name":"Smart Watch Ultra","price":"$499","compare_price":"$599","badge":"SALE"}},{"type":"product","settings":{"name":"Noise Cancel Headphones","price":"$349"}}]}]}
{% endschema %}
