{%- comment -%}
  ╔═══════════════════════════════════════════════════════════════╗
  ║  ConvertFlow Visual Builder — Premium Section Template       ║
  ║  Type: Split-Screen Asymmetrical Hero + Sticky ATC           ║
  ║  Style: High-Tech Glassmorphism                              ║
  ║  Niche: Premium Skincare / Cosmetics                         ║
  ║  Version: 1.0                                                ║
  ╚═══════════════════════════════════════════════════════════════╝
{%- endcomment -%}

{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap' | stylesheet_tag }}

{%- style -%}
  /* ═══ RESET & BASE ═══ */
  .myapp-hero-glas {
    --myapp-accent: {{ section.settings.accent_color }};
    --myapp-accent-glow: {{ section.settings.accent_color }}40;
    --myapp-bg: {{ section.settings.bg_color }};
    --myapp-text: {{ section.settings.text_color }};
    --myapp-text-muted: {{ section.settings.text_muted_color }};
    --myapp-glass-bg: {{ section.settings.glass_bg }};
    --myapp-glass-border: {{ section.settings.glass_border }};
    position: relative;
    overflow: hidden;
    background: var(--myapp-bg);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    min-height: {{ section.settings.section_height }}vh;
    display: flex;
    align-items: stretch;
  }

  /* ═══ VIDEO BACKGROUND ═══ */
  .myapp-hero-glas__video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .myapp-hero-glas__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: {{ section.settings.video_opacity | times: 0.01 }};
  }
  .myapp-hero-glas__video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      {{ section.settings.gradient_direction }}deg,
      {{ section.settings.bg_color }}f0 0%,
      {{ section.settings.bg_color }}80 40%,
      transparent 70%
    );
    z-index: 1;
  }

  /* ═══ SPLIT LAYOUT ═══ */
  .myapp-hero-glas__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: {{ section.settings.content_width }}fr {{ section.settings.media_width }}fr;
    gap: 0;
    width: 100%;
    min-height: {{ section.settings.section_height }}vh;
  }

  /* ═══ CONTENT SIDE ═══ */
  .myapp-hero-glas__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 5rem);
    padding-right: clamp(2rem, 4vw, 4rem);
    position: relative;
    z-index: 3;
  }
  .myapp-hero-glas__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: var(--myapp-glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--myapp-glass-border);
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--myapp-accent);
    margin-bottom: 24px;
    width: fit-content;
  }
  .myapp-hero-glas__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--myapp-accent);
    animation: myapp-pulse 2s ease-in-out infinite;
  }
  @keyframes myapp-pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 var(--myapp-accent-glow); }
    50% { opacity: 0.7; box-shadow: 0 0 0 8px transparent; }
  }

  .myapp-hero-glas__headline {
    font-size: clamp(2.2rem, 5vw, {{ section.settings.headline_size }}px);
    font-weight: {{ section.settings.headline_weight }};
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--myapp-text);
    margin: 0 0 20px;
  }
  .myapp-hero-glas__headline em {
    font-style: normal;
    background: linear-gradient(135deg, var(--myapp-accent), {{ section.settings.accent_secondary }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .myapp-hero-glas__subtext {
    font-size: clamp(0.95rem, 1.2vw, {{ section.settings.subtext_size }}px);
    font-weight: 400;
    line-height: 1.7;
    color: var(--myapp-text-muted);
    margin: 0 0 32px;
    max-width: 480px;
  }

  /* ═══ GLASS CARD: PRODUCT + ATC ═══ */
  .myapp-hero-glas__product-card {
    background: var(--myapp-glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--myapp-glass-border);
    border-radius: {{ section.settings.card_radius }}px;
    padding: 24px;
    max-width: 440px;
    margin-bottom: 28px;
  }
  .myapp-hero-glas__product-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .myapp-hero-glas__product-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--myapp-text);
    margin: 0;
  }
  .myapp-hero-glas__product-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--myapp-accent);
    background: var(--myapp-accent-glow);
    padding: 3px 10px;
    border-radius: 4px;
  }
  .myapp-hero-glas__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }
  .myapp-hero-glas__price-current {
    font-size: 28px;
    font-weight: 800;
    color: var(--myapp-text);
    letter-spacing: -0.02em;
  }
  .myapp-hero-glas__price-compare {
    font-size: 16px;
    font-weight: 400;
    color: var(--myapp-text-muted);
    text-decoration: line-through;
  }
  .myapp-hero-glas__price-save {
    font-size: 12px;
    font-weight: 600;
    color: #10b981;
    background: rgba(16, 185, 129, 0.12);
    padding: 2px 8px;
    border-radius: 4px;
  }

  /* Rating Stars */
  .myapp-hero-glas__rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .myapp-hero-glas__stars {
    display: flex;
    gap: 2px;
    color: #fbbf24;
    font-size: 14px;
  }
  .myapp-hero-glas__rating-text {
    font-size: 12px;
    color: var(--myapp-text-muted);
    font-weight: 500;
  }

  /* ATC Button */
  .myapp-hero-glas__atc-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: {{ section.settings.btn_padding_y }}px {{ section.settings.btn_padding_x }}px;
    background: linear-gradient(135deg, var(--myapp-accent), {{ section.settings.accent_secondary }});
    color: {{ section.settings.btn_text_color }};
    font-family: 'Inter', sans-serif;
    font-size: {{ section.settings.btn_font_size }}px;
    font-weight: 700;
    border: none;
    border-radius: {{ section.settings.btn_radius }}px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    letter-spacing: 0.02em;
    text-transform: {{ section.settings.btn_text_transform }};
    position: relative;
    overflow: hidden;
  }
  .myapp-hero-glas__atc-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.15) 50%, transparent 60%);
    transform: translateX(-100%);
    transition: transform 0.6s;
  }
  .myapp-hero-glas__atc-btn:hover::before {
    transform: translateX(100%);
  }
  .myapp-hero-glas__atc-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--myapp-accent-glow);
  }
  .myapp-hero-glas__atc-icon {
    width: 18px;
    height: 18px;
  }

  /* Trust Badges under ATC */
  .myapp-hero-glas__trust-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 14px;
  }
  .myapp-hero-glas__trust-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 500;
    color: var(--myapp-text-muted);
  }
  .myapp-hero-glas__trust-icon {
    width: 14px;
    height: 14px;
    opacity: 0.7;
  }

  /* ═══ MEDIA SIDE ═══ */
  .myapp-hero-glas__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .myapp-hero-glas__product-img {
    position: relative;
    z-index: 2;
    max-width: 80%;
    max-height: 70vh;
    object-fit: contain;
    filter: drop-shadow(0 20px 60px rgba(0,0,0,0.4));
    animation: myapp-float 6s ease-in-out infinite;
  }
  @keyframes myapp-float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  .myapp-hero-glas__glow-orb {
    position: absolute;
    width: {{ section.settings.glow_size }}px;
    height: {{ section.settings.glow_size }}px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--myapp-accent-glow), transparent 70%);
    filter: blur(60px);
    z-index: 1;
    animation: myapp-glow-drift 8s ease-in-out infinite alternate;
  }
  @keyframes myapp-glow-drift {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(30px, -20px) scale(1.15); }
  }

  /* ═══ FLOATING STATS (GLASS CHIPS) ═══ */
  .myapp-hero-glas__stat-chip {
    position: absolute;
    z-index: 5;
    background: var(--myapp-glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--myapp-glass-border);
    border-radius: 16px;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: myapp-chip-in 0.8s ease-out both;
  }
  .myapp-hero-glas__stat-chip--1 { top: 18%; right: 8%; animation-delay: 0.4s; }
  .myapp-hero-glas__stat-chip--2 { bottom: 22%; left: 5%; animation-delay: 0.7s; }
  @keyframes myapp-chip-in {
    0% { opacity: 0; transform: translateY(20px) scale(0.9); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .myapp-hero-glas__stat-value {
    font-size: 18px;
    font-weight: 800;
    color: var(--myapp-text);
    line-height: 1;
  }
  .myapp-hero-glas__stat-label {
    font-size: 10px;
    font-weight: 500;
    color: var(--myapp-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.2;
  }
  .myapp-hero-glas__stat-icon {
    font-size: 22px;
    line-height: 1;
  }

  /* ═══ STICKY ADD-TO-CART BAR ═══ */
  .myapp-hero-glas__sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
    background: var(--myapp-glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid var(--myapp-glass-border);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .myapp-hero-glas__sticky-atc.myapp-is-visible {
    transform: translateY(0);
  }
  .myapp-hero-glas__sticky-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 960px;
    width: 100%;
  }
  .myapp-hero-glas__sticky-img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--myapp-glass-border);
  }
  .myapp-hero-glas__sticky-info {
    flex: 1;
    min-width: 0;
  }
  .myapp-hero-glas__sticky-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--myapp-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .myapp-hero-glas__sticky-price {
    font-size: 14px;
    font-weight: 700;
    color: var(--myapp-accent);
  }
  .myapp-hero-glas__sticky-btn {
    padding: 12px 28px;
    background: linear-gradient(135deg, var(--myapp-accent), {{ section.settings.accent_secondary }});
    color: {{ section.settings.btn_text_color }};
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 700;
    border: none;
    border-radius: {{ section.settings.btn_radius }}px;
    cursor: pointer;
    transition: all 0.3s;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .myapp-hero-glas__sticky-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px var(--myapp-accent-glow);
  }

  /* ═══ MOBILE ═══ */
  @media (max-width: 768px) {
    .myapp-hero-glas { min-height: auto; }
    .myapp-hero-glas__inner {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .myapp-hero-glas__content {
      padding: 2rem 1.25rem 1.5rem;
      order: 2;
    }
    .myapp-hero-glas__media {
      min-height: 55vw;
      order: 1;
    }
    .myapp-hero-glas__product-img { max-width: 60%; }
    .myapp-hero-glas__headline { font-size: clamp(1.7rem, 7vw, 2.4rem); }
    .myapp-hero-glas__product-card { max-width: 100%; }
    .myapp-hero-glas__stat-chip { display: none; }
    .myapp-hero-glas__trust-row { flex-wrap: wrap; }
    .myapp-hero-glas__video-overlay {
      background: linear-gradient(180deg, {{ section.settings.bg_color }}30 0%, {{ section.settings.bg_color }}f0 60%);
    }
    .myapp-hero-glas__sticky-inner { gap: 10px; }
    .myapp-hero-glas__sticky-btn { padding: 10px 18px; font-size: 12px; }
  }
{%- endstyle -%}

<section
  class="myapp-hero-glas"
  id="myapp-hero-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-sticky-atc="{{ section.settings.enable_sticky_atc }}"
>
  {%- comment -%} ── Video Background ── {%- endcomment -%}
  {% if section.settings.video_url != blank %}
    <div class="myapp-hero-glas__video-wrap">
      <video
        class="myapp-hero-glas__video"
        autoplay muted loop playsinline
        poster="{{ section.settings.video_poster | image_url: width: 1920 }}"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
      <div class="myapp-hero-glas__video-overlay"></div>
    </div>
  {% endif %}

  {%- comment -%} ── Split Grid ── {%- endcomment -%}
  <div class="myapp-hero-glas__inner">

    {%- comment -%} ── LEFT: Content ── {%- endcomment -%}
    <div class="myapp-hero-glas__content">

      {% if section.settings.badge_text != blank %}
        <div class="myapp-hero-glas__badge">
          <span class="myapp-hero-glas__badge-dot"></span>
          {{ section.settings.badge_text }}
        </div>
      {% endif %}

      <h1 class="myapp-hero-glas__headline">{{ section.settings.headline }}</h1>
      <p class="myapp-hero-glas__subtext">{{ section.settings.subtext }}</p>

      {%- comment -%} ── Glass Product Card ── {%- endcomment -%}
      <div class="myapp-hero-glas__product-card">
        <div class="myapp-hero-glas__product-top">
          <p class="myapp-hero-glas__product-name">{{ section.settings.product_name }}</p>
          {% if section.settings.product_tag != blank %}
            <span class="myapp-hero-glas__product-tag">{{ section.settings.product_tag }}</span>
          {% endif %}
        </div>

        {%- comment -%} Rating ── {%- endcomment -%}
        {% if section.settings.show_rating %}
          <div class="myapp-hero-glas__rating">
            <div class="myapp-hero-glas__stars">
              {% for i in (1..5) %}
                {% if i <= section.settings.rating_stars %}★{% else %}☆{% endif %}
              {% endfor %}
            </div>
            <span class="myapp-hero-glas__rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {% endif %}

        {%- comment -%} Price ── {%- endcomment -%}
        <div class="myapp-hero-glas__price-row">
          <span class="myapp-hero-glas__price-current">{{ section.settings.price_current }}</span>
          {% if section.settings.price_compare != blank %}
            <span class="myapp-hero-glas__price-compare">{{ section.settings.price_compare }}</span>
          {% endif %}
          {% if section.settings.price_save != blank %}
            <span class="myapp-hero-glas__price-save">{{ section.settings.price_save }}</span>
          {% endif %}
        </div>

        {%- comment -%} ATC Button ── {%- endcomment -%}
        <a href="{{ section.settings.atc_url }}" class="myapp-hero-glas__atc-btn">
          <svg class="myapp-hero-glas__atc-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          {{ section.settings.atc_text }}
        </a>

        {%- comment -%} Trust row ── {%- endcomment -%}
        {% if section.settings.show_trust %}
          <div class="myapp-hero-glas__trust-row">
            {% for block in section.blocks %}
              {% if block.type == 'trust_badge' %}
                <div class="myapp-hero-glas__trust-item" {{ block.shopify_attributes }}>
                  {% if block.settings.trust_icon != blank %}
                    <img class="myapp-hero-glas__trust-icon" src="{{ block.settings.trust_icon | image_url: width: 28 }}" alt="" loading="lazy">
                  {% else %}
                    <svg class="myapp-hero-glas__trust-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  {% endif %}
                  {{ block.settings.trust_text }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>

    {%- comment -%} ── RIGHT: Media ── {%- endcomment -%}
    <div class="myapp-hero-glas__media">
      <div class="myapp-hero-glas__glow-orb" style="top: 30%; left: 20%;"></div>

      {% if section.settings.product_image != blank %}
        <img
          class="myapp-hero-glas__product-img"
          src="{{ section.settings.product_image | image_url: width: 1200 }}"
          alt="{{ section.settings.product_name }}"
          loading="eager"
          width="600"
          height="600"
        >
      {% endif %}

      {%- comment -%} ── Floating Glass Stat Chips ── {%- endcomment -%}
      {% for block in section.blocks %}
        {% if block.type == 'stat_chip' %}
          <div class="myapp-hero-glas__stat-chip myapp-hero-glas__stat-chip--{{ forloop.index }}" {{ block.shopify_attributes }}>
            {% if block.settings.chip_emoji != blank %}
              <span class="myapp-hero-glas__stat-icon">{{ block.settings.chip_emoji }}</span>
            {% endif %}
            <div>
              <div class="myapp-hero-glas__stat-value">{{ block.settings.chip_value }}</div>
              <div class="myapp-hero-glas__stat-label">{{ block.settings.chip_label }}</div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {%- comment -%} ── STICKY ADD TO CART ── {%- endcomment -%}
  {% if section.settings.enable_sticky_atc %}
    <div class="myapp-hero-glas__sticky-atc" id="myapp-sticky-atc-{{ section.id }}">
      <div class="myapp-hero-glas__sticky-inner">
        {% if section.settings.product_image != blank %}
          <img
            class="myapp-hero-glas__sticky-img"
            src="{{ section.settings.product_image | image_url: width: 88 }}"
            alt="{{ section.settings.product_name }}"
            loading="lazy"
          >
        {% endif %}
        <div class="myapp-hero-glas__sticky-info">
          <div class="myapp-hero-glas__sticky-name">{{ section.settings.product_name }}</div>
          <div class="myapp-hero-glas__sticky-price">{{ section.settings.price_current }}</div>
        </div>
        <a href="{{ section.settings.atc_url }}" class="myapp-hero-glas__sticky-btn">{{ section.settings.atc_text }}</a>
      </div>
    </div>
  {% endif %}
</section>

{%- comment -%} ── Sticky ATC Scroll Script ── {%- endcomment -%}
{% if section.settings.enable_sticky_atc %}
  <script>
    (function() {
      const sectionEl = document.getElementById('myapp-hero-{{ section.id }}');
      const stickyBar = document.getElementById('myapp-sticky-atc-{{ section.id }}');
      if (!sectionEl || !stickyBar) return;
      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            stickyBar.classList.remove('myapp-is-visible');
          } else {
            stickyBar.classList.add('myapp-is-visible');
          }
        });
      }, { threshold: 0.15 });
      observer.observe(sectionEl);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "CF Hero — Glassmorphism",
  "tag": "section",
  "class": "myapp-section",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Design Tokens"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary Text",
      "default": "#f0f0f5"
    },
    {
      "type": "color",
      "id": "text_muted_color",
      "label": "Muted Text",
      "default": "#8b8b9e"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
