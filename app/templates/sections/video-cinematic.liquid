{%- comment -%} CF Visual Builder — Cinematic Video Section {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@400;500&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-video-cin{--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};--accent:{{ section.settings.accent }};font-family:'Inter',sans-serif;background:var(--bg);padding:clamp(3rem,7vw,6rem) clamp(1.5rem,4vw,4rem)}
.myapp-video-cin__header{text-align:center;max-width:600px;margin:0 auto clamp(2rem,3vw,3rem)}
.myapp-video-cin__title{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,3vw,{{ section.settings.title_size }}px);font-weight:700;color:var(--txt);margin:0 0 10px}
.myapp-video-cin__sub{font-size:14px;color:var(--muted)}
.myapp-video-cin__wrap{position:relative;max-width:1000px;margin:0 auto;border-radius:{{ section.settings.radius }}px;overflow:hidden;aspect-ratio:16/9;background:#000;cursor:pointer}
.myapp-video-cin__poster{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.myapp-video-cin__wrap:hover .myapp-video-cin__poster{transform:scale(1.03)}
.myapp-video-cin__play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:{{ section.settings.play_size }}px;height:{{ section.settings.play_size }}px;background:{{ section.settings.play_bg }};backdrop-filter:blur(12px);border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid rgba(255,255,255,.3);transition:all .3s;z-index:2}
.myapp-video-cin__play:hover{transform:translate(-50%,-50%) scale(1.1);border-color:#fff}
.myapp-video-cin__play svg{width:24px;height:24px;fill:#fff;margin-left:3px}
.myapp-video-cin__overlay{position:absolute;inset:0;background:linear-gradient(transparent 50%,rgba(0,0,0,.4));z-index:1}
.myapp-video-cin__caption{text-align:center;margin-top:16px;font-style:italic;font-size:13px;color:var(--muted)}
.myapp-video-cin__iframe{position:absolute;inset:0;width:100%;height:100%;border:none;z-index:3}
{%- endstyle -%}
<section class="myapp-video-cin" id="myapp-video-cin-{{ section.id }}">
  {% if section.settings.title != blank %}<div class="myapp-video-cin__header"><h2 class="myapp-video-cin__title">{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p class="myapp-video-cin__sub">{{ section.settings.subtitle }}</p>{% endif %}</div>{% endif %}
  <div class="myapp-video-cin__wrap" id="myapp-video-wrap-{{ section.id }}" onclick="(function(el){var v=el.querySelector('.myapp-video-cin__iframe');if(!v){var f=document.createElement('iframe');f.className='myapp-video-cin__iframe';f.src='{{ section.settings.video_embed }}?autoplay=1';f.allow='autoplay;fullscreen';el.appendChild(f)}})(this)">
    {% if section.settings.poster != blank %}<img class="myapp-video-cin__poster" src="{{ section.settings.poster | image_url: width: 1920 }}" alt="{{ section.settings.title }}" loading="lazy">{% endif %}
    <div class="myapp-video-cin__overlay"></div>
    <div class="myapp-video-cin__play"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg></div>
  </div>
  {% if section.settings.caption != blank %}<p class="myapp-video-cin__caption">{{ section.settings.caption }}</p>{% endif %}
</section>
{% schema %}
{"name":"CF Video — Cinematic","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#1a1a1a"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"muted","label":"Muted","default":"#9ca3af"},{"type":"color","id":"accent","label":"Accent","default":"#c9a961"},{"type":"text","id":"play_bg","label":"Play Button BG","default":"rgba(0,0,0,0.5)"},{"type":"text","id":"title","label":"Title","default":"Watch the Story"},{"type":"range","id":"title_size","label":"Title Size","min":24,"max":48,"step":2,"default":36,"unit":"px"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Behind the scenes of our craft"},{"type":"text","id":"video_embed","label":"Video Embed URL","default":"https://www.youtube.com/embed/dQw4w9WgXcQ","info":"YouTube/Vimeo embed URL"},{"type":"image_picker","id":"poster","label":"Poster Image"},{"type":"range","id":"radius","label":"Corner Radius","min":0,"max":24,"step":4,"default":12,"unit":"px"},{"type":"range","id":"play_size","label":"Play Button Size","min":48,"max":96,"step":8,"default":72,"unit":"px"},{"type":"text","id":"caption","label":"Caption","default":"— Our journey from bean to cup"}],"presets":[{"name":"CF Video — Cinematic"}]}
{% endschema %}
