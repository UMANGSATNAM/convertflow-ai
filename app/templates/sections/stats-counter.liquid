{%- comment -%} CF Visual Builder — Animated Stats Counter {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-stats{--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--accent:{{ section.settings.accent }};--muted:{{ section.settings.muted }};font-family:'Inter',sans-serif;background:var(--bg);padding:clamp(3rem,6vw,5rem) clamp(1.5rem,4vw,4rem)}
.myapp-stats__grid{display:flex;justify-content:center;gap:clamp(2rem,5vw,6rem);flex-wrap:wrap;max-width:1000px;margin:0 auto}
.myapp-stats__item{text-align:center;min-width:120px}
.myapp-stats__value{font-size:clamp(2rem,5vw,{{ section.settings.value_size }}px);font-weight:800;color:var(--txt);letter-spacing:-.03em;line-height:1}
.myapp-stats__value span{background:linear-gradient(135deg,var(--accent),{{ section.settings.accent_end }});-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.myapp-stats__label{font-size:13px;font-weight:500;color:var(--muted);margin-top:8px;letter-spacing:.02em}
.myapp-stats__divider{width:1px;background:{{ section.settings.divider_color }};align-self:stretch}
@media(max-width:768px){.myapp-stats__divider{display:none}.myapp-stats__grid{gap:2rem}}
{%- endstyle -%}
<section class="myapp-stats" id="myapp-stats-{{ section.id }}">
  <div class="myapp-stats__grid">
    {% for block in section.blocks %}
      {% unless forloop.first %}<div class="myapp-stats__divider"></div>{% endunless %}
      <div class="myapp-stats__item" {{ block.shopify_attributes }}>
        <div class="myapp-stats__value"><span data-myapp-count="{{ block.settings.value }}">{{ block.settings.value }}</span>{{ block.settings.suffix }}</div>
        <div class="myapp-stats__label">{{ block.settings.label }}</div>
      </div>
    {% endfor %}
  </div>
</section>
<script>
(function(){const els=document.querySelectorAll('[data-myapp-count]');const io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){const el=e.target;const end=parseInt(el.dataset.myappCount.replace(/[^0-9]/g,''));let c=0;const step=Math.ceil(end/60);const t=setInterval(function(){c+=step;if(c>=end){c=end;clearInterval(t)}el.textContent=c.toLocaleString()},20);io.unobserve(el)}})},{threshold:.3});els.forEach(function(el){io.observe(el)})})();
</script>
{% schema %}
{"name":"CF Stats — Animated Counter","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#111827"},{"type":"color","id":"muted","label":"Muted","default":"#6b7280"},{"type":"color","id":"accent","label":"Accent","default":"#635bff"},{"type":"color","id":"accent_end","label":"Accent End","default":"#10b981"},{"type":"color","id":"divider_color","label":"Divider","default":"#e5e7eb"},{"type":"range","id":"value_size","label":"Value Size","min":28,"max":64,"step":4,"default":48,"unit":"px"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"value","label":"Number Value","default":"10000"},{"type":"text","id":"suffix","label":"Suffix","default":"+"},{"type":"text","id":"label","label":"Label","default":"Happy Customers"}]}],"presets":[{"name":"CF Stats — Animated Counter","blocks":[{"type":"stat","settings":{"value":"10000","suffix":"+","label":"Happy Customers"}},{"type":"stat","settings":{"value":"98","suffix":"%","label":"Satisfaction Rate"}},{"type":"stat","settings":{"value":"50","suffix":"+","label":"Countries Served"}},{"type":"stat","settings":{"value":"4","suffix":".9★","label":"Average Rating"}}]}]}
{% endschema %}
