{%- comment -%} CF Visual Builder — Masonry Gallery — Home {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-gallery{--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};font-family:'Inter',sans-serif;background:var(--bg);padding:clamp(3rem,7vw,6rem) clamp(1.5rem,4vw,4rem)}
.myapp-gallery__header{text-align:center;max-width:560px;margin:0 auto clamp(2rem,3vw,3rem)}
.myapp-gallery__title{font-size:clamp(1.6rem,3vw,{{ section.settings.title_size }}px);font-weight:700;color:var(--txt);margin:0 0 8px;letter-spacing:-.02em}
.myapp-gallery__sub{font-size:14px;color:var(--muted)}
.myapp-gallery__grid{columns:{{ section.settings.columns }};column-gap:{{ section.settings.gap }}px;max-width:1200px;margin:0 auto}
.myapp-gallery__item{break-inside:avoid;margin-bottom:{{ section.settings.gap }}px;position:relative;overflow:hidden;border-radius:{{ section.settings.radius }}px;cursor:pointer}
.myapp-gallery__img{width:100%;display:block;transition:transform .5s}
.myapp-gallery__item:hover .myapp-gallery__img{transform:scale(1.05)}
.myapp-gallery__caption{position:absolute;bottom:0;left:0;right:0;padding:16px;background:linear-gradient(transparent,rgba(0,0,0,.6));color:#fff;transform:translateY(100%);transition:transform .3s}
.myapp-gallery__item:hover .myapp-gallery__caption{transform:translateY(0)}
.myapp-gallery__caption-text{font-size:13px;font-weight:600}
.myapp-gallery__caption-sub{font-size:11px;opacity:.7;margin-top:2px}
@media(max-width:768px){.myapp-gallery__grid{columns:2}}
{%- endstyle -%}
<section class="myapp-gallery" id="myapp-gallery-{{ section.id }}">
  {% if section.settings.title != blank %}<div class="myapp-gallery__header"><h2 class="myapp-gallery__title">{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p class="myapp-gallery__sub">{{ section.settings.subtitle }}</p>{% endif %}</div>{% endif %}
  <div class="myapp-gallery__grid">
    {% for block in section.blocks %}
    <div class="myapp-gallery__item" {{ block.shopify_attributes }}>
      {% if block.settings.image != blank %}<img class="myapp-gallery__img" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.caption }}" loading="lazy">{% endif %}
      {% if block.settings.caption != blank %}<div class="myapp-gallery__caption"><div class="myapp-gallery__caption-text">{{ block.settings.caption }}</div>{% if block.settings.sub_caption != blank %}<div class="myapp-gallery__caption-sub">{{ block.settings.sub_caption }}</div>{% endif %}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"CF Gallery — Masonry","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#111827"},{"type":"color","id":"muted","label":"Muted","default":"#6b7280"},{"type":"text","id":"title","label":"Title","default":"Our Gallery"},{"type":"range","id":"title_size","label":"Title Size","min":24,"max":48,"step":2,"default":36,"unit":"px"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Inspiration for your space"},{"type":"range","id":"columns","label":"Columns","min":2,"max":4,"step":1,"default":3},{"type":"range","id":"gap","label":"Gap","min":8,"max":24,"step":4,"default":12,"unit":"px"},{"type":"range","id":"radius","label":"Image Radius","min":0,"max":20,"step":4,"default":8,"unit":"px"}],"blocks":[{"type":"image","name":"Gallery Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption"},{"type":"text","id":"sub_caption","label":"Sub Caption"}]}],"presets":[{"name":"CF Gallery — Masonry"}]}
{% endschema %}
