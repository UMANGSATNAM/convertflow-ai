{%- comment -%} CF Visual Builder — Minimal Hero — Fashion {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-hero-min{--a:{{ section.settings.accent }};--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};font-family:'Inter',sans-serif;background:var(--bg);min-height:{{ section.settings.height }}vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.myapp-hero-min__inner{max-width:{{ section.settings.max_width }}px;margin:0 auto;padding:clamp(3rem,8vw,8rem) clamp(1.5rem,4vw,4rem);display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,6rem);align-items:center}
.myapp-hero-min__content{display:flex;flex-direction:column;gap:24px}
.myapp-hero-min__tag{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.myapp-hero-min__h1{font-size:clamp(2.4rem,5.5vw,{{ section.settings.h1_size }}px);font-weight:{{ section.settings.h1_weight }};line-height:1.05;letter-spacing:-.03em;color:var(--txt);margin:0}
.myapp-hero-min__sub{font-size:clamp(.95rem,1.1vw,17px);line-height:1.7;color:var(--muted);max-width:440px;margin:0}
.myapp-hero-min__cta{display:inline-flex;align-items:center;gap:8px;padding:{{ section.settings.btn_py }}px {{ section.settings.btn_px }}px;background:var(--txt);color:var(--bg);font-size:14px;font-weight:600;border:2px solid var(--txt);border-radius:{{ section.settings.btn_radius }}px;text-decoration:none;transition:all .3s;width:fit-content;letter-spacing:.01em}
.myapp-hero-min__cta:hover{background:transparent;color:var(--txt)}
.myapp-hero-min__cta-secondary{background:transparent;color:var(--txt);border-color:var(--muted)}
.myapp-hero-min__cta-secondary:hover{border-color:var(--txt)}
.myapp-hero-min__ctas{display:flex;gap:12px;flex-wrap:wrap}
.myapp-hero-min__media{position:relative}
.myapp-hero-min__img{width:100%;aspect-ratio:{{ section.settings.img_ratio }};object-fit:cover;border-radius:{{ section.settings.img_radius }}px}
.myapp-hero-min__accent-line{position:absolute;bottom:-16px;left:0;width:60px;height:3px;background:var(--a)}
@media(max-width:768px){.myapp-hero-min__inner{grid-template-columns:1fr;text-align:center}.myapp-hero-min__sub{max-width:100%}.myapp-hero-min__ctas{justify-content:center}.myapp-hero-min__accent-line{left:50%;transform:translateX(-50%)}}
{%- endstyle -%}
<section class="myapp-hero-min" id="myapp-hero-min-{{ section.id }}">
  <div class="myapp-hero-min__inner">
    <div class="myapp-hero-min__content">
      {% if section.settings.tag != blank %}<p class="myapp-hero-min__tag">{{ section.settings.tag }}</p>{% endif %}
      <h1 class="myapp-hero-min__h1">{{ section.settings.headline }}</h1>
      <p class="myapp-hero-min__sub">{{ section.settings.subtext }}</p>
      <div class="myapp-hero-min__ctas">
        {% if section.settings.cta_text != blank %}<a href="{{ section.settings.cta_url }}" class="myapp-hero-min__cta">{{ section.settings.cta_text }} →</a>{% endif %}
        {% if section.settings.cta2_text != blank %}<a href="{{ section.settings.cta2_url }}" class="myapp-hero-min__cta myapp-hero-min__cta-secondary">{{ section.settings.cta2_text }}</a>{% endif %}
      </div>
    </div>
    <div class="myapp-hero-min__media">
      {% if section.settings.image != blank %}<img class="myapp-hero-min__img" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.headline }}" loading="eager">{% endif %}
      <div class="myapp-hero-min__accent-line"></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"CF Hero — Minimal","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text Color","default":"#111827"},{"type":"color","id":"muted","label":"Muted Text","default":"#6b7280"},{"type":"color","id":"accent","label":"Accent Line","default":"#111827"},{"type":"range","id":"height","label":"Min Height","min":50,"max":100,"step":5,"default":85,"unit":"vh"},{"type":"range","id":"max_width","label":"Max Width","min":900,"max":1600,"step":100,"default":1280,"unit":"px"},{"type":"text","id":"tag","label":"Tag Line","default":"New Collection SS26"},{"type":"html","id":"headline","label":"Headline","default":"Effortless Style, Elevated."},{"type":"range","id":"h1_size","label":"Headline Size","min":36,"max":96,"step":2,"default":64,"unit":"px"},{"type":"select","id":"h1_weight","label":"Headline Weight","default":"800","options":[{"value":"700","label":"Bold"},{"value":"800","label":"Extra Bold"}]},{"type":"textarea","id":"subtext","label":"Subtext","default":"Clean lines. Premium fabrics. Designed for the modern wardrobe with sustainability at its core."},{"type":"image_picker","id":"image","label":"Hero Image"},{"type":"text","id":"img_ratio","label":"Image Aspect Ratio","default":"3/4"},{"type":"range","id":"img_radius","label":"Image Radius","min":0,"max":32,"step":4,"default":4,"unit":"px"},{"type":"text","id":"cta_text","label":"Primary CTA","default":"Shop Now"},{"type":"url","id":"cta_url","label":"Primary CTA Link"},{"type":"text","id":"cta2_text","label":"Secondary CTA","default":"View Lookbook"},{"type":"url","id":"cta2_url","label":"Secondary CTA Link"},{"type":"range","id":"btn_py","label":"Button Padding Y","min":8,"max":20,"step":2,"default":14,"unit":"px"},{"type":"range","id":"btn_px","label":"Button Padding X","min":16,"max":48,"step":4,"default":28,"unit":"px"},{"type":"range","id":"btn_radius","label":"Button Radius","min":0,"max":24,"step":2,"default":0,"unit":"px"}],"presets":[{"name":"CF Hero — Minimal"}]}
{% endschema %}
