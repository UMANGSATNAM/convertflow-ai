{%- comment -%} CF Visual Builder — Glass Testimonials {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-testi-gl{--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};--accent:{{ section.settings.accent }};--glass:{{ section.settings.glass_bg }};--glass-b:{{ section.settings.glass_border }};--star:{{ section.settings.star_color }};font-family:'Inter',sans-serif;background:var(--bg);padding:clamp(3rem,7vw,6rem) clamp(1.5rem,4vw,4rem);overflow:hidden}
.myapp-testi-gl__header{text-align:center;max-width:560px;margin:0 auto clamp(2rem,4vw,3.5rem)}
.myapp-testi-gl__eyebrow{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
.myapp-testi-gl__title{font-size:clamp(1.6rem,3vw,{{ section.settings.title_size }}px);font-weight:800;letter-spacing:-.02em;color:var(--txt);margin:0 0 12px}
.myapp-testi-gl__subtitle{font-size:14px;color:var(--muted)}
.myapp-testi-gl__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns }},1fr);gap:20px;max-width:1200px;margin:0 auto}
.myapp-testi-gl__card{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--glass-b);border-radius:{{ section.settings.card_radius }}px;padding:24px;transition:all .3s}
.myapp-testi-gl__card:hover{transform:translateY(-3px);border-color:var(--accent)}
.myapp-testi-gl__stars{display:flex;gap:2px;color:var(--star);font-size:14px;margin-bottom:14px}
.myapp-testi-gl__quote{font-size:14px;line-height:1.7;color:var(--txt);margin:0 0 18px;font-style:italic}
.myapp-testi-gl__author{display:flex;align-items:center;gap:12px}
.myapp-testi-gl__avatar{width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid var(--glass-b)}
.myapp-testi-gl__name{font-size:13px;font-weight:600;color:var(--txt)}
.myapp-testi-gl__role{font-size:11px;color:var(--muted)}
.myapp-testi-gl__verified{display:inline-flex;align-items:center;gap:4px;font-size:10px;font-weight:600;color:var(--accent);margin-top:2px}
.myapp-testi-gl__summary{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:clamp(2rem,3vw,3rem);padding-top:24px;border-top:1px solid var(--glass-b)}
.myapp-testi-gl__summary-stat{text-align:center}
.myapp-testi-gl__summary-value{font-size:24px;font-weight:800;color:var(--txt)}
.myapp-testi-gl__summary-label{font-size:11px;color:var(--muted)}
@media(max-width:768px){.myapp-testi-gl__grid{grid-template-columns:1fr}.myapp-testi-gl__summary{flex-wrap:wrap;gap:16px}}
{%- endstyle -%}
<section class="myapp-testi-gl" id="myapp-testi-gl-{{ section.id }}">
  <div class="myapp-testi-gl__header">
    {% if section.settings.eyebrow != blank %}<p class="myapp-testi-gl__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2 class="myapp-testi-gl__title">{{ section.settings.title }}</h2>
    {% if section.settings.subtitle != blank %}<p class="myapp-testi-gl__subtitle">{{ section.settings.subtitle }}</p>{% endif %}
  </div>
  <div class="myapp-testi-gl__grid">
    {% for block in section.blocks %}{% if block.type == 'review' %}
    <div class="myapp-testi-gl__card" {{ block.shopify_attributes }}>
      <div class="myapp-testi-gl__stars">{% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}</div>
      <p class="myapp-testi-gl__quote">"{{ block.settings.quote }}"</p>
      <div class="myapp-testi-gl__author">
        {% if block.settings.avatar != blank %}<img class="myapp-testi-gl__avatar" src="{{ block.settings.avatar | image_url: width: 72 }}" alt="{{ block.settings.name }}" loading="lazy">{% endif %}
        <div><div class="myapp-testi-gl__name">{{ block.settings.name }}</div><div class="myapp-testi-gl__role">{{ block.settings.role }}</div>{% if block.settings.verified %}<div class="myapp-testi-gl__verified">✓ Verified Purchase</div>{% endif %}</div>
      </div>
    </div>
    {% endif %}{% endfor %}
  </div>
  {% if section.settings.show_summary %}
  <div class="myapp-testi-gl__summary">
    <div class="myapp-testi-gl__summary-stat"><div class="myapp-testi-gl__summary-value">{{ section.settings.avg_rating }}</div><div class="myapp-testi-gl__summary-label">Average Rating</div></div>
    <div class="myapp-testi-gl__summary-stat"><div class="myapp-testi-gl__summary-value">{{ section.settings.total_reviews }}</div><div class="myapp-testi-gl__summary-label">Verified Reviews</div></div>
    <div class="myapp-testi-gl__summary-stat"><div class="myapp-testi-gl__summary-value">{{ section.settings.recommend_pct }}</div><div class="myapp-testi-gl__summary-label">Recommend</div></div>
  </div>
  {% endif %}
</section>
{% schema %}
{"name":"CF Testimonials — Glass","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#0a0a0f"},{"type":"color","id":"text_color","label":"Text","default":"#f0f0f5"},{"type":"color","id":"muted","label":"Muted","default":"#8b8b9e"},{"type":"color","id":"accent","label":"Accent","default":"#a78bfa"},{"type":"color","id":"star_color","label":"Star Color","default":"#fbbf24"},{"type":"text","id":"glass_bg","label":"Glass BG","default":"rgba(255,255,255,0.05)"},{"type":"text","id":"glass_border","label":"Glass Border","default":"rgba(255,255,255,0.08)"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Real Results"},{"type":"text","id":"title","label":"Title","default":"Loved by 10,000+ Customers"},{"type":"range","id":"title_size","label":"Title Size","min":24,"max":48,"step":2,"default":38,"unit":"px"},{"type":"text","id":"subtitle","label":"Subtitle","default":"See what people are saying about our products"},{"type":"range","id":"columns","label":"Columns","min":2,"max":3,"step":1,"default":3},{"type":"range","id":"card_radius","label":"Card Radius","min":8,"max":24,"step":4,"default":16,"unit":"px"},{"type":"checkbox","id":"show_summary","label":"Show Summary Bar","default":true},{"type":"text","id":"avg_rating","label":"Average Rating","default":"4.9"},{"type":"text","id":"total_reviews","label":"Total Reviews","default":"2,847"},{"type":"text","id":"recommend_pct","label":"Recommend %","default":"97%"}],"blocks":[{"type":"review","name":"Review Card","settings":[{"type":"range","id":"stars","label":"Stars","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Quote","default":"This serum completely transformed my skin."},{"type":"text","id":"name","label":"Name","default":"Sarah M."},{"type":"text","id":"role","label":"Role","default":"Verified Buyer"},{"type":"image_picker","id":"avatar","label":"Avatar"},{"type":"checkbox","id":"verified","label":"Verified Badge","default":true}]}],"presets":[{"name":"CF Testimonials — Glass","blocks":[{"type":"review","settings":{"stars":5,"quote":"Completely transformed my skin in just 4 weeks. The glow is unreal!","name":"Sarah M.","role":"Age 34","verified":true}},{"type":"review","settings":{"stars":5,"quote":"I've tried everything — this is the only serum that actually works.","name":"Emily R.","role":"Age 28","verified":true}},{"type":"review","settings":{"stars":5,"quote":"My dermatologist asked what I changed. Enough said.","name":"Jessica L.","role":"Age 41","verified":true}}]}]}
{% endschema %}
