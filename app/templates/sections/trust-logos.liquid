{%- comment -%} CF Visual Builder — Trust Logo Bar {%- endcomment -%}
{{ 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap' | stylesheet_tag }}
{%- style -%}
.myapp-trust{--bg:{{ section.settings.bg }};--txt:{{ section.settings.text_color }};--muted:{{ section.settings.muted }};--border:{{ section.settings.border_color }};font-family:'Inter',sans-serif;background:var(--bg);padding:{{ section.settings.padding_y }}px clamp(1.5rem,4vw,4rem);{% if section.settings.show_borders %}border-top:1px solid var(--border);border-bottom:1px solid var(--border){% endif %};overflow:hidden}
.myapp-trust__label{text-align:center;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:20px}
.myapp-trust__track{display:flex;align-items:center;gap:{{ section.settings.logo_gap }}px;{% if section.settings.enable_scroll %}animation:myapp-trust-scroll {{ section.settings.scroll_speed }}s linear infinite{% else %}justify-content:center;flex-wrap:wrap{% endif %}}
.myapp-trust__track:hover{animation-play-state:paused}
@keyframes myapp-trust-scroll{to{transform:translateX(-50%)}}
.myapp-trust__logo{height:{{ section.settings.logo_height }}px;opacity:{{ section.settings.logo_opacity | times: 0.01 }};filter:{{ section.settings.logo_filter }};transition:all .3s;flex-shrink:0}
.myapp-trust__logo:hover{opacity:1;filter:none}
{%- endstyle -%}
<section class="myapp-trust" id="myapp-trust-{{ section.id }}">
  {% if section.settings.label != blank %}<p class="myapp-trust__label">{{ section.settings.label }}</p>{% endif %}
  <div class="myapp-trust__track">
    {% for block in section.blocks %}
      {% if block.settings.logo != blank %}<img class="myapp-trust__logo" src="{{ block.settings.logo | image_url: height: 80 }}" alt="{{ block.settings.alt }}" loading="lazy" {{ block.shopify_attributes }}>{% endif %}
    {% endfor %}
    {% if section.settings.enable_scroll %}
      {% for block in section.blocks %}
        {% if block.settings.logo != blank %}<img class="myapp-trust__logo" src="{{ block.settings.logo | image_url: height: 80 }}" alt="{{ block.settings.alt }}" loading="lazy" aria-hidden="true">{% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"CF Trust — Logo Bar","tag":"section","class":"myapp-section","settings":[{"type":"color","id":"bg","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#111827"},{"type":"color","id":"muted","label":"Muted","default":"#9ca3af"},{"type":"color","id":"border_color","label":"Border","default":"#f1f3f5"},{"type":"checkbox","id":"show_borders","label":"Show Top/Bottom Borders","default":true},{"type":"text","id":"label","label":"Label","default":"As Seen In"},{"type":"range","id":"padding_y","label":"Vertical Padding","min":16,"max":64,"step":8,"default":32,"unit":"px"},{"type":"range","id":"logo_height","label":"Logo Height","min":16,"max":48,"step":4,"default":28,"unit":"px"},{"type":"range","id":"logo_gap","label":"Logo Gap","min":24,"max":80,"step":8,"default":48,"unit":"px"},{"type":"range","id":"logo_opacity","label":"Logo Opacity","min":20,"max":100,"step":10,"default":50,"unit":"%"},{"type":"select","id":"logo_filter","label":"Logo Filter","default":"grayscale(1)","options":[{"value":"none","label":"Full Color"},{"value":"grayscale(1)","label":"Grayscale"},{"value":"grayscale(1) brightness(1.5)","label":"Light Grayscale"}]},{"type":"checkbox","id":"enable_scroll","label":"Auto-Scroll Marquee","default":true},{"type":"range","id":"scroll_speed","label":"Scroll Speed (seconds)","min":10,"max":60,"step":5,"default":25,"unit":"s"}],"blocks":[{"type":"logo","name":"Logo","settings":[{"type":"image_picker","id":"logo","label":"Logo Image"},{"type":"text","id":"alt","label":"Alt Text","default":"Brand Logo"}]}],"presets":[{"name":"CF Trust — Logo Bar"}]}
{% endschema %}
