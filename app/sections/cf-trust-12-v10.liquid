{% schema %}
{
  "name": "12 · Women's Trust (v10)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon Accent Color","default":"#A38971"},
