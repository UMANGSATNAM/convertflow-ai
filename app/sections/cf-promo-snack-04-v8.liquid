<style>
.cf-ps-04-v8 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  display: flex;
  justify-content: center;
}

.cf-ps-04-v8-inner {
  max-width: {{ section.settings.max_width }}px;
  background: #fff;
  border-radius: 40px;
  padding: 10px 25px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.cf-ps-04-v8-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: {{ section.settings.accent_color }};
}

.cf-ps-04-v8-text {
  color: {{ section.settings.text_color }};
  font-size: 13px;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0;
}

@media (max-width: 600px) {
  .cf-ps-04-v8-inner { padding: 10px 20px; }
  .cf-ps-04-v8-text { font-size: 11px; }
}
</style>

<div class="cf-ps-04-v8">
  <div class="cf-ps-04-v8-inner">
    <div class="cf-ps-04-v8-dot"></div>
    <p class="cf-ps-04-v8-text">
      {{ section.settings.text }}
    </p>
    <div class="cf-ps-04-v8-dot"></div>
  </div>
</div>

{% schema %}
{
  "name": "08 · Holistic Aura Note",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Wrappper","default":"#F9F9F9"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#5B5B5B"},
    {"type":"color","id":"accent_color","label":"Dot Color","default":"#CBD5CF"},
    {"type":"text","id":"text","label":"Text","default":"Complimentary shipping on holistic bundles"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":400,"max":1200,"step":50,"default":650}
  ],
  "presets": [{"name":"08 · Holistic Aura Snack"}]
}
{% endschema %}
