<style>
.cf-ft-01{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:'Playfair Display',serif}
.cf-ft-01-inner{max-width:1400px;margin:0 auto}
.cf-ft-01-header{text-align:center;margin-bottom:50px}
.cf-ft-01-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:400;margin-bottom:15px;font-style:italic}
.cf-ft-01-sub{font-size:13px;color:#666;letter-spacing:0.2em;text-transform:uppercase;font-family:sans-serif}
.cf-ft-01-grid{display:grid;grid-template-columns:repeat({{ section.settings.cols }}, 1fr);gap:40px}
.cf-ft-01-card{text-decoration:none;display:block;group}
.cf-ft-01-img-wrap{position:relative;aspect-ratio:3/4;overflow:hidden;margin-bottom:20px;background:#f9f9f9}
.cf-ft-01-img{width:100%;height:100%;object-fit:cover;transition:transform 0.8s cubic-bezier(0.2,0.8,0.2,1);filter:grayscale(20%)}
.cf-ft-01-card:hover .cf-ft-01-img{transform:scale(1.05);filter:grayscale(0%)}
.cf-ft-01-info{text-align:center}
.cf-ft-01-name{font-family:sans-serif;font-size:14px;color:{{ section.settings.text_color }};letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px}
.cf-ft-01-price{font-size:18px;color:{{ section.settings.text_color }};font-weight:400}
.cf-ft-01-btn{display:inline-block;margin-top:20px;padding:12px 30px;border:1px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-size:11px;letter-spacing:0.15em;text-transform:uppercase;font-family:sans-serif;transition:0.3s}
.cf-ft-01-card:hover .cf-ft-01-btn{background:{{ section.settings.text_color }};color:#fff}
@media(max-width:900px){.cf-ft-01-grid{grid-template-columns:repeat(2,1fr);gap:20px}}
@media(max-width:500px){.cf-ft-01-grid{grid-template-columns:1fr}}
</style>

<div class="cf-ft-01">
  <div class="cf-ft-01-inner">
    <div class="cf-ft-01-header">
      <div class="cf-ft-01-sub">{{ section.settings.subtitle }}</div>
      <h2 class="cf-ft-01-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="cf-ft-01-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="cf-ft-01-card">
            <div class="cf-ft-01-img-wrap">
              <img class="cf-ft-01-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
            </div>
            <div class="cf-ft-01-info">
              <div class="cf-ft-01-name">{{ product.title }}</div>
              <div class="cf-ft-01-price">{{ product.price | money }}</div>
              <div class="cf-ft-01-btn">View Product</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <a href="#" class="cf-ft-01-card">
            <div class="cf-ft-01-img-wrap">
               <div style="width:100%;height:100%;background:#e5e5e5;display:flex;align-items:center;justify-content:center;color:#999;font-family:sans-serif;font-size:12px">Placeholder Product {{ i }}</div>
            </div>
            <div class="cf-ft-01-info">
              <div class="cf-ft-01-name">Luxury Item {{ i }}</div>
              <div class="cf-ft-01-price">$450.00</div>
              <div class="cf-ft-01-btn">View Product</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Lookbook",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"LATEST ARRIVALS"},
    {"type":"text","id":"title","label":"Title","default":"The Fall Collection"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":72,"step":2,"default":48},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product Limit","min":2,"max":12,"step":1,"default":4},
    {"type":"range","id":"cols","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"01 · Luxury Lookbook"}]
}
{% endschema %}
