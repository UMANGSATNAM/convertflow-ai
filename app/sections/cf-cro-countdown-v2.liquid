<style>
.cf-cro-cd2{width:100%;background:linear-gradient(135deg,{{ section.settings.bg_from }},{{ section.settings.bg_to }});padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;position:relative;overflow:hidden}
.cf-cro-cd2::before{content:'';position:absolute;top:-50%;right:-20%;width:500px;height:500px;border-radius:50%;background:rgba(255,255,255,0.05)}
.cf-cro-cd2-inner{max-width:800px;margin:0 auto;text-align:center;position:relative;z-index:1}
.cf-cro-cd2-badge{display:inline-block;background:rgba(255,255,255,0.15);backdrop-filter:blur(10px);color:#fff;padding:8px 20px;border-radius:100px;font-size:13px;font-weight:700;margin-bottom:24px}
.cf-cro-cd2 h2{font-size:clamp(28px,4vw,48px);font-weight:900;color:#fff;margin:0 0 8px;line-height:1.1}
.cf-cro-cd2-sub{font-size:16px;color:rgba(255,255,255,0.7);margin-bottom:36px}
.cf-cro-cd2-timer{display:flex;justify-content:center;gap:12px;margin-bottom:32px}
.cf-cro-cd2-unit{text-align:center}
.cf-cro-cd2-num{width:72px;height:72px;background:rgba(255,255,255,0.12);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.15);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;color:#fff;margin-bottom:6px}
.cf-cro-cd2-label{font-size:11px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.1em}
.cf-cro-cd2-sep{font-size:28px;color:rgba(255,255,255,0.25);line-height:72px}
.cf-cro-cd2-offer{display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);padding:12px 24px;border-radius:12px;margin-bottom:28px}
.cf-cro-cd2-offer-code{background:#fff;color:{{ section.settings.bg_from }};padding:6px 16px;border-radius:8px;font-size:14px;font-weight:800;letter-spacing:0.05em}
.cf-cro-cd2-offer span{color:rgba(255,255,255,0.8);font-size:14px}
.cf-cro-cd2-cta{display:inline-flex;align-items:center;gap:8px;padding:18px 48px;background:#fff;color:{{ section.settings.bg_from }};border-radius:100px;font-size:17px;font-weight:800;text-decoration:none;transition:0.2s;box-shadow:0 4px 20px rgba(0,0,0,0.2)}
.cf-cro-cd2-cta:hover{transform:translateY(-3px);box-shadow:0 8px 32px rgba(0,0,0,0.3)}
@media(max-width:480px){.cf-cro-cd2-num{width:56px;height:56px;font-size:24px}}
</style>

<div class="cf-cro-cd2">
  <div class="cf-cro-cd2-inner">
    <div class="cf-cro-cd2-badge">⏰ {{ section.settings.badge }}</div>
    <h2>{{ section.settings.heading }}</h2>
    <p class="cf-cro-cd2-sub">{{ section.settings.subheading }}</p>
    <div class="cf-cro-cd2-timer" id="cf-cd2-{{ section.id }}">
      <div class="cf-cro-cd2-unit"><div class="cf-cro-cd2-num" data-unit="d">{{ section.settings.days }}</div><div class="cf-cro-cd2-label">Days</div></div>
      <span class="cf-cro-cd2-sep">:</span>
      <div class="cf-cro-cd2-unit"><div class="cf-cro-cd2-num" data-unit="h">{{ section.settings.hours }}</div><div class="cf-cro-cd2-label">Hours</div></div>
      <span class="cf-cro-cd2-sep">:</span>
      <div class="cf-cro-cd2-unit"><div class="cf-cro-cd2-num" data-unit="m">{{ section.settings.minutes }}</div><div class="cf-cro-cd2-label">Mins</div></div>
      <span class="cf-cro-cd2-sep">:</span>
      <div class="cf-cro-cd2-unit"><div class="cf-cro-cd2-num" data-unit="s">00</div><div class="cf-cro-cd2-label">Secs</div></div>
    </div>
    {% if section.settings.coupon_code != blank %}
      <div class="cf-cro-cd2-offer">
        <span>Use code</span>
        <span class="cf-cro-cd2-offer-code">{{ section.settings.coupon_code }}</span>
        <span>at checkout</span>
      </div>
    {% endif %}
    <div><a href="{{ section.settings.cta_link }}" class="cf-cro-cd2-cta">{{ section.settings.cta_text }} →</a></div>
  </div>
</div>

<script>
(function(){
  var el=document.getElementById('cf-cd2-{{ section.id }}');
  if(!el)return;
  var t=parseInt('{{ section.settings.days }}')*86400+parseInt('{{ section.settings.hours }}')*3600+parseInt('{{ section.settings.minutes }}')*60;
  function p(n){return n<10?'0'+n:''+n}
  setInterval(function(){
    if(t<=0)return;t--;
    var n=el.querySelectorAll('.cf-cro-cd2-num');
    n[0].textContent=p(Math.floor(t/86400));n[1].textContent=p(Math.floor((t%86400)/3600));
    n[2].textContent=p(Math.floor((t%3600)/60));n[3].textContent=p(t%60);
  },1000);
})();
</script>

{% schema %}
{
  "name": "CRO · Gradient Countdown v2",
  "settings": [
    {"type":"text","id":"badge","label":"Badge","default":"SALE ENDING SOON"},
    {"type":"text","id":"heading","label":"Heading","default":"Black Friday Blowout"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Up to 60% off sitewide — biggest sale of the year"},
    {"type":"range","id":"days","label":"Days","min":0,"max":30,"step":1,"default":1},
    {"type":"range","id":"hours","label":"Hours","min":0,"max":23,"step":1,"default":12},
    {"type":"range","id":"minutes","label":"Minutes","min":0,"max":59,"step":1,"default":30},
    {"type":"text","id":"coupon_code","label":"Coupon Code","default":"BLACKFRI60"},
    {"type":"text","id":"cta_text","label":"CTA Text","default":"Shop the Sale"},
    {"type":"text","id":"cta_link","label":"CTA Link","default":"/collections/sale"},
    {"type":"color","id":"bg_from","label":"Gradient From","default":"#7C3AED"},
    {"type":"color","id":"bg_to","label":"Gradient To","default":"#E11D48"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Gradient Countdown v2"}]
}
{% endschema %}
