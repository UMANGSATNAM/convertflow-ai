<style>
.cf-header-05-v3 {
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-header-05-v3-top {
  background: {{ section.settings.accent_color }};
  text-align: center;
  padding: 9px 20px;
  font-size: 12px;
  color: #fff;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.cf-header-05-v3-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  border-bottom: 1px solid {{ section.settings.border_color }};
}
.cf-header-05-v3-logo {
  font-size: 22px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.cf-header-05-v3-nav {
  display: flex;
  gap: 35px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v3-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  transition: color 0.2s;
}
.cf-header-05-v3-nav a:hover { color: {{ section.settings.accent_color }}; }
.cf-header-05-v3-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}
.cf-header-05-v3-icon {
  color: {{ section.settings.text_color }};
  cursor: pointer;
  opacity: 0.8;
  transition: opacity 0.2s;
}
.cf-header-05-v3-icon:hover { opacity: 1; }
.cf-header-05-v3-icon svg { width: 20px; height: 20px; stroke-width: 1.8; }
@media (max-width: 900px) {
  .cf-header-05-v3-nav { display: none; }
  .cf-header-05-v3-bar { padding: 15px 20px; }
}
</style>

<div class="cf-header-05-v3">
  {% if section.settings.top_text != blank %}
    <div class="cf-header-05-v3-top">{{ section.settings.top_text }}</div>
  {% endif %}
  <div class="cf-header-05-v3-bar">
    <a href="/" class="cf-header-05-v3-logo">{{ section.settings.logo_text }}</a>
    <nav>
      <ul class="cf-header-05-v3-nav">
        {% for block in section.blocks %}
          <li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="cf-header-05-v3-actions">
      <div class="cf-header-05-v3-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v3-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
      <div class="cf-header-05-v3-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Clean Beauty",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#1f2937"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#22c55e"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#f3f4f6"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"PURE"},
    {"type":"text","id":"top_text","label":"Announcement Text","default":"CERTIFIED ORGANIC · VEGAN FORMULAS · ZERO WASTE"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Skincare"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "03 · Clean Beauty Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
