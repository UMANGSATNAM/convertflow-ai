<style>
.cf-promo-01-v6{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};display:flex;justify-content:center}
.cf-promo-01-v6-inner{max-width:800px;width:100%;position:relative;display:flex;align-items:center;justify-content:center}
.cf-promo-01-v6-img-wrap{width:100%;aspect-ratio:3/4;background:#ccc;overflow:hidden;position:relative;z-index:1}
.cf-promo-01-v6-img{width:100%;height:100%;object-fit:cover;opacity:0.85;transition:1.5s ease-out}
.cf-promo-01-v6-inner:hover .cf-promo-01-v6-img{transform:scale(1.05);opacity:1}
.cf-promo-01-v6-content{position:absolute;z-index:2;text-align:center;color:#FFFFFF;padding:40px;width:100%}
.cf-promo-01-v6-title{font-family:serif;font-size:clamp(40px, 8vw, 100px);font-weight:400;margin:0 0 20px 0;line-height:1;letter-spacing:0.02em}
.cf-promo-01-v6-desc{font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;margin:0 0 40px 0}
.cf-promo-01-v6-btn{display:inline-block;padding:15px 50px;border:1px solid #FFFFFF;font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:#FFFFFF;transition:0.3s}
.cf-promo-01-v6-btn:hover{background:#FFFFFF;color:#000000}
@media(max-width:768px){
  .cf-promo-01-v6-content{padding:20px}
  .cf-promo-01-v6-title{font-size:48px}
}
</style>

<div class="cf-promo-01-v6">
  <div class="cf-promo-01-v6-inner">
    <div class="cf-promo-01-v6-img-wrap">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="cf-promo-01-v6-img" alt="">
      {% else %}
        <div class="cf-promo-01-v6-img" style="background:#222;"></div>
      {% endif %}
    </div>
    <div class="cf-promo-01-v6-content">
      <h2 class="cf-promo-01-v6-title">{{ section.settings.title }}</h2>
      <p class="cf-promo-01-v6-desc">{{ section.settings.subtitle }}</p>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-promo-01-v6-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Promo (v6)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Vertical Campaign Image"},
    {"type":"text","id":"title","label":"Header Title","default":"Odyssey"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"FALL WINTER CAMPAIGN"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Enter Collection"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Outer Canvas Background","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Fallback Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":100}
  ],
  "presets": [{"name":"01 · Luxury Promo (v6)"}]
}
{% endschema %}
