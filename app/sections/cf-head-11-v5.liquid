<style>
.cf-h-11-v5{width:100%;background:{{ section.settings.bg_color }};padding:0 40px;height:{{ section.settings.height }}px;display:flex;align-items:center;justify-content:space-between;font-family:sans-serif}
.cf-h-11-v5-side{flex:1;display:flex;align-items:center}
.cf-h-11-v5-menu-btn{background:none;border:none;color:{{ section.settings.text_color }};cursor:pointer;padding:0;display:flex;align-items:center;gap:10px;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;font-weight:600}
.cf-h-11-v5-logo{font-size:26px;color:{{ section.settings.text_color }};font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;text-decoration:none}
.cf-h-11-v5-icon{color:{{ section.settings.text_color }};transition:0.3s}
.cf-h-11-v5-icon:hover{opacity:0.6}
@media(max-width:768px){.cf-h-11-v5{padding:0 20px}.cf-h-11-v5-menu-text{display:none}}
</style>

<div class="cf-h-11-v5">
  <div class="cf-h-11-v5-side">
    <button class="cf-h-11-v5-menu-btn" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      <span class="cf-h-11-v5-menu-text">MENU</span>
    </button>
  </div>
  
  <div class="cf-h-11-v5-side" style="justify-content:center;">
    <a href="/" class="cf-h-11-v5-logo">{{ section.settings.logo_text }}</a>
  </div>
  
  <div class="cf-h-11-v5-side" style="justify-content:flex-end;gap:20px;">
    <a href="/search" class="cf-h-11-v5-icon" aria-label="Search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </a>
    <a href="/cart" class="cf-h-11-v5-icon" aria-label="Cart">
       <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Header (v5)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"AESTHETIC"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F4F4F4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#222222"},
    {"type":"range","id":"height","label":"Height","min":60,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Header (v5)"}]
}
{% endschema %}
