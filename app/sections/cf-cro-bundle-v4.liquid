<style>
.cf-cro-bun4{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-bun4-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:40px}
.cf-cro-bun4-images{flex:1.2;display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.cf-cro-bun4-img{background:{{ section.settings.text_color }}04;border-radius:20px;overflow:hidden;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;position:relative}
.cf-cro-bun4-img:first-child{grid-column:1 / span 2;aspect-ratio:16/9}
.cf-cro-bun4-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:0.5s}
.cf-cro-bun4-img:hover img{transform:scale(1.05)}
.cf-cro-bun4-plus{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;z-index:10;border:4px solid {{ section.settings.bg_color }}}
.cf-cro-bun4-content{flex:1;padding:24px 0}
.cf-cro-bun4-badge{display:inline-block;padding:6px 14px;background:{{ section.settings.text_color }}10;color:{{ section.settings.text_color }};border-radius:100px;font-size:12px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:16px}
.cf-cro-bun4 h2{font-size:clamp(32px,4vw,48px);font-weight:900;color:{{ section.settings.text_color }};margin:0 0 16px;line-height:1.1;letter-spacing:-0.02em}
.cf-cro-bun4-desc{font-size:16px;line-height:1.6;color:{{ section.settings.text_color }};opacity:0.7;margin-bottom:32px}
.cf-cro-bun4-price{display:flex;align-items:baseline;gap:12px;margin-bottom:24px}
.cf-cro-bun4-price b{font-size:40px;font-weight:900;color:{{ section.settings.text_color }};line-height:1}
.cf-cro-bun4-price s{font-size:20px;color:{{ section.settings.text_color }};opacity:0.4;text-decoration:line-through}
.cf-cro-bun4-price span{background:{{ section.settings.accent_color }};color:#fff;padding:6px 12px;border-radius:8px;font-size:13px;font-weight:700;margin-left:8px}
.cf-cro-bun4-btn{display:block;width:100%;padding:20px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};border-radius:16px;font-size:18px;font-weight:800;text-decoration:none;text-align:center;transition:0.3s}
.cf-cro-bun4-btn:hover{background:{{ section.settings.accent_color }};color:#fff;transform:translateY(-2px);box-shadow:0 12px 30px {{ section.settings.accent_color }}40}
.cf-cro-bun4-guarantee{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:20px;font-size:14px;font-weight:600;color:{{ section.settings.text_color }};opacity:0.6}
@media(max-width:992px){.cf-cro-bun4-inner{flex-direction:column-reverse}.cf-cro-bun4-images{width:100%}}
</style>

<div class="cf-cro-bun4">
  <div class="cf-cro-bun4-inner">
    <div class="cf-cro-bun4-images" style="position:relative">
      <div class="cf-cro-bun4-img">{% if section.settings.img_1 != blank %}<img src="{{ section.settings.img_1 | image_url: width: 800 }}" alt="" loading="lazy">{% else %}<div style="font-size:48px;opacity:0.2">📦</div>{% endif %}</div>
      <div class="cf-cro-bun4-img">{% if section.settings.img_2 != blank %}<img src="{{ section.settings.img_2 | image_url: width: 400 }}" alt="" loading="lazy">{% else %}<div style="font-size:32px;opacity:0.2">📦</div>{% endif %}</div>
      <div class="cf-cro-bun4-img">{% if section.settings.img_3 != blank %}<img src="{{ section.settings.img_3 | image_url: width: 400 }}" alt="" loading="lazy">{% else %}<div style="font-size:32px;opacity:0.2">📦</div>{% endif %}</div>
      <div class="cf-cro-bun4-plus">+</div>
    </div>
    <div class="cf-cro-bun4-content">
      <div class="cf-cro-bun4-badge">FREQUENTLY BOUGHT TOGETHER</div>
      <h2>{{ section.settings.bundle_name }}</h2>
      <p class="cf-cro-bun4-desc">{{ section.settings.description }}</p>
      
      <div style="margin-bottom:32px;border-left:2px solid {{ section.settings.accent_color }};padding-left:16px">
        {% assign items = section.settings.items | split: '|' %}
        {% for item in items %}<div style="font-size:15px;font-weight:600;color:{{ section.settings.text_color }};margin-bottom:8px">{{ item }}</div>{% endfor %}
      </div>

      <div class="cf-cro-bun4-price">
        <b>{{ section.settings.price }}</b>
        <s>{{ section.settings.compare }}</s>
        <span>SAVE {{ section.settings.save_pct }}</span>
      </div>
      
      <a href="{{ section.settings.cta_link }}" class="cf-cro-bun4-btn">{{ section.settings.cta_text }}</a>
      <div class="cf-cro-bun4-guarantee"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> 60-Day Money-Back Guarantee</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Premium Bundle v4",
  "settings": [
    {"type":"image_picker","id":"img_1","label":"Main Product Image"},
    {"type":"image_picker","id":"img_2","label":"Add-on 1 Image"},
    {"type":"image_picker","id":"img_3","label":"Add-on 2 Image"},
    {"type":"text","id":"bundle_name","label":"Bundle Name","default":"The Ultimate Setup"},
    {"type":"textarea","id":"description","label":"Description","default":"Everything you need to get started right away. Curated specifically to give you the best possible experience out of the box."},
    {"type":"textarea","id":"items","label":"Items List (|)","default":"1x The Core Device|2x Premium Accessories|1x Protective Travel Case"},
    {"type":"text","id":"price","label":"Price","default":"$199"},
    {"type":"text","id":"compare","label":"Original Price","default":"$265"},
    {"type":"text","id":"save_pct","label":"Save Percentage","default":"25%"},
    {"type":"text","id":"cta_text","label":"CTA","default":"Add Bundle to Cart"},
    {"type":"text","id":"cta_link","label":"Link","default":"/cart"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F8FAFC"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0F172A"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#F43F5E"},
    {"type":"range","id":"padding_y","label":"Top/Bottom Padding","min":20,"max":120,"step":10,"default":80}
  ],
  "presets": [{"name":"CRO · Premium Bundle v4"}]
}
{% endschema %}
