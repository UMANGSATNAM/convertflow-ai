<style>
.cf-trust-12-v2{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }};border-top:1px solid {{ section.settings.border_color }};border-bottom:1px solid {{ section.settings.border_color }}}
.cf-trust-12-v2-inner{max-width:1400px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:40px}
.cf-trust-12-v2-item{display:flex;align-items:center;gap:15px;flex:1;min-width:250px}
.cf-trust-12-v2-icon{width:40px;height:40px;display:flex;align-items:center;justify-content:center;color:{{ section.settings.accent_color }}}
.cf-trust-12-v2-text-wrap{display:flex;flex-direction:column}
.cf-trust-12-v2-title{font-size:16px;margin:0 0 4px 0;font-style:italic;font-weight:400}
.cf-trust-12-v2-desc{font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;opacity:0.6;margin:0}
@media(max-width:900px){.cf-trust-12-v2-inner{flex-direction:column;align-items:flex-start}.cf-trust-12-v2-item{width:100%}}
</style>

<div class="cf-trust-12-v2">
  <div class="cf-trust-12-v2-inner">
    {% for i in (1..4) %}
      <div class="cf-trust-12-v2-item">
        <div class="cf-trust-12-v2-icon">
          {% if i == 1 %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><rect x="3" y="8" width="18" height="12" rx="2" ry="2"></rect><line x1="16" y1="8" x2="16" y2="4"></line><line x1="8" y1="8" x2="8" y2="4"></line><line x1="12" y1="12" x2="12" y2="12"></line></svg>
          {% elsif i == 2 %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          {% elsif i == 3 %}
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"></path><path d="M16.5 21A4.5 4.5 0 1 0 16.5 12a4.5 4.5 0 0 0 0 9Z"></path><path d="M16.5 14L16.5 19"></path></svg>
          {% else %}
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          {% endif %}
        </div>
        <div class="cf-trust-12-v2-text-wrap">
          <h3 class="cf-trust-12-v2-title">
            {% if i == 1 %}Complimentary Shipping{% elsif i == 2 %}Same Day Dispatch{% elsif i == 3 %}Complimentary Returns{% else %}Ethically Sourced{% endif %}
          </h3>
          <p class="cf-trust-12-v2-desc">
            {% if i == 1 %}On all orders above $200{% elsif i == 2 %}Order before 2PM EST{% elsif i == 3 %}Within 30 days of purchase{% else %}Crafted with conscience{% endif %}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Trust (v2)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#222222"},
    {"type":"color","id":"accent_color","label":"Icon Accent Color","default":"#A38971"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#F0F0F0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":40}
  ],
  "presets": [{"name":"12 · Women's Trust (v2)"}]
}
{% endschema %}
