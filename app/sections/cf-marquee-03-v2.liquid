<style>
.cf-mq-03-v2 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  border-top: 1px solid {{ section.settings.border_color }};
  border-bottom: 1px solid {{ section.settings.border_color }};
  display: flex;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-mq-03-v2-track {
  display: flex;
  white-space: nowrap;
  animation: cf-mq-03-v2-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-03-v2-track:hover {
  animation-play-state: paused;
}

@keyframes cf-mq-03-v2-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.cf-mq-03-v2-item {
  display: flex;
  align-items: center;
  padding: 0 40px;
  font-size: {{ section.settings.text_size }}px;
  font-weight: bold;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
}

/* Blinking cursor effect after each item */
.cf-mq-03-v2-item::after {
  content: '_';
  color: {{ section.settings.accent_color }};
  margin-left: 50px; /* Spacer replacement */
  animation: cf-mq-03-v2-blink 1s step-end infinite;
}

@keyframes cf-mq-03-v2-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
</style>

<div class="cf-mq-03-v2">
  <div class="cf-mq-03-v2-track">
    {% for block in section.blocks %}
      <div class="cf-mq-03-v2-item">{{ block.settings.text }}</div>
    {% endfor %}
    {% for block in section.blocks %}
      <div class="cf-mq-03-v2-item">{{ block.settings.text }}</div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "02 · Terminal Ticker",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#00ff41"},
    {"type":"color","id":"accent_color","label":"Cursor Color","default":"#ffffff"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#333333"},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":36,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":10},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":20}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "limit": 8,
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"NEW_OS_UPDATE_AVAILABLE"}
      ]
    }
  ],
  "presets": [
    {
      "name": "02 · Terminal Ticker",
      "blocks": [
        {"type": "text"},
        {"type": "text"},
        {"type": "text"},
        {"type": "text"}
      ]
    }
  ]
}
{% endschema %}
