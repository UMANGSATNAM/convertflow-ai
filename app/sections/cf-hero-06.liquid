<style>
.cf-hero-06{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;width:100%;min-height:{{ section.settings.height }}px;background:{{ section.settings.bg_color }};display:flex;align-items:stretch;overflow:hidden}
.cf-hero-06-left{flex:1;padding:80px 60px;display:flex;flex-direction:column;justify-content:center;position:relative}
.cf-hero-06-badge{display:inline-flex;align-items:center;gap:8px;background:{{ section.settings.badge_bg }};color:{{ section.settings.badge_color }};padding:6px 16px;border-radius:6px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:24px;width:fit-content}
.cf-hero-06 h1{font-size:clamp(32px,4vw,{{ section.settings.heading_size }}px);font-weight:800;color:{{ section.settings.heading_color }};margin:0 0 20px;line-height:1.1;letter-spacing:-0.02em}
.cf-hero-06 p{font-size:16px;color:{{ section.settings.text_color }};line-height:1.7;margin:0 0 32px;max-width:460px}
.cf-hero-06-email{display:flex;gap:0;max-width:440px;border-radius:8px;overflow:hidden;border:2px solid {{ section.settings.heading_color }}}
.cf-hero-06-email input{flex:1;padding:14px 16px;border:none;font-size:14px;outline:none;font-family:inherit;background:transparent;color:{{ section.settings.heading_color }}}
.cf-hero-06-email input::placeholder{color:{{ section.settings.text_color }};opacity:0.5}
.cf-hero-06-email button{padding:14px 28px;border:none;background:{{ section.settings.heading_color }};color:{{ section.settings.bg_color }};font-weight:600;font-size:14px;cursor:pointer;white-space:nowrap;font-family:inherit}
.cf-hero-06-trust{margin-top:20px;font-size:12px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-hero-06-right{flex:1;position:relative;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:20px}
.cf-hero-06-right div{border-radius:12px;overflow:hidden;min-height:200px}
.cf-hero-06-right div:first-child{grid-row:1/3}
.cf-hero-06-right img{width:100%;height:100%;object-fit:cover}
@media(max-width:768px){.cf-hero-06{flex-direction:column}.cf-hero-06-left{padding:40px 24px}.cf-hero-06-right{min-height:300px;padding:12px}}
</style>

<section class="cf-hero-06">
  <div class="cf-hero-06-left">
    {% if section.settings.badge != blank %}<div class="cf-hero-06-badge">{{ section.settings.badge }}</div>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <div class="cf-hero-06-email">
      <input type="email" placeholder="{{ section.settings.input_placeholder }}">
      <button type="button">{{ section.settings.btn_text }}</button>
    </div>
    <div class="cf-hero-06-trust">{{ section.settings.trust_text }}</div>
  </div>
  <div class="cf-hero-06-right">
    <div style="background:linear-gradient(135deg,#a78bfa,#ec4899)">
      {% if section.settings.img1 != blank %}<img src="{{ section.settings.img1 | image_url: width: 600 }}" alt="Hero 1">{% endif %}
    </div>
    <div style="background:linear-gradient(135deg,#fbbf24,#f97316)">
      {% if section.settings.img2 != blank %}<img src="{{ section.settings.img2 | image_url: width: 600 }}" alt="Hero 2">{% endif %}
    </div>
    <div style="background:linear-gradient(135deg,#34d399,#3b82f6)">
      {% if section.settings.img3 != blank %}<img src="{{ section.settings.img3 | image_url: width: 600 }}" alt="Hero 3">{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "06 · Email Capture Hero",
  "settings": [
    {"type":"range","id":"padding_top","label":"Padding Top","min":0,"max":200,"step":5,"default":0},
    {"type":"range","id":"padding_bottom","label":"Padding Bottom","min":0,"max":200,"step":5,"default":0},
    {"type":"text","id":"badge","label":"Badge","default":"🔥 LIMITED OFFER"},
    {"type":"text","id":"heading","label":"Heading","default":"Get 20% Off Your First Order"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Subscribe to our newsletter and unlock an exclusive discount on your first purchase."},
    {"type":"text","id":"input_placeholder","label":"Input Placeholder","default":"Enter your email address"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Get Offer"},
    {"type":"text","id":"trust_text","label":"Trust Text","default":"✓ No spam. Unsubscribe anytime. 100K+ subscribers."},
    {"type":"image_picker","id":"img1","label":"Image 1 (Tall)"},
    {"type":"image_picker","id":"img2","label":"Image 2 (Top)"},
    {"type":"image_picker","id":"img3","label":"Image 3 (Bottom)"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading Color","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#666666"},
    {"type":"color","id":"badge_bg","label":"Badge BG","default":"#fef3c7"},
    {"type":"color","id":"badge_color","label":"Badge Color","default":"#92400e"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":28,"max":60,"step":2,"default":42},
    {"type":"range","id":"height","label":"Min Height","min":400,"max":700,"step":50,"default":550}
  ],
  "presets": [{"name":"06 · Email Capture Hero"}]
}
{% endschema %}
