<style>
.cf-fc-02-v2 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-fc-02-v2-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-02-v2-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 30px;
  border-bottom: 1px dashed {{ section.settings.border_color }};
  padding-bottom: 20px;
}

.cf-fc-02-v2-title {
  font-size: clamp(20px, 4vw, {{ section.settings.title_size }}px);
  font-weight: 900;
  text-transform: uppercase;
  color: {{ section.settings.text_color }};
  margin: 0;
  letter-spacing: 0.1em;
}

.cf-fc-02-v2-title span {
  color: {{ section.settings.accent_color }};
}

.cf-fc-02-v2-link {
  font-size: 13px;
  font-weight: bold;
  text-transform: uppercase;
  text-decoration: none;
  color: {{ section.settings.text_color }};
  transition: 0.2s;
}
.cf-fc-02-v2-link:hover {
  color: {{ section.settings.accent_color }};
}

.cf-fc-02-v2-carousel {
  display: flex;
  overflow-x: auto;
  gap: 20px;
  padding-bottom: 20px;
  scrollbar-width: thin;
  scrollbar-color: {{ section.settings.border_color }} {{ section.settings.bg_color }};
}

.cf-fc-02-v2-carousel::-webkit-scrollbar {
  height: 6px;
}
.cf-fc-02-v2-carousel::-webkit-scrollbar-track {
  background: {{ section.settings.bg_color }};
}
.cf-fc-02-v2-carousel::-webkit-scrollbar-thumb {
  background-color: {{ section.settings.border_color }};
  border-radius: 0px;
}

.cf-fc-02-v2-item {
  flex: 0 0 calc(80% - 20px);
  max-width: 320px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  position: relative;
  border: 1px solid {{ section.settings.border_color }};
  background: #000;
  box-shadow: 0 0 10px {{ section.settings.accent_color }}40 inset;
  transition: 0.3s;
}

.cf-fc-02-v2-item:hover {
  border-color: {{ section.settings.accent_color }};
  box-shadow: 0 0 15px {{ section.settings.accent_color }}80 inset, 0 0 10px {{ section.settings.accent_color }};
}

.cf-fc-02-v2-img-wrap {
  width: 100%;
  aspect-ratio: 1/1;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid {{ section.settings.border_color }};
}

.cf-fc-02-v2-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 20px;
  transition: transform 0.4s;
  filter: drop-shadow(0 0 10px rgba(255,255,255,0.1));
}

.cf-fc-02-v2-item:hover .cf-fc-02-v2-img {
  transform: scale(1.05);
}

.cf-fc-02-v2-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: {{ section.settings.accent_color }};
  color: #000;
  padding: 4px 10px;
  font-weight: 900;
  font-size: 10px;
  text-transform: uppercase;
  z-index: 2;
}

.cf-fc-02-v2-info {
  padding: 15px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}

.cf-fc-02-v2-title-main {
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  color: {{ section.settings.text_color }};
  margin: 0 0 15px 0;
  line-height: 1.4;
}

.cf-fc-02-v2-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px dashed {{ section.settings.border_color }};
  padding-top: 10px;
}

.cf-fc-02-v2-price {
  font-size: 13px;
  color: {{ section.settings.accent_color }};
  font-weight: bold;
}

.cf-fc-02-v2-icon {
  color: {{ section.settings.text_color }};
  font-size: 10px;
}

@media (min-width: 768px) {
  .cf-fc-02-v2-item {
    flex: 0 0 calc(25% - 15px);
  }
}
</style>

<div class="cf-fc-02-v2">
  <div class="cf-fc-02-v2-inner">
    <div class="cf-fc-02-v2-header">
      <h2 class="cf-fc-02-v2-title">{{ section.settings.title }} <span>_</span></h2>
      <a href="{{ section.settings.link }}" class="cf-fc-02-v2-link">>> {{ section.settings.link_text }}</a>
    </div>

    <div class="cf-fc-02-v2-carousel">
      {% if section.settings.collection != blank and collections[section.settings.collection].products.size > 0 %}
        {% for product in collections[section.settings.collection].products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="cf-fc-02-v2-item">
            <div class="cf-fc-02-v2-img-wrap">
              {% if product.compare_at_price > product.price %}
                <div class="cf-fc-02-v2-badge">SALE</div>
              {% endif %}
              <img class="cf-fc-02-v2-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}">
            </div>
            <div class="cf-fc-02-v2-info">
              <h3 class="cf-fc-02-v2-title-main">{{ product.title }}</h3>
              <div class="cf-fc-02-v2-meta">
                <div class="cf-fc-02-v2-price">
                  <span>{{ product.price | money }}</span>
                </div>
                <div class="cf-fc-02-v2-icon">[+]</div>
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.limit) %}
          <a href="#" class="cf-fc-02-v2-item">
            <div class="cf-fc-02-v2-img-wrap">
              <div class="cf-fc-02-v2-img" style="background:#222; display:flex; align-items:center; justify-content:center; color:#555;">TECH-GEAR_{{ i }}</div>
            </div>
            <div class="cf-fc-02-v2-info">
              <h3 class="cf-fc-02-v2-title-main">SYSTEM UTILITY PANT V.{{ i }}</h3>
              <div class="cf-fc-02-v2-meta">
                <div class="cf-fc-02-v2-price">$180.00</div>
                <div class="cf-fc-02-v2-icon">[+]</div>
              </div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "02 · Tech Neon Slider",
  "settings": [
    {"type":"text","id":"title","label":"Section Title","default":"SYS_CATALOG"},
    {"type":"range","id":"title_size","label":"Title Size","min":16,"max":48,"step":2,"default":28},
    {"type":"text","id":"link_text","label":"Link Text","default":"INITIALIZE"},
    {"type":"url","id":"link","label":"Link URL"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Product Limit","min":4,"max":12,"step":1,"default":8},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#09090b"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#d4d4d8"},
    {"type":"color","id":"accent_color","label":"Neon Accent (Green/Orange)","default":"#22c55e"},
    {"type":"color","id":"border_color","label":"Grid/Lines Color","default":"#27272a"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1600,"step":100,"default":1200}
  ],
  "presets": [{"name":"02 · Tech Neon Slider Collection"}]
}
{% endschema %}
