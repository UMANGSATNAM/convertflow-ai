<style>
.cf-feat-13-v2{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-13-v2-inner{max-width:1600px;margin:0 auto}
.cf-feat-13-v2-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px}
.cf-feat-13-v2-title{font-size:clamp(32px, 5vw, 64px);line-height:1;margin:0;font-weight:900;text-transform:uppercase;letter-spacing:-0.02em}
.cf-feat-13-v2-btn{font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;color:{{ section.settings.text_color }};border-bottom:1px solid {{ section.settings.text_color }};padding-bottom:5px;transition:0.3s}
.cf-feat-13-v2-btn:hover{color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }}}
.cf-feat-13-v2-grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:40px}
.cf-feat-13-v2-card{text-decoration:none;color:inherit;display:block}
.cf-feat-13-v2-img-wrap{width:100%;aspect-ratio:3/4;background:#f0f0f0;overflow:hidden;margin-bottom:20px}
.cf-feat-13-v2-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-feat-13-v2-card:hover .cf-feat-13-v2-img{transform:scale(1.05)}
.cf-feat-13-v2-info{display:flex;justify-content:space-between;align-items:flex-start}
.cf-feat-13-v2-name{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;margin:0 0 5px 0}
.cf-feat-13-v2-type{font-size:11px;opacity:0.6;margin:0}
.cf-feat-13-v2-price{font-size:12px;font-weight:800}
@media(max-width:1024px){
  .cf-feat-13-v2-grid{grid-template-columns:repeat(2, 1fr);gap:20px}
}
@media(max-width:600px){
  .cf-feat-13-v2-header{flex-direction:column;align-items:flex-start;gap:20px}
  .cf-feat-13-v2-grid{grid-template-columns:repeat(2, 1fr);gap:10px}
  .cf-feat-13-v2-info{flex-direction:column;gap:5px}
}
</style>

<div class="cf-feat-13-v2">
  <div class="cf-feat-13-v2-inner">
    <div class="cf-feat-13-v2-header">
      <h2 class="cf-feat-13-v2-title">{{ section.settings.title }}</h2>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-feat-13-v2-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    
    <div class="cf-feat-13-v2-grid">
      {% for i in (1..8) %}
        <a href="#" class="cf-feat-13-v2-card">
          <div class="cf-feat-13-v2-img-wrap">
            <div class="cf-feat-13-v2-img" style="background:#555;"></div>
          </div>
          <div class="cf-feat-13-v2-info">
            <div>
              <h3 class="cf-feat-13-v2-name">Product Name 0{{ i }}</h3>
              <p class="cf-feat-13-v2-type">Outerwear</p>
            </div>
            <div class="cf-feat-13-v2-price">$240</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Featured (v2)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"LATEST ARRIVALS"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"View Full Collection"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Hover","default":"#FF3300"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Featured (v2)"}]
}
{% endschema %}
