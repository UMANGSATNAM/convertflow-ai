<style>
.cf-cat-13-v10{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;overflow:hidden}
.cf-cat-13-v10-inner{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1fr 1.5fr 1fr;gap:20px}
.cf-cat-13-v10-col{display:flex;flex-direction:column;gap:40px}
.cf-cat-13-v10-col-2{padding-top:100px}
.cf-cat-13-v10-col-3{padding-top:40px}
.cf-cat-13-v10-card{position:relative;text-decoration:none;display:block}
.cf-cat-13-v10-img-wrap{width:100%;aspect-ratio:3/4;overflow:hidden;background:#ebebeb}
.cf-cat-13-v10-img{width:100%;height:100%;object-fit:cover;transition:0.6s}
.cf-cat-13-v10-card:hover .cf-cat-13-v10-img{transform:scale(1.03)}
.cf-cat-13-v10-label-wrap{position:absolute;bottom:-20px;left:20px;background:{{ section.settings.bg_color }};padding:15px;border:1px solid {{ section.settings.text_color }};z-index:2;display:flex;align-items:center;gap:10px}
.cf-cat-13-v10-label{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.15em;color:{{ section.settings.text_color }};margin:0}
.cf-cat-13-v10-card:hover .cf-cat-13-v10-label-wrap{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-cat-13-v10-card:hover .cf-cat-13-v10-label{color:{{ section.settings.bg_color }}}
@media(max-width:1024px){
  .cf-cat-13-v10-inner{grid-template-columns:1fr 1fr}
  .cf-cat-13-v10-col-3{display:none}
}
@media(max-width:600px){
  .cf-cat-13-v10-inner{grid-template-columns:1fr;gap:60px}
  .cf-cat-13-v10-col-2{padding-top:0}
}
</style>

<div class="cf-cat-13-v10">
  <div class="cf-cat-13-v10-inner">
    <div class="cf-cat-13-v10-col cf-cat-13-v10-col-1">
      <a href="#" class="cf-cat-13-v10-card">
        <div class="cf-cat-13-v10-img-wrap">
          <div class="cf-cat-13-v10-img" style="background:#444;"></div>
        </div>
        <div class="cf-cat-13-v10-label-wrap">
          <h3 class="cf-cat-13-v10-label">01 / Outerwear</h3>
        </div>
      </a>
      <a href="#" class="cf-cat-13-v10-card">
        <div class="cf-cat-13-v10-img-wrap">
          <div class="cf-cat-13-v10-img" style="background:#555;"></div>
        </div>
        <div class="cf-cat-13-v10-label-wrap">
          <h3 class="cf-cat-13-v10-label">02 / Knitwear</h3>
        </div>
      </a>
    </div>

    <div class="cf-cat-13-v10-col cf-cat-13-v10-col-2">
      <a href="#" class="cf-cat-13-v10-card" style="aspect-ratio:3/5;">
        <div class="cf-cat-13-v10-img-wrap" style="aspect-ratio:3/5;">
          <div class="cf-cat-13-v10-img" style="background:#666;"></div>
        </div>
        <div class="cf-cat-13-v10-label-wrap">
          <h3 class="cf-cat-13-v10-label">03 / Tailoring</h3>
        </div>
      </a>
    </div>

    <div class="cf-cat-13-v10-col cf-cat-13-v10-col-3">
      <a href="#" class="cf-cat-13-v10-card">
        <div class="cf-cat-13-v10-img-wrap">
          <div class="cf-cat-13-v10-img" style="background:#777;"></div>
        </div>
        <div class="cf-cat-13-v10-label-wrap">
          <h3 class="cf-cat-13-v10-label">04 / Footwear</h3>
        </div>
      </a>
      <a href="#" class="cf-cat-13-v10-card">
        <div class="cf-cat-13-v10-img-wrap">
          <div class="cf-cat-13-v10-img" style="background:#888;"></div>
        </div>
        <div class="cf-cat-13-v10-label-wrap">
          <h3 class="cf-cat-13-v10-label">05 / Accessories</h3>
        </div>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Category (v10)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text & Border Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Brand Category (v10)"}]
}
{% endschema %}
