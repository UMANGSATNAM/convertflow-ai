<style>
.cf-fc-03-v8 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-fc-03-v8-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-03-v8-heading {
  font-size: clamp(24px, 4vw, 36px);
  color: {{ section.settings.accent_color }};
  margin: 0 0 30px 0;
  text-transform: uppercase;
}
.cf-fc-03-v8-heading::before {
  content: 'cat inventory.log';
  color: {{ section.settings.text_color }};
  opacity: 0.5;
  display: block;
  font-size: 14px;
  margin-bottom: 15px;
}

.cf-fc-03-v8-log {
  border-left: 2px solid {{ section.settings.accent_color }}40;
  padding-left: 15px;
  display: flex;
  flex-direction: column;
}

.cf-fc-03-v8-item {
  position: relative;
  text-decoration: none;
  padding: 15px 0;
  border-bottom: 1px dashed {{ section.settings.text_color }}20;
  display: grid;
  grid-template-columns: 80px 1fr auto;
  align-items: center;
  gap: 20px;
  transition: 0.2s;
  color: {{ section.settings.text_color }};
}

.cf-fc-03-v8-item:hover {
  background: rgba(255,255,255,0.02);
  padding-left: 10px;
}

.cf-fc-03-v8-id {
  font-size: 12px;
  opacity: 0.5;
}

.cf-fc-03-v8-title {
  font-size: 16px;
  font-weight: bold;
  margin: 0;
}

.cf-fc-03-v8-item:hover .cf-fc-03-v8-title {
  color: {{ section.settings.accent_color }};
}

.cf-fc-03-v8-price {
  font-weight: bold;
}

/* Hover Image Reveal */
.cf-fc-03-v8-preview {
  position: absolute;
  top: 50%; right: 150px;
  transform: translateY(-50%) rotate(5deg);
  width: 150px; height: 150px;
  background: #111;
  border: 1px solid {{ section.settings.accent_color }};
  opacity: 0;
  pointer-events: none;
  transition: 0.3s;
  z-index: 10;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.cf-fc-03-v8-item:hover .cf-fc-03-v8-preview {
  opacity: 1;
  transform: translateY(-50%) rotate(0deg);
}

.cf-fc-03-v8-preview img {
  width: 100%; height: 100%; object-fit: cover;
  filter: contrast(1.2);
}

@media (max-width: 768px) {
  .cf-fc-03-v8-item {
    grid-template-columns: 1fr auto;
  }
  .cf-fc-03-v8-id { display: none; }
  .cf-fc-03-v8-preview { display: none; }
}
</style>

<div class="cf-fc-03-v8">
  <div class="cf-fc-03-v8-inner">
    <h2 class="cf-fc-03-v8-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-fc-03-v8-log">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="cf-fc-03-v8-item">
            <span class="cf-fc-03-v8-id">[0x{{ forloop.index }}A]</span>
            <span class="cf-fc-03-v8-title">{{ product.title }}</span>
            <span class="cf-fc-03-v8-price">{{ product.price | money }}</span>
            <div class="cf-fc-03-v8-preview">
              <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}">
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <a href="#" class="cf-fc-03-v8-item">
            <span class="cf-fc-03-v8-id">[0x{{ i }}A]</span>
            <span class="cf-fc-03-v8-title">Database Storage Unit {{ i }}</span>
            <span class="cf-fc-03-v8-price">$89.00</span>
            <div class="cf-fc-03-v8-preview">
              <div style="width:100%; height:100%; background: linear-gradient(45deg, #111, {{ section.settings.accent_color | color_modify: 'alpha', 0.2 }});"></div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "08 · Hacker Data Log",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"ASSET_INVENTORY"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":12,"step":1,"default":6},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#d4d4d4"},
    {"type":"color","id":"accent_color","label":"Terminal Green Focus","default":"#4af626"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":600,"max":1200,"step":100,"default":900}
  ],
  "presets": [{"name":"08 · Hacker Data Log Collection"}]
}
{% endschema %}
