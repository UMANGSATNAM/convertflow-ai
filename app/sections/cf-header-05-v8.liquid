<style>
.cf-header-05-v8 {
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-header-05-v8-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 40px;
  font-size: 11px;
  color: {{ section.settings.text_color }};
  opacity: 0.7;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-bottom: 1px solid {{ section.settings.border_color }};
}
.cf-header-05-v8-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 40px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
.cf-header-05-v8-logo {
  font-size: 32px;
  font-weight: 800;
  font-style: italic;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  background: linear-gradient(135deg, {{ section.settings.accent_color }}, #f43f5e, #a855f7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.cf-header-05-v8-nav {
  display: flex;
  gap: 30px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v8-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: color 0.2s;
}
.cf-header-05-v8-nav a:hover { color: {{ section.settings.accent_color }}; }
.cf-header-05-v8-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}
.cf-header-05-v8-icon { color: {{ section.settings.text_color }}; cursor: pointer; }
.cf-header-05-v8-icon svg { width: 22px; height: 22px; stroke-width: 1.8; }
@media (max-width: 900px) {
  .cf-header-05-v8-top, .cf-header-05-v8-nav { display: none; }
  .cf-header-05-v8-bar { padding: 15px 20px; }
}
</style>

<div class="cf-header-05-v8">
  <div class="cf-header-05-v8-top">
    <span>{{ section.settings.top_left }}</span>
    <span>{{ section.settings.top_center }}</span>
    <span>{{ section.settings.top_right }}</span>
  </div>
  <div class="cf-header-05-v8-bar">
    <a href="/" class="cf-header-05-v8-logo">{{ section.settings.logo_text }}</a>
    <nav>
      <ul class="cf-header-05-v8-nav">
        {% for block in section.blocks %}
          <li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="cf-header-05-v8-actions">
      <div class="cf-header-05-v8-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v8-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
      <div class="cf-header-05-v8-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/></svg></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "08 · Nail Art Studio",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#fdf2f8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#831843"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#ec4899"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#fce7f3"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"NAILÉ"},
    {"type":"text","id":"top_left","label":"Top Bar Left Text","default":"New: Chrome Collection"},
    {"type":"text","id":"top_center","label":"Top Bar Center Text","default":"Free Express Shipping on orders $60+"},
    {"type":"text","id":"top_right","label":"Top Bar Right Text","default":"20+ Trending Shades"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Gel Polish"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "08 · Nail Art Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
