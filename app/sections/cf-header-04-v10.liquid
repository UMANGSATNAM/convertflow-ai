<style>
.cf-h-04-v10 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  position: {{ section.settings.position }};
  top: 0;
  z-index: 50;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  border-bottom: 3px solid {{ section.settings.accent_color }};
}

.cf-h-04-v10-top {
  padding: 15px 20px;
}

.cf-h-04-v10-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cf-h-04-v10-logo {
  font-size: 28px;
  font-weight: 800;
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  display: flex; align-items: center; gap: 8px;
  text-transform: uppercase;
  letter-spacing: -0.5px;
}

.cf-h-04-v10-logo svg {
  width: 32px; height: 32px;
}

.cf-h-04-v10-trust {
  display: flex;
  gap: 30px;
}

.cf-h-04-v10-trust-item {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cf-h-04-v10-trust-icon {
  width: 36px; height: 36px;
  background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  color: {{ section.settings.accent_color }};
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

.cf-h-04-v10-trust-icon svg { width: 18px; height: 18px; stroke-width: 2; }

.cf-h-04-v10-trust-text {
  display: flex; flex-direction: column;
}

.cf-h-04-v10-trust-title {
  color: {{ section.settings.text_color }};
  font-size: 13px; font-weight: 700; margin: 0; line-height: 1.2;
}

.cf-h-04-v10-trust-sub {
  color: #666; font-size: 11px; margin: 0;
}

.cf-h-04-v10-bottom {
  background: {{ section.settings.bottom_bg }};
}

.cf-h-04-v10-bottom-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cf-h-04-v10-nav {
  display: flex;
}

.cf-h-04-v10-link {
  color: #fff;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  padding: 15px 20px;
  transition: background 0.2s ease;
}

.cf-h-04-v10-link:hover {
  background: rgba(255,255,255,0.1);
}

.cf-h-04-v10-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.cf-h-04-v10-action {
  color: #fff; text-decoration: none; display: flex; align-items: center; gap: 6px;
  font-size: 14px; font-weight: 600; transition: opacity 0.2s;
}
.cf-h-04-v10-action:hover { opacity: 0.8; }
.cf-h-04-v10-action svg { width: 18px; height: 18px; }

.cf-h-04-v10-mobile-toggle {
  display: none; background: none; border: none; cursor: pointer; color: {{ section.settings.accent_color }};
}

@media (max-width: 900px) {
  .cf-h-04-v10-trust { display: none; }
  .cf-h-04-v10-nav { display: none; }
  .cf-h-04-v10-bottom { display: none; } /* Hide bottom bar fully on mobile, bring actions to top */
  .cf-h-04-v10-mobile-toggle { display: block; }
}
</style>

<div class="cf-h-04-v10">
  <div class="cf-h-04-v10-top">
    <div class="cf-h-04-v10-inner">
      <button class="cf-h-04-v10-mobile-toggle" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      
      <a href="/" class="cf-h-04-v10-logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" style="height: auto;">
        {% else %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          {{ shop.name | default: 'HEALTH+MED' }}
        {% endif %}
      </a>
      
      <div class="cf-h-04-v10-trust">
        <div class="cf-h-04-v10-trust-item">
          <div class="cf-h-04-v10-trust-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div class="cf-h-04-v10-trust-text">
            <h4 class="cf-h-04-v10-trust-title">FDA Approved</h4>
            <p class="cf-h-04-v10-trust-sub">Facility Certified</p>
          </div>
        </div>
        <div class="cf-h-04-v10-trust-item">
          <div class="cf-h-04-v10-trust-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <div class="cf-h-04-v10-trust-text">
            <h4 class="cf-h-04-v10-trust-title">Free Shipping</h4>
            <p class="cf-h-04-v10-trust-sub">On orders over $50</p>
          </div>
        </div>
        <div class="cf-h-04-v10-trust-item">
          <div class="cf-h-04-v10-trust-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M15.05 5A5 5 0 0 1 19 8.95M15.05 1A9 9 0 0 1 23 8.94m-1 7.98v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <div class="cf-h-04-v10-trust-text">
            <h4 class="cf-h-04-v10-trust-title">1-800-HEALTH</h4>
            <p class="cf-h-04-v10-trust-sub">24/7 Expert Support</p>
          </div>
        </div>
      </div>
      
      <!-- Mobile placeholder for actions -->
      <a href="/cart" class="cf-h-04-v10-action cf-h-04-v10-mobile-cart" style="display:none; color: {{ section.settings.accent_color }};">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      </a>
      <style>@media(max-width:900px){.cf-h-04-v10-mobile-cart{display:flex !important;}}</style>

    </div>
  </div>
  
  <div class="cf-h-04-v10-bottom">
    <div class="cf-h-04-v10-bottom-inner">
      <nav class="cf-h-04-v10-nav">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="cf-h-04-v10-link">{{ link.title }}</a>
        {% else %}
          <a href="#" class="cf-h-04-v10-link">All Products</a>
          <a href="#" class="cf-h-04-v10-link">Vitamins</a>
          <a href="#" class="cf-h-04-v10-link">First Aid</a>
          <a href="#" class="cf-h-04-v10-link">Medical Devices</a>
        {% endfor %}
      </nav>
      
      <div class="cf-h-04-v10-actions">
        <a href="/search" class="cf-h-04-v10-action"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg> Search</a>
        <a href="/account" class="cf-h-04-v10-action"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg> Account</a>
        <a href="/cart" class="cf-h-04-v10-action"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg> Cart</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · Medical Professional",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Top","default":"#ffffff"},
    {"type":"color","id":"bottom_bg","label":"Background Nav","default":"#1e3a8a"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#1d4ed8"},
    {"type":"link_list","id":"menu","label":"Menu"},
    {"type":"image_picker","id":"logo","label":"Logo Image"},
    {"type":"range","id":"logo_width","label":"Logo Width","min":50,"max":250,"step":5,"default":180},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1600,"step":50,"default":1200},
    {"type":"select","id":"position","label":"Header Position","options":[{"value":"relative","label":"Static"},{"value":"sticky","label":"Sticky"}],"default":"relative"}
  ],
  "presets": [{"name":"10 · Medical Professional"}]
}
{% endschema %}
