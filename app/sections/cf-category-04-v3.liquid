<style>
.cf-cat-04-v3 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Georgia', serif;
}

.cf-cat-04-v3-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v3-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 50px;
  border-bottom: 1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.1 }};
  padding-bottom: 20px;
}

.cf-cat-04-v3-title {
  font-size: 42px;
  font-style: italic;
  font-weight: normal;
  color: {{ section.settings.text_color }};
  margin: 0;
}

.cf-cat-04-v3-link {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: opacity 0.3s;
}
.cf-cat-04-v3-link:hover { opacity: 0.7; }

.cf-cat-04-v3-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 40px;
}

.cf-cat-04-v3-item {
  text-decoration: none;
  display: block;
}

.cf-cat-04-v3-image-wrap {
  width: 100%;
  padding-bottom: 140%;
  border-radius: 200px 200px 0 0;
  overflow: hidden;
  position: relative;
  margin-bottom: 25px;
  background: #f4efeb;
  transition: transform 0.5s ease;
}

.cf-cat-04-v3-item:hover .cf-cat-04-v3-image-wrap {
  transform: translateY(-10px);
}

.cf-cat-04-v3-image-wrap img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.8s ease;
}

.cf-cat-04-v3-item:hover .cf-cat-04-v3-image-wrap img {
  transform: scale(1.05);
}

.cf-cat-04-v3-name {
  color: {{ section.settings.text_color }};
  font-size: 22px;
  margin: 0;
  text-align: center;
}

@media (max-width: 900px) {
  .cf-cat-04-v3-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .cf-cat-04-v3-header { flex-direction: column; align-items: flex-start; gap: 15px; }
}
@media (max-width: 600px) {
  .cf-cat-04-v3-grid { grid-template-columns: repeat(2, 1fr); }
  .cf-cat-04-v3-title { font-size: 32px; }
}
</style>

<div class="cf-cat-04-v3">
  <div class="cf-cat-04-v3-inner">
    <div class="cf-cat-04-v3-header">
      <h2 class="cf-cat-04-v3-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-cat-04-v3-link">{{ section.settings.btn_text }}</a>
    </div>

    <div class="cf-cat-04-v3-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v3-item">
          <div class="cf-cat-04-v3-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;position:absolute;display:flex;align-items:center;justify-content:center;color:#999;">Image</div>
            {% endif %}
          </div>
          <h3 class="cf-cat-04-v3-name">{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Organic Flow Grid",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4A4A4A"},
    {"type":"text","id":"title","label":"Title","default":"The Roots of Wellness"},
    {"type":"text","id":"btn_text","label":"View All Link","default":"View Directory"},
    {"type":"url","id":"btn_link","label":"Link"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Category Name","default":"Digestion"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "03 · Organic Flow Grid",
      "blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]
    }
  ]
}
{% endschema %}
