<style>
.cf-cat-12-v9{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }}}
.cf-cat-12-v9-inner{max-width:1400px;margin:0 auto;display:flex;gap:60px;align-items:center}
.cf-cat-12-v9-img-pane{flex:1;height:700px;position:relative;border-radius:{{ section.settings.border_radius }}px;overflow:hidden}
.cf-cat-12-v9-hero-img{width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;opacity:0;transition:opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1)}
.cf-cat-12-v9-hero-img.active{opacity:1;z-index:2}
.cf-cat-12-v9-hero-img.default{opacity:1;z-index:1}
.cf-cat-12-v9-nav-pane{flex:1;display:flex;flex-direction:column;justify-content:center}
.cf-cat-12-v9-sub{font-family:sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:0.2em;color:{{ section.settings.accent_color }};margin-bottom:20px}
.cf-cat-12-v9-title{font-size:48px;font-weight:300;margin:0 0 40px 0;text-transform:uppercase;letter-spacing:0.05em}
.cf-cat-12-v9-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:15px}
.cf-cat-12-v9-link{display:flex;align-items:center;justify-content:space-between;padding:20px;border:1px solid {{ section.settings.border_color }};border-radius:4px;text-decoration:none;color:{{ section.settings.text_color }};transition:0.3s;background:transparent}
.cf-cat-12-v9-link-title{font-size:24px;font-style:italic}
.cf-cat-12-v9-link-arrow{transform:translateX(-10px);opacity:0;transition:0.3s;font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;font-weight:600;display:flex;align-items:center;gap:10px}
.cf-cat-12-v9-link:hover{background:{{ section.settings.hover_bg }};border-color:transparent}
.cf-cat-12-v9-link:hover .cf-cat-12-v9-link-arrow{transform:translateX(0);opacity:1;color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-cat-12-v9-inner{flex-direction:column-reverse}.cf-cat-12-v9-img-pane{width:100%;height:400px}.cf-cat-12-v9-nav-pane{width:100%}}
</style>

<div class="cf-cat-12-v9">
  <div class="cf-cat-12-v9-inner">
    <div class="cf-cat-12-v9-img-pane">
      <div class="cf-cat-12-v9-hero-img default" style="background:#eee"></div>
      {% for i in (1..5) %}
        <div class="cf-cat-12-v9-hero-img" id="cf-cat-img-12-v9-{{ forloop.index }}" style="background:#{{ forloop.index | times: 111111 }}"></div>
      {% endfor %}
    </div>
    
    <div class="cf-cat-12-v9-nav-pane">
      <span class="cf-cat-12-v9-sub">{{ section.settings.subtitle }}</span>
      <h2 class="cf-cat-12-v9-title">{{ section.settings.title }}</h2>
      
      <div class="cf-cat-12-v9-list">
        {% for i in (1..5) %}
          <a href="#" class="cf-cat-12-v9-link" onmouseenter="document.getElementById('cf-cat-img-12-v9-{{ forloop.index }}').classList.add('active')" onmouseleave="document.getElementById('cf-cat-img-12-v9-{{ forloop.index }}').classList.remove('active')">
            <span class="cf-cat-12-v9-link-title">Category {{ i }}</span>
            <span class="cf-cat-12-v9-link-arrow">
              View
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Category (v9)",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"THE CATEGORIES"},
    {"type":"text","id":"title","label":"Title","default":"Curated Looks"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#A38971"},
    {"type":"color","id":"border_color","label":"List Border","default":"#E4E4E4"},
    {"type":"color","id":"hover_bg","label":"List Hover Background","default":"#FDFBF7"},
    {"type":"range","id":"border_radius","label":"Image Rounding","min":0,"max":20,"step":2,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":10,"default":80}
  ],
  "presets": [{"name":"12 · Women's Category (v9)"}]
}
{% endschema %}
