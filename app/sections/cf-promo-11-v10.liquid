<style>
.cf-pr-11-v10{width:100%;height:{{ section.settings.height }}vh;background:{{ section.settings.bg_color }};display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;font-family:sans-serif}
.cf-pr-11-v10-bg{position:absolute;top:0;left:0;width:100%;height:100%;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;opacity:0.6;filter:grayscale(100%);transition:0.8s}
.cf-pr-11-v10:hover .cf-pr-11-v10-bg{transform:scale(1.05);opacity:0.4}
.cf-pr-11-v10-content{position:relative;z-index:2;text-align:center;padding:20px;max-width:800px}
.cf-pr-11-v10-title{font-size:clamp(60px,10vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;line-height:0.9;margin:0 0 30px 0;letter-spacing:-0.05em}
.cf-pr-11-v10-btn{display:inline-block;padding:20px 40px;background:none;border:3px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-size:16px;font-weight:900;letter-spacing:0.1em;text-transform:uppercase;transition:0.3s;box-shadow:8px 8px 0 {{ section.settings.accent_color }}}
.cf-pr-11-v10-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};box-shadow:0 0 0 {{ section.settings.accent_color }};transform:translate(8px, 8px)}
</style>

<div class="cf-pr-11-v10">
  <div class="cf-pr-11-v10-bg"></div>
  <div class="cf-pr-11-v10-content">
    <h2 class="cf-pr-11-v10-title">{{ section.settings.title }}</h2>
    <a href="{{ section.settings.btn_link }}" class="cf-pr-11-v10-btn">{{ section.settings.btn_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Promo (v10)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Image"},
    {"type":"text","id":"title","label":"Massive Title","default":"ARCHIVES LAUNCH"},
    {"type":"range","id":"title_size","label":"Title Size","min":60,"max":160,"step":5,"default":120},
    {"type":"text","id":"btn_label","label":"Button Label","default":"ENTER NOW"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#F4F4F4"},
    {"type":"color","id":"accent_color","label":"Button Shadow Color","default":"#5A5A5A"},
    {"type":"range","id":"height","label":"Height (vh)","min":50,"max":100,"step":5,"default":90}
  ],
  "presets": [{"name":"11 · Men's Promo (v10)"}]
}
{% endschema %}
