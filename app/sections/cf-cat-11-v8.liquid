<style>
.cf-cat-11-v8{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;overflow:hidden}
.cf-cat-11-v8-inner{display:flex;gap:20px;overflow-x:auto;padding-bottom:20px;scrollbar-width:none}
.cf-cat-11-v8-inner::-webkit-scrollbar{display:none}
.cf-cat-11-v8-card{flex:0 0 350px;display:block;text-decoration:none;color:{{ section.settings.text_color }};transition:0.3s;border:1px solid {{ section.settings.border_color }};background:{{ section.settings.card_bg }}}
.cf-cat-11-v8-card:hover{transform:translateY(-8px);box-shadow:8px 8px 0 {{ section.settings.accent_color }}}
.cf-cat-11-v8-img{width:100%;height:450px;object-fit:cover;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-cat-11-v8-bottom{padding:25px;display:flex;justify-content:space-between;align-items:center}
.cf-cat-11-v8-label{font-size:18px;font-weight:900;text-transform:uppercase;margin:0;letter-spacing:0.02em}
.cf-cat-11-v8-arrow{width:30px;height:30px;border-radius:50%;border:2px solid {{ section.settings.text_color }};display:flex;align-items:center;justify-content:center;transition:0.3s}
.cf-cat-11-v8-card:hover .cf-cat-11-v8-arrow{background:{{ section.settings.text_color }};color:{{ section.settings.card_bg }}}
@media(max-width:768px){.cf-cat-11-v8-card{flex:0 0 280px}.cf-cat-11-v8-img{height:350px}}
</style>

<div class="cf-cat-11-v8">
  <div class="cf-cat-11-v8-inner">
    {% for i in (1..6) %}
       {% capture img_key %}img_{{ i }}{% endcapture %}
       {% capture label_key %}label_{{ i }}{% endcapture %}
       {% capture link_key %}link_{{ i }}{% endcapture %}
       <a href="{{ section.settings[link_key] }}" class="cf-cat-11-v8-card">
         {% if section.settings[img_key] %}
           <img src="{{ section.settings[img_key] | image_url: width: 600 }}" class="cf-cat-11-v8-img">
         {% else %}
           <div style="width:100%;height:450px;background:#e2e2e2" class="cf-cat-11-v8-img"></div>
         {% endif %}
         <div class="cf-cat-11-v8-bottom">
           <h3 class="cf-cat-11-v8-label">{{ section.settings[label_key] }}</h3>
           <div class="cf-cat-11-v8-arrow">
             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
           </div>
         </div>
       </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Category (v8)",
  "settings": [
    {"type":"image_picker","id":"img_1","label":"Image 1"},
    {"type":"text","id":"label_1","label":"Label 1","default":"T-SHIRTS"},
    {"type":"url","id":"link_1","label":"Link 1"},
    {"type":"image_picker","id":"img_2","label":"Image 2"},
    {"type":"text","id":"label_2","label":"Label 2","default":"HOODIES"},
    {"type":"url","id":"link_2","label":"Link 2"},
    {"type":"image_picker","id":"img_3","label":"Image 3"},
    {"type":"text","id":"label_3","label":"Label 3","default":"JACKETS"},
    {"type":"url","id":"link_3","label":"Link 3"},
    {"type":"image_picker","id":"img_4","label":"Image 4"},
    {"type":"text","id":"label_4","label":"Label 4","default":"DENIM"},
    {"type":"url","id":"link_4","label":"Link 4"},
    {"type":"image_picker","id":"img_5","label":"Image 5"},
    {"type":"text","id":"label_5","label":"Label 5","default":"PANTS"},
    {"type":"url","id":"link_5","label":"Link 5"},
    {"type":"image_picker","id":"img_6","label":"Image 6"},
    {"type":"text","id":"label_6","label":"Label 6","default":"ACCESSORIES"},
    {"type":"url","id":"link_6","label":"Link 6"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FAFAFA"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#D1D1D1"},
    {"type":"color","id":"accent_color","label":"Shadow Hover Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"11 · Men's Category (v8)"}]
}
{% endschema %}
