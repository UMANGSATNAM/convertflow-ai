<style>
.cf-pr-04-v8 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: radial-gradient(circle at center, {{ section.settings.bg_gradient_start }} 0%, {{ section.settings.bg_color }} 100%);
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cf-pr-04-v8-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cf-pr-04-v8-tag {
  color: {{ section.settings.text_color }};
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.3em;
  margin-bottom: 25px;
  opacity: 0.7;
}

.cf-pr-04-v8-title {
  color: {{ section.settings.text_color }};
  font-size: 54px;
  font-weight: 300;
  line-height: 1.2;
  margin: 0 0 25px 0;
  max-width: 800px;
  letter-spacing: -0.02em;
}

.cf-pr-04-v8-desc {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  line-height: 1.6;
  margin: 0 0 40px 0;
  max-width: 500px;
  opacity: 0.8;
}

.cf-pr-04-v8-btn {
  display: inline-block;
  background-color: transparent;
  color: {{ section.settings.text_color }};
  border: 1px solid {{ section.settings.text_color }};
  padding: 14px 40px;
  border-radius: 50px;
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: all 0.3s;
}

.cf-pr-04-v8-btn:hover {
  background-color: {{ section.settings.text_color }};
  color: {{ section.settings.bg_color }};
}

.cf-pr-04-v8-image {
  margin-top: 60px;
  width: 100%;
  max-width: 800px;
  height: 400px;
  border-radius: 300px 300px 0 0;
  overflow: hidden;
  box-shadow: 0 25px 50px -12px rgba(0,0,0,0.1);
  position: relative;
}

.cf-pr-04-v8-image img {
  width: 100%; height: 100%; object-fit: cover;
}

@media (max-width: 768px) {
  .cf-pr-04-v8-title { font-size: 36px; }
  .cf-pr-04-v8-image { height: 300px; border-radius: 200px 200px 0 0; }
}
</style>

<div class="cf-pr-04-v8">
  <div class="cf-pr-04-v8-inner">
    <div class="cf-pr-04-v8-tag">{{ section.settings.tag }}</div>
    <h2 class="cf-pr-04-v8-title">{{ section.settings.title }}</h2>
    <p class="cf-pr-04-v8-desc">{{ section.settings.desc }}</p>
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="cf-pr-04-v8-btn">{{ section.settings.btn_text }}</a>
    {% endif %}
    
    <div class="cf-pr-04-v8-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title }}">
      {% else %}
        <div style="width:100%;height:100%;background:#e5e5e5;display:flex;align-items:center;justify-content:center;color:#999;">Image</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "08 · Holistic Aura Poster",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color Outer","default":"#F9F9F9"},
    {"type":"color","id":"bg_gradient_start","label":"Background Glow Center","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#5B5B5B"},
    {"type":"text","id":"tag","label":"Tag","default":"ELEVATE YOUR WELLBEING"},
    {"type":"text","id":"title","label":"Title","default":"A gentle approach to holistic health and wellness."},
    {"type":"textarea","id":"desc","label":"Description","default":"Discover our curated selection of natural supplements, designed to harmonize your body and mind."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Holistic"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":100},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "presets": [{"name":"08 · Holistic Aura Poster"}]
}
{% endschema %}
