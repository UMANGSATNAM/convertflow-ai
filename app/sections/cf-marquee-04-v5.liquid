<style>
.cf-mq-04-v5 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: 'Playfair Display', serif;
}

.cf-mq-04-v5-track {
  display: inline-flex;
  animation: cf-mq-04-v5-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v5-item {
  display: inline-flex;
  align-items: center;
  padding: 0 60px;
  font-size: {{ section.settings.font_size }}px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 300;
}

.cf-mq-04-v5-icon {
  margin: 0 60px;
  color: {{ section.settings.accent_color }};
  font-size: 0.5em; /* diamond character */
}

@keyframes cf-mq-04-v5-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v5">
  <div class="cf-mq-04-v5-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v5-item">
          <span>{{ block.settings.text }}</span>
          <span class="cf-mq-04-v5-icon">◆</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "05 · Spa Serenity",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#ECE7E1"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#5A5043"},
    {"type":"color","id":"accent_color","label":"Diamond Color","default":"#C8BCA7"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":25},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":24,"step":1,"default":14},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":100,"step":5,"default":50}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"FIND YOUR INNER PEACE"}
      ]
    }
  ],
  "presets": [
    {
      "name": "05 · Spa Serenity",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
