<style>
.cf-feat-12-v7{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }}}
.cf-feat-12-v7-inner{max-width:1400px;margin:0 auto}
.cf-feat-12-v7-top{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px}
.cf-feat-12-v7-title-wrap{max-width:600px}
.cf-feat-12-v7-sub{font-size:14px;font-style:italic;color:{{ section.settings.accent_color }};margin-bottom:15px;display:block}
.cf-feat-12-v7-title{font-size:clamp(40px, 5vw, 64px);line-height:1.1;margin:0;font-weight:400}
.cf-feat-12-v7-dots{display:flex;gap:10px}
.cf-feat-12-v7-dot{width:10px;height:10px;border-radius:50%;background:{{ section.settings.text_color }};opacity:0.2;transition:0.3s}
.cf-feat-12-v7-dot.active{opacity:1;background:{{ section.settings.accent_color }}}
.cf-feat-12-v7-grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:2px;background:{{ section.settings.border_color }};border:1px solid {{ section.settings.border_color }}}
.cf-feat-12-v7-card{background:{{ section.settings.bg_color }};padding:30px;text-decoration:none;display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;group;transition:0.3s}
.cf-feat-12-v7-card:hover{background:{{ section.settings.hover_bg }}}
.cf-feat-12-v7-img-wrap{width:100%;aspect-ratio:3/4;overflow:hidden;margin-bottom:25px}
.cf-feat-12-v7-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-feat-12-v7-card:hover .cf-feat-12-v7-img{transform:scale(1.05)}
.cf-feat-12-v7-title-product{font-size:18px;color:{{ section.settings.text_color }};margin:0 0 10px 0;font-weight:400;font-style:italic}
.cf-feat-12-v7-price{font-family:sans-serif;font-size:13px;color:{{ section.settings.text_color }};margin:0}
.cf-feat-12-v7-quick{position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);background:rgba(255,255,255,0.9);color:#111;padding:12px 25px;font-family:sans-serif;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;border-radius:30px;opacity:0;transition:0.3s;pointer-events:none}
.cf-feat-12-v7-card:hover .cf-feat-12-v7-quick{opacity:1;transform:translate(-50%, -60%)}
@media(max-width:1024px){.cf-feat-12-v7-grid{grid-template-columns:repeat(2, 1fr)}}
@media(max-width:600px){.cf-feat-12-v7-top{flex-direction:column;align-items:flex-start;gap:20px}.cf-feat-12-v7-grid{grid-template-columns:repeat(2, 1fr)}.cf-feat-12-v7-card{padding:15px}}
</style>

<div class="cf-feat-12-v7">
  <div class="cf-feat-12-v7-inner">
    <div class="cf-feat-12-v7-top">
      <div class="cf-feat-12-v7-title-wrap">
        <span class="cf-feat-12-v7-sub">{{ section.settings.subtitle }}</span>
        <h2 class="cf-feat-12-v7-title">{{ section.settings.title }}</h2>
      </div>
      <div class="cf-feat-12-v7-dots">
        <div class="cf-feat-12-v7-dot active"></div>
        <div class="cf-feat-12-v7-dot"></div>
        <div class="cf-feat-12-v7-dot"></div>
      </div>
    </div>
    
    <div class="cf-feat-12-v7-grid">
      {% for i in (1..4) %}
        <a href="#" class="cf-feat-12-v7-card">
          <div class="cf-feat-12-v7-img-wrap">
            <div class="cf-feat-12-v7-img" style="background:#e4e4e4"></div>
          </div>
          <h3 class="cf-feat-12-v7-title-product">Ribbed Knit Polo</h3>
          <p class="cf-feat-12-v7-price">$110.00</p>
          <div class="cf-feat-12-v7-quick">QUICK VIEW</div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Featured (v7",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trending Now"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Header Title",
      "default": "The Weekend Edit"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "hover_bg",
      "label": "Card Hover Background",
      "default": "#F4ECE4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Grid Separator Color",
      "default": "#EAEAEE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Subtitle/Dots",
      "default": "#A38971"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 40,
      "max": 160,
      "step": 10,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "12 · Women's Featured (v7"
    }
  ]
}
{% endschema %}
