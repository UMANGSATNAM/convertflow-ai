<style>
.cf-cro-sp{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-sp-inner{max-width:1200px;margin:0 auto}
.cf-cro-sp-head{text-align:center;margin-bottom:40px}
.cf-cro-sp h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-sp-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-cro-sp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.cf-cro-sp-card{background:#fff;border:1px solid {{ section.settings.text_color }}10;border-radius:16px;padding:28px;position:relative;transition:all 0.3s}
.cf-cro-sp-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,0.08)}
.cf-cro-sp-stars{color:#F59E0B;font-size:16px;margin-bottom:12px;letter-spacing:2px}
.cf-cro-sp-quote{font-size:15px;line-height:1.7;color:{{ section.settings.text_color }};margin-bottom:20px;font-style:italic;opacity:0.85}
.cf-cro-sp-author{display:flex;align-items:center;gap:12px;border-top:1px solid {{ section.settings.text_color }}10;padding-top:16px}
.cf-cro-sp-avatar{width:44px;height:44px;border-radius:50%;background:{{ section.settings.accent_color }}20;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:{{ section.settings.accent_color }};overflow:hidden}
.cf-cro-sp-avatar img{width:100%;height:100%;object-fit:cover}
.cf-cro-sp-name{font-size:14px;font-weight:700;color:{{ section.settings.text_color }}}
.cf-cro-sp-verified{font-size:12px;color:{{ section.settings.accent_color }};display:flex;align-items:center;gap:4px}
.cf-cro-sp-product{display:inline-block;margin-top:12px;padding:6px 14px;background:{{ section.settings.accent_color }}10;color:{{ section.settings.accent_color }};border-radius:8px;font-size:12px;font-weight:600;text-decoration:none;transition:0.2s}
.cf-cro-sp-product:hover{background:{{ section.settings.accent_color }};color:#fff}
.cf-cro-sp-summary{display:flex;justify-content:center;gap:40px;margin-top:40px;padding:32px;background:{{ section.settings.text_color }}05;border-radius:16px}
.cf-cro-sp-summary-item{text-align:center}
.cf-cro-sp-summary-item b{font-size:32px;color:{{ section.settings.text_color }};display:block}
.cf-cro-sp-summary-item span{font-size:13px;color:{{ section.settings.text_color }};opacity:0.5}
@media(max-width:768px){.cf-cro-sp-grid{grid-template-columns:1fr}.cf-cro-sp-summary{flex-direction:column;gap:20px}}
</style>

<div class="cf-cro-sp">
  <div class="cf-cro-sp-inner">
    <div class="cf-cro-sp-head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="cf-cro-sp-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="cf-cro-sp-grid">
      {%- for i in (1..3) -%}
        {%- assign name_key = 'review_name_' | append: i -%}
        {%- assign text_key = 'review_text_' | append: i -%}
        {%- assign product_key = 'review_product_' | append: i -%}
        <div class="cf-cro-sp-card">
          <div class="cf-cro-sp-stars">★★★★★</div>
          <div class="cf-cro-sp-quote">"{{ section.settings[text_key] }}"</div>
          <div class="cf-cro-sp-author">
            <div class="cf-cro-sp-avatar">{{ section.settings[name_key] | slice: 0 }}</div>
            <div>
              <div class="cf-cro-sp-name">{{ section.settings[name_key] }}</div>
              <div class="cf-cro-sp-verified">✓ Verified Buyer</div>
            </div>
          </div>
          {% if section.settings[product_key] != blank %}
            <a href="#" class="cf-cro-sp-product">🛍 {{ section.settings[product_key] }}</a>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
    <div class="cf-cro-sp-summary">
      <div class="cf-cro-sp-summary-item"><b>{{ section.settings.total_reviews }}</b><span>Total Reviews</span></div>
      <div class="cf-cro-sp-summary-item"><b>{{ section.settings.avg_rating }}</b><span>Average Rating</span></div>
      <div class="cf-cro-sp-summary-item"><b>{{ section.settings.recommend_pct }}</b><span>Would Recommend</span></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Social Proof",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Don't Just Take Our Word For It"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Real reviews from real customers"},
    {"type":"text","id":"review_name_1","label":"Reviewer 1 Name","default":"Sarah M."},
    {"type":"textarea","id":"review_text_1","label":"Review 1 Text","default":"I was skeptical at first, but this product literally changed my skin in 2 weeks. My friends keep asking what I'm using!"},
    {"type":"text","id":"review_product_1","label":"Review 1 Product","default":"Glow Serum"},
    {"type":"text","id":"review_name_2","label":"Reviewer 2 Name","default":"James K."},
    {"type":"textarea","id":"review_text_2","label":"Review 2 Text","default":"Best purchase I've made this year. The quality is insane for the price. Already ordered my 3rd bottle."},
    {"type":"text","id":"review_product_2","label":"Review 2 Product","default":"Daily Moisturizer"},
    {"type":"text","id":"review_name_3","label":"Reviewer 3 Name","default":"Priya R."},
    {"type":"textarea","id":"review_text_3","label":"Review 3 Text","default":"Fast shipping, beautiful packaging, and the product works better than brands 3x the price. 10/10 would recommend."},
    {"type":"text","id":"review_product_3","label":"Review 3 Product","default":"Starter Kit"},
    {"type":"text","id":"total_reviews","label":"Total Reviews","default":"12,847+"},
    {"type":"text","id":"avg_rating","label":"Average Rating","default":"4.9/5"},
    {"type":"text","id":"recommend_pct","label":"Would Recommend %","default":"98%"},
    {"type":"color","id":"bg_color","label":"Background","default":"#f8f9fa"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#6C3CE1"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Social Proof"}]
}
{% endschema %}
