<style>
.cf-head-03{width:100%;background:{{ section.settings.bg_color }};position:sticky;top:0;z-index:100;box-shadow:0 1px 0 rgba(255,255,255,0.1)}
.cf-head-03-inner{display:flex;align-items:center;justify-content:space-between;padding:{{ section.settings.padding_y }}px 20px;gap:20px;max-width:1400px;margin:0 auto}
.cf-head-03-logo{font-size:clamp(20px,2vw,{{ section.settings.logo_size }}px);font-weight:700;color:{{ section.settings.logo_color }};text-decoration:none;letter-spacing:-0.02em}
.cf-head-03-search{flex:1;max-width:600px;position:relative;display:none}
.cf-head-03-search input{width:100%;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.1);color:{{ section.settings.logo_color }};padding:12px 16px 12px 48px;border-radius:8px;font-size:14px;outline:none;transition:0.2s}
.cf-head-03-search input:focus{background:rgba(255,255,255,0.15);border-color:{{ section.settings.accent_color }}}
.cf-head-03-search svg{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:rgba(255,255,255,0.5)}
.cf-head-03-icons{display:flex;align-items:center;gap:20px;color:{{ section.settings.logo_color }}}
.cf-head-03-icons a{color:inherit;text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:4px;font-size:11px;opacity:0.8;transition:0.2s}
.cf-head-03-icons a:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-head-03-m-search{display:block;width:100%;padding:10px 20px;background:rgba(0,0,0,0.2)}
.cf-head-03-m-search input{width:100%;background:#fff;border:none;padding:10px 16px;border-radius:6px;font-size:14px}
@media(min-width:768px){.cf-head-03-search{display:block}.cf-head-03-m-search{display:none}.cf-head-03-inner{padding:{{ section.settings.padding_y }}px 40px}}
</style>

<header class="cf-head-03">
  <div class="cf-head-03-inner">
    <a href="/" class="cf-head-03-logo">{{ section.settings.logo_text }}</a>
    <div class="cf-head-03-search">
      <form action="/search" method="get">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" name="q" placeholder="{{ section.settings.search_placeholder }}">
      </form>
    </div>
    <div class="cf-head-03-icons">
      <a href="/account"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Account</span></a>
      <a href="/cart"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><span>Cart</span></a>
    </div>
  </div>
  <div class="cf-head-03-m-search">
    <form action="/search" method="get">
      <input type="text" name="q" placeholder="{{ section.settings.search_placeholder }}">
    </form>
  </div>
</header>

{% schema %}
{
  "name": "03 · Tech Header",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"TECHSTORE"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":20,"max":48,"step":2,"default":28},
    {"type":"text","id":"search_placeholder","label":"Search Placeholder","default":"Search for laptops, phones, accessories..."},
    {"type":"color","id":"bg_color","label":"Background","default":"#0f172a"},
    {"type":"color","id":"logo_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#3b82f6"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20}
  ],
  "presets": [{"name":"03 · Tech Header"}]
}
{% endschema %}
