<style>
.cf-mq-05-v9 { overflow: hidden; background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 0; }
.cf-mq-05-v9-track { display: flex; animation: mq05v9s {{ section.settings.speed }}s linear infinite; }
.cf-mq-05-v9-track:hover { animation-play-state: paused; }
@keyframes mq05v9s { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.cf-mq-05-v9-item {
  display: inline-flex; align-items: center; gap: 20px;
  padding: 0 50px;
  font-family: 'Baskerville','Georgia',serif;
  font-size: {{ section.settings.font_size }}px;
  font-style: italic;
  font-weight: normal;
  color: {{ section.settings.text_color }};
  white-space: nowrap;
  letter-spacing: 0.05em;
}
.cf-mq-05-v9-sep { width: 3px; height: 3px; background: {{ section.settings.accent_color }}; border-radius: 50%; display: inline-block; }
</style>

<div class="cf-mq-05-v9">
  <div class="cf-mq-05-v9-track">
    {% for i in (1..4) %}{% for block in section.blocks %}
      <span class="cf-mq-05-v9-item">
        {{ block.settings.text }}
        <span class="cf-mq-05-v9-sep"></span>
      </span>
    {% endfor %}{% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "09 · Fragrance Marquee",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#faf8f5"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#2c2416"},
    {"type":"color","id":"accent_color","label":"Separator Color","default":"#b8973a"},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":28,"step":1,"default":18},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":16},
    {"type":"range","id":"speed","label":"Speed (seconds)","min":10,"max":80,"step":5,"default":45}
  ],
  "blocks": [
    {"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Notes of Jasmine & Oud"}]}
  ],
  "presets": [{"name": "09 · Fragrance Marquee","blocks": [{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
