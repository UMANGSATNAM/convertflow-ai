<style>
.cf-mq-11-v10{width:100%;overflow:hidden;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;background-attachment:fixed;padding:{{ section.settings.padding_y }}px 0;display:flex;position:relative}
.cf-mq-11-v10::before{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});z-index:1}
.cf-mq-11-v10-track{display:flex;white-space:nowrap;animation:cf-mq-11-v10-scroll {{ section.settings.speed }}s linear infinite;z-index:2;position:relative}
.cf-mq-11-v10-item{display:inline-flex;align-items:center;padding:0 60px;font-family:sans-serif;font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;letter-spacing:-0.05em;text-shadow:0 4px 12px rgba(0,0,0,0.5)}
@keyframes cf-mq-11-v10-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<div class="cf-mq-11-v10">
  <div class="cf-mq-11-v10-track">
    {% for i in (1..6) %}
      <div class="cf-mq-11-v10-item">
        {{ section.settings.text }}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Marquee (v10)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Parallax Background Image"},
    {"type":"range","id":"overlay_opacity","label":"Dark Overlay Opacity","min":0,"max":100,"step":5,"default":60},
    {"type":"text","id":"text","label":"Text","default":"THE CORE COLLECTION"},
    {"type":"range","id":"text_size","label":"Text Size","min":40,"max":160,"step":4,"default":80},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":150,"step":10,"default":80},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":100,"step":5,"default":50}
  ],
  "presets": [{"name":"11 · Men's Marquee (v10)"}]
}
{% endschema %}
