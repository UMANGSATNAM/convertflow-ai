<style>
.cf-feat-01-v10{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;display:flex;flex-direction:column}
.cf-feat-01-v10-band-1{padding:{{ section.settings.padding_y }}px 0;width:100%;overflow:hidden;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-feat-01-v10-band-2{padding:{{ section.settings.padding_y }}px 0;width:100%;overflow:hidden;background:{{ section.settings.bg_2 }};color:{{ section.settings.text_2 }}}
.cf-feat-01-v10-track-1{display:flex;white-space:nowrap;animation:cf-feat-01-v10-scroll-1 40s linear infinite}
.cf-feat-01-v10-track-2{display:flex;white-space:nowrap;animation:cf-feat-01-v10-scroll-2 40s linear infinite}
.cf-feat-01-v10-img-item{display:inline-flex;padding:0 20px}
.cf-feat-01-v10-img-box{width:300px;aspect-ratio:3/4;background:#ccc;overflow:hidden}
.cf-feat-01-v10-img-box img, .cf-feat-01-v10-img-box div{width:100%;height:100%;object-fit:cover;transition:1.2s}
.cf-feat-01-v10-img-item:hover .cf-feat-01-v10-img-box div{transform:scale(1.05)}
.cf-feat-01-v10-text-item{display:inline-flex;align-items:center;padding:0 80px;font-size:clamp(40px, 6vw, 84px);font-weight:400;letter-spacing:0.02em;text-transform:uppercase}
.cf-feat-01-v10-text-item span{font-style:italic;margin-left:20px}
.cf-feat-01-v10-product-info{margin-top:20px;text-align:center}
.cf-feat-01-v10-product-name{font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.1em;margin:0 0 5px 0}
.cf-feat-01-v10-product-price{font-size:14px;font-style:italic}
@keyframes cf-feat-01-v10-scroll-1{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
@keyframes cf-feat-01-v10-scroll-2{0%{transform:translateX(-50%)} 100%{transform:translateX(0)}}
</style>

<div class="cf-feat-01-v10">
  <div class="cf-feat-01-v10-band-1">
    <div class="cf-feat-01-v10-track-1">
      {% for j in (1..2) %}
        {% for i in (1..4) %}
          <div class="cf-feat-01-v10-text-item">
            THE NEW <span>CLASSICS</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  
  <div class="cf-feat-01-v10-band-2">
    <div class="cf-feat-01-v10-track-2">
      {% for j in (1..2) %}
        {% for i in (1..6) %}
          <a href="#" class="cf-feat-01-v10-img-item" style="text-decoration:none;color:inherit;display:block;">
            <div class="cf-feat-01-v10-img-box">
              <div style="background:#444;"></div>
            </div>
            <div class="cf-feat-01-v10-product-info">
              <h4 class="cf-feat-01-v10-product-name">Silhouette 0{{ i }}</h4>
              <div class="cf-feat-01-v10-product-price">$850</div>
            </div>
          </a>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Featured (v10)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Top Canvas","default":"#111111"},
    {"type":"color","id":"text_color","label":"Top Text","default":"#FFFFFF"},
    {"type":"color","id":"bg_2","label":"Bottom Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_2","label":"Bottom Text","default":"#111111"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#333333"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":150,"step":10,"default":80}
  ],
  "presets": [{"name":"01 · Luxury Featured (v10)"}]
}
{% endschema %}
