<style>
.cf-sn-11-v3{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-sn-11-v3-inner{max-width:1000px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;border-top:2px dashed {{ section.settings.border_color }};border-bottom:2px dashed {{ section.settings.border_color }};padding:25px 0}
.cf-sn-11-v3-title{font-size:24px;font-weight:900;text-transform:uppercase;margin:0;letter-spacing:-0.02em}
.cf-sn-11-v3-code-box{display:flex;align-items:stretch;border:1px solid {{ section.settings.text_color }}}
.cf-sn-11-v3-code{padding:10px 20px;font-family:monospace;font-size:18px;font-weight:700;letter-spacing:0.1em;border-right:1px solid {{ section.settings.text_color }};display:flex;align-items:center}
.cf-sn-11-v3-btn{padding:10px 20px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};text-decoration:none;font-size:12px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;display:flex;align-items:center;transition:0.3s;border:none;cursor:pointer}
.cf-sn-11-v3-btn:hover{background:transparent;color:{{ section.settings.text_color }}}
@media(max-width:768px){.cf-sn-11-v3-inner{flex-direction:column;gap:15px;text-align:center}}
</style>

<div class="cf-sn-11-v3">
  <div class="cf-sn-11-v3-inner">
    <h3 class="cf-sn-11-v3-title">{{ section.settings.title }}</h3>
    <div class="cf-sn-11-v3-code-box">
      <div class="cf-sn-11-v3-code">{{ section.settings.code }}</div>
      <a href="{{ section.settings.btn_link }}" class="cf-sn-11-v3-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Snack (v3)",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"FREE EXPEDITED SHIPPING OVER $150"},
    {"type":"text","id":"code","label":"Code","default":"FAST150"},
    {"type":"text","id":"btn_label","label":"Button Label","default":"REDEEM"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Text & Accent Color","default":"#1A1A1A"},
    {"type":"color","id":"border_color","label":"Dashed Border Color","default":"#CCCCCC"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":5,"default":30}
  ],
  "presets": [{"name":"11 · Men's Snack (v3)"}]
}
{% endschema %}
