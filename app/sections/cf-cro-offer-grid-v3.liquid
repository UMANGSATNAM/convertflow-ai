<style>
.cf-cro-og3{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-og3-inner{max-width:800px;margin:0 auto;text-align:center}
.cf-cro-og3 h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-og3-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6;margin-bottom:32px}
.cf-cro-og3-stack{display:flex;flex-direction:column;gap:16px;margin-bottom:32px}
.cf-cro-og3-row{display:flex;align-items:center;gap:16px;background:#fff;border:2px solid {{ section.settings.text_color }}08;border-radius:16px;padding:20px 24px;cursor:pointer;transition:0.3s}
.cf-cro-og3-row:hover,.cf-cro-og3-row.active{border-color:{{ section.settings.accent_color }};box-shadow:0 4px 20px {{ section.settings.accent_color }}10}
.cf-cro-og3-radio{width:24px;height:24px;border-radius:50%;border:2px solid {{ section.settings.text_color }}20;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cf-cro-og3-row.active .cf-cro-og3-radio{border-color:{{ section.settings.accent_color }};background:{{ section.settings.accent_color }}}
.cf-cro-og3-row.active .cf-cro-og3-radio::after{content:'✓';color:#fff;font-size:14px;font-weight:700}
.cf-cro-og3-info{flex:1;text-align:left}
.cf-cro-og3-info b{font-size:16px;color:{{ section.settings.text_color }};display:block;margin-bottom:2px}
.cf-cro-og3-info small{font-size:13px;color:{{ section.settings.text_color }};opacity:0.5}
.cf-cro-og3-tag{padding:4px 12px;border-radius:100px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;flex-shrink:0}
.cf-cro-og3-row:nth-child(2) .cf-cro-og3-tag{background:{{ section.settings.accent_color }};color:#fff}
.cf-cro-og3-row:nth-child(1) .cf-cro-og3-tag,.cf-cro-og3-row:nth-child(3) .cf-cro-og3-tag{background:{{ section.settings.text_color }}08;color:{{ section.settings.text_color }}}
.cf-cro-og3-price{text-align:right;flex-shrink:0}
.cf-cro-og3-price b{font-size:20px;color:{{ section.settings.text_color }};display:block}
.cf-cro-og3-price s{font-size:13px;color:{{ section.settings.text_color }};opacity:0.35}
.cf-cro-og3-btn{display:block;width:100%;padding:16px;background:{{ section.settings.accent_color }};color:#fff;border:none;border-radius:12px;font-size:17px;font-weight:700;cursor:pointer;text-decoration:none;text-align:center;transition:0.2s;box-shadow:0 4px 14px {{ section.settings.accent_color }}40}
.cf-cro-og3-btn:hover{transform:translateY(-2px)}
</style>

<div class="cf-cro-og3">
  <div class="cf-cro-og3-inner">
    <h2>{{ section.settings.heading }}</h2>
    <p class="cf-cro-og3-sub">{{ section.settings.subheading }}</p>
    <div class="cf-cro-og3-stack">
      <div class="cf-cro-og3-row" onclick="this.parentElement.querySelectorAll('.cf-cro-og3-row').forEach(r=>r.classList.remove('active'));this.classList.add('active')">
        <div class="cf-cro-og3-radio"></div>
        <div class="cf-cro-og3-info"><b>{{ section.settings.opt1_name }}</b><small>{{ section.settings.opt1_desc }}</small></div>
        <div class="cf-cro-og3-tag">{{ section.settings.opt1_tag }}</div>
        <div class="cf-cro-og3-price"><b>{{ section.settings.opt1_price }}</b><s>{{ section.settings.opt1_orig }}</s></div>
      </div>
      <div class="cf-cro-og3-row active" onclick="this.parentElement.querySelectorAll('.cf-cro-og3-row').forEach(r=>r.classList.remove('active'));this.classList.add('active')">
        <div class="cf-cro-og3-radio"></div>
        <div class="cf-cro-og3-info"><b>{{ section.settings.opt2_name }}</b><small>{{ section.settings.opt2_desc }}</small></div>
        <div class="cf-cro-og3-tag">⭐ BEST DEAL</div>
        <div class="cf-cro-og3-price"><b>{{ section.settings.opt2_price }}</b><s>{{ section.settings.opt2_orig }}</s></div>
      </div>
      <div class="cf-cro-og3-row" onclick="this.parentElement.querySelectorAll('.cf-cro-og3-row').forEach(r=>r.classList.remove('active'));this.classList.add('active')">
        <div class="cf-cro-og3-radio"></div>
        <div class="cf-cro-og3-info"><b>{{ section.settings.opt3_name }}</b><small>{{ section.settings.opt3_desc }}</small></div>
        <div class="cf-cro-og3-tag">{{ section.settings.opt3_tag }}</div>
        <div class="cf-cro-og3-price"><b>{{ section.settings.opt3_price }}</b><s>{{ section.settings.opt3_orig }}</s></div>
      </div>
    </div>
    <a href="{{ section.settings.cta_link }}" class="cf-cro-og3-btn">{{ section.settings.cta_text }}</a>
  </div>
</div>

{% schema %}
