<style>
.cf-cat-04-v10 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-cat-04-v10-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v10-header {
  margin-bottom: 40px;
  border-bottom: 2px solid {{ section.settings.accent_color }};
  padding-bottom: 15px;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.cf-cat-04-v10-title {
  color: {{ section.settings.text_color }};
  font-size: 32px;
  font-weight: 800;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cf-cat-04-v10-link {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-weight: 700;
  font-size: 14px;
  text-transform: uppercase;
}

.cf-cat-04-v10-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 30px;
}

.cf-cat-04-v10-item {
  display: block;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  background: #fff;
  border-radius: 4px;
}

.cf-cat-04-v10-image-wrap {
  width: 100%;
  aspect-ratio: 4/3;
  position: relative;
  overflow: hidden;
  background: #f1f5f9;
}

.cf-cat-04-v10-item img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.4s;
}

.cf-cat-04-v10-item:hover img {
  transform: scale(1.05);
}

.cf-cat-04-v10-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: {{ section.settings.accent_color | color_modify: 'alpha', 0.8 }};
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.cf-cat-04-v10-item:hover .cf-cat-04-v10-overlay {
  opacity: 1;
}

.cf-cat-04-v10-icon {
  color: #fff;
}

.cf-cat-04-v10-icon svg { width: 40px; height: 40px; stroke-width: 2; }

.cf-cat-04-v10-name {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 700;
  text-transform: uppercase;
  text-align: center;
  padding: 20px 10px;
  margin: 0;
  background: #fff;
  border: 1px solid {{ section.settings.border_color }};
  border-top: none;
  border-radius: 0 0 4px 4px;
}

@media (max-width: 900px) {
  .cf-cat-04-v10-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}
@media (max-width: 600px) {
  .cf-cat-04-v10-grid { grid-template-columns: 1fr; }
  .cf-cat-04-v10-header { flex-direction: column; align-items: flex-start; gap: 10px; }
}
</style>

<div class="cf-cat-04-v10">
  <div class="cf-cat-04-v10-inner">
    <div class="cf-cat-04-v10-header">
      <h2 class="cf-cat-04-v10-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-cat-04-v10-link">{{ section.settings.btn_text }}</a>
    </div>

    <div class="cf-cat-04-v10-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v10-item">
          <div class="cf-cat-04-v10-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#94a3b8;">Image</div>
            {% endif %}
            <div class="cf-cat-04-v10-overlay">
              <div class="cf-cat-04-v10-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </div>
            </div>
          </div>
          <h3 class="cf-cat-04-v10-name">{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · Med-Tech Categories",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#1d4ed8"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},
    {"type":"text","id":"title","label":"Title","default":"EQUIPMENT CATEGORIES"},
    {"type":"text","id":"btn_text","label":"Button Name","default":"View Directory"},
    {"type":"url","id":"btn_link","label":"Link"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":3},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Category Name","default":"Diagnostics"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "10 · Med-Tech Grid",
      "blocks": [{"type":"category"},{"type":"category"},{"type":"category"}]
    }
  ]
}
{% endschema %}
