<style>
@keyframes cf-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.cf-ann-01 {
  width: 100%;
  overflow: hidden;
  padding: {{ section.settings.padding_y }}px 0;
  background: {{ section.settings.bg_gradient | default: 'linear-gradient(90deg, #7928ca 0%, #ff0080 100%)' }};
}
.cf-ann-01-track {
  display: flex;
  width: max-content;
  animation: cf-marquee {{ section.settings.speed }}s linear infinite;
}
.cf-ann-01-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 40px;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  white-space: nowrap;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  letter-spacing: 0.02em;
}
.cf-ann-01-sep {
  color: {{ section.settings.text_color }};
  opacity: 0.5;
  font-size: 18px;
}
</style>

<div class="cf-ann-01">
  <div class="cf-ann-01-track">
    {%- assign texts = section.settings.texts | split: '|' -%}
    {%- for i in (1..4) -%}
      {%- for text in texts -%}
        <span class="cf-ann-01-item">
          {{ section.settings.emoji }}&nbsp;{{ text }}
          <span class="cf-ann-01-sep">✦</span>
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "01 · Gradient Marquee",
  "settings": [
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(90deg, #7928ca 0%, #ff0080 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "texts",
      "label": "Announcements (separate by |)",
      "default": "Free shipping on orders over ₹999 | Use code SALE20 for 20% off | New arrivals every Friday"
    },
    {
      "type": "text",
      "id": "emoji",
      "label": "Emoji / Icon",
      "default": "🎉"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding (px)",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10
    }
  ],
  "presets": [{ "name": "01 · Gradient Marquee" }]
}
{% endschema %}
