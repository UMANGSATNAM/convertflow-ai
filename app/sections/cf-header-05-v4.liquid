<style>
.cf-header-05-v4 {
  background-color: {{ section.settings.bg_color }};
  font-family: 'Georgia', 'Times New Roman', serif;
}
.cf-header-05-v4-top {
  background: {{ section.settings.bg_color }};
  text-align: center;
  padding: 12px 20px;
  font-size: 12px;
  color: {{ section.settings.text_color }};
  opacity: 0.8;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  border-bottom: 1px solid {{ section.settings.border_color }};
}
.cf-header-05-v4-logo-bar {
  text-align: center;
  padding: 30px 20px 15px;
  border-bottom: 1px solid {{ section.settings.border_color }};
}
.cf-header-05-v4-logo {
  font-family: 'Didot', 'Playfair Display', 'Georgia', serif;
  font-size: 40px;
  font-weight: normal;
  letter-spacing: 0.3em;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  text-transform: uppercase;
}
.cf-header-05-v4-nav-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 50px;
  padding: 15px 40px;
  position: relative;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
.cf-header-05-v4-nav {
  display: flex;
  gap: 40px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v4-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  transition: color 0.2s;
}
.cf-header-05-v4-nav a:hover { color: {{ section.settings.accent_color }}; }
.cf-header-05-v4-actions {
  position: absolute;
  right: 40px;
  display: flex;
  gap: 20px;
}
.cf-header-05-v4-icon { color: {{ section.settings.text_color }}; cursor: pointer; opacity: 0.8; }
.cf-header-05-v4-icon svg { width: 18px; height: 18px; stroke-width: 1.5; }
@media (max-width: 900px) {
  .cf-header-05-v4-nav { display: none; }
  .cf-header-05-v4-actions { position: static; }
  .cf-header-05-v4-nav-bar { justify-content: space-between; }
  .cf-header-05-v4-logo { font-size: 28px; }
}
</style>

<div class="cf-header-05-v4">
  {% if section.settings.top_text != blank %}
    <div class="cf-header-05-v4-top">{{ section.settings.top_text }}</div>
  {% endif %}
  <div class="cf-header-05-v4-logo-bar">
    <a href="/" class="cf-header-05-v4-logo">{{ section.settings.logo_text }}</a>
  </div>
  <div class="cf-header-05-v4-nav-bar">
    <nav>
      <ul class="cf-header-05-v4-nav">
        {% for block in section.blocks %}
          <li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="cf-header-05-v4-actions">
      <div class="cf-header-05-v4-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v4-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Luxury Cosmetics",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#1a1a1a"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#e8d5b7"},
    {"type":"color","id":"accent_color","label":"Accent Color (Gold)","default":"#d4af37"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#333333"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"LUMIÈRE"},
    {"type":"text","id":"top_text","label":"Announcement Text","default":"Complimentary Shipping on Orders Over $150"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1400}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Collections"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "04 · Luxury Cosmetics Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
