<style>
.cf-trust-01-v6{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif}
.cf-trust-01-v6-inner{max-width:1600px;margin:0 auto;display:flex;align-items:center;gap:80px}
.cf-trust-01-v6-img-col{flex:1;aspect-ratio:4/5;background:#ececec;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,0.05)}
.cf-trust-01-v6-img{width:100%;height:100%;object-fit:cover}
.cf-trust-01-v6-content-col{flex:1;padding-right:40px}
.cf-trust-01-v6-title{font-size:clamp(40px, 6vw, 72px);font-weight:400;margin:0 0 60px 0;letter-spacing:0.02em;line-height:1}
.cf-trust-01-v6-list{display:flex;flex-direction:column;gap:30px}
.cf-trust-01-v6-item{display:flex;align-items:flex-start;gap:20px;padding-bottom:30px;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-trust-01-v6-item:last-child{border-bottom:none;padding-bottom:0}
.cf-trust-01-v6-icon{font-size:18px;color:{{ section.settings.accent_color }};padding-top:4px}
.cf-trust-01-v6-item-info h4{font-size:22px;margin:0 0 10px 0;font-weight:400;letter-spacing:0.02em}
.cf-trust-01-v6-item-info p{font-family:sans-serif;font-size:13px;opacity:0.7;line-height:1.6;margin:0}
@media(max-width:1024px){
  .cf-trust-01-v6-inner{flex-direction:column}
  .cf-trust-01-v6-content-col{padding:0}
  .cf-trust-01-v6-img-col{width:100%;max-width:600px}
}
</style>

<div class="cf-trust-01-v6">
  <div class="cf-trust-01-v6-inner">
    <div class="cf-trust-01-v6-img-col">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="cf-trust-01-v6-img" alt="">
      {% else %}
        <div class="cf-trust-01-v6-img" style="background:#ddd;"></div>
      {% endif %}
    </div>
    
    <div class="cf-trust-01-v6-content-col">
      <h2 class="cf-trust-01-v6-title">{{ section.settings.title }}</h2>
      <div class="cf-trust-01-v6-list">
        {% for i in (1..3) %}
          <div class="cf-trust-01-v6-item">
            <div class="cf-trust-01-v6-icon">✦</div>
            <div class="cf-trust-01-v6-item-info">
              <h4>
                {% if i == 1 %}Impeccable Standards{% elsif i == 2 %}Enduring Value{% else %}Sartorial Elegance{% endif %}
              </h4>
              <p>
                {% if i == 1 %}We refuse to compromise on the caliber of our materials or construction.{% elsif i == 2 %}Pieces designed not for a season, but for a lifetime of admiration.{% else %}Flawless execution of form intended to elevate your daily ritual.{% endif %}
              </p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Trust (v6)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Editorial Image"},
    {"type":"text","id":"title","label":"Header Title","default":"The Commitment"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon/Accent","default":"#A38971"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#EEEEEE"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Trust (v6)"}]
}
{% endschema %}
