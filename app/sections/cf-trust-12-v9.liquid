<style>
.cf-trust-12-v9{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-trust-12-v9-inner{max-width:1400px;margin:0 auto}
.cf-trust-12-v9-title{font-size:clamp(32px, 5vw, 60px);font-family:serif;font-weight:400;margin:0 0 60px 0;text-align:center;font-style:italic}
.cf-trust-12-v9-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-bottom:60px}
.cf-trust-12-v9-block{display:flex;flex-direction:column;justify-content:center;padding:40px}
.cf-trust-12-v9-img-pane{position:relative;width:100%;min-height:400px;border-radius:{{ section.settings.border_radius }}px;overflow:hidden;background:#f5f5f5}
.cf-trust-12-v9-img{width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;transition:0.8s}
.cf-trust-12-v9-img-pane:hover .cf-trust-12-v9-img{transform:scale(1.05)}
.cf-trust-12-v9-badge{display:flex;align-items:flex-start;gap:25px;margin-bottom:40px}
.cf-trust-12-v9-badge:last-child{margin-bottom:0}
.cf-trust-12-v9-icon{flex:0 0 50px;height:50px;border:1px solid {{ section.settings.border_color }};border-radius:50%;display:flex;align-items:center;justify-content:center;color:{{ section.settings.accent_color }}}
.cf-trust-12-v9-info{flex:1}
.cf-trust-12-v9-info-title{font-family:serif;font-size:24px;margin:0 0 10px 0;font-weight:400}
.cf-trust-12-v9-info-desc{font-size:14px;line-height:1.6;opacity:0.75;margin:0}
@media(max-width:900px){.cf-trust-12-v9-grid{grid-template-columns:1fr}.cf-trust-12-v9-grid:nth-child(even) .cf-trust-12-v9-img-pane{grid-row:1}.cf-trust-12-v9-block{padding:20px 0}}
</style>

<div class="cf-trust-12-v9">
  <div class="cf-trust-12-v9-inner">
    {% if section.settings.title != blank %}
      <h2 class="cf-trust-12-v9-title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="cf-trust-12-v9-grid">
      <div class="cf-trust-12-v9-img-pane">
        <div class="cf-trust-12-v9-img" style="background:#e8e8e8"></div>
      </div>
      <div class="cf-trust-12-v9-block">
        <div class="cf-trust-12-v9-badge">
          <div class="cf-trust-12-v9-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div class="cf-trust-12-v9-info">
            <h3 class="cf-trust-12-v9-info-title">Sustainably Sourced</h3>
            <p class="cf-trust-12-v9-info-desc">Our pieces are crafted using ethically cultivated materials that are kind to the earth and safe for the skin.</p>
          </div>
        </div>
        <div class="cf-trust-12-v9-badge">
          <div class="cf-trust-12-v9-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
          <div class="cf-trust-12-v9-info">
            <h3 class="cf-trust-12-v9-info-title">Elevated Packaging</h3>
            <p class="cf-trust-12-v9-info-desc">Every order is hand-packed into beautiful, recyclable boxes that make unboxing a delightful experience.</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="cf-trust-12-v9-grid" style="margin-bottom:0;">
      <div class="cf-trust-12-v9-block" style="order:1;">
        <div class="cf-trust-12-v9-badge">
          <div class="cf-trust-12-v9-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div class="cf-trust-12-v9-info">
            <h3 class="cf-trust-12-v9-info-title">Secure Commerce</h3>
            <p class="cf-trust-12-v9-info-desc">We use top-tier SSL encryption to ensure your personal details are always protected.</p>
          </div>
        </div>
        <div class="cf-trust-12-v9-badge">
           <div class="cf-trust-12-v9-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="cf-trust-12-v9-info">
            <h3 class="cf-trust-12-v9-info-title">Free & Fast Shipping</h3>
            <p class="cf-trust-12-v9-info-desc">Orders ship quickly. Enjoy complimentary standard shipping worldwide on all purchases over $200.</p>
          </div>
        </div>
      </div>
      <div class="cf-trust-12-v9-img-pane" style="order:2;">
        <div class="cf-trust-12-v9-img" style="background:#e4e4e4"></div>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Trust (v9)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Studio Standard"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon Accent Color","default":"#A88A70"},
    {"type":"color","id":"border_color","label":"Icon Border Color","default":"#EAEAEE"},
    {"type":"range","id":"border_radius","label":"Image Rounding","min":0,"max":20,"step":2,"default":0},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":10,"default":100}
  ],
  "presets": [{"name":"12 · Women's Trust (v9)"}]
}
{% endschema %}
