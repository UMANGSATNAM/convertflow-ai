<style>
.cf-header-03-v9 {
  width: 100%;
  background: {{ section.settings.bg_color | color_modify: 'alpha', 0.85 }};
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(0,0,0,0.1);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  position: sticky;
  top: 0;
  z-index: 100;
}

.cf-header-03-v9-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-header-03-v9-nav {
  display: none;
  align-items: center;
  gap: 30px;
  flex: 1;
}

.cf-header-03-v9-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  opacity: 0.8;
  transition: 0.2s;
  font-weight: 500;
}

.cf-header-03-v9-nav a:hover {
  opacity: 1;
  color: {{ section.settings.accent_color }};
}

.cf-header-03-v9-logo {
  flex: 1;
  text-align: center;
  font-size: {{ section.settings.logo_size }}px;
  font-weight: 600;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  letter-spacing: -0.02em;
}

.cf-header-03-v9-actions {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20px;
}

.cf-header-03-v9-icon {
  color: {{ section.settings.text_color }};
  opacity: 0.8;
  transition: 0.2s;
  display: flex;
}

.cf-header-03-v9-icon:hover {
  opacity: 1;
  color: {{ section.settings.accent_color }};
}

.cf-header-03-v9-icon svg {
  width: 20px; height: 20px;
  stroke-width: 1.5;
}

@media (min-width: 768px) {
  .cf-header-03-v9-nav { display: flex; }
  .cf-header-03-v9-logo { flex: 0 1 auto; }
}
</style>

<div class="cf-header-03-v9">
  <div class="cf-header-03-v9-inner">
    
    <nav class="cf-header-03-v9-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <a href="/" class="cf-header-03-v9-logo">{{ section.settings.logo_text }}</a>

    <div class="cf-header-03-v9-actions">
      <a href="/search" class="cf-header-03-v9-icon" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="/cart" class="cf-header-03-v9-icon" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "09 · Clean iOS Tech",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base (White default)","default":"#ffffff"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"Studio"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":16,"max":40,"step":2,"default":22},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#0066cc"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":15},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1800,"step":100,"default":1200}
  ],
  "presets": [{"name":"09 · Clean iOS Tech Header"}]
}
{% endschema %}
