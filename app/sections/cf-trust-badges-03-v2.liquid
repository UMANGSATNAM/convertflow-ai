<style>
.cf-tb-03-v2 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-tb-03-v2-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  border-top: 1px dashed {{ section.settings.border_color }};
  border-bottom: 1px dashed {{ section.settings.border_color }};
  padding: 30px 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 40px;
}

.cf-tb-03-v2-item {
  display: flex;
  align-items: center;
  gap: 15px;
  color: {{ section.settings.text_color }};
}

.cf-tb-03-v2-icon {
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
}

.cf-tb-03-v2-icon svg {
  width: 24px; height: 24px;
}

.cf-tb-03-v2-text {
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: bold;
}

.cf-tb-03-v2-bracket {
  color: {{ section.settings.border_color }};
}

@media (max-width: 768px) {
  .cf-tb-03-v2-inner {
    flex-direction: column;
    align-items: flex-start;
    padding-left: 20px;
  }
}
</style>

<div class="cf-tb-03-v2">
  <div class="cf-tb-03-v2-inner">
    {% for block in section.blocks %}
      <div class="cf-tb-03-v2-item">
        <div class="cf-tb-03-v2-icon">
          {% if block.settings.icon == 'shield' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {% elsif block.settings.icon == 'lock' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {% elsif block.settings.icon == 'truck' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          {% endif %}
        </div>
        <div class="cf-tb-03-v2-text">
          <span class="cf-tb-03-v2-bracket">[</span> {{ block.settings.title }} <span class="cf-tb-03-v2-bracket">]</span>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "02 · Hacker Terminal Badges",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#050505"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#d4d4d4"},
    {"type":"color","id":"accent_color","label":"Terminal Green Accent","default":"#00ff41"},
    {"type":"color","id":"border_color","label":"Lines/Brackets","default":"#333333"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":100,"step":5,"default":40},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "shield", "label": "Shield"},
            {"value": "lock", "label": "Lock"},
            {"value": "truck", "label": "Truck"},
            {"value": "check", "label": "Checkmark"}
          ],
          "default": "check"
        },
        {"type":"text","id":"title","label":"Text","default":"SYSTEM_SECURE"}
      ]
    }
  ],
  "presets": [
    {
      "name": "02 · Hacker Terminal Badges",
      "blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"}]
    }
  ]
}
{% endschema %}
