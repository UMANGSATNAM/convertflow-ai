<style>
.cf-ft-04{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif}
.cf-ft-04-inner{max-width:1200px;margin:0 auto}
.cf-ft-04-header{text-align:center;margin-bottom:60px}
.cf-ft-04-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:700;margin-bottom:15px;letter-spacing:-0.03em}
.cf-ft-04-sub{font-size:16px;color:#64748b;max-width:500px;margin:0 auto;line-height:1.5}
.cf-ft-04-grid{display:grid;grid-template-columns:repeat({{ section.settings.cols }}, 1fr);gap:30px}
.cf-ft-04-card{text-decoration:none;display:flex;flex-direction:column;background:#fff;border-radius:24px;padding:25px;box-shadow:0 10px 30px rgba(0,0,0,0.03);border:1px solid #f1f5f9;transition:0.3s;text-align:center}
.cf-ft-04-card:hover{transform:translateY(-10px);box-shadow:0 20px 40px rgba(0,0,0,0.08);border-color:{{ section.settings.accent_color | color_modify: 'alpha', 0.5 }}}
.cf-ft-04-img-wrap{aspect-ratio:1/1;margin-bottom:20px}
.cf-ft-04-img{width:100%;height:100%;object-fit:contain;transition:0.5s}
.cf-ft-04-card:hover .cf-ft-04-img{transform:scale(1.08)}
.cf-ft-04-name{font-size:18px;color:{{ section.settings.text_color }};font-weight:600;margin-bottom:8px;line-height:1.3}
.cf-ft-04-price{font-size:16px;color:#475569;font-weight:500;margin-bottom:24px}
.cf-ft-04-btn{display:inline-block;padding:12px 24px;background:{{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};color:{{ section.settings.accent_color }};border-radius:100px;font-weight:600;font-size:14px;transition:0.2s}
.cf-ft-04-card:hover .cf-ft-04-btn{background:{{ section.settings.accent_color }};color:#fff}
@media(max-width:900px){.cf-ft-04-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.cf-ft-04-grid{grid-template-columns:1fr}}
</style>

<div class="cf-ft-04">
  <div class="cf-ft-04-inner">
    <div class="cf-ft-04-header">
      <h2 class="cf-ft-04-title">{{ section.settings.title }}</h2>
      <p class="cf-ft-04-sub">{{ section.settings.subtitle }}</p>
    </div>
    
    <div class="cf-ft-04-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="cf-ft-04-card">
            <div class="cf-ft-04-img-wrap">
              <img class="cf-ft-04-img" src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
            </div>
            <div class="cf-ft-04-name">{{ product.title }}</div>
            <div class="cf-ft-04-price">{{ product.price | money }}</div>
            <div><div class="cf-ft-04-btn">Add to Bag</div></div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <a href="#" class="cf-ft-04-card">
            <div class="cf-ft-04-img-wrap">
               <div style="width:100%;height:100%;border-radius:50%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8">BOTTLE</div>
            </div>
            <div class="cf-ft-04-name">Organic Daily Vitamin {{ i }}</div>
            <div class="cf-ft-04-price">$35.00</div>
            <div><div class="cf-ft-04-btn">Add to Bag</div></div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Health Carousel",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Shop Bestsellers"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":64,"step":2,"default":42},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Hand-picked essentials for your daily wellness routine."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product Limit","min":2,"max":12,"step":1,"default":4},
    {"type":"range","id":"cols","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":3},
    {"type":"color","id":"bg_color","label":"Background","default":"#f8fafc"},
    {"type":"color","id":"text_color","label":"Title Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent (Green)","default":"#16a34a"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"04 · Health Carousel"}]
}
{% endschema %}
