<style>
.cf-trust-13-v8{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;border-top:2px solid {{ section.settings.text_color }};border-bottom:2px solid {{ section.settings.text_color }}}
.cf-trust-13-v8-inner{max-width:1600px;margin:0 auto;display:grid;grid-template-columns:30% 1fr}
.cf-trust-13-v8-left{border-right:2px solid {{ section.settings.text_color }};display:flex;align-items:center;justify-content:center;padding:60px 40px}
.cf-trust-13-v8-label{font-size:clamp(40px, 6vw, 80px);font-weight:900;text-transform:uppercase;letter-spacing:-0.03em;transform:rotate(-90deg);white-space:nowrap}
.cf-trust-13-v8-right{display:flex;flex-direction:column}
.cf-trust-13-v8-item{padding:40px 60px;border-bottom:1px solid {{ section.settings.border_color }};display:flex;align-items:center;gap:40px}
.cf-trust-13-v8-item:last-child{border-bottom:none}
.cf-trust-13-v8-num{font-size:12px;font-weight:800;letter-spacing:0.2em;transform:rotate(-90deg);opacity:0.5}
.cf-trust-13-v8-content{flex:1}
.cf-trust-13-v8-title{font-size:24px;font-weight:800;text-transform:uppercase;margin:0 0 10px 0;letter-spacing:-0.01em}
.cf-trust-13-v8-desc{font-size:15px;line-height:1.6;opacity:0.8;margin:0;max-width:600px}
@media(max-width:1024px){
  .cf-trust-13-v8-inner{grid-template-columns:100px 1fr}
  .cf-trust-13-v8-label{font-size:40px;transform:rotate(-90deg)}
  .cf-trust-13-v8-item{padding:30px}
}
@media(max-width:768px){
  .cf-trust-13-v8-inner{grid-template-columns:1fr}
  .cf-trust-13-v8-left{border-right:none;border-bottom:2px solid {{ section.settings.text_color }};padding:30px}
  .cf-trust-13-v8-label{transform:none}
  .cf-trust-13-v8-item{flex-direction:column;align-items:flex-start;gap:20px}
  .cf-trust-13-v8-num{transform:none}
}
</style>

<div class="cf-trust-13-v8">
  <div class="cf-trust-13-v8-inner">
    <div class="cf-trust-13-v8-left">
      <div class="cf-trust-13-v8-label">{{ section.settings.side_label }}</div>
    </div>
    <div class="cf-trust-13-v8-right">
      {% for i in (1..3) %}
        <div class="cf-trust-13-v8-item">
          <div class="cf-trust-13-v8-num">0{{ i }}</div>
          <div class="cf-trust-13-v8-content">
            <h4 class="cf-trust-13-v8-title">
              {% if i == 1 %}Global Express Shipping{% elsif i == 2 %}Hassle-Free Returns{% else %}Client Support{% endif %}
            </h4>
            <p class="cf-trust-13-v8-desc">
              {% if i == 1 %}Complimentary tracked shipping on all domestic orders and international orders over $300.{% elsif i == 2 %}Request a return within 14 days of delivery. Prepaid return labels provided for domestic clients.{% else %}Our advisory team is available Monday through Friday to assist with styling and sizing inquiries.{% endif %}
            </p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Trust (v8)",
  "settings": [
    {"type":"text","id":"side_label","label":"Vertical Side Label","default":"SERVICE"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#F0F0F0"},
    {"type":"color","id":"text_color","label":"Text & Border Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Inner List Border Color","default":"#DDDDDD"}
  ],
  "presets": [{"name":"13 · Trust (v8)"}]
}
{% endschema %}
