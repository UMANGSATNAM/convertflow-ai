<style>
.cf-header-05-v10 {
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-header-05-v10-top {
  background: {{ section.settings.accent_color }};
  text-align: center;
  padding: 9px 20px;
  font-size: 12px;
  color: #fff;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.cf-header-05-v10-top-leaf { font-size: 14px; }
.cf-header-05-v10-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 40px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  border-bottom: 1px solid {{ section.settings.border_color }};
}
.cf-header-05-v10-logo {
  font-size: 22px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 8px;
}
.cf-header-05-v10-logo-badge {
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 9px;
  padding: 2px 6px;
  border-radius: 20px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.cf-header-05-v10-nav {
  display: flex;
  gap: 30px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v10-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s;
}
.cf-header-05-v10-nav a:hover { color: {{ section.settings.accent_color }}; }
.cf-header-05-v10-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}
.cf-header-05-v10-icon { color: {{ section.settings.text_color }}; cursor: pointer; opacity: 0.8; }
.cf-header-05-v10-icon svg { width: 20px; height: 20px; stroke-width: 1.8; }
@media (max-width: 900px) {
  .cf-header-05-v10-nav { display: none; }
  .cf-header-05-v10-bar { padding: 15px 20px; }
}
</style>

<div class="cf-header-05-v10">
  {% if section.settings.top_text != blank %}
    <div class="cf-header-05-v10-top">
      <span class="cf-header-05-v10-top-leaf">🌿</span>
      {{ section.settings.top_text }}
      <span class="cf-header-05-v10-top-leaf">🌿</span>
    </div>
  {% endif %}
  <div class="cf-header-05-v10-bar">
    <a href="/" class="cf-header-05-v10-logo">
      {{ section.settings.logo_text }}
      <span class="cf-header-05-v10-logo-badge">Eco</span>
    </a>
    <nav>
      <ul class="cf-header-05-v10-nav">
        {% for block in section.blocks %}
          <li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="cf-header-05-v10-actions">
      <div class="cf-header-05-v10-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v10-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
      <div class="cf-header-05-v10-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · Sustainable Beauty",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f0fdf4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#14532d"},
    {"type":"color","id":"accent_color","label":"Accent Color (Green)","default":"#16a34a"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#dcfce7"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"verdant"},
    {"type":"text","id":"top_text","label":"Announcement Text","default":"Carbon Neutral Shipping · Refillable Packaging · 1% for the Planet"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Skincare"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "10 · Sustainable Beauty Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
