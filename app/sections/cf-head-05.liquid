<style>
.cf-head-05{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;border-bottom:1px solid rgba(0,0,0,0.03)}
.cf-head-05-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}
.cf-head-05-burger{display:flex;flex-direction:column;gap:5px;width:24px;cursor:pointer;color:{{ section.settings.text_color }}}
.cf-head-05-burger span{display:block;height:2px;width:100%;background:currentColor;border-radius:2px}
.cf-head-05-logo{font-family:'Georgia', serif;font-size:clamp(22px,3vw,{{ section.settings.logo_size }}px);font-weight:400;color:{{ section.settings.logo_color }};text-decoration:none;letter-spacing:0.04em}
.cf-head-05-icons{display:flex;align-items:center;gap:20px;color:{{ section.settings.text_color }}}
.cf-head-05-icons a{color:inherit;text-decoration:none;transition:0.3s}
.cf-head-05-icons a:hover{color:{{ section.settings.accent_color }}}
</style>

<header class="cf-head-05">
  <div class="cf-head-05-inner">
    <div class="cf-head-05-burger">
      <span></span><span></span><span></span>
    </div>
    <a href="/" class="cf-head-05-logo">{{ section.settings.logo_text }}</a>
    <div class="cf-head-05-icons">
      <a href="/search"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></a>
      <a href="/cart"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "05 · Beauty Header",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"Aura Skincare"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":20,"max":50,"step":2,"default":32},
    {"type":"color","id":"bg_color","label":"Background","default":"#fffbfb"},
    {"type":"color","id":"logo_color","label":"Logo Color","default":"#4a3c31"},
    {"type":"color","id":"text_color","label":"Icon/Burger Color","default":"#8a7b72"},
    {"type":"color","id":"accent_color","label":"Hover Color","default":"#d4aba0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":12,"max":40,"step":2,"default":20}
  ],
  "presets": [{"name":"05 · Beauty Header"}]
}
{% endschema %}
