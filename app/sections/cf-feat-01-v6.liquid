<style>
.cf-feat-01-v6{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-feat-01-v6-inner{max-width:1400px;margin:0 auto;display:flex;gap:60px;align-items:center}
.cf-feat-01-v6-list{flex:1;display:flex;flex-direction:column;gap:30px}
.cf-feat-01-v6-header{font-size:clamp(32px, 5vw, 64px);font-weight:400;margin:0 0 40px 0;letter-spacing:0.02em}
.cf-feat-01-v6-item{text-decoration:none;color:inherit;display:flex;justify-content:space-between;padding-bottom:20px;border-bottom:1px solid {{ section.settings.border_color }};transition:0.3s}
.cf-feat-01-v6-item-title{font-size:20px;font-style:italic;margin:0;font-weight:400}
.cf-feat-01-v6-item-price{font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.1em;opacity:0.6}
.cf-feat-01-v6-item:hover{color:{{ section.settings.accent_color }}}
.cf-feat-01-v6-item:hover .cf-feat-01-v6-item-price{opacity:1}
.cf-feat-01-v6-preview{flex:1;aspect-ratio:3/4;background:#ececec;position:relative;overflow:hidden}
.cf-feat-01-v6-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.6s, transform 1s}
.cf-feat-01-v6-img.active{opacity:1;transform:scale(1.05)}
@media(max-width:1024px){
  .cf-feat-01-v6-inner{flex-direction:column}
  .cf-feat-01-v6-preview{display:none} /* Optional */
}
</style>

<div class="cf-feat-01-v6">
  <div class="cf-feat-01-v6-inner">
    <div class="cf-feat-01-v6-list" id="cf-feat-01-v6-list-{{ section.id }}">
      <h2 class="cf-feat-01-v6-header">{{ section.settings.title }}</h2>
      {% for i in (1..5) %}
        <a href="#" class="cf-feat-01-v6-item" data-index="{{ i }}">
          <h4 class="cf-feat-01-v6-item-title">Exquisite Object 0{{ i }}</h4>
          <span class="cf-feat-01-v6-item-price">$1,200</span>
        </a>
      {% endfor %}
      <a href="{{ section.settings.btn_link }}" style="display:inline-block;margin-top:20px;font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:{{ section.settings.text_color }};text-decoration:none;">{{ section.settings.btn_text }}</a>
    </div>
    
    <div class="cf-feat-01-v6-preview" id="cf-feat-01-v6-preview-{{ section.id }}">
      {% for i in (1..5) %}
        <div class="cf-feat-01-v6-img {% if i == 1 %}active{% endif %}" id="cf-feat-01-v6-img-{{ section.id }}-{{ i }}" style="background:hsl({{ i | times: 60 }}, 20%, 30%);"></div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const listItems = document.querySelectorAll('#cf-feat-01-v6-list-{{ section.id }} .cf-feat-01-v6-item');
    const images = document.querySelectorAll('#cf-feat-01-v6-preview-{{ section.id }} .cf-feat-01-v6-img');
    
    listItems.forEach(item => {
      item.addEventListener('mouseenter', () => {
        const idx = item.getAttribute('data-index');
        images.forEach(img => img.classList.remove('active'));
        const target = document.getElementById(`cf-feat-01-v6-img-{{ section.id }}-${idx}`);
        if(target) target.classList.add('active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "01 · Luxury Featured (v6)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Selection"},
    {"type":"text","id":"btn_text","label":"View All Button","default":"View Full Collection"},
    {"type":"url","id":"btn_link","label":"View All Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#A38971"},
    {"type":"color","id":"border_color","label":"List Separator","default":"#EAEAEE"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Featured (v6)"}]
}
{% endschema %}
