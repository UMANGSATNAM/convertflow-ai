<style>
.cf-mq-03-v3 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  box-shadow: 0 0 10px {{ section.settings.accent_color }}40 inset;
  display: flex;
}

.cf-mq-03-v3-track {
  display: flex;
  white-space: nowrap;
  animation: cf-mq-03-v3-scroll {{ section.settings.speed }}s linear infinite;
}

@keyframes cf-mq-03-v3-scroll {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

.cf-mq-03-v3-item {
  display: flex;
  align-items: center;
  padding: 0 50px;
  font-size: {{ section.settings.text_size }}px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-family: 'Inter', sans-serif;
  position: relative;
  /* Glitch effect on hover */
  transition: 0.2s;
}

.cf-mq-03-v3-track:hover .cf-mq-03-v3-item {
  text-shadow: 2px 2px 0 red, -2px -2px 0 cyan;
}

.cf-mq-03-v3-separator {
  color: {{ section.settings.accent_color }};
  font-size: {{ section.settings.text_size | times: 1.2 }}px;
}
</style>

<div class="cf-mq-03-v3">
  <div class="cf-mq-03-v3-track">
    {% for block in section.blocks %}
      <div class="cf-mq-03-v3-item">{{ block.settings.text }}</div>
      <div class="cf-mq-03-v3-separator">/*</div>
    {% endfor %}
    {% for block in section.blocks %}
      <div class="cf-mq-03-v3-item">{{ block.settings.text }}</div>
      <div class="cf-mq-03-v3-separator">/*</div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "03 · Glitch Loop",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#050505"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Separator/Glow Accent","default":"#ff003c"},
    {"type":"range","id":"text_size","label":"Text Size","min":16,"max":64,"step":2,"default":24},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":5,"default":20},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":25}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "limit": 6,
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"SYSTEM OVERRIDE"}
      ]
    }
  ],
  "presets": [
    {
      "name": "03 · Glitch Loop Marquee",
      "blocks": [
        {"type": "text"},
        {"type": "text"},
        {"type": "text"}
      ]
    }
  ]
}
{% endschema %}
