<style>
.cf-cro-cd4{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;border-top:1px solid {{ section.settings.text_color }}10;border-bottom:1px solid {{ section.settings.text_color }}10}
.cf-cro-cd4-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:40px}
.cf-cro-cd4-text{display:flex;align-items:center;gap:20px}
.cf-cro-cd4-icon{width:48px;height:48px;border-radius:12px;background:{{ section.settings.accent_color }};color:#fff;display:flex;align-items:center;justify-content:center;font-size:24px}
.cf-cro-cd4 h3{font-size:24px;font-weight:800;color:{{ section.settings.text_color }};margin:0 0 4px;letter-spacing:-0.01em}
.cf-cro-cd4 p{font-size:15px;color:{{ section.settings.text_color }};opacity:0.7;margin:0}
.cf-cro-cd4-right{display:flex;align-items:center;gap:32px}
.cf-cro-cd4-timer{display:flex;gap:12px}
.cf-cro-cd4-unit{display:flex;flex-direction:column;align-items:center;min-width:60px}
.cf-cro-cd4-num{font-size:36px;font-weight:900;color:{{ section.settings.text_color }};line-height:1;font-variant-numeric:tabular-nums}
.cf-cro-cd4-lbl{font-size:11px;font-weight:700;color:{{ section.settings.text_color }};opacity:0.4;text-transform:uppercase;letter-spacing:0.1em;margin-top:4px}
.cf-cro-cd4-colon{font-size:32px;font-weight:900;color:{{ section.settings.text_color }};opacity:0.2;line-height:1;margin-top:2px}
.cf-cro-cd4-btn{padding:16px 32px;background:{{ section.settings.accent_color }};color:#fff;border-radius:12px;font-size:15px;font-weight:700;text-decoration:none;transition:transform 0.2s;white-space:nowrap}
.cf-cro-cd4-btn:hover{transform:translateY(-2px)}
@media(max-width:992px){.cf-cro-cd4-inner{flex-direction:column;text-align:center}.cf-cro-cd4-text{flex-direction:column;gap:12px}.cf-cro-cd4-right{flex-direction:column;width:100%}.cf-cro-cd4-btn{width:100%;text-align:center}}
</style>

<div class="cf-cro-cd4" id="cf-cd4-{{ section.id }}">
  <div class="cf-cro-cd4-inner">
    <div class="cf-cro-cd4-text">
      <div class="cf-cro-cd4-icon">⚡</div>
      <div>
        <h3>{{ section.settings.heading }}</h3>
        <p>{{ section.settings.subheading }}</p>
      </div>
    </div>
    <div class="cf-cro-cd4-right">
      <div class="cf-cro-cd4-timer">
        <div class="cf-cro-cd4-unit"><div class="cf-cro-cd4-num" data-u="h">{{ section.settings.hours }}</div><div class="cf-cro-cd4-lbl">Hours</div></div>
        <div class="cf-cro-cd4-colon">:</div>
        <div class="cf-cro-cd4-unit"><div class="cf-cro-cd4-num" data-u="m">{{ section.settings.minutes }}</div><div class="cf-cro-cd4-lbl">Mins</div></div>
        <div class="cf-cro-cd4-colon">:</div>
        <div class="cf-cro-cd4-unit"><div class="cf-cro-cd4-num" data-u="s">00</div><div class="cf-cro-cd4-lbl">Secs</div></div>
      </div>
      <a href="{{ section.settings.cta_link }}" class="cf-cro-cd4-btn">{{ section.settings.cta_text }}</a>
    </div>
  </div>
</div>

<script>
(function(){var e=document.getElementById('cf-cd4-{{ section.id }}');if(!e)return;var t=parseInt('{{ section.settings.hours }}')*3600+parseInt('{{ section.settings.minutes }}')*60;function p(n){return n<10?'0'+n:''+n}setInterval(function(){if(t<=0)return;t--;var n=e.querySelectorAll('.cf-cro-cd4-num');n[0].textContent=p(Math.floor(t/3600));n[1].textContent=p(Math.floor((t%3600)/60));n[2].textContent=p(t%60)},1000)})();
</script>

{% schema %}
{
  "name": "CRO · Slim Timer Bar v4",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Flash Sale Ends Soon"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Take 30% off your entire order today only."},
    {"type":"range","id":"hours","label":"Hours","min":0,"max":23,"step":1,"default":4},
    {"type":"range","id":"minutes","label":"Minutes","min":0,"max":59,"step":1,"default":45},
    {"type":"text","id":"cta_text","label":"CTA","default":"Shop the Sale"},
    {"type":"text","id":"cta_link","label":"CTA Link","default":"/collections/sale"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#EF4444"},
    {"type":"range","id":"padding_y","label":"Top/Bottom Padding","min":10,"max":60,"step":5,"default":20}
  ],
  "presets": [{"name":"CRO · Slim Timer Bar v4"}]
}
{% endschema %}
