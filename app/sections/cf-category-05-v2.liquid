<style>
.cf-cat-05-v2 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-cat-05-v2-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-cat-05-v2-header { text-align: center; margin-bottom: 50px; }
.cf-cat-05-v2-title { font-size: 38px; font-weight: 800; color: {{ section.settings.text_color }}; margin: 0 0 10px 0; letter-spacing: -0.02em; }
.cf-cat-05-v2-subtitle { color: #6b7280; font-size: 16px; }
.cf-cat-05-v2-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 20px; }
.cf-cat-05-v2-card {
  display: block; text-decoration: none;
  background: #fff; border-radius: 16px; overflow: hidden;
  position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  transition: transform 0.3s;
}
.cf-cat-05-v2-card:hover { transform: translateY(-8px); }
.cf-cat-05-v2-img { aspect-ratio: 3/4; position: relative; overflow: hidden; background: #fce7f3; }
.cf-cat-05-v2-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s; }
.cf-cat-05-v2-card:hover .cf-cat-05-v2-img img { transform: scale(1.05); }
.cf-cat-05-v2-name {
  text-align: center; padding: 18px 10px;
  font-size: 16px; font-weight: 700; color: {{ section.settings.text_color }};
}
@media (max-width: 900px) { .cf-cat-05-v2-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-cat-05-v2">
  <div class="cf-cat-05-v2-inner">
    <div class="cf-cat-05-v2-header">
      <h2 class="cf-cat-05-v2-title">{{ section.settings.title }}</h2>
      <p class="cf-cat-05-v2-subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="cf-cat-05-v2-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-05-v2-card">
        <div class="cf-cat-05-v2-img">
          {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}
        </div>
        <div class="cf-cat-05-v2-name">{{ block.settings.title }}</div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "02 · Glam Categories","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#fff0f6"},{"type":"color","id":"text_color","label":"Text Color","default":"#1e1b4b"},{"type":"text","id":"title","label":"Title","default":"Shop by Category"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Curated looks for every vibe."},{"type":"range","id":"cols","label":"Columns","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "category","name": "Category","settings": [{"type":"text","id":"title","label":"Name","default":"Complexion"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets": [{"name": "02 · Glam Categories","blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
