<style>
.cf-head-02-v4 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4px 30px rgba(0,0,0,0.03);
}

.cf-head-02-v4-main {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-head-02-v4-nav-left, .cf-head-02-v4-nav-right {
  display: none;
  gap: 24px;
}

.cf-head-02-v4-nav-right {
  justify-content: flex-end;
}

.cf-head-02-v4-logo {
  font-size: clamp(32px, 6vw, {{ section.settings.logo_size }}px);
  font-weight: 900;
  color: {{ section.settings.logo_color }};
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: -0.05em;
  line-height: 0.85;
  text-align: center;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.cf-head-02-v4-logo:hover {
  transform: scale(1.05);
  color: {{ section.settings.hover_color }};
}

.cf-head-02-v4-link {
  font-size: 13px;
  font-weight: 800;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: 0.1em;
  position: relative;
  transition: 0.2s;
}

.cf-head-02-v4-link::before {
  content: '→';
  position: absolute;
  left: -20px;
  opacity: 0;
  color: {{ section.settings.hover_color }};
  transition: all 0.2s ease;
  transform: translateX(-10px);
}

.cf-head-02-v4-link:hover {
  color: {{ section.settings.logo_color }};
}

.cf-head-02-v4-link:hover::before {
  opacity: 1;
  transform: translateX(0);
}

.cf-head-02-v4-mobile-cart {
  display: block;
  text-align: right;
  font-weight: 800;
  font-size: 13px;
  text-transform: uppercase;
  color: {{ section.settings.logo_color }};
  text-decoration: none;
}

.cf-head-02-v4-mobile-menu {
  display: block;
  font-weight: 800;
  font-size: 13px;
  text-transform: uppercase;
  color: {{ section.settings.logo_color }};
  text-decoration: none;
}

@media (min-width: 1024px) {
  .cf-head-02-v4-main { padding: {{ section.settings.padding_y }}px 40px; }
  .cf-head-02-v4-nav-left, .cf-head-02-v4-nav-right { display: flex; align-items: center; }
  .cf-head-02-v4-mobile-cart, .cf-head-02-v4-mobile-menu { display: none; }
}
</style>

<header class="cf-head-02-v4">
  <div class="cf-head-02-v4-main">
    <!-- Mobile Menu Toggle -->
    <a href="#" class="cf-head-02-v4-mobile-menu">MENU</a>

    <nav class="cf-head-02-v4-nav-left">
      <a href="{{ section.settings.link_1_url }}" class="cf-head-02-v4-link">{{ section.settings.link_1 }}</a>
      <a href="{{ section.settings.link_2_url }}" class="cf-head-02-v4-link">{{ section.settings.link_2 }}</a>
    </nav>
    
    <a href="/" class="cf-head-02-v4-logo">{{ section.settings.logo_text }}</a>
    
    <nav class="cf-head-02-v4-nav-right">
      <a href="{{ section.settings.link_3_url }}" class="cf-head-02-v4-link">{{ section.settings.link_3 }}</a>
      <a href="{{ section.settings.link_4_url }}" class="cf-head-02-v4-link">{{ section.settings.link_4 }}</a>
      <a href="/cart" class="cf-head-02-v4-link" style="margin-left:20px; color: {{ section.settings.hover_color }};">CART (0)</a>
    </nav>

    <!-- Mobile Cart Toggle -->
    <a href="/cart" class="cf-head-02-v4-mobile-cart">CART (0)</a>
  </div>
</header>

{% schema %}
{
  "name": "04 · Center Logo Oversize",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "OVERSIZE"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo Size",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 48
    },
    {
      "type": "text",
      "id": "link_1",
      "label": "Link 1",
      "default": "New In"
    },
    {
      "type": "text",
      "id": "link_1_url",
      "label": "Link 1 URL",
      "default": "/collections/new"
    },
    {
      "type": "text",
      "id": "link_2",
      "label": "Link 2",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "link_2_url",
      "label": "Link 2 URL",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "link_3",
      "label": "Link 3",
      "default": "About"
    },
    {
      "type": "text",
      "id": "link_3_url",
      "label": "Link 3 URL",
      "default": "/pages/about"
    },
    {
      "type": "text",
      "id": "link_4",
      "label": "Link 4",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "link_4_url",
      "label": "Link 4 URL",
      "default": "/blogs/news"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Link Color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "hover_color",
      "label": "Hover Accent",
      "default": "#10b981"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "04 · Center Logo Oversize"
    }
  ]
}
{% endschema %}
