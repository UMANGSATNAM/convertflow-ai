<style>
.cf-cat-11-v3{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif}
.cf-cat-11-v3-inner{max-width:1400px;margin:0 auto}
.cf-cat-11-v3-title{font-size:40px;font-weight:900;text-transform:uppercase;color:{{ section.settings.text_color }};margin:0 0 40px 0;letter-spacing:-0.03em;text-align:center}
.cf-cat-11-v3-grid{display:grid;grid-template-columns:repeat(5, 1fr);gap:15px}
.cf-cat-11-v3-card{display:flex;flex-direction:column;align-items:center;text-decoration:none;gap:15px}
.cf-cat-11-v3-img-wrap{width:100%;aspect-ratio:1/1;border-radius:50%;overflow:hidden;background:#e5e5e5;padding:5px;border:1px solid {{ section.settings.border_color }};transition:0.3s}
.cf-cat-11-v3-img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.cf-cat-11-v3-card:hover .cf-cat-11-v3-img-wrap{transform:translateY(-10px);box-shadow:0 15px 30px rgba(0,0,0,0.1);border-color:{{ section.settings.text_color }}}
.cf-cat-11-v3-label{font-size:14px;color:{{ section.settings.text_color }};font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin:0;transition:0.3s}
.cf-cat-11-v3-card:hover .cf-cat-11-v3-label{color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-cat-11-v3-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){.cf-cat-11-v3-grid{grid-template-columns:repeat(2,1fr)}}
</style>

<div class="cf-cat-11-v3">
  <div class="cf-cat-11-v3-inner">
    <h2 class="cf-cat-11-v3-title">{{ section.settings.title }}</h2>
    <div class="cf-cat-11-v3-grid">
      {% for i in (1..5) %}
        {% capture img_key %}img_{{ i }}{% endcapture %}
        {% capture label_key %}label_{{ i }}{% endcapture %}
        {% capture link_key %}link_{{ i }}{% endcapture %}
        <a href="{{ section.settings[link_key] }}" class="cf-cat-11-v3-card">
          <div class="cf-cat-11-v3-img-wrap">
            {% if section.settings[img_key] %}
              <img src="{{ section.settings[img_key] | image_url: width: 400 }}" class="cf-cat-11-v3-img">
            {% else %}
              <div style="width:100%;height:100%;background:#d2d2d2"></div>
            {% endif %}
          </div>
          <h3 class="cf-cat-11-v3-label">{{ section.settings[label_key] }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Category (v3)",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"EXPLORE BY CATEGORY"},
    {"type":"image_picker","id":"img_1","label":"Image 1"},
    {"type":"text","id":"label_1","label":"Label 1","default":"NEW ARRIVALS"},
    {"type":"url","id":"link_1","label":"Link 1"},
    {"type":"image_picker","id":"img_2","label":"Image 2"},
    {"type":"text","id":"label_2","label":"Label 2","default":"TAILORING"},
    {"type":"url","id":"link_2","label":"Link 2"},
    {"type":"image_picker","id":"img_3","label":"Image 3"},
    {"type":"text","id":"label_3","label":"Label 3","default":"DENIM"},
    {"type":"url","id":"link_3","label":"Link 3"},
    {"type":"image_picker","id":"img_4","label":"Image 4"},
    {"type":"text","id":"label_4","label":"Label 4","default":"FOOTWEAR"},
    {"type":"url","id":"link_4","label":"Link 4"},
    {"type":"image_picker","id":"img_5","label":"Image 5"},
    {"type":"text","id":"label_5","label":"Label 5","default":"BAGS"},
    {"type":"url","id":"link_5","label":"Link 5"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Circle Border","default":"#E0E0E0"},
    {"type":"color","id":"accent_color","label":"Hover Color","default":"#8A8A8A"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Category (v3)"}]
}
{% endschema %}
