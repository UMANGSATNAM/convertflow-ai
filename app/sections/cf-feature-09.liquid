<style>
.cf-ft-09{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:serif;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-ft-09-inner{max-width:1400px;margin:0 auto}
.cf-ft-09-header{text-align:left;margin-bottom:60px;display:flex;justify-content:space-between;align-items:flex-end}
.cf-ft-09-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:400;margin:0;max-width:600px}
.cf-ft-09-link{font-size:12px;color:{{ section.settings.text_color }};text-transform:uppercase;letter-spacing:0.15em;text-decoration:none;font-family:sans-serif;padding-bottom:5px;border-bottom:1px solid {{ section.settings.text_color }};transition:0.3s}
.cf-ft-09-link:hover{color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }}}
.cf-ft-09-grid{display:grid;grid-template-columns:repeat({{ section.settings.cols }}, 1fr);gap:40px}
.cf-ft-09-card{text-decoration:none;display:block;group}
.cf-ft-09-img-wrap{aspect-ratio:4/5;background:#f5f5f4;margin-bottom:20px;overflow:hidden;position:relative}
.cf-ft-09-img{width:100%;height:100%;object-fit:cover;transition:transform 0.8s cubic-bezier(0.2,0.8,0.2,1);filter:brightness(0.95)}
.cf-ft-09-card:hover .cf-ft-09-img{transform:scale(1.03);filter:brightness(1)}
.cf-ft-09-info{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
.cf-ft-09-name{font-size:18px;color:{{ section.settings.text_color }};letter-spacing:0.02em}
.cf-ft-09-price{font-family:sans-serif;font-size:14px;color:#78716c;font-weight:600}
@media(max-width:900px){.cf-ft-09-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.cf-ft-09-grid{grid-template-columns:1fr}.cf-ft-09-header{flex-direction:column;align-items:flex-start;gap:20px}}
</style>

<div class="cf-ft-09">
  <div class="cf-ft-09-inner">
    <div class="cf-ft-09-header">
      <h2 class="cf-ft-09-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-ft-09-link">{{ section.settings.btn_label }}</a>
    </div>
    
    <div class="cf-ft-09-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="cf-ft-09-card">
            <div class="cf-ft-09-img-wrap">
              <img class="cf-ft-09-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
            </div>
            <div class="cf-ft-09-info">
              <div class="cf-ft-09-name">{{ product.title }}</div>
              <div class="cf-ft-09-price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <a href="#" class="cf-ft-09-card">
            <div class="cf-ft-09-img-wrap">
               <div style="width:100%;height:100%;background:#e7e5e4;display:flex;align-items:center;justify-content:center;color:#a8a29e;font-family:sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase">Furniture Piece {{ i }}</div>
            </div>
            <div class="cf-ft-09-info">
              <div class="cf-ft-09-name">Modern Lounge Chair</div>
              <div class="cf-ft-09-price">$899.00</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "09 · Furniture Gallery",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Signature Pieces"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":64,"step":2,"default":48},
    {"type":"text","id":"btn_label","label":"Button Label","default":"VIEW COLLECTION"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product Limit","min":2,"max":12,"step":1,"default":3},
    {"type":"range","id":"cols","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":3},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"border_color","label":"Border Line","default":"#e7e5e4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#292524"},
    {"type":"color","id":"accent_color","label":"Accent (Hover)","default":"#a8a29e"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"09 · Furniture Gallery"}]
}
{% endschema %}
