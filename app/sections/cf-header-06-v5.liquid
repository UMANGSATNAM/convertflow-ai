<div class="cf-auto-header-v5" style="background: {{ section.settings.bg_color }}; font-family: 'Inter', sans-serif;">
  <div class="cf-auto-header-v5-container" style="max-width: 1400px; margin: 0 auto; padding: 24px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 40px;">

    <!-- Menu (Left) -->
    <div class="cf-auto-header-v5-nav" style="display: flex; gap: 32px;">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" style="color: {{ section.settings.text_color }}; text-decoration: none; font-size: 14px; font-weight: 500; transition: opacity 0.2s; opacity: 0.8;" class="cf-hover-op">
          {{ link.title }}
        </a>
      {% endfor %}
    </div>

    <!-- Logo (Center) -->
    <div class="cf-auto-header-v5-logo" style="display: flex; justify-content: center;">
      <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 12px;">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <!-- EV style abstract icon -->
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          <span style="font-size: 22px; font-weight: 600; color: {{ section.settings.text_color }}; letter-spacing: 1px;">
            {{ shop.name }}
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Actions (Right) -->
    <div class="cf-auto-header-v5-actions" style="display: flex; justify-content: flex-end; align-items: center; gap: 24px;">
      
      <form action="/search" method="get" class="cf-search-pill" style="display: flex; align-items: center; background: rgba(0,0,0,0.04); padding: 8px 16px; border-radius: 30px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.text_color }}" stroke-width="2" style="opacity: 0.5; margin-right: 8px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" name="q" placeholder="Search" style="border: none; background: transparent; font-size: 14px; color: {{ section.settings.text_color }}; outline: none; width: 100px;">
      </form>

      <a href="/account" style="color: {{ section.settings.text_color }}; opacity: 0.8;" class="cf-hover-op">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>

      <a href="/cart" style="color: {{ section.settings.text_color }}; opacity: 0.8; display: flex; align-items: center; gap: 6px;" class="cf-hover-op">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span style="font-size: 13px; font-weight: 600;">{{ cart.item_count }}</span>
      </a>

      <!-- CTA Button -->
      <a href="{{ section.settings.cta_link }}" style="background: {{ section.settings.accent_color }}; color: #fff; text-decoration: none; font-size: 13px; font-weight: 500; padding: 10px 20px; border-radius: 30px; letter-spacing: 0.5px; transition: transform 0.2s;" class="cf-btn-pop">
        {{ section.settings.cta_text }}
      </a>

    </div>
  </div>
</div>

<style>
  .cf-hover-op:hover {
    opacity: 1 !important;
  }
  .cf-btn-pop:hover {
    transform: scale(1.05);
  }
  @media (max-width: 1024px) {
    .cf-auto-header-v5-container {
      grid-template-columns: auto 1fr auto;
    }
    .cf-auto-header-v5-nav { display: none !important; }
    .cf-auto-header-v5-logo { justify-content: flex-start; }
    .cf-search-pill { display: none !important; }
  }
</style>

{% schema %}
{
  "name": "06 · EV Auto Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#3b82f6"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Height",
      "default": 30
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Book Test Drive"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
