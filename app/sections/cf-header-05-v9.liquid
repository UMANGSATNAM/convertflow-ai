<style>
.cf-header-05-v9 {
  background: {{ section.settings.bg_color }};
  font-family: 'Didot', 'Playfair Display', 'Georgia', serif;
}
.cf-header-05-v9-top {
  text-align: center;
  padding: 10px;
  font-size: 11px;
  color: {{ section.settings.accent_color }};
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-header-05-v9-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 60px;
  border-top: 1px solid {{ section.settings.border_color }};
  border-bottom: 1px solid {{ section.settings.border_color }};
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
.cf-header-05-v9-nav {
  display: flex;
  gap: 40px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v9-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 13px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-weight: 400;
  transition: color 0.2s;
}
.cf-header-05-v9-nav a:hover { color: {{ section.settings.accent_color }}; }
.cf-header-05-v9-logo {
  font-size: 36px;
  font-weight: normal;
  font-style: italic;
  letter-spacing: 0.1em;
  color: {{ section.settings.text_color }};
  text-decoration: none;
}
.cf-header-05-v9-actions {
  display: flex;
  align-items: center;
  gap: 20px;
  justify-content: flex-end;
}
.cf-header-05-v9-icon { color: {{ section.settings.text_color }}; cursor: pointer; opacity: 0.8; }
.cf-header-05-v9-icon svg { width: 18px; height: 18px; stroke-width: 1.2; }
@media (max-width: 900px) {
  .cf-header-05-v9-nav { display: none; }
  .cf-header-05-v9-bar { padding: 20px 20px; }
  .cf-header-05-v9-logo { font-size: 28px; }
}
</style>

<div class="cf-header-05-v9">
  <div class="cf-header-05-v9-top">{{ section.settings.top_text }}</div>
  <div class="cf-header-05-v9-bar">
    <nav><ul class="cf-header-05-v9-nav">
      {% for block in section.blocks limit: 3 %}<li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>{% endfor %}
    </ul></nav>
    <a href="/" class="cf-header-05-v9-logo">{{ section.settings.logo_text }}</a>
    <div class="cf-header-05-v9-actions">
      <nav><ul class="cf-header-05-v9-nav" style="justify-content:flex-end;">
        {% for block in section.blocks offset: 3 %}<li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>{% endfor %}
      </ul></nav>
      <div class="cf-header-05-v9-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v9-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/></svg></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "09 · Fragrance Maison",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#faf8f5"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#2c2416"},
    {"type":"color","id":"accent_color","label":"Accent Color (Gold)","default":"#b8973a"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e8e0d0"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"Parfumerie"},
    {"type":"text","id":"top_text","label":"Top Text","default":"Artisan Fragrances — Handcrafted in Small Batches"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1400}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Eau de Parfum"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "09 · Fragrance Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
