<style>
.cf-tb-04-v4 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-tb-04-v4-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-tb-04-v4-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.cf-tb-04-v4-item {
  background: #fff;
  border: 1px solid {{ section.settings.border_color }};
  border-radius: 8px;
  padding: 24px;
  text-align: center;
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
}

.cf-tb-04-v4-icon {
  color: {{ section.settings.accent_color }};
  margin-bottom: 15px;
  display: flex;
  justify-content: center;
}

.cf-tb-04-v4-icon svg {
  width: 32px; height: 32px; stroke-width: 2;
}

.cf-tb-04-v4-title {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 8px 0;
}

.cf-tb-04-v4-desc {
  color: #64748b;
  font-size: 13px;
  line-height: 1.5;
  margin: 0;
}

@media (max-width: 900px) {
  .cf-tb-04-v4-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .cf-tb-04-v4-grid { grid-template-columns: 1fr; }
}
</style>

<div class="cf-tb-04-v4">
  <div class="cf-tb-04-v4-inner">
    <div class="cf-tb-04-v4-grid">
      {% for block in section.blocks %}
        <div class="cf-tb-04-v4-item">
          <div class="cf-tb-04-v4-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h4 class="cf-tb-04-v4-title">{{ block.settings.title }}</h4>
          <p class="cf-tb-04-v4-desc">{{ block.settings.desc }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Clinical Proof",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f8fafc"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#2563eb"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Scientifically Proven"},
        {"type":"text","id":"desc","label":"Description","default":"Tested in medical labs."}
      ]
    }
  ],
  "presets": [
    {
      "name": "04 · Clinical Proof Badges",
      "blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]
    }
  ]
}
{% endschema %}
