<style>
.cf-fc-03-v6 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-fc-03-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-03-v6-heading {
  font-size: clamp(28px, 4vw, 40px);
  color: {{ section.settings.accent_color }};
  text-transform: uppercase;
  margin: 0 0 40px 0;
  text-align: center;
  text-shadow: 0 0 10px {{ section.settings.accent_color }}80;
}

.cf-fc-03-v6-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 30px;
}

.cf-fc-03-v6-card {
  position: relative;
  text-decoration: none;
  background: #050505;
  padding: 20px;
  display: flex;
  flex-direction: column;
  transition: 0.3s;
  border: 1px solid #222;
}

/* Glowing Neon Frame on hover */
.cf-fc-03-v6-card::before {
  content: '';
  position: absolute;
  top: -1px; left: -1px; right: -1px; bottom: -1px;
  border: 1px solid {{ section.settings.accent_color }};
  box-shadow: 0 0 15px {{ section.settings.accent_color }}80;
  opacity: 0;
  transition: 0.3s;
  pointer-events: none;
}

.cf-fc-03-v6-card:hover::before {
  opacity: 1;
}

.cf-fc-03-v6-img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1;
  background: #111;
  margin-bottom: 20px;
  overflow: hidden;
  border-bottom: 2px solid #222;
  transition: 0.3s;
}

.cf-fc-03-v6-card:hover .cf-fc-03-v6-img-wrap {
  border-color: {{ section.settings.accent_color }};
}

.cf-fc-03-v6-img {
  width: 100%; height: 100%; object-fit: cover;
  opacity: 0.8;
  filter: contrast(1.2) grayscale(0.2);
  transition: 0.3s;
}

.cf-fc-03-v6-card:hover .cf-fc-03-v6-img {
  opacity: 1;
  filter: contrast(1) grayscale(0);
  transform: scale(1.05);
}

.cf-fc-03-v6-title {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 700;
  text-transform: uppercase;
  margin: 0 0 10px 0;
  line-height: 1.2;
}

.cf-fc-03-v6-price {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  opacity: 0.8;
  margin-top: auto;
}

.cf-fc-03-v6-add {
  display: block;
  text-align: center;
  background: transparent;
  color: {{ section.settings.accent_color }};
  border: 1px solid {{ section.settings.accent_color }};
  padding: 10px;
  font-size: 14px;
  font-weight: 700;
  margin-top: 15px;
  text-transform: uppercase;
  transition: 0.3s;
}

.cf-fc-03-v6-add:hover {
  background: {{ section.settings.accent_color }};
  color: #000;
  box-shadow: 0 0 10px {{ section.settings.accent_color }}80;
}
</style>

<div class="cf-fc-03-v6">
  <div class="cf-fc-03-v6-inner">
    <h2 class="cf-fc-03-v6-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-fc-03-v6-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <div class="cf-fc-03-v6-card">
            <a href="{{ product.url }}" style="text-decoration: none; flex: 1; display:flex; flex-direction:column;">
              <div class="cf-fc-03-v6-img-wrap">
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="cf-fc-03-v6-img">
              </div>
              <h3 class="cf-fc-03-v6-title">{{ product.title }}</h3>
              <div class="cf-fc-03-v6-price">{{ product.price | money }}</div>
            </a>
            <a href="{{ product.url }}" class="cf-fc-03-v6-add">VIEW</a>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="cf-fc-03-v6-card">
            <a href="#" style="text-decoration: none; flex: 1; display:flex; flex-direction:column;">
              <div class="cf-fc-03-v6-img-wrap">
                <div style="width:100%; height:100%; background:#222;"></div>
              </div>
              <h3 class="cf-fc-03-v6-title">Neon Graphics Core {{ i }}</h3>
              <div class="cf-fc-03-v6-price">$399.00</div>
            </a>
            <a href="#" class="cf-fc-03-v6-add">VIEW</a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Neon Frame Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW_ARRIVALS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Neon Outline Color",
      "default": "#eab308"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "06 · Neon Frame Collectio"
    }
  ]
}
{% endschema %}
