<style>
.cf-cat-13-v7{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;text-align:center}
.cf-cat-13-v7-inner{max-width:1400px;margin:0 auto}
.cf-cat-13-v7-title{font-size:clamp(32px, 5vw, 64px);font-weight:400;font-style:italic;margin:0 0 60px 0;letter-spacing:0.02em}
.cf-cat-13-v7-grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:40px}
.cf-cat-13-v7-item{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:inherit}
.cf-cat-13-v7-img-wrap{width:100%;aspect-ratio:1/2;border-radius:200px;overflow:hidden;margin-bottom:25px;background:#e0e0e0;position:relative}
.cf-cat-13-v7-img{width:100%;height:100%;object-fit:cover;transition:0.6s}
.cf-cat-13-v7-item:hover .cf-cat-13-v7-img{transform:scale(1.05);filter:brightness(0.9)}
.cf-cat-13-v7-label{font-family:sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.1em;margin-bottom:10px}
.cf-cat-13-v7-desc{font-size:14px;font-style:italic;opacity:0.7;margin:0}
@media(max-width:1024px){
  .cf-cat-13-v7-grid{grid-template-columns:repeat(2, 1fr);row-gap:60px}
  .cf-cat-13-v7-img-wrap{aspect-ratio:2/3;border-radius:100px}
}
@media(max-width:600px){
  .cf-cat-13-v7-grid{grid-template-columns:1fr;row-gap:40px}
  .cf-cat-13-v7-img-wrap{aspect-ratio:3/4;border-radius:150px;width:80%}
}
</style>

<div class="cf-cat-13-v7">
  <div class="cf-cat-13-v7-inner">
    <h2 class="cf-cat-13-v7-title">{{ section.settings.title }}</h2>
    
    <div class="cf-cat-13-v7-grid">
      <a href="#" class="cf-cat-13-v7-item">
        <div class="cf-cat-13-v7-img-wrap">
          <div class="cf-cat-13-v7-img" style="background:#444;"></div>
        </div>
        <div class="cf-cat-13-v7-label">Menswear</div>
        <div class="cf-cat-13-v7-desc">Collection 04</div>
      </a>
      <a href="#" class="cf-cat-13-v7-item" style="margin-top:40px;">
        <div class="cf-cat-13-v7-img-wrap">
          <div class="cf-cat-13-v7-img" style="background:#555;"></div>
        </div>
        <div class="cf-cat-13-v7-label">Womenswear</div>
        <div class="cf-cat-13-v7-desc">Collection 04</div>
      </a>
      <a href="#" class="cf-cat-13-v7-item">
        <div class="cf-cat-13-v7-img-wrap">
          <div class="cf-cat-13-v7-img" style="background:#666;"></div>
        </div>
        <div class="cf-cat-13-v7-label">Footwear</div>
        <div class="cf-cat-13-v7-desc">Permanent Collection</div>
      </a>
      <a href="#" class="cf-cat-13-v7-item" style="margin-top:40px;">
        <div class="cf-cat-13-v7-img-wrap">
          <div class="cf-cat-13-v7-img" style="background:#777;"></div>
        </div>
        <div class="cf-cat-13-v7-label">Objects</div>
        <div class="cf-cat-13-v7-desc">Home & Lifestyle</div>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Category (v7)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Categories"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Brand Category (v7)"}]
}
{% endschema %}
