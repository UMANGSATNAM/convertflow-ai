<style>
.cf-tr-02{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif;overflow:hidden}
.cf-tr-02-inner{max-width:1400px;margin:0 auto;display:flex;justify-content:center;gap:15px;flex-wrap:wrap}
.cf-tr-02-item{background:#111;border:2px solid {{ section.settings.border_color }};padding:15px 30px;transform:skewX(-10deg);display:flex;align-items:center;gap:15px;box-shadow:4px 4px 0 {{ section.settings.border_color }};transition:0.2s}
.cf-tr-02-item:hover{background:{{ section.settings.border_color }};box-shadow:0 0 0 #000;transform:skewX(-10deg) translate(4px, 4px)}
.cf-tr-02-icon{color:{{ section.settings.card_text }};transform:skewX(10deg)}
.cf-tr-02-item:hover .cf-tr-02-icon{color:{{ section.settings.bg_color }}}
.cf-tr-02-text{transform:skewX(10deg)}
.cf-tr-02-title{font-size:16px;font-weight:900;text-transform:uppercase;color:{{ section.settings.card_text }};margin-bottom:2px}
.cf-tr-02-item:hover .cf-tr-02-title{color:{{ section.settings.bg_color }}}
.cf-tr-02-desc{font-size:12px;color:rgba(255,255,255,0.6);font-weight:700;text-transform:uppercase}
.cf-tr-02-item:hover .cf-tr-02-desc{color:rgba(0,0,0,0.8)}
@media(max-width:768px){.cf-tr-02-inner{flex-direction:column;align-items:stretch}.cf-tr-02-item{transform:none}.cf-tr-02-icon,.cf-tr-02-text{transform:none}}
</style>

<div class="cf-tr-02">
  <div class="cf-tr-02-inner">
    {% for block in section.blocks %}
    <div class="cf-tr-02-item">
      <div class="cf-tr-02-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <div class="cf-tr-02-text">
         <div class="cf-tr-02-title">{{ block.settings.title }}</div>
         <div class="cf-tr-02-desc">{{ block.settings.desc }}</div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "02 · Streetwear Trust",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#000000"},
    {"type":"color","id":"card_text","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"border_color","label":"Accent / Border","default":"#eab308"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":40}
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust Item",
      "limit": 4,
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"100% Legit"},
        {"type":"text","id":"desc","label":"Description","default":"Verified Auth"}
      ]
    }
  ],
  "presets": [
    {
      "name": "02 · Streetwear Trust",
      "blocks": [
        {"type":"trust","settings":{"title":"Worldwide Shipping","desc":"Fast & Tracked"}},
        {"type":"trust","settings":{"title":"100% Authentic","desc":"Verified Goods"}},
        {"type":"trust","settings":{"title":"Secure Checkout","desc":"Apple Pay / Card"}}
      ]
    }
  ]
}
{% endschema %}
