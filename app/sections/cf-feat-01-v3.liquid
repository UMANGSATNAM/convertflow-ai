<style>
.cf-feat-01-v3{width:100%;padding:{{ section.settings.padding_y }}px 0;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-feat-01-v3-header{text-align:center;margin-bottom:60px}
.cf-feat-01-v3-title{font-size:clamp(32px, 5vw, 56px);font-weight:400;margin:0;letter-spacing:0.02em}
.cf-feat-01-v3-track{display:flex;gap:20px;padding:0 40px 40px 40px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.cf-feat-01-v3-track::-webkit-scrollbar{display:none}
.cf-feat-01-v3-card{flex:0 0 350px;scroll-snap-align:start;text-decoration:none;color:inherit;position:relative}
.cf-feat-01-v3-img-wrap{width:100%;aspect-ratio:3/4;background:{{ section.settings.card_bg }};margin-bottom:20px;overflow:hidden;}
.cf-feat-01-v3-img{width:100%;height:100%;object-fit:cover;transition:0.8s ease}
.cf-feat-01-v3-card:hover .cf-feat-01-v3-img{transform:scale(1.05)}
.cf-feat-01-v3-info{display:flex;justify-content:space-between;align-items:flex-end}
.cf-feat-01-v3-name{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;margin:0}
.cf-feat-01-v3-price{font-size:14px;color:{{ section.settings.accent_color }}}
@media(max-width:768px){
  .cf-feat-01-v3-card{flex:0 0 280px}
}
</style>

<div class="cf-feat-01-v3">
  <div class="cf-feat-01-v3-header">
    <h2 class="cf-feat-01-v3-title">{{ section.settings.title }}</h2>
  </div>
  <div class="cf-feat-01-v3-track">
    {% for i in (1..8) %}
      <a href="#" class="cf-feat-01-v3-card">
        <div class="cf-feat-01-v3-img-wrap">
           <div class="cf-feat-01-v3-img" style="background:#e5e5e5;"></div>
        </div>
        <div class="cf-feat-01-v3-info">
          <h4 class="cf-feat-01-v3-name">New Arrival Item 0{{ i }}</h4>
          <span class="cf-feat-01-v3-price">$2,100</span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Featured (v3)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"Latest Arrivals"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"card_bg","label":"Product Background","default":"#F0EEEA"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Price Color","default":"#777777"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Featured (v3)"}]
}
{% endschema %}
