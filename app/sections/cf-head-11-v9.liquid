<style>
.cf-h-11-v9{width:100%;font-family:sans-serif;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:15px 30px;display:flex;flex-direction:column;gap:15px;border-bottom:3px solid {{ section.settings.text_color }}}
.cf-h-11-v9-top{display:flex;justify-content:space-between;align-items:center}
.cf-h-11-v9-brand{display:flex;align-items:center;gap:15px}
.cf-h-11-v9-logo{font-size:32px;font-weight:900;letter-spacing:-0.03em;text-transform:uppercase;text-decoration:none;color:inherit;line-height:1}
.cf-h-11-v9-tag{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};padding:4px 8px;font-size:10px;font-weight:800;letter-spacing:0.1em;border-radius:2px}
.cf-h-11-v9-icons{display:flex;gap:15px}
.cf-h-11-v9-icon{width:40px;height:40px;border:2px solid {{ section.settings.text_color }};display:flex;align-items:center;justify-content:center;color:inherit;text-decoration:none;transition:0.2s}
.cf-h-11-v9-icon:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-h-11-v9-bottom{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none}
.cf-h-11-v9-bottom::-webkit-scrollbar{display:none}
.cf-h-11-v9-link{white-space:nowrap;padding:10px 20px;border:1px solid {{ section.settings.text_color }};color:inherit;text-decoration:none;font-size:13px;font-weight:700;text-transform:uppercase;transition:0.2s;border-radius:30px}
.cf-h-11-v9-link:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
@media(max-width:600px){.cf-h-11-v9{padding:15px}.cf-h-11-v9-tag{display:none}}
</style>

<div class="cf-h-11-v9">
  <div class="cf-h-11-v9-top">
    <div class="cf-h-11-v9-brand">
      <a href="/" class="cf-h-11-v9-logo">{{ section.settings.logo_text }}</a>
      <span class="cf-h-11-v9-tag">{{ section.settings.tag_text }}</span>
    </div>
    <div class="cf-h-11-v9-icons">
      <a href="/search" class="cf-h-11-v9-icon" aria-label="Search">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="/cart" class="cf-h-11-v9-icon" aria-label="Cart">
         <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </a>
    </div>
  </div>
  
  <div class="cf-h-11-v9-bottom">
    {% for link in linklists[section.settings.menu].links limit:8 %}
      <a href="{{ link.url }}" class="cf-h-11-v9-link">{{ link.title }}</a>
    {% else %}
      <a href="#" class="cf-h-11-v9-link">All Products</a>
      <a href="#" class="cf-h-11-v9-link">T-Shirts</a>
      <a href="#" class="cf-h-11-v9-link">Hoodies</a>
      <a href="#" class="cf-h-11-v9-link">Bottoms</a>
      <a href="#" class="cf-h-11-v9-link">Accessories</a>
      <a href="#" class="cf-h-11-v9-link">Sale</a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Header (v9)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"UTIL"},
    {"type":"text","id":"tag_text","label":"Tag Text","default":"EST. 2026"},
    {"type":"link_list","id":"menu","label":"Pill Navigation"},
    {"type":"color","id":"bg_color","label":"Background","default":"#DFDFDF"},
    {"type":"color","id":"text_color","label":"Text & Accent Color","default":"#161616"}
  ],
  "presets": [{"name":"11 · Men's Header (v9)"}]
}
{% endschema %}
