<style>
.cf-ps-02-v9 {
  width: 100%;
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  display: flex;
  justify-content: center;
}

.cf-ps-02-v9-inner {
  max-width: 900px;
  width: 100%;
  position: relative;
  background: {{ section.settings.border_color }};
  padding: 8px; /* Thickness of the ticker border */
  display: flex;
  flex-direction: column;
}

.cf-ps-02-v9-ticker-wrap {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  overflow: hidden;
  z-index: 1;
}

.cf-ps-02-v9-ticker {
  background: {{ section.settings.accent_color }};
  color: {{ section.settings.border_color }};
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-weight: bold;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  white-space: nowrap;
  display: flex;
}

.cf-ps-02-v9-ticker.top {
  position: absolute; top: 0; left: 0; width: 100%; height: 8px;
  align-items: center;
}
.cf-ps-02-v9-ticker.bottom {
  position: absolute; bottom: 0; left: 0; width: 100%; height: 8px;
  align-items: center;
}

.cf-ps-02-v9-track-1 { animation: cf-ps-02-v9-scroll-1 10s linear infinite; display: flex; }
.cf-ps-02-v9-track-2 { animation: cf-ps-02-v9-scroll-2 10s linear infinite reverse; display: flex; }

@keyframes cf-ps-02-v9-scroll-1 { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes cf-ps-02-v9-scroll-2 { from { transform: translateX(-50%); } to { transform: translateX(0); } }

.cf-ps-02-v9-content {
  background: {{ section.settings.box_bg }};
  position: relative;
  z-index: 10;
  padding: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
}

.cf-ps-02-v9-title {
  font-size: clamp(24px, 5vw, {{ section.settings.title_size }}px);
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  letter-spacing: -0.02em;
  margin-bottom: 20px;
}

.cf-ps-02-v9-btn {
  background: {{ section.settings.text_color }};
  color: {{ section.settings.box_bg }};
  padding: 12px 32px;
  font-weight: 900;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 14px;
  letter-spacing: 0.1em;
  transition: opacity 0.2s;
}

.cf-ps-02-v9-btn:hover {
  opacity: 0.8;
}

@media (min-width: 768px) {
  .cf-ps-02-v9-content {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
    padding: 40px 60px;
  }
  .cf-ps-02-v9-title {
    margin-bottom: 0;
  }
}
</style>

<div class="cf-ps-02-v9">
  <div class="cf-ps-02-v9-inner">
    
    <div class="cf-ps-02-v9-ticker-wrap">
      <div class="cf-ps-02-v9-ticker top">
        <div class="cf-ps-02-v9-track-1">
          {% assign items = (1..10) %}
          {% for i in items %}<span>{{ section.settings.ticker_text }} &nbsp; </span>{% endfor %}
        </div>
      </div>
      <div class="cf-ps-02-v9-ticker bottom">
        <div class="cf-ps-02-v9-track-2">
          {% assign items = (1..10) %}
          {% for i in items %}<span>{{ section.settings.ticker_text }} &nbsp; </span>{% endfor %}
        </div>
      </div>
    </div>

    <div class="cf-ps-02-v9-content">
      <h3 class="cf-ps-02-v9-title">{{ section.settings.title }}</h3>
      <a href="{{ section.settings.btn_link }}" class="cf-ps-02-v9-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "09 · Ticker Border Snack",
  "settings": [
    {"type":"text","id":"ticker_text","label":"Ticker Text","default":"LIMTED EDITION // DO NOT RE-SELL //"},
    {"type":"text","id":"title","label":"Title","default":"THE COLLAB IS LIVE"},
    {"type":"range","id":"title_size","label":"Title Size","min":20,"max":64,"step":2,"default":32},
    {"type":"text","id":"btn_label","label":"Button Label","default":"BUY NOW"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#F1F1F1"},
    {"type":"color","id":"box_bg","label":"Inner Box Base","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Ticker Accent Color","default":"#eab308"},
    {"type":"color","id":"border_color","label":"Border/Text (Ticker text)","default":"#000000"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"09 · Ticker Border Snack"}]
}
{% endschema %}
