<style>
.cf-marquee-01-v6{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0}
.cf-marquee-01-v6-track{display:flex;white-space:nowrap;animation:cf-marquee-01-v6-scroll {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v6-item{display:inline-flex;align-items:center;padding:0 80px}
.cf-marquee-01-v6-text{font-family:serif;font-size:clamp(40px, 6vw, 84px);font-weight:400;letter-spacing:0.02em;text-transform:uppercase;background:linear-gradient(to right, #BF953F, #FCF6BA, #B38728, #FBF5B7, #AA771C);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
@keyframes cf-marquee-01-v6-scroll{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-01-v6">
  <div class="cf-marquee-01-v6-track">
    {% for j in (1..3) %}
      {% for i in (1..3) %}
        <div class="cf-marquee-01-v6-item">
          <span class="cf-marquee-01-v6-text">{{ section.settings.text }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v6)",
  "settings": [
    {"type":"text","id":"text","label":"Marquee Text","default":"LIMITED EDITION"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":60},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#080808"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v6)"}]
}
{% endschema %}
