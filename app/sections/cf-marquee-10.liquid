<style>
.cf-mq-10{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;transform:skewY(-2deg);margin:20px 0;position:relative;z-index:10}
.cf-mq-10-wrap{display:flex;white-space:nowrap;animation:cf-mq-10-s {{ section.settings.speed }}s linear infinite}
.cf-mq-10-item{font-family:sans-serif;color:{{ section.settings.text_color }};font-size:{{ section.settings.text_size }}px;font-weight:900;text-transform:uppercase;font-style:italic;padding:0 30px;display:flex;align-items:center;gap:30px}
.cf-mq-10-t1{color:{{ section.settings.text_color }}}
.cf-mq-10-t2{color:{{ section.settings.accent_color }}}
@keyframes cf-mq-10-s{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>
<div class="cf-mq-10">
  <div class="cf-mq-10-wrap">
    {% assign reps = (1..15) %}
    {% for i in reps %}
      <div class="cf-mq-10-item">
        <span class="cf-mq-10-t1">{{ section.settings.text1 }}</span>
        <span class="cf-mq-10-t2">{{ section.settings.text2 }}</span>
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "10 · Fitness Marquee",
  "settings": [
    {"type":"text","id":"text1","label":"Text 1","default":"PUSH YOUR LIMITS"},
    {"type":"text","id":"text2","label":"Text 2","default":"NO EXCUSES"},
    {"type":"color","id":"bg_color","label":"Background","default":"#dc2626"},
    {"type":"color","id":"text_color","label":"Text Color 1","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Text Color 2","default":"#000000"},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":5,"max":40,"step":1,"default":15},
    {"type":"range","id":"text_size","label":"Text Size","min":16,"max":64,"step":2,"default":32},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":20}
  ],
  "presets": [{"name":"10 · Fitness Marquee"}]
}
{% endschema %}
