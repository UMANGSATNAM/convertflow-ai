<style>
.cf-header-05-v6 {
  background-color: {{ section.settings.bg_color }};
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-header-05-v6-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 40px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
.cf-header-05-v6-logo {
  font-size: 24px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  display: flex;
  flex-direction: column;
  line-height: 1;
}
.cf-header-05-v6-logo-sub {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
}
.cf-header-05-v6-nav {
  display: flex;
  gap: 30px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v6-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: color 0.2s;
}
.cf-header-05-v6-nav a:hover { color: {{ section.settings.accent_color }}; }
.cf-header-05-v6-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}
.cf-header-05-v6-icon { color: {{ section.settings.text_color }}; cursor: pointer; }
.cf-header-05-v6-icon svg { width: 22px; height: 22px; stroke-width: 2; }
.cf-header-05-v6-btn {
  background: {{ section.settings.text_color }};
  color: {{ section.settings.bg_color }};
  text-decoration: none;
  padding: 8px 18px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  transition: opacity 0.2s;
}
.cf-header-05-v6-btn:hover { opacity: 0.8; }
.cf-header-05-v6-announcement {
  background: {{ section.settings.accent_color }};
  color: #fff;
  text-align: center;
  padding: 8px;
  font-size: 13px;
  font-weight: 600;
}
@media (max-width: 900px) {
  .cf-header-05-v6-nav { display: none; }
  .cf-header-05-v6-bar { padding: 15px 20px; }
}
</style>

<div class="cf-header-05-v6">
  {% if section.settings.top_text != blank %}
    <div class="cf-header-05-v6-announcement">{{ section.settings.top_text }}</div>
  {% endif %}
  <div class="cf-header-05-v6-bar">
    <a href="/" class="cf-header-05-v6-logo">
      {{ section.settings.logo_text }}
      {% if section.settings.logo_sub != blank %}<span class="cf-header-05-v6-logo-sub">{{ section.settings.logo_sub }}</span>{% endif %}
    </a>
    <nav>
      <ul class="cf-header-05-v6-nav">
        {% for block in section.blocks %}
          <li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="cf-header-05-v6-actions">
      <div class="cf-header-05-v6-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v6-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/></svg></div>
      <a href="{{ section.settings.btn_link }}" class="cf-header-05-v6-btn">{{ section.settings.btn_text }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Indie Brand",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#fffbf5"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#18181b"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#7c3aed"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"blossom"},
    {"type":"text","id":"logo_sub","label":"Logo Subtext","default":"beauty co."},
    {"type":"text","id":"top_text","label":"Announcement","default":"🌸 New Drop — Spring Bloom Collection"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Drop"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Makeup"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "06 · Indie Brand Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
