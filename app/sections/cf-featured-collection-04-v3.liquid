<style>
.cf-fc-04-v3 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Georgia', serif;
}

.cf-fc-04-v3-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-04-v3-header {
  text-align: center;
  margin-bottom: 60px;
}

.cf-fc-04-v3-title {
  color: {{ section.settings.text_color }};
  font-size: 46px;
  font-style: italic;
  font-weight: normal;
  margin: 0 0 15px 0;
}

.cf-fc-04-v3-subtitle {
  color: {{ section.settings.text_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 15px;
  opacity: 0.7;
}

.cf-fc-04-v3-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 40px;
}

.cf-fc-04-v3-card {
  text-decoration: none;
  display: block;
  text-align: center;
}

.cf-fc-04-v3-image-wrap {
  width: 100%;
  padding-bottom: 130%;
  border-radius: 200px 200px 0 0;
  background: #F4EFEB;
  position: relative;
  overflow: hidden;
  margin-bottom: 25px;
}

.cf-fc-04-v3-image-wrap img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.6s ease;
}

.cf-fc-04-v3-card:hover .cf-fc-04-v3-image-wrap img {
  transform: scale(1.03);
}

.cf-fc-04-v3-badge {
  position: absolute;
  top: 20px; left: 50%;
  transform: translateX(-50%);
  background: {{ section.settings.brand_color }};
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 4px 12px;
  border-radius: 30px;
}

.cf-fc-04-v3-name {
  color: {{ section.settings.text_color }};
  font-size: 20px;
  margin: 0 0 10px 0;
}

.cf-fc-04-v3-price {
  color: {{ section.settings.text_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 14px;
  opacity: 0.7;
}

.cf-fc-04-v3-footer {
  text-align: center;
  margin-top: 60px;
}

.cf-fc-04-v3-btn {
  display: inline-block;
  border: 1px solid {{ section.settings.brand_color }};
  color: {{ section.settings.brand_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  text-decoration: none;
  padding: 14px 40px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border-radius: 40px;
  transition: all 0.3s;
}

.cf-fc-04-v3-btn:hover {
  background: {{ section.settings.brand_color }};
  color: #fff;
}

@media (max-width: 900px) {
  .cf-fc-04-v3-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}
@media (max-width: 600px) {
  .cf-fc-04-v3-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .cf-fc-04-v3-title { font-size: 36px; }
}
</style>

<div class="cf-fc-04-v3">
  <div class="cf-fc-04-v3-inner">
    <div class="cf-fc-04-v3-header">
      <h2 class="cf-fc-04-v3-title">{{ section.settings.title }}</h2>
      <p class="cf-fc-04-v3-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="cf-fc-04-v3-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.url }}" class="cf-fc-04-v3-card">
          <div class="cf-fc-04-v3-image-wrap">
            {% if block.settings.badge != blank %}
              <div class="cf-fc-04-v3-badge">{{ block.settings.badge }}</div>
            {% endif %}
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#999;position:absolute;">Image</div>
            {% endif %}
          </div>
          <h3 class="cf-fc-04-v3-name">{{ block.settings.title }}</h3>
          <div class="cf-fc-04-v3-price">{{ block.settings.price }}</div>
        </a>
      {% endfor %}
    </div>

    <div class="cf-fc-04-v3-footer">
      <a href="{{ section.settings.btn_link }}" class="cf-fc-04-v3-btn">{{ section.settings.btn_text }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Organic Flow Products",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4A4A4A"},
    {"type":"color","id":"brand_color","label":"Brand Accent Color","default":"#A3B18A"},
    {"type":"text","id":"title","label":"Title","default":"Our Best Sellers"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Loved by our community."},
    {"type":"text","id":"btn_text","label":"Button Name","default":"Discover All"},
    {"type":"url","id":"btn_link","label":"Link"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":3},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1100}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Product Title","default":"Ashwagandha Root"},
        {"type":"text","id":"price","label":"Price","default":"$34.00"},
        {"type":"text","id":"badge","label":"Badge (Optional)","default":"Organic"},
        {"type":"url","id":"url","label":"Product Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "03 · Organic Flow Products",
      "blocks": [{"type":"product"},{"type":"product"},{"type":"product"}]
    }
  ]
}
{% endschema %}
