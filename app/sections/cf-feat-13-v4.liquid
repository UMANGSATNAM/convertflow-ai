<style>
.cf-feat-13-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif}
.cf-feat-13-v4-inner{max-width:1400px;margin:0 auto;position:relative}
.cf-feat-13-v4-header{text-align:center;margin-bottom:100px}
.cf-feat-13-v4-sub{font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:{{ section.settings.accent_color }};display:block;margin-bottom:20px}
.cf-feat-13-v4-title{font-size:clamp(40px, 8vw, 100px);font-weight:900;text-transform:uppercase;letter-spacing:-0.03em;line-height:0.9;margin:0}
.cf-feat-13-v4-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;position:relative}
.cf-feat-13-v4-card{text-decoration:none;color:inherit;display:block;max-width:500px}
.cf-feat-13-v4-img-wrap{width:100%;aspect-ratio:3/4;overflow:hidden;background:#ebebeb;margin-bottom:30px;transition:0.6s}
.cf-feat-13-v4-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-feat-13-v4-card:hover .cf-feat-13-v4-img-wrap{transform:translateY(-10px);box-shadow:0 30px 60px rgba(0,0,0,0.1)}
.cf-feat-13-v4-card:hover .cf-feat-13-v4-img{transform:scale(1.05)}
.cf-feat-13-v4-name{font-size:24px;font-weight:800;text-transform:uppercase;margin:0 0 10px 0;letter-spacing:-0.01em}
.cf-feat-13-v4-price{font-size:16px;opacity:0.7}
.cf-feat-13-v4-card-1{justify-self:start}
.cf-feat-13-v4-card-2{justify-self:end;margin-top:200px}
.cf-feat-13-v4-btn-wrap{text-align:center;margin-top:100px}
.cf-feat-13-v4-btn{display:inline-block;padding:18px 50px;font-size:12px;font-weight:800;letter-spacing:0.15em;text-transform:uppercase;color:{{ section.settings.text_color }};border:2px solid {{ section.settings.text_color }};text-decoration:none;transition:0.3s}
.cf-feat-13-v4-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
@media(max-width:900px){
  .cf-feat-13-v4-grid{grid-template-columns:1fr;gap:80px}
  .cf-feat-13-v4-card-2{margin-top:0;justify-self:start}
  .cf-feat-13-v4-card{max-width:100%}
  .cf-feat-13-v4-header{margin-bottom:60px}
}
</style>

<div class="cf-feat-13-v4">
  <div class="cf-feat-13-v4-inner">
    <div class="cf-feat-13-v4-header">
      <span class="cf-feat-13-v4-sub">{{ section.settings.subtitle }}</span>
      <h2 class="cf-feat-13-v4-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="cf-feat-13-v4-grid">
      <a href="#" class="cf-feat-13-v4-card cf-feat-13-v4-card-1">
        <div class="cf-feat-13-v4-img-wrap">
          <div class="cf-feat-13-v4-img" style="background:#555;"></div>
        </div>
        <h3 class="cf-feat-13-v4-name">Key Piece 01</h3>
        <div class="cf-feat-13-v4-price">$450</div>
      </a>
      
      <a href="#" class="cf-feat-13-v4-card cf-feat-13-v4-card-2">
        <div class="cf-feat-13-v4-img-wrap">
          <div class="cf-feat-13-v4-img" style="background:#666;"></div>
        </div>
        <h3 class="cf-feat-13-v4-name">Key Piece 02</h3>
        <div class="cf-feat-13-v4-price">$380</div>
      </a>
    </div>
    
    <div class="cf-feat-13-v4-btn-wrap">
      <a href="{{ section.settings.btn_link }}" class="cf-feat-13-v4-btn">{{ section.settings.btn_text }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Featured (v4)",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"SPOTLIGHT"},
    {"type":"text","id":"title","label":"Header Title","default":"THE HEAVYWEIGHTS"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Discover More"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#F4ECE4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#1A1A1A"},
    {"type":"color","id":"accent_color","label":"Accent Subtitle","default":"#888888"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Featured (v4)"}]
}
{% endschema %}
