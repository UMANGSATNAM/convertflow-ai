<style>
.cf-header-12-v6{width:100%;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 20px;}
.cf-header-12-v6-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid {{ section.settings.border_color }};padding-bottom:15px}
.cf-header-12-v6-left{flex:1;display:flex;gap:15px}
.cf-header-12-v6-icon{color:{{ section.settings.text_color }};cursor:pointer;opacity:0.8;transition:0.3s}
.cf-header-12-v6-icon:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-header-12-v6-logo{flex:0 0 auto;text-decoration:none;text-align:center}
.cf-header-12-v6-logo img{max-height:{{ section.settings.logo_height }}px;height:auto}
.cf-header-12-v6-logo h1{font-size:36px;font-weight:400;margin:0;letter-spacing:0.08em;text-transform:uppercase}
.cf-header-12-v6-right{flex:1;display:flex;justify-content:flex-end;gap:15px}
.cf-header-12-v6-nav-row{display:flex;justify-content:center;gap:40px;padding-top:20px}
.cf-header-12-v6-link{font-size:12px;color:{{ section.settings.text_color }};text-decoration:none;text-transform:uppercase;letter-spacing:0.2em;transition:0.3s;font-family:sans-serif}
.cf-header-12-v6-link:hover{color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-header-12-v6-nav-row{display:none}}
</style>

<div class="cf-header-12-v6">
  <div class="cf-header-12-v6-inner">
    <div class="cf-header-12-v6-left">
      <div class="cf-header-12-v6-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <div class="cf-header-12-v6-icon" style="display:none;" id="mobile-menu-v6">
         <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </div>
    </div>
    
    <a href="/" class="cf-header-12-v6-logo">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% else %}
        <h1>{{ section.settings.logo_text }}</h1>
      {% endif %}
    </a>
    
    <div class="cf-header-12-v6-right">
      <div class="cf-header-12-v6-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      <div class="cf-header-12-v6-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </div>
    </div>
  </div>
  
  <div class="cf-header-12-v6-nav-row">
    {% for link in linklists[section.settings.menu].links %}
      <a href="{{ link.url }}" class="cf-header-12-v6-link">{{ link.title }}</a>
    {% else %}
      <a href="#" class="cf-header-12-v6-link">Designers</a>
      <a href="#" class="cf-header-12-v6-link">Clothing</a>
      <a href="#" class="cf-header-12-v6-link">Shoes</a>
      <a href="#" class="cf-header-12-v6-link">Bags</a>
      <a href="#" class="cf-header-12-v6-link">Accessories</a>
      <a href="#" class="cf-header-12-v6-link">Beauty</a>
    {% endfor %}
  </div>
</div>

<script>
  if(window.innerWidth <= 900) {
    document.getElementById('mobile-menu-v6').style.display = 'block';
  }
</script>

{% schema %}
{
  "name": "12 · Women's Header (v6)",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo Image"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"MAISON"},
    {"type":"range","id":"logo_height","label":"Logo Height","min":20,"max":100,"step":5,"default":35},
    {"type":"link_list","id":"menu","label":"Main Menu"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#999999"},
    {"type":"color","id":"border_color","label":"Divider Border","default":"#EEEEEE"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":50,"step":2,"default":20}
  ],
  "presets": [{"name":"12 · Women's Header (v6)"}]
}
{% endschema %}
