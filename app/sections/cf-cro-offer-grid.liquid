<style>
.cf-cro-og{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-og-inner{max-width:1200px;margin:0 auto}
.cf-cro-og-head{text-align:center;margin-bottom:40px}
.cf-cro-og-tag{display:inline-block;background:{{ section.settings.accent_color }};color:#fff;padding:6px 16px;border-radius:100px;font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:16px}
.cf-cro-og h2{font-size:clamp(24px,3vw,40px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-og-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-cro-og-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.cf-cro-og-card{background:#fff;border:2px solid {{ section.settings.text_color }}10;border-radius:16px;padding:32px 24px;text-align:center;position:relative;overflow:hidden;transition:all 0.3s}
.cf-cro-og-card:hover{border-color:{{ section.settings.accent_color }};transform:translateY(-4px);box-shadow:0 12px 40px {{ section.settings.accent_color }}15}
.cf-cro-og-card.popular{border-color:{{ section.settings.accent_color }};box-shadow:0 8px 30px {{ section.settings.accent_color }}15}
.cf-cro-og-pop{position:absolute;top:0;left:0;right:0;background:{{ section.settings.accent_color }};color:#fff;font-size:12px;font-weight:700;padding:6px;text-transform:uppercase;letter-spacing:0.08em}
.cf-cro-og-qty{font-size:48px;font-weight:900;color:{{ section.settings.accent_color }};line-height:1;margin:20px 0 8px}
.cf-cro-og-name{font-size:18px;font-weight:700;color:{{ section.settings.text_color }};margin-bottom:16px}
.cf-cro-og-price{display:flex;align-items:baseline;justify-content:center;gap:8px;margin-bottom:4px}
.cf-cro-og-price b{font-size:28px;color:{{ section.settings.text_color }}}
.cf-cro-og-price s{font-size:16px;color:{{ section.settings.text_color }};opacity:0.4}
.cf-cro-og-each{font-size:13px;color:{{ section.settings.accent_color }};font-weight:600;margin-bottom:20px}
.cf-cro-og-save{display:inline-block;background:{{ section.settings.accent_color }}15;color:{{ section.settings.accent_color }};padding:4px 12px;border-radius:8px;font-size:13px;font-weight:700;margin-bottom:20px}
.cf-cro-og-btn{display:block;width:100%;padding:14px;background:{{ section.settings.accent_color }};color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;transition:0.2s;text-decoration:none;text-align:center}
.cf-cro-og-btn:hover{opacity:0.9;transform:scale(1.02)}
@media(max-width:768px){.cf-cro-og-grid{grid-template-columns:1fr}}
</style>

<div class="cf-cro-og">
  <div class="cf-cro-og-inner">
    <div class="cf-cro-og-head">
      <div class="cf-cro-og-tag">{{ section.settings.tag }}</div>
      <h2>{{ section.settings.heading }}</h2>
      <p class="cf-cro-og-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="cf-cro-og-grid">
      <div class="cf-cro-og-card">
        <div class="cf-cro-og-qty">1</div>
        <div class="cf-cro-og-name">{{ section.settings.product_name }}</div>
        <div class="cf-cro-og-price"><b>{{ section.settings.price_1 }}</b><s>{{ section.settings.orig_1 }}</s></div>
        <div class="cf-cro-og-each">{{ section.settings.each_1 }}</div>
        <a href="{{ section.settings.cta_link }}" class="cf-cro-og-btn">{{ section.settings.cta_text }}</a>
      </div>
      <div class="cf-cro-og-card popular">
        <div class="cf-cro-og-pop">⭐ MOST POPULAR</div>
        <div class="cf-cro-og-qty">2</div>
        <div class="cf-cro-og-name">{{ section.settings.product_name }}</div>
        <div class="cf-cro-og-price"><b>{{ section.settings.price_2 }}</b><s>{{ section.settings.orig_2 }}</s></div>
        <div class="cf-cro-og-each">{{ section.settings.each_2 }}</div>
        <div class="cf-cro-og-save">Save {{ section.settings.save_2 }}</div>
        <a href="{{ section.settings.cta_link }}" class="cf-cro-og-btn">{{ section.settings.cta_text }}</a>
      </div>
      <div class="cf-cro-og-card">
        <div class="cf-cro-og-qty">3</div>
        <div class="cf-cro-og-name">{{ section.settings.product_name }}</div>
        <div class="cf-cro-og-price"><b>{{ section.settings.price_3 }}</b><s>{{ section.settings.orig_3 }}</s></div>
        <div class="cf-cro-og-each">{{ section.settings.each_3 }}</div>
        <div class="cf-cro-og-save">Save {{ section.settings.save_3 }} — BEST VALUE</div>
        <a href="{{ section.settings.cta_link }}" class="cf-cro-og-btn">{{ section.settings.cta_text }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Buy More Save More",
  "settings": [
    {"type":"text","id":"tag","label":"Tag Line","default":"<svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\'><path d=\'M8.5 14.5A2.5 2.5 0 0 0 11 12c-2.2 0-4-1.8-4-4a8 8 0 0 1 12 6.5 6 6 0 1 1-12 0\'/></svg> LIMITED TIME OFFER"},
    {"type":"text","id":"heading","label":"Heading","default":"Buy More, Save More"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Stock up and save big — offers end tonight!"},
    {"type":"text","id":"product_name","label":"Product Name","default":"Premium Bundle Pack"},
    {"type":"text","id":"price_1","label":"1-Pack Price","default":"$47.99"},
    {"type":"text","id":"orig_1","label":"1-Pack Original","default":"$79.99"},
    {"type":"text","id":"each_1","label":"1-Pack Per Unit","default":"$47.99 each"},
    {"type":"text","id":"price_2","label":"2-Pack Price","default":"$84.99"},
    {"type":"text","id":"orig_2","label":"2-Pack Original","default":"$159.98"},
    {"type":"text","id":"each_2","label":"2-Pack Per Unit","default":"$42.50 each"},
    {"type":"text","id":"save_2","label":"2-Pack Savings","default":"47%"},
    {"type":"text","id":"price_3","label":"3-Pack Price","default":"$114.99"},
    {"type":"text","id":"orig_3","label":"3-Pack Original","default":"$239.97"},
    {"type":"text","id":"each_3","label":"3-Pack Per Unit","default":"$38.33 each"},
    {"type":"text","id":"save_3","label":"3-Pack Savings","default":"52%"},
    {"type":"text","id":"cta_text","label":"CTA Text","default":"Add to Cart"},
    {"type":"text","id":"cta_link","label":"CTA Link","default":"/cart"},
    {"type":"color","id":"bg_color","label":"Background","default":"#f8f9fa"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#E53E3E"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Buy More Save More"}]
}
{% endschema %}
