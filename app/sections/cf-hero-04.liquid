<style>
.cf-hero-04{width:100%;min-height:{{ section.settings.height }}px;display:flex;align-items:center;background:{{ section.settings.bg_color }};overflow:hidden;position:relative}
.cf-hero-04::before{content:'';position:absolute;top:-50%;right:-20%;width:600px;height:600px;border-radius:50%;background:{{ section.settings.accent_color }};opacity:0.08;z-index:0}
.cf-hero-04::after{content:'';position:absolute;bottom:-30%;left:-10%;width:400px;height:400px;border-radius:50%;background:{{ section.settings.accent_color }};opacity:0.05;z-index:0}
.cf-hero-04-inner{position:relative;z-index:1;width:100%;max-width:1200px;margin:0 auto;padding:80px 40px;display:flex;align-items:center;gap:60px}
.cf-hero-04-text{flex:1}
.cf-hero-04-eyebrow{font-size:13px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:{{ section.settings.accent_color }};margin-bottom:20px;display:flex;align-items:center;gap:8px}
.cf-hero-04-eyebrow::before{content:'';width:32px;height:2px;background:{{ section.settings.accent_color }}}
.cf-hero-04 h1{font-size:clamp(32px,4.5vw,{{ section.settings.heading_size }}px);font-weight:800;line-height:1.05;color:{{ section.settings.heading_color }};margin:0 0 24px;letter-spacing:-0.03em}
.cf-hero-04 p{font-size:17px;line-height:1.7;color:{{ section.settings.text_color }};margin:0 0 40px;max-width:480px}
.cf-hero-04-stats{display:flex;gap:40px;margin-top:48px;padding-top:32px;border-top:1px solid rgba(0,0,0,0.08)}
.cf-hero-04-stat h3{font-size:28px;font-weight:800;color:{{ section.settings.heading_color }};margin:0}
.cf-hero-04-stat span{font-size:13px;color:{{ section.settings.text_color }};opacity:0.7}
.cf-hero-04-visual{flex:1;position:relative;display:flex;justify-content:center}
.cf-hero-04-card{width:320px;height:420px;border-radius:16px;overflow:hidden;position:relative;box-shadow:0 20px 60px rgba(0,0,0,0.15)}
.cf-hero-04-card img{width:100%;height:100%;object-fit:cover}
.cf-hero-04-btn{display:inline-flex;padding:14px 32px;border-radius:8px;font-size:15px;font-weight:600;background:{{ section.settings.accent_color }};color:#fff;text-decoration:none;border:none;cursor:pointer;transition:0.2s}
.cf-hero-04-btn:hover{opacity:0.9;transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,0.15)}
@media(max-width:768px){.cf-hero-04-inner{flex-direction:column;padding:40px 24px}.cf-hero-04-stats{gap:24px}.cf-hero-04-card{width:240px;height:320px}}
</style>

<section class="cf-hero-04">
  <div class="cf-hero-04-inner">
    <div class="cf-hero-04-text">
      <div class="cf-hero-04-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <a href="{{ section.settings.btn_link }}" class="cf-hero-04-btn">{{ section.settings.btn_text }}</a>
      <div class="cf-hero-04-stats">
        <div class="cf-hero-04-stat"><h3>{{ section.settings.stat1_val }}</h3><span>{{ section.settings.stat1_label }}</span></div>
        <div class="cf-hero-04-stat"><h3>{{ section.settings.stat2_val }}</h3><span>{{ section.settings.stat2_label }}</span></div>
        <div class="cf-hero-04-stat"><h3>{{ section.settings.stat3_val }}</h3><span>{{ section.settings.stat3_label }}</span></div>
      </div>
    </div>
    <div class="cf-hero-04-visual">
      <div class="cf-hero-04-card">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading }}" loading="eager">
        {% else %}
          <div style="width:100%;height:100%;background:linear-gradient(145deg,#f093fb 0%,#f5576c 100%)"></div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "04 · Stats Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow Text","default":"TRENDING NOW"},
    {"type":"text","id":"heading","label":"Heading","default":"Redefining Modern Fashion"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"From runway to everyday. Discover pieces that blend artisan craftsmanship with contemporary design."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Discover More"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"image_picker","id":"image","label":"Feature Image"},
    {"type":"text","id":"stat1_val","label":"Stat 1 Value","default":"25K+"},
    {"type":"text","id":"stat1_label","label":"Stat 1 Label","default":"Happy Customers"},
    {"type":"text","id":"stat2_val","label":"Stat 2 Value","default":"500+"},
    {"type":"text","id":"stat2_label","label":"Stat 2 Label","default":"Products"},
    {"type":"text","id":"stat3_val","label":"Stat 3 Value","default":"4.9★"},
    {"type":"text","id":"stat3_label","label":"Stat 3 Label","default":"Average Rating"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading Color","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#666666"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#6366f1"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":32,"max":72,"step":2,"default":50},
    {"type":"range","id":"height","label":"Min Height","min":400,"max":800,"step":50,"default":600}
  ],
  "presets": [{"name":"04 · Stats Hero"}]
}
{% endschema %}
