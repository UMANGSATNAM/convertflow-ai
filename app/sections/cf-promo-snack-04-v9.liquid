<style>
.cf-ps-04-v9 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  display: flex;
  justify-content: center;
}

.cf-ps-04-v9-inner {
  max-width: {{ section.settings.max_width }}px;
  background: #fff;
  border-radius: 8px;
  border: 1px dashed {{ section.settings.border_color }};
  padding: 12px 24px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.cf-ps-04-v9-icon {
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
  justify-content: center;
}

.cf-ps-04-v9-icon svg {
  width: 22px; height: 22px; stroke-width: 2;
}

.cf-ps-04-v9-text {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  font-weight: 600;
  margin: 0;
}

.cf-ps-04-v9-text strong {
  background: {{ section.settings.accent_color }};
  color: #fff;
  padding: 2px 8px;
  border-radius: 4px;
  margin: 0 4px;
}

@media (max-width: 600px) {
  .cf-ps-04-v9-inner { padding: 10px 15px; gap: 10px; flex-direction: column; text-align: center; }
  .cf-ps-04-v9-text { font-size: 13px; }
}
</style>

<div class="cf-ps-04-v9">
  <div class="cf-ps-04-v9-inner">
    <div class="cf-ps-04-v9-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="7" width="20" height="10" rx="5" ry="5"></rect><line x1="12" y1="7" x2="12" y2="17"></line></svg>
    </div>
    <p class="cf-ps-04-v9-text">
      {{ section.settings.text | replace: '[', '<strong>' | replace: ']', '</strong>' }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "09 · Supplements Snack",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Wrappper","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#18181b"},
    {"type":"color","id":"accent_color","label":"Highlight Color (Red)","default":"#ef4444"},
    {"type":"color","id":"border_color","label":"Dashed Border Color","default":"#d4d4d8"},
    {"type":"text","id":"text","label":"Text (use [brackets] to highlight pill)","default":"Subscribe to any multi and save [20%] on your first order."},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":400,"max":1200,"step":50,"default":750}
  ],
  "presets": [{"name":"09 · Supplements Snack"}]
}
{% endschema %}
