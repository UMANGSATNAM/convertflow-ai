<style>
.cf-pr-04{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif}
.cf-pr-04-inner{max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:stretch;border-radius:40px;overflow:hidden;box-shadow:0 20px 50px rgba(0,0,0,0.08);background:#fff}
.cf-pr-04-left{flex:1;min-width:300px;padding:80px 60px;display:flex;flex-direction:column;justify-content:center;background:{{ section.settings.card_bg }}}
.cf-pr-04-leaf{color:{{ section.settings.accent_color }};margin-bottom:20px}
.cf-pr-04-title{font-size:clamp(36px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};line-height:1.1;font-weight:700;margin-bottom:20px;letter-spacing:-0.03em}
.cf-pr-04-desc{font-size:17px;color:#475569;margin-bottom:40px;line-height:1.6}
.cf-pr-04-btn{display:inline-block;padding:16px 36px;background:{{ section.settings.accent_color }};color:#fff;border-radius:100px;text-decoration:none;font-weight:600;font-size:16px;transition:0.3s;text-align:center}
.cf-pr-04-btn:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(22, 163, 74, 0.2)}
.cf-pr-04-right{flex:1;min-width:300px;position:relative;background:#f8fafc}
.cf-pr-04-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;border-top-left-radius:50%;border-bottom-left-radius:50%}
@media(max-width:768px){.cf-pr-04-left{padding:40px 20px}.cf-pr-04-img{position:relative;height:300px;border-radius:0}}
</style>

<div class="cf-pr-04">
  <div class="cf-pr-04-inner">
    <div class="cf-pr-04-left">
      <div class="cf-pr-04-leaf">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
      </div>
      <h2 class="cf-pr-04-title">{{ section.settings.title }}</h2>
      <p class="cf-pr-04-desc">{{ section.settings.desc }}</p>
      <div><a href="{{ section.settings.btn_link }}" class="cf-pr-04-btn">{{ section.settings.btn_label }}</a></div>
    </div>
    <div class="cf-pr-04-right">
      {% if section.settings.image != blank %}
        <img class="cf-pr-04-img" src="{{ section.settings.image | image_url: width: 800 }}" alt="Promo">
      {% else %}
        <div class="cf-pr-04-img" style="background:#e2e8f0"></div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Health Promo",
  "settings": [
    {"type":"image_picker","id":"image","label":"Right Image"},
    {"type":"text","id":"title","label":"Title","default":"Pure. Natural. Effective."},
    {"type":"range","id":"title_size","label":"Title Size","min":32,"max":64,"step":2,"default":48},
    {"type":"textarea","id":"desc","label":"Description","default":"Give your body the nutrients it deserves with our 100% organic, locally sourced supplements."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"Shop Organic"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Outer Background","default":"#f8fafc"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Title Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent (Green)","default":"#16a34a"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":0,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"04 · Health Promo"}]
}
{% endschema %}
