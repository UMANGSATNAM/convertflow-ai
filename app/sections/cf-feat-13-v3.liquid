<style>
.cf-feat-13-v3{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif}
.cf-feat-13-v3-inner{max-width:1600px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.cf-feat-13-v3-poster{width:100%;height:100%;min-height:700px;background:#e0e0e0;position:relative;overflow:hidden}
.cf-feat-13-v3-poster-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover}
.cf-feat-13-v3-content{display:flex;flex-direction:column;justify-content:center;overflow:hidden}
.cf-feat-13-v3-title{font-size:clamp(40px, 5vw, 84px);font-weight:900;line-height:1;margin:0 0 40px 0;text-transform:uppercase;letter-spacing:-0.02em}
.cf-feat-13-v3-scroll{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:20px;scrollbar-width:none}
.cf-feat-13-v3-scroll::-webkit-scrollbar{display:none}
.cf-feat-13-v3-card{flex:0 0 300px;scroll-snap-align:start;text-decoration:none;color:inherit;position:relative}
.cf-feat-13-v3-img-wrap{width:100%;aspect-ratio:3/4;background:#f5f5f5;margin-bottom:15px;overflow:hidden}
.cf-feat-13-v3-img{width:100%;height:100%;object-fit:cover;transition:0.5s}
.cf-feat-13-v3-card:hover .cf-feat-13-v3-img{transform:scale(1.05)}
.cf-feat-13-v3-info{display:flex;justify-content:space-between;align-items:center}
.cf-feat-13-v3-name{font-size:13px;font-weight:700;text-transform:uppercase;margin:0;letter-spacing:0.05em}
.cf-feat-13-v3-price{font-size:13px;opacity:0.8}
.cf-feat-13-v3-add{display:inline-block;margin-top:40px;padding:15px 40px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};text-transform:uppercase;font-size:12px;font-weight:800;letter-spacing:0.1em;text-decoration:none;transition:0.3s}
.cf-feat-13-v3-add:hover{opacity:0.8}
@media(max-width:1024px){
  .cf-feat-13-v3-inner{grid-template-columns:1fr;gap:40px}
  .cf-feat-13-v3-poster{min-height:500px}
}
@media(max-width:600px){
  .cf-feat-13-v3-card{flex:0 0 240px}
}
</style>

<div class="cf-feat-13-v3">
  <div class="cf-feat-13-v3-inner">
    <div class="cf-feat-13-v3-poster">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="cf-feat-13-v3-poster-img">
      {% else %}
        <div class="cf-feat-13-v3-poster-img" style="background:#444;"></div>
      {% endif %}
    </div>
    
    <div class="cf-feat-13-v3-content">
      <h2 class="cf-feat-13-v3-title">{{ section.settings.title }}</h2>
      
      <div class="cf-feat-13-v3-scroll">
        {% for i in (1..5) %}
          <a href="#" class="cf-feat-13-v3-card">
            <div class="cf-feat-13-v3-img-wrap">
              <div class="cf-feat-13-v3-img" style="background:#ececec;"></div>
            </div>
            <div class="cf-feat-13-v3-info">
              <h3 class="cf-feat-13-v3-name">Garment 0{{ i }}</h3>
              <span class="cf-feat-13-v3-price">$350</span>
            </div>
          </a>
        {% endfor %}
      </div>
      
      <div>
        <a href="{{ section.settings.btn_link }}" class="cf-feat-13-v3-add">{{ section.settings.btn_text }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Featured (v3)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Poster Image"},
    {"type":"text","id":"title","label":"Header Title","default":"THE CAPSULE"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop All Pieces"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":100}
  ],
  "presets": [{"name":"13 · Featured (v3)"}]
}
{% endschema %}
