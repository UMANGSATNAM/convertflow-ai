<style>
.cf-cat-01-v8{width:100%;font-family:serif;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }}}
.cf-cat-01-v8-grid{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;width:100%;height:100vh;min-height:800px}
.cf-cat-01-v8-card{position:relative;display:flex;align-items:center;justify-content:center;text-decoration:none;color:inherit;background:{{ section.settings.base_color }};transition:0.4s;overflow:hidden}
.cf-cat-01-v8-card:nth-child(1){background:color-mix(in srgb, {{ section.settings.base_color }} 100%, black 0%)}
.cf-cat-01-v8-card:nth-child(2){background:color-mix(in srgb, {{ section.settings.base_color }} 80%, black 20%)}
.cf-cat-01-v8-card:nth-child(3){background:color-mix(in srgb, {{ section.settings.base_color }} 60%, black 40%)}
.cf-cat-01-v8-card:nth-child(4){background:color-mix(in srgb, {{ section.settings.base_color }} 40%, black 60%)}
.cf-cat-01-v8-bg-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.6s, transform 1s;mix-blend-mode:overlay}
.cf-cat-01-v8-card:hover .cf-cat-01-v8-bg-img{opacity:0.3;transform:scale(1.05)}
.cf-cat-01-v8-content{position:relative;z-index:2;text-align:center}
.cf-cat-01-v8-name{font-size:clamp(32px, 4vw, 56px);font-weight:400;margin:0 0 10px 0;letter-spacing:0.02em}
.cf-cat-01-v8-link{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;opacity:0.8;transition:0.3s}
.cf-cat-01-v8-card:hover .cf-cat-01-v8-link{opacity:1;letter-spacing:0.25em}
@media(max-width:768px){
  .cf-cat-01-v8-grid{grid-template-columns:1fr;grid-template-rows:repeat(4, 25vh)}
}
</style>

<div class="cf-cat-01-v8">
  <div class="cf-cat-01-v8-grid">
    {% for i in (1..4) %}
      <a href="#" class="cf-cat-01-v8-card">
        <div class="cf-cat-01-v8-bg-img" style="background:url('https://ui-avatars.com/api/?name={{ i }}&background=random') center/cover;"></div>
        <div class="cf-cat-01-v8-content">
          <h3 class="cf-cat-01-v8-name">Category {{ i }}</h3>
          <div class="cf-cat-01-v8-link">Shop Section</div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v8)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"base_color","label":"Base Monochromatic Color","default":"#C4A482"}
  ],
  "presets": [{"name":"01 · Luxury Category (v8)"}]
}
{% endschema %}
