<style>
.cf-promo-12-v5{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }}}
.cf-promo-12-v5-inner{max-width:1400px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center}
.cf-promo-12-v5-top{max-width:600px;margin-bottom:60px}
.cf-promo-12-v5-pre{font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.2em;color:{{ section.settings.accent_color }};display:block;margin-bottom:15px}
.cf-promo-12-v5-title{font-size:clamp(36px, 4vw, 56px);font-weight:400;margin:0 0 20px 0;line-height:1.2;font-style:italic}
.cf-promo-12-v5-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;width:100%}
.cf-promo-12-v5-img-wrap{position:relative;height:500px;overflow:hidden}
.cf-promo-12-v5-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-promo-12-v5-img-wrap:hover .cf-promo-12-v5-img{transform:scale(1.05)}
.cf-promo-12-v5-btn{display:inline-block;margin-top:40px;padding:15px 40px;border:1px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.2em;transition:0.3s}
.cf-promo-12-v5-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
@media(max-width:768px){.cf-promo-12-v5-grid{grid-template-columns:1fr}.cf-promo-12-v5-img-wrap{height:400px}}
</style>

<div class="cf-promo-12-v5">
  <div class="cf-promo-12-v5-inner">
    <div class="cf-promo-12-v5-top">
      <span class="cf-promo-12-v5-pre">{{ section.settings.subtitle }}</span>
      <h2 class="cf-promo-12-v5-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-promo-12-v5-btn" style="margin-top:0;">{{ section.settings.btn_label }}</a>
    </div>
    
    <div class="cf-promo-12-v5-grid">
      <div class="cf-promo-12-v5-img-wrap">
        {% if section.settings.img_1 %}
          <img src="{{ section.settings.img_1 | image_url: width: 800 }}" class="cf-promo-12-v5-img" alt="Promo Left">
        {% else %}
          <div style="background:#ddd;width:100%;height:100%"></div>
        {% endif %}
      </div>
      <div class="cf-promo-12-v5-img-wrap">
        {% if section.settings.img_2 %}
          <img src="{{ section.settings.img_2 | image_url: width: 800 }}" class="cf-promo-12-v5-img" alt="Promo Right">
        {% else %}
          <div style="background:#ccc;width:100%;height:100%"></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Promo (v5)",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"NEW ARRIVALS"},
    {"type":"textarea","id":"title","label":"Header Title","default":"A softer approach to modern tailoring."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"DISCOVER MORE"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    
    {"type":"image_picker","id":"img_1","label":"Left Image"},
    {"type":"image_picker","id":"img_2","label":"Right Image"},
    
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Subtitle Color","default":"#B59A7A"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":10,"default":80}
  ],
  "presets": [{"name":"12 · Women's Promo (v5)"}]
}
{% endschema %}
