<style>
.cf-h-11-v6{width:100%;font-family:sans-serif;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};border-bottom:2px solid {{ section.settings.text_color }}}
.cf-h-11-v6-inner{display:flex;height:{{ section.settings.height }}px}
.cf-h-11-v6-col{flex:1;display:flex;align-items:center;padding:0 30px;border-right:2px solid {{ section.settings.text_color }}}
.cf-h-11-v6-col:last-child{border-right:none}
.cf-h-11-v6-logo{font-size:24px;font-weight:900;letter-spacing:-0.05em;text-transform:uppercase;text-decoration:none;color:inherit}
.cf-h-11-v6-nav{display:flex;gap:30px;width:100%;justify-content:center}
.cf-h-11-v6-link{text-decoration:none;color:inherit;font-size:14px;font-weight:700;text-transform:uppercase;transition:0.2s}
.cf-h-11-v6-link:hover{color:{{ section.settings.accent_color }}}
.cf-h-11-v6-utils{display:flex;gap:30px;width:100%;justify-content:flex-end}
.cf-h-11-v6-icon{color:inherit;text-decoration:none;font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px;text-transform:uppercase}
.cf-h-11-v6-icon:hover{color:{{ section.settings.accent_color }}}
.cf-h-11-v6-mobile{display:none;background:none;border:none;color:inherit;cursor:pointer;padding:0;font-weight:800;font-size:14px;text-transform:uppercase}
@media(max-width:900px){.cf-h-11-v6-col:nth-child(2){display:none}.cf-h-11-v6-icon span{display:none}.cf-h-11-v6-mobile{display:flex;align-items:center;gap:8px}.cf-h-11-v6-utils{justify-content:space-between}}
</style>

<div class="cf-h-11-v6">
  <div class="cf-h-11-v6-inner">
    <div class="cf-h-11-v6-col" style="flex:0.5;">
      <a href="/" class="cf-h-11-v6-logo">{{ section.settings.logo_text }}</a>
    </div>
    
    <div class="cf-h-11-v6-col">
      <div class="cf-h-11-v6-nav">
        {% for link in linklists[section.settings.menu].links limit:4 %}
          <a href="{{ link.url }}" class="cf-h-11-v6-link">{{ link.title }}</a>
        {% else %}
          <a href="#" class="cf-h-11-v6-link">Shop</a>
          <a href="#" class="cf-h-11-v6-link">Collections</a>
          <a href="#" class="cf-h-11-v6-link">Editorial</a>
          <a href="#" class="cf-h-11-v6-link">About</a>
        {% endfor %}
      </div>
    </div>
    
    <div class="cf-h-11-v6-col" style="flex:0.5;">
      <div class="cf-h-11-v6-utils">
        <button class="cf-h-11-v6-mobile">MENU</button>
        <div style="display:flex;gap:20px;">
          <a href="/search" class="cf-h-11-v6-icon">
             <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
             <span>Search</span>
          </a>
          <a href="/cart" class="cf-h-11-v6-icon">
             <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
             <span>Cart [0]</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Header (v6)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"STRUCTURE"},
    {"type":"link_list","id":"menu","label":"Navigation Menu"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text & Border Color","default":"#000000"},
    {"type":"color","id":"accent_color","label":"Hover Color","default":"#8A8A8A"},
    {"type":"range","id":"height","label":"Height","min":60,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Header (v6)"}]
}
{% endschema %}
