<div class="cf-auto-fc-v9" style="background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="cf-auto-fc-v9-container" style="max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px dashed {{ section.settings.border_color }}; padding-bottom: 20px; margin-bottom: 40px;">
      <div>
        <h2 style="font-family: 'Rajdhani', sans-serif; font-size: {{ section.settings.title_size }}px; font-weight: 700; color: {{ section.settings.text_color }}; text-transform: uppercase; margin: 0 0 5px 0; letter-spacing: 1px;">
          {{ section.settings.title }}
        </h2>
        <div style="font-family: 'Inter', sans-serif; font-size: 14px; color: {{ section.settings.text_color }}; opacity: 0.6; text-transform: uppercase; letter-spacing: 2px;">
          // {{ section.settings.subtitle }} //
        </div>
      </div>
      
      {% if section.settings.show_btn %}
        <a href="{{ section.settings.btn_link }}" class="cf-btn-fc-v9" style="display: inline-block; background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; border: 1px solid {{ section.settings.text_color }}; padding: 10px 20px; font-family: 'Rajdhani', sans-serif; font-size: 16px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; transition: all 0.2s;">
          {{ section.settings.btn_text }}
        </a>
      {% endif %}
    </div>

    <!-- Rugged Off-Road Card Grid -->
    <div class="cf-auto-fc-v9-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: 20px;">
      
      {% for i in (1..section.settings.products) %}
        {% capture img %}product_img_{{i}}{% endcapture %}
        {% capture title %}product_title_{{i}}{% endcapture %}
        {% capture price %}product_price_{{i}}{% endcapture %}
        {% capture is_rugged %}product_rugged_{{i}}{% endcapture %}
        {% capture link %}product_link_{{i}}{% endcapture %}

        <div class="cf-auto-fc-v9-card" style="background: {{ section.settings.card_bg }}; padding: 20px; border: 1px solid {{ section.settings.border_color }}; position: relative; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s;">
          
          <!-- Industrial corner accents -->
          <div style="position: absolute; top: 5px; left: 5px; width: 6px; height: 6px; border-radius: 50%; background: {{ section.settings.border_color }};"></div>
          <div style="position: absolute; top: 5px; right: 5px; width: 6px; height: 6px; border-radius: 50%; background: {{ section.settings.border_color }};"></div>
          <div style="position: absolute; bottom: 5px; left: 5px; width: 6px; height: 6px; border-radius: 50%; background: {{ section.settings.border_color }};"></div>
          <div style="position: absolute; bottom: 5px; right: 5px; width: 6px; height: 6px; border-radius: 50%; background: {{ section.settings.border_color }};"></div>

          <a href="{{ section.settings[link] | default: '#' }}" style="display: block; position: relative; padding-top: 80%; background: #eaeaea; margin-bottom: 20px; border: 1px solid {{ section.settings.border_color }}; overflow: hidden;">
            {% if section.settings[img] %}
              <img src="{{ section.settings[img] | image_url: width: 500 }}" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s;" class="cf-img-v9" alt="{{ section.settings[title] }}">
            {% endif %}
            
            {% if section.settings[is_rugged] %}
              <div style="position: absolute; top: 10px; left: -25px; background: {{ section.settings.accent_color }}; color: #fff; font-family: 'Rajdhani', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; padding: 2px 30px; transform: rotate(-45deg); letter-spacing: 1px;">
                RUGGED
              </div>
            {% endif %}
          </a>

          <div style="flex: 1; display: flex; flex-direction: column;">
            <a href="{{ section.settings[link] | default: '#' }}" style="text-decoration: none; color: inherit; flex: 1;">
              <h3 style="font-family: 'Rajdhani', sans-serif; font-size: 20px; font-weight: 700; color: {{ section.settings.text_color }}; margin: 0 0 10px 0; text-transform: uppercase; line-height: 1.1;">
                {{ section.settings[title] | default: 'Off-Road Part' }}
              </h3>
            </a>
            
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 15px; border-top: 1px dashed {{ section.settings.border_color }};">
              <span style="font-family: 'Rajdhani', sans-serif; font-size: 24px; font-weight: 700; color: {{ section.settings.accent_color }};">
                {{ section.settings[price] | default: '$250.00' }}
              </span>
              <button style="background: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }}; border: none; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background 0.2s;" class="cf-btn-add-v9">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </button>
            </div>
          </div>

        </div>
      {% endfor %}

    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Inter:wght@400;600&display=swap');
  
  .cf-btn-fc-v9:hover { background: {{ section.settings.text_color }} !important; color: {{ section.settings.bg_color }} !important; }
  .cf-auto-fc-v9-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); border-color: {{ section.settings.accent_color }}; }
  .cf-auto-fc-v9-card:hover .cf-img-v9 { transform: scale(1.05); }
  .cf-btn-add-v9:hover { background: {{ section.settings.accent_color }} !important; color: #fff !important; }

  @media (max-width: 1024px) {
    .cf-auto-fc-v9-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 768px) {
    .cf-auto-fc-v9-container > div:first-child { flex-direction: column; gap: 15px; align-items: flex-start; }
    .cf-auto-fc-v9-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 480px) {
    .cf-auto-fc-v9-grid { grid-template-columns: 1fr !important; }
  }
</style>

