<style>
.cf-fc-03-v9 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-fc-03-v9-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-03-v9-heading {
  font-size: clamp(28px, 4vw, 40px);
  color: {{ section.settings.text_color }};
  margin: 0 0 40px 0;
  text-align: center;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.cf-fc-03-v9-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 30px;
}

.cf-fc-03-v9-card {
  text-decoration: none;
  background: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  transition: 0.3s;
  border: 1px solid #eaeaea;
}

.cf-fc-03-v9-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 30px rgba(0,0,0,0.1);
}

.cf-fc-03-v9-img-wrap {
  width: 100%;
  aspect-ratio: 1/1;
  background: #f9fafb;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.cf-fc-03-v9-img {
  width: 100%; height: 100%;
  object-fit: contain;
  transition: 0.5s;
}

.cf-fc-03-v9-card:hover .cf-fc-03-v9-img {
  transform: scale(1.05);
}

.cf-fc-03-v9-content {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.cf-fc-03-v9-title {
  color: {{ section.settings.text_color }};
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 10px 0;
  line-height: 1.3;
}

.cf-fc-03-v9-price {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 500;
  opacity: 0.8;
  margin-top: auto;
}

.cf-fc-03-v9-btn {
  margin-top: 20px;
  background: {{ section.settings.text_color }};
  color: #fff;
  text-align: center;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  transition: 0.2s;
}

.cf-fc-03-v9-card:hover .cf-fc-03-v9-btn {
  background: {{ section.settings.accent_color }};
}
</style>

<div class="cf-fc-03-v9">
  <div class="cf-fc-03-v9-inner">
    <h2 class="cf-fc-03-v9-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-fc-03-v9-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="cf-fc-03-v9-card">
            <div class="cf-fc-03-v9-img-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="cf-fc-03-v9-img">
            </div>
            <div class="cf-fc-03-v9-content">
              <h3 class="cf-fc-03-v9-title">{{ product.title }}</h3>
              <div class="cf-fc-03-v9-price">{{ product.price | money }}</div>
              <div class="cf-fc-03-v9-btn">Buy Now</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <a href="#" class="cf-fc-03-v9-card">
            <div class="cf-fc-03-v9-img-wrap">
              <!-- Placeholder -->
              <div style="width:100px; height:100px; background:#ddd; border-radius:10px;"></div>
            </div>
            <div class="cf-fc-03-v9-content">
              <h3 class="cf-fc-03-v9-title">Minimalist Device {{ i }}</h3>
              <div class="cf-fc-03-v9-price">$299.00</div>
              <div class="cf-fc-03-v9-btn">Buy Now</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "09 · Clean Matte Shelf",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Latest Innovations"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":12,"step":1,"default":4},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#f9fafb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#2563eb"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "presets": [{"name":"09 · Clean Matte Collection"}]
}
{% endschema %}
