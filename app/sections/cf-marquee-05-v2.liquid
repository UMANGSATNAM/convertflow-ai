<style>
.cf-mq-05 { overflow: hidden; background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 0; }
.cf-mq-05-track-wrap { display: flex; position: relative; }
.cf-mq-05-track {
  display: flex;
  gap: 0;
  animation: mq05scroll {{ section.settings.speed }}s linear infinite;
  white-space: nowrap;
}
.cf-mq-05-track:hover { animation-play-state: paused; }
@keyframes mq05scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
.cf-mq-05-item {
  display: inline-flex;
  align-items: center;
  gap: 15px;
  padding: 0 40px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
}
.cf-mq-05-sep {
  color: {{ section.settings.accent_color }};
  font-size: {{ section.settings.font_size | times: 1.2 }}px;
}
</style>

<div class="cf-mq-05">
  <div class="cf-mq-05-track-wrap">
    <div class="cf-mq-05-track">
      {% assign items = section.blocks %}
      {% for i in (1..4) %}
        {% for block in items %}
          <span class="cf-mq-05-item">
            {{ block.settings.text }}
            <span class="cf-mq-05-sep">{{ section.settings.separator }}</span>
          </span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Beauty Marquees",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#fce7f3"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#831843"},
    {"type":"color","id":"accent_color","label":"Separator Color","default":"#ec4899"},
    {"type":"text","id":"separator","label":"Separator","default":"✦"},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":28,"step":1,"default":16},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":14},
    {"type":"range","id":"speed","label":"Scroll Speed (seconds)","min":10,"max":80,"step":5,"default":30}
  ],
  "blocks": [
    {"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Glam All Day"}]}
  ],
  "presets": [{"name": "02 · Glam Influencer Marquee","blocks": [{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
