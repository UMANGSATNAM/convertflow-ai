<div class="cf-auto-fc-v10" style="background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="cf-auto-fc-v10-container" style="max-width: 1400px; margin: 0 auto; display: flex; gap: 40px; align-items: stretch;">
    
    <!-- Thin Vertical Title Track -->
    <div style="flex: 0 0 80px; background: {{ section.settings.accent_color }}; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;">
      <div style="transform: rotate(-90deg); white-space: nowrap; font-family: 'Oswald', sans-serif; font-size: 40px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 5px;">
        {{ section.settings.title }}
      </div>
      <!-- Track lines -->
      <div style="position: absolute; top: 0; left: 10px; bottom: 0; width: 2px; background: rgba(255,255,255,0.2);"></div>
      <div style="position: absolute; top: 0; right: 10px; bottom: 0; width: 2px; background: rgba(255,255,255,0.2);"></div>
    </div>

    <!-- Main Grid Area -->
    <div style="flex: 1; display: flex; flex-direction: column;">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px;">
        <p style="font-family: 'Inter', sans-serif; font-size: 16px; color: {{ section.settings.text_color }}; margin: 0; max-width: 500px;">
          {{ section.settings.subtitle }}
        </p>
        {% if section.settings.show_btn %}
          <a href="{{ section.settings.btn_link }}" class="cf-btn-fc-v10" style="font-family: 'Oswald', sans-serif; font-size: 14px; font-weight: 500; text-transform: uppercase; color: {{ section.settings.text_color }}; text-decoration: none; border-bottom: 2px solid {{ section.settings.accent_color }}; padding-bottom: 5px; letter-spacing: 1px; transition: color 0.2s;">
            {{ section.settings.btn_text }} &rarr;
          </a>
        {% endif %}
      </div>

      <div class="cf-auto-fc-v10-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: 2px; background: {{ section.settings.border_color }}; border: 2px solid {{ section.settings.border_color }};">
        
        {% for i in (1..section.settings.products) %}
          {% capture img %}product_img_{{i}}{% endcapture %}
          {% capture title %}product_title_{{i}}{% endcapture %}
          {% capture price %}product_price_{{i}}{% endcapture %}
          {% capture badge %}product_badge_{{i}}{% endcapture %}
          {% capture link %}product_link_{{i}}{% endcapture %}

          <div class="cf-auto-fc-v10-card" style="background: {{ section.settings.card_bg }}; padding: 30px; display: flex; flex-direction: column; position: relative; transition: background 0.3s;">
            
            {% if section.settings[badge] != blank %}
              <div style="position: absolute; top: 20px; left: 20px; font-family: 'Oswald', sans-serif; font-size: 10px; font-weight: 500; text-transform: uppercase; background: #111; color: #fff; padding: 4px 8px; letter-spacing: 1px; z-index: 2;">
                {{ section.settings[badge] }}
              </div>
            {% endif %}

            <a href="{{ section.settings[link] | default: '#' }}" style="display: block; width: 100%; height: 200px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px; text-decoration: none;">
              {% if section.settings[img] %}
                <img src="{{ section.settings[img] | image_url: width: 400 }}" style="max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; filter: grayscale(20%); transition: filter 0.3s, transform 0.4s;" class="cf-img-v10" alt="{{ section.settings[title] }}">
              {% else %}
                 <div style="width: 100%; height: 100%; background: #eaeaea;"></div>
              {% endif %}
            </a>

            <div style="margin-top: auto;">
              <a href="{{ section.settings[link] | default: '#' }}" style="text-decoration: none; color: inherit;">
                <h3 style="font-family: 'Inter', sans-serif; font-size: 18px; font-weight: 700; color: {{ section.settings.text_color }}; margin: 0 0 10px 0; line-height: 1.3;">
                  {{ section.settings[title] | default: 'Precision Auto Part' }}
                </h3>
              </a>
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <span style="font-family: 'Oswald', sans-serif; font-size: 22px; font-weight: 500; color: {{ section.settings.text_color }};">
                  {{ section.settings[price] | default: '$320.00' }}
                </span>
                
                <button class="cf-btn-add-v10" style="background: transparent; color: {{ section.settings.text_color }}; border: 1px solid {{ section.settings.border_color }}; width: 35px; height: 35px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
              </div>
            </div>

          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;700&display=swap');
  
  .cf-btn-fc-v10:hover { color: {{ section.settings.accent_color }} !important; }
  .cf-auto-fc-v10-card:hover { background: #fafafa; }
  .cf-auto-fc-v10-card:hover .cf-img-v10 { filter: grayscale(0%); transform: translateY(-5px); }
  .cf-auto-fc-v10-card:hover .cf-btn-add-v10 { background: {{ section.settings.text_color }}; color: {{ section.settings.card_bg }}; border-color: {{ section.settings.text_color }}; }

  @media (max-width: 1024px) {
    .cf-auto-fc-v10-grid { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 768px) {
    .cf-auto-fc-v10-container { flex-direction: column; gap: 20px; }
    .cf-auto-fc-v10-container > div:first-child { flex: none; height: 60px; width: 100%; }
    .cf-auto-fc-v10-container > div:first-child > div:first-child { transform: rotate(0deg); font-size: 24px; letter-spacing: 2px; }
    .cf-auto-fc-v10-container > div:first-child > div:not(:first-child) { display: none; }
    .cf-auto-fc-v10-grid { grid-template-columns: 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "06 · Track Line Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Track Color",
      "default": "#0047cc"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Grid Lines",
      "default": "#f0f0f0"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Vertical Target Word",
      "default": "ESSENTIALS"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Hand-picked components to keep your vehicle running at peak efficiency."
    },
    {
      "type": "checkbox",
      "id": "show_btn",
      "label": "Show Top Button",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP ALL"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "products",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Number of Products",
      "default": 6
    },
    { "type": "header", "content": "Product 1" },
    { "type": "image_picker", "id": "product_img_1", "label": "Image" },
    { "type": "text", "id": "product_title_1", "label": "Title", "default": "Performance Oil Filter" },
    { "type": "text", "id": "product_price_1", "label": "Price", "default": "$24.99" },
    { "type": "text", "id": "product_badge_1", "label": "Badge", "default": "BEST SELLER" },
    { "type": "url", "id": "product_link_1", "label": "Link" },
    { "type": "header", "content": "Product 2" },
    { "type": "image_picker", "id": "product_img_2", "label": "Image" },
    { "type": "text", "id": "product_title_2", "label": "Title", "default": "Synthetic Motor Oil 5W-30" },
    { "type": "text", "id": "product_price_2", "label": "Price", "default": "$45.00" },
    { "type": "text", "id": "product_badge_2", "label": "Badge" },
    { "type": "url", "id": "product_link_2", "label": "Link" },
    { "type": "header", "content": "Product 3" },
    { "type": "image_picker", "id": "product_img_3", "label": "Image" },
    { "type": "text", "id": "product_title_3", "label": "Title", "default": "Iridium Spark Plugs Set" },
    { "type": "text", "id": "product_price_3", "label": "Price", "default": "$60.00" },
    { "type": "text", "id": "product_badge_3", "label": "Badge", "default": "SALE" },
    { "type": "url", "id": "product_link_3", "label": "Link" },
    { "type": "header", "content": "Product 4" },
    { "type": "image_picker", "id": "product_img_4", "label": "Image" },
    { "type": "text", "id": "product_title_4", "label": "Title", "default": "Ceramic Brake Pads" },
    { "type": "text", "id": "product_price_4", "label": "Price", "default": "$85.00" },
    { "type": "text", "id": "product_badge_4", "label": "Badge" },
    { "type": "url", "id": "product_link_4", "label": "Link" },
    { "type": "header", "content": "Product 5" },
    { "type": "image_picker", "id": "product_img_5", "label": "Image" },
    { "type": "text", "id": "product_title_5", "label": "Title", "default": "Heavy Duty Battery" },
    { "type": "text", "id": "product_price_5", "label": "Price", "default": "$180.00" },
    { "type": "text", "id": "product_badge_5", "label": "Badge" },
    { "type": "url", "id": "product_link_5", "label": "Link" },
    { "type": "header", "content": "Product 6" },
    { "type": "image_picker", "id": "product_img_6", "label": "Image" },
    { "type": "text", "id": "product_title_6", "label": "Title", "default": "Wiper Blades Pair" },
    { "type": "text", "id": "product_price_6", "label": "Price", "default": "$35.00" },
    { "type": "text", "id": "product_badge_6", "label": "Badge" },
    { "type": "url", "id": "product_link_6", "label": "Link" }
  ]
}
