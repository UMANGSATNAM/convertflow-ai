<style>
.cf-pr-03-v3 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  overflow: hidden;
}

.cf-pr-03-v3-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex;
  position: relative;
  background: #000;
  border: 1px solid {{ section.settings.accent_color }};
  box-shadow: 15px 15px 0 {{ section.settings.accent_color }};
}

.cf-pr-03-v3-img-container {
  width: 100%;
  aspect-ratio: 16/9;
  position: relative;
}

.cf-pr-03-v3-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.7;
}

.cf-pr-03-v3-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: linear-gradient(90deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40px;
}

.cf-pr-03-v3-label {
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 14px;
  color: {{ section.settings.accent_color }};
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 20px;
  display: inline-block;
  background: rgba(0,255,255,0.1);
  padding: 4px 12px;
  border-left: 4px solid {{ section.settings.accent_color }};
}

.cf-pr-03-v3-heading {
  font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
  font-weight: 900;
  color: {{ section.settings.text_color }};
  margin: 0 0 20px 0;
  line-height: 1.1;
  text-transform: uppercase;
  /* Basic offset text-shadow */
  text-shadow: 2px 2px 0 #ff003c, -2px -2px 0 #0ff;
  font-family: 'Impact', 'Arial Black', sans-serif;
}

.cf-pr-03-v3-desc {
  font-size: 16px;
  color: {{ section.settings.text_color }};
  max-width: 500px;
  line-height: 1.6;
  margin: 0 0 30px 0;
  font-family: ui-monospace, SFMono-Regular, monospace;
}

.cf-pr-03-v3-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: {{ section.settings.accent_color }};
  color: #000;
  font-weight: 900;
  font-size: 16px;
  text-transform: uppercase;
  text-decoration: none;
  padding: 16px 32px;
  clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
  transition: 0.3s;
  align-self: flex-start;
  font-family: ui-monospace, SFMono-Regular, monospace;
}

.cf-pr-03-v3-btn:hover {
  background: #fff;
  color: #000;
  box-shadow: 0 0 20px #fff;
}

@media (min-width: 768px) {
  .cf-pr-03-v3-overlay {
    padding: 60px;
  }
}
</style>

<div class="cf-pr-03-v3">
  <div class="cf-pr-03-v3-inner">
    <div class="cf-pr-03-v3-img-container">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="Promo Image" class="cf-pr-03-v3-img">
      {% else %}
        <div class="cf-pr-03-v3-img" style="background:#111;"></div>
      {% endif %}
    </div>
    <div class="cf-pr-03-v3-overlay">
      <div class="cf-pr-03-v3-label">{{ section.settings.label }}</div>
      <h2 class="cf-pr-03-v3-heading">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="cf-pr-03-v3-desc">{{ section.settings.subheading }}</p>
      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url }}" class="cf-pr-03-v3-btn">{{ section.settings.link_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Cyber Deck Billboard",
  "settings": [
    {"type":"text","id":"label","label":"Small Label","default":"SYS.OVERRIDE"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"textarea","id":"heading","label":"Heading","default":"CYBER\nMONDAY\nDEALS"},
    {"type":"range","id":"title_size","label":"Title Size","min":32,"max":100,"step":2,"default":80},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Up to 50% off select tech accessories and modular drops."},
    {"type":"text","id":"link_text","label":"Link Text","default":"SHOP THE DROP"},
    {"type":"url","id":"link_url","label":"Link URL"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Cyan Accent","default":"#00ffff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "presets": [{"name":"03 · Cyber Deck Billboard"}]
}
{% endschema %}
