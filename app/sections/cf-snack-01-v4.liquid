<style>
.cf-snack-01-v4{width:100%;border-top:1px solid {{ section.settings.border_color }};border-bottom:1px solid {{ section.settings.border_color }};background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;display:flex}
.cf-snack-01-v4-left{flex:1;padding:40px 60px;display:flex;align-items:center;justify-content:flex-end;border-right:1px solid {{ section.settings.border_color }}}
.cf-snack-01-v4-right{flex:1;padding:40px 60px;display:flex;align-items:center;justify-content:flex-start}
.cf-snack-01-v4-title{font-size:clamp(24px, 3vw, 36px);font-weight:400;margin:0;letter-spacing:0.02em}
.cf-snack-01-v4-title span{font-style:italic}
.cf-snack-01-v4-btn{display:inline-block;padding-bottom:5px;border-bottom:1px solid {{ section.settings.text_color }};font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:inherit;transition:0.3s}
.cf-snack-01-v4-btn:hover{color:{{ section.settings.accent_color }};border-bottom-color:{{ section.settings.accent_color }}}
@media(max-width:768px){
  .cf-snack-01-v4{flex-direction:column}
  .cf-snack-01-v4-left{border-right:none;border-bottom:1px solid {{ section.settings.border_color }};justify-content:center;text-align:center;padding:30px 20px}
  .cf-snack-01-v4-right{justify-content:center;padding:30px 20px}
}
</style>

<div class="cf-snack-01-v4">
  <div class="cf-snack-01-v4-left">
    <h3 class="cf-snack-01-v4-title">{{ section.settings.title }}</h3>
  </div>
  <div class="cf-snack-01-v4-right">
    <a href="{{ section.settings.btn_link }}" class="cf-snack-01-v4-btn">{{ section.settings.btn_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Snack (v4)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title (use <span> for italic)","default":"Discover the <span>New Essentials</span>"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Explore The Collection"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#A38971"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#E2DFD8"}
  ],
  "presets": [{"name":"01 · Luxury Snack (v4)"}]
}
{% endschema %}
