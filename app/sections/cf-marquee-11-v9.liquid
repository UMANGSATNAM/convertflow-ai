<style>
.cf-mq-11-v9{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;display:flex;flex-direction:column;gap:10px}
.cf-mq-11-v9-track-1{display:flex;white-space:nowrap;animation:cf-mq-11-v9-scroll-left {{ section.settings.speed }}s linear infinite}
.cf-mq-11-v9-track-2{display:flex;white-space:nowrap;animation:cf-mq-11-v9-scroll-right {{ section.settings.speed }}s linear infinite}
.cf-mq-11-v9-item{display:inline-flex;align-items:center;padding:0 20px;font-family:sans-serif;font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};font-weight:700;letter-spacing:0.04em;text-transform:uppercase}
.cf-mq-11-v9-item.outline{color:transparent;-webkit-text-stroke:1px {{ section.settings.text_color }}}
@keyframes cf-mq-11-v9-scroll-left{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
@keyframes cf-mq-11-v9-scroll-right{0%{transform:translateX(-50%)}100%{transform:translateX(0)}}
</style>

<div class="cf-mq-11-v9">
  <div class="cf-mq-11-v9-track-1">
    {% for i in (1..8) %}
      <div class="cf-mq-11-v9-item">{{ section.settings.text_line_1 }}</div>
    {% endfor %}
  </div>
  <div class="cf-mq-11-v9-track-2">
    {% for i in (1..8) %}
      <div class="cf-mq-11-v9-item outline">{{ section.settings.text_line_2 }}</div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Marquee (v9)",
  "settings": [
    {"type":"text","id":"text_line_1","label":"Line 1 Text","default":"MENS FALL PREVIEW"},
    {"type":"text","id":"text_line_2","label":"Line 2 Text","default":"MENS FALL PREVIEW"},
    {"type":"range","id":"text_size","label":"Text Size","min":20,"max":100,"step":2,"default":40},
    {"type":"color","id":"bg_color","label":"Background","default":"#E8E8E8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":60,"step":5,"default":20},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":100,"step":5,"default":40}
  ],
  "presets": [{"name":"11 · Men's Marquee (v9)"}]
}
{% endschema %}
