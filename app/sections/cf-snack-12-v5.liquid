<style>
.cf-snack-12-v5{position:fixed;bottom:30px;left:30px;z-index:99;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:10px;border-radius:8px;box-shadow:0 15px 40px rgba(0,0,0,0.15);font-family:sans-serif;display:flex;align-items:center;gap:15px;max-width:350px}
.cf-snack-12-v5-img{width:60px;height:80px;object-fit:cover;border-radius:4px}
.cf-snack-12-v5-content{flex:1;padding-right:10px}
.cf-snack-12-v5-tag{font-size:9px;text-transform:uppercase;letter-spacing:0.1em;color:{{ section.settings.accent_color }};font-weight:700;margin-bottom:5px;display:block}
.cf-snack-12-v5-title{font-size:14px;font-family:serif;font-style:italic;margin:0 0 8px 0;line-height:1.2}
.cf-snack-12-v5-copy{width:100%;text-align:left;background:none;border:none;padding:0;color:{{ section.settings.text_color }};font-family:sans-serif;font-size:11px;font-weight:600;text-decoration:underline;cursor:pointer;text-underline-offset:4px}
.cf-snack-12-v5-close{position:absolute;top:-10px;right:-10px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};border:none;width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 5px 15px rgba(0,0,0,0.1)}
@media(max-width:600px){.cf-snack-12-v5{bottom:15px;left:15px;right:15px;max-width:100%}}
</style>

<div class="cf-snack-12-v5" id="cf-snack-12-v5-{{ section.id }}">
  <button class="cf-snack-12-v5-close" onclick="document.getElementById('cf-snack-12-v5-{{ section.id }}').style.display='none'">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  
  {% if section.settings.image %}
    <img src="{{ section.settings.image | image_url: width: 150 }}" class="cf-snack-12-v5-img" alt="Promo">
  {% else %}
    <div class="cf-snack-12-v5-img" style="background:#e0e0e0"></div>
  {% endif %}
  
  <div class="cf-snack-12-v5-content">
    <span class="cf-snack-12-v5-tag">{{ section.settings.tag }}</span>
    <h4 class="cf-snack-12-v5-title">{{ section.settings.title }}</h4>
    <button class="cf-snack-12-v5-copy" onclick="navigator.clipboard.writeText('{{ section.settings.code }}'); this.innerText='COPIED THE CODE'">
      CLICK TO COPY: {{ section.settings.code }}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Snack (v5)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Thumbnail Image"},
    {"type":"text","id":"tag","label":"Tag","default":"Exclusive"},
    {"type":"text","id":"title","label":"Title","default":"Unlock $50 Off Your Next Dress"},
    {"type":"text","id":"code","label":"Promo Code","default":"DRESS50"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Tag Accent Color","default":"#A88661"}
  ],
  "presets": [{"name":"12 · Women's Snack (v5)"}]
}
{% endschema %}
