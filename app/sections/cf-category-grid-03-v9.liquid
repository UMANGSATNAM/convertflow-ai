<style>
.cf-cg-03-v9 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-cg-03-v9-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cg-03-v9-heading {
  font-size: clamp(28px, 4vw, 40px);
  color: {{ section.settings.text_color }};
  margin: 0 0 40px 0;
  text-align: center;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.cf-cg-03-v9-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 20px;
}

.cf-cg-03-v9-card {
  text-decoration: none;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  transition: 0.3s;
  border: 1px solid #eaeaea;
  display: flex;
  flex-direction: column;
}

.cf-cg-03-v9-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 25px rgba(0,0,0,0.1);
}

.cf-cg-03-v9-img-wrap {
  width: 100%;
  aspect-ratio: 1/1;
  background: #f4f4f5;
  position: relative;
  overflow: hidden;
}

.cf-cg-03-v9-img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: 0.5s;
}

.cf-cg-03-v9-card:hover .cf-cg-03-v9-img {
  transform: scale(1.03);
}

.cf-cg-03-v9-content {
  padding: 20px;
  text-align: center;
  background: #fff;
}

.cf-cg-03-v9-title {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 600;
  margin: 0;
}
</style>

<div class="cf-cg-03-v9">
  <div class="cf-cg-03-v9-inner">
    <h2 class="cf-cg-03-v9-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-cg-03-v9-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cg-03-v9-card">
          <div class="cf-cg-03-v9-img-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" class="cf-cg-03-v9-img">
            {% else %}
              <div style="width:100%; height:100%; background:#f4f4f5;"></div>
            {% endif %}
          </div>
          <div class="cf-cg-03-v9-content">
            <h3 class="cf-cg-03-v9-title">{{ block.settings.title }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "09 · Clean Minimal Grid",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Shop by Category"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#f9fafb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Laptops"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "09 · Clean Minimal Grid",
      "blocks": [
        {"type": "category"},{"type": "category"},{"type": "category"},{"type": "category"}
      ]
    }
  ]
}
{% endschema %}
