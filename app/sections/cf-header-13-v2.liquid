<style>
.cf-head-13-v2{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;border-bottom:2px solid {{ section.settings.text_color }};position:relative;z-index:50}
.cf-head-13-v2-inner{max-width:1600px;margin:0 auto;display:grid;grid-template-columns:1fr auto 1fr;align-items:stretch;height:90px}
.cf-head-13-v2-nav{display:flex;align-items:stretch;border-right:2px solid {{ section.settings.text_color }}}
.cf-head-13-v2-nav:last-child{border-right:none;border-left:2px solid {{ section.settings.text_color }};justify-content:flex-end}
.cf-head-13-v2-link{display:flex;align-items:center;padding:0 30px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.15em;text-decoration:none;color:{{ section.settings.text_color }};transition:0.3s;border-right:2px solid {{ section.settings.text_color }};position:relative;overflow:hidden}
.cf-head-13-v2-link:last-child{border-right:none}
.cf-head-13-v2-link::before{content:"";position:absolute;top:0;left:0;width:100%;height:100%;background:{{ section.settings.text_color }};transform:translateY(100%);transition:transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);z-index:-1}
.cf-head-13-v2-link:hover{color:{{ section.settings.bg_color }}}
.cf-head-13-v2-link:hover::before{transform:translateY(0)}
.cf-head-13-v2-logo{display:flex;align-items:center;justify-content:center;padding:0 50px;font-size:32px;font-weight:900;letter-spacing:0.05em;text-transform:uppercase;text-decoration:none;color:{{ section.settings.text_color }}}
.cf-head-13-v2-icon-group{display:flex;align-items:stretch}
.cf-head-13-v2-icon{display:flex;align-items:center;justify-content:center;width:90px;border-left:2px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};transition:0.3s;cursor:pointer}
.cf-head-13-v2-icon:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-head-13-v2-mobile-btn{display:none}
@media(max-width:1024px){
  .cf-head-13-v2-inner{display:flex;justify-content:space-between;align-items:center;height:70px}
  .cf-head-13-v2-nav{display:none}
  .cf-head-13-v2-logo{border:none;padding:0 20px;font-size:24px}
  .cf-head-13-v2-mobile-btn{display:flex;align-items:center;justify-content:center;width:70px;height:70px;border-right:2px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }}}
  .cf-head-13-v2-icon-group{border-left:none}
  .cf-head-13-v2-icon{width:70px}
}
</style>

<div class="cf-head-13-v2">
  <div class="cf-head-13-v2-inner">
    <div class="cf-head-13-v2-mobile-btn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </div>
    
    <div class="cf-head-13-v2-nav">
      {% for link in linklists[section.settings.menu].links limit:3 %}
        <a href="{{ link.url }}" class="cf-head-13-v2-link">{{ link.title }}</a>
      {% else %}
        <a href="#" class="cf-head-13-v2-link">SHOP</a>
        <a href="#" class="cf-head-13-v2-link">COLLECTIONS</a>
        <a href="#" class="cf-head-13-v2-link">ABOUT</a>
      {% endfor %}
    </div>

    <a href="/" class="cf-head-13-v2-logo">
      {{ section.settings.logo_text }}
    </a>

    <div class="cf-head-13-v2-nav">
      <div class="cf-head-13-v2-icon-group">
        <div class="cf-head-13-v2-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <div class="cf-head-13-v2-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div class="cf-head-13-v2-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Header (v2)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"STUDIO"},
    {"type":"link_list","id":"menu","label":"Navigation Menu"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Line & Text Color","default":"#000000"}
  ],
  "presets": [{"name":"13 · Brand Header (v2)"}]
}
{% endschema %}
