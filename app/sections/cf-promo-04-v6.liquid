<style>
.cf-pr-04-v6 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Baskerville', 'Times New Roman', serif;
  color: {{ section.settings.text_color }};
}

.cf-pr-04-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  border: 1px solid {{ section.settings.border_color }};
  padding: 15px;
}

.cf-pr-04-v6-box {
  border: 1px solid {{ section.settings.border_color }};
  display: flex;
  align-items: center;
}

.cf-pr-04-v6-content {
  width: 50%;
  padding: 80px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cf-pr-04-v6-year {
  font-size: 14px;
  letter-spacing: 0.2em;
  margin-bottom: 20px;
  text-transform: uppercase;
}

.cf-pr-04-v6-title {
  font-size: 52px;
  font-weight: normal;
  margin: 0 0 25px 0;
  line-height: 1.1;
  color: {{ section.settings.text_color }};
}

.cf-pr-04-v6-desc {
  font-size: 18px;
  line-height: 1.6;
  margin: 0 0 40px 0;
  opacity: 0.8;
  max-width: 400px;
}

.cf-pr-04-v6-btn {
  display: inline-block;
  background-color: transparent;
  color: {{ section.settings.text_color }};
  border: 1px solid {{ section.settings.text_color }};
  padding: 14px 40px;
  text-decoration: none;
  font-size: 14px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: all 0.3s;
}

.cf-pr-04-v6-btn:hover {
  background-color: {{ section.settings.text_color }};
  color: {{ section.settings.bg_color }};
}

.cf-pr-04-v6-image {
  width: 50%;
  position: relative;
  min-height: 600px;
  border-left: 1px solid {{ section.settings.border_color }};
}

.cf-pr-04-v6-image img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
}

@media (max-width: 900px) {
  .cf-pr-04-v6-box { flex-direction: column; }
  .cf-pr-04-v6-content { width: 100%; padding: 50px 20px; }
  .cf-pr-04-v6-image { width: 100%; min-height: 400px; border-left: none; border-top: 1px solid {{ section.settings.border_color }}; }
  .cf-pr-04-v6-title { font-size: 38px; }
}
</style>

<div class="cf-pr-04-v6">
  <div class="cf-pr-04-v6-inner">
    <div class="cf-pr-04-v6-box">
      <div class="cf-pr-04-v6-content">
        <div class="cf-pr-04-v6-year">{{ section.settings.tag }}</div>
        <h2 class="cf-pr-04-v6-title">{{ section.settings.title }}</h2>
        <p class="cf-pr-04-v6-desc">{{ section.settings.desc }}</p>
        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_link }}" class="cf-pr-04-v6-btn">{{ section.settings.btn_text }}</a>
        {% endif %}
      </div>
      <div class="cf-pr-04-v6-image">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}">
        {% else %}
          <div style="width:100%;height:100%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;">Image</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Apothecary Vintage",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#2d3a33"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f4f1ea"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Lines",
      "default": "#4a5c52"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag / Year",
      "default": "EST. 1992"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Wildcrafted pure extracts."
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "Sourced from sustainable farms to bring you the highest quality natural remedies."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Shop The Range"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "06 · Apothecary Vintage P"
    }
  ]
}
{% endschema %}
