<div class="cf-auto-snack-v6" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 50px 20px;">
  <div class="cf-auto-snack-v6-container" style="max-width: 1000px; margin: 0 auto; display: flex; align-items: stretch; border: 2px solid {{ section.settings.text_color }};">
    
    <!-- Left Logo/Icon Area -->
    <div style="background: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }}; padding: 30px; display: flex; align-items: center; justify-content: center; width: 120px;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
    </div>

    <!-- Center Content -->
    <div style="flex: 1; padding: 30px 40px; display: flex; flex-direction: column; justify-content: center;">
      <h3 style="font-family: 'Arial Black', Impact, sans-serif; font-size: 24px; text-transform: uppercase; margin: 0 0 10px 0; line-height: 1.1; letter-spacing: -1px;">
        {{ section.settings.title }}
      </h3>
      <p style="font-family: Helvetica, sans-serif; font-size: 15px; margin: 0; opacity: 0.8;">
        {{ section.settings.subtitle }}
      </p>
    </div>

    <!-- Right Action Area -->
    <div style="padding: 30px; display: flex; align-items: center; justify-content: center; border-left: 2px dashed rgba(0,0,0,0.1);">
      <a href="{{ section.settings.btn_link }}" class="cf-btn-snack-v6" style="display: inline-block; background: {{ section.settings.accent_color }}; color: #fff; padding: 15px 35px; font-family: 'Arial Black', Impact, sans-serif; font-size: 14px; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; transition: filter 0.2s;">
        {{ section.settings.btn_text }}
      </a>
    </div>

  </div>
</div>

<style>
  .cf-btn-snack-v6:hover {
    filter: brightness(1.1);
  }
  @media (max-width: 800px) {
    .cf-auto-snack-v6-container { flex-direction: column; }
    .cf-auto-snack-v6-container > div:first-child { width: 100%; height: 80px; }
    .cf-auto-snack-v6-container > div:last-child { border-left: none; border-top: 2px dashed rgba(0,0,0,0.1); }
  }
</style>

{% schema %}
{
  "name": "06 · Tool Block Snack",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e60000"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "LIMITED TIME BUNDLE"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Buy any floor jack, get a free set of jack stands."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP BUNDLE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
