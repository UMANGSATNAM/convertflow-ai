<style>
.cf-marquee-01-v9{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 0;position:relative}
.cf-marquee-01-v9::after{content:"";position:absolute;bottom:calc({{ section.settings.padding_y }}px - 10px);left:10%;width:80%;height:1px;background:{{ section.settings.accent_color }}}
.cf-marquee-01-v9-track{display:flex;white-space:nowrap;animation:cf-marquee-01-v9-scroll {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v9-item{display:inline-flex;align-items:center;padding:0 60px}
.cf-marquee-01-v9-text{font-family:serif;font-size:18px;font-style:italic;letter-spacing:0.05em;font-weight:400}
@keyframes cf-marquee-01-v9-scroll{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-01-v9">
  <div class="cf-marquee-01-v9-track">
    {% for j in (1..3) %}
      {% for i in (1..5) %}
        <div class="cf-marquee-01-v9-item">
          <span class="cf-marquee-01-v9-text">{{ section.settings.text }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v9)",
  "settings": [
    {"type":"text","id":"text","label":"Marquee Text","default":"Curated for the Discerning Individual"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":60},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#444444"},
    {"type":"color","id":"accent_color","label":"Underline Divider Color","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":100,"step":5,"default":40}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v9)"}]
}
{% endschema %}
