<style>
.cf-cg-03-v10 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: 'Inter', sans-serif;
}

.cf-cg-03-v10-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cg-03-v10-heading {
  font-size: clamp(32px, 5vw, 48px);
  color: {{ section.settings.text_color }};
  font-weight: 900;
  text-transform: uppercase;
  font-style: italic;
  text-align: center;
  margin: 0 0 50px 0;
  letter-spacing: -0.02em;
}

.cf-cg-03-v10-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 30px;
}

.cf-cg-03-v10-card-wrap {
  position: relative;
  border-radius: 8px;
  padding: 3px; /* Space for RGB border */
  /* Animated RGB Background on Hover */
  background: #222; /* Default border */
  transition: 0.3s;
  z-index: 1;
}

.cf-cg-03-v10-card-wrap:hover {
  background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
  background-size: 400% 400%;
  animation: cf-cg-03-v10-rgb 2s linear infinite;
  box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
}

@keyframes cf-cg-03-v10-rgb {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.cf-cg-03-v10-card {
  background: #0b0b0f;
  border-radius: 5px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  text-decoration: none;
  height: 100%;
  position: relative;
  z-index: 2;
  overflow: hidden;
}

.cf-cg-03-v10-img-wrap {
  width: 120px; height: 120px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.cf-cg-03-v10-img {
  width: 100%; height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 0 10px rgba(255,255,255,0.1));
  transition: 0.3s;
}

.cf-cg-03-v10-card-wrap:hover .cf-cg-03-v10-img {
  transform: translateY(-10px) scale(1.1);
  filter: drop-shadow(0 10px 20px rgba(255,255,255,0.3));
}

.cf-cg-03-v10-title {
  color: {{ section.settings.text_color }};
  font-size: 20px;
  font-weight: 800;
  text-transform: uppercase;
  font-style: italic;
  margin: 0;
  position: relative;
  z-index: 2;
  transition: 0.3s;
}

.cf-cg-03-v10-card-wrap:hover .cf-cg-03-v10-title {
  text-shadow: 0 0 10px rgba(255,255,255,0.5);
}

/* Subtle background glow inside the card based on hover */
.cf-cg-03-v10-card::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  width: 150px; height: 150px;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  transform: translate(-50%, -50%);
  opacity: 0;
  transition: 0.3s;
  z-index: 1;
}

.cf-cg-03-v10-card-wrap:hover .cf-cg-03-v10-card::before {
  opacity: 1;
}
</style>

<div class="cf-cg-03-v10">
  <div class="cf-cg-03-v10-inner">
    <h2 class="cf-cg-03-v10-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-cg-03-v10-grid">
      {% for block in section.blocks %}
        <div class="cf-cg-03-v10-card-wrap">
          <a href="{{ block.settings.link }}" class="cf-cg-03-v10-card">
            <div class="cf-cg-03-v10-img-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title }}" class="cf-cg-03-v10-img">
              {% else %}
                 <!-- Placeholder shape -->
                <div style="width: 80px; height: 80px; background: #333; transform: rotate(45deg);"></div>
              {% endif %}
            </div>
            <h3 class="cf-cg-03-v10-title">{{ block.settings.title }}</h3>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · RGB Glowing Borders",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"ARMORY"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#050505"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {"type":"image_picker","id":"image","label":"Image (Transparent PNG best)"},
        {"type":"text","id":"title","label":"Title","default":"Keyboards"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "10 · RGB Glowing Borders",
      "blocks": [
        {"type": "category"},{"type": "category"},{"type": "category"},{"type": "category"}
      ]
    }
  ]
}
{% endschema %}
