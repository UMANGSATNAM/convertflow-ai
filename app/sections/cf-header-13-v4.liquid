<style>
.cf-head-13-v4{width:100%;background:{{ section.settings.bg_color }};padding:15px;position:sticky;top:0;z-index:100}
.cf-head-13-v4-pill{max-width:1200px;margin:0 auto;background:rgba(255,255,255,0.05);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:100px;padding:10px 30px;display:flex;justify-content:space-between;align-items:center;color:{{ section.settings.text_color }};font-family:sans-serif;box-shadow:0 10px 30px rgba(0,0,0,0.1)}
.cf-head-13-v4-nav{display:flex;gap:30px;align-items:center}
.cf-head-13-v4-link{font-size:12px;font-weight:600;letter-spacing:0.05em;color:inherit;text-decoration:none;transition:0.3s;opacity:0.7}
.cf-head-13-v4-link:hover{opacity:1;transform:translateY(-1px)}
.cf-head-13-v4-logo{font-size:20px;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:inherit;text-decoration:none}
.cf-head-13-v4-icons{display:flex;gap:20px;align-items:center}
.cf-head-13-v4-icon{opacity:0.7;transition:0.3s;cursor:pointer}
.cf-head-13-v4-icon:hover{opacity:1}
.cf-head-13-v4-menu-btn{display:none}
@media(max-width:900px){
  .cf-head-13-v4-nav{display:none}
  .cf-head-13-v4-icons{display:none}
  .cf-head-13-v4-menu-btn{display:block;opacity:0.8}
}
</style>

<div class="cf-head-13-v4" style="background:transparent; pointer-events:none;">
  <div class="cf-head-13-v4-pill" style="pointer-events:all; background:{{ section.settings.pill_bg }}; border-color:{{ section.settings.border_color }};">
    
    <div class="cf-head-13-v4-menu-btn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </div>

    <div class="cf-head-13-v4-nav">
      {% for link in linklists[section.settings.menu].links limit:3 %}
        <a href="{{ link.url }}" class="cf-head-13-v4-link">{{ link.title }}</a>
      {% else %}
        <a href="#" class="cf-head-13-v4-link">Shop</a>
        <a href="#" class="cf-head-13-v4-link">Campaigns</a>
        <a href="#" class="cf-head-13-v4-link">Journal</a>
      {% endfor %}
    </div>

    <a href="/" class="cf-head-13-v4-logo">
      {{ section.settings.logo_text }}
    </a>

    <div class="cf-head-13-v4-icons">
      <div class="cf-head-13-v4-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <div class="cf-head-13-v4-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      <div class="cf-head-13-v4-icon" style="display:flex;align-items:center;gap:5px">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span style="font-size:11px;font-weight:700">0</span>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Header (v4)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"AURA"},
    {"type":"link_list","id":"menu","label":"Navigation Menu"},
    {"type":"color","id":"pill_bg","label":"Pill Background","default":"rgba(0,0,0,0.85)"},
    {"type":"color","id":"border_color","label":"Pill Border","default":"rgba(255,255,255,0.15)"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"}
  ],
  "presets": [{"name":"13 · Brand Header (v4)"}]
}
{% endschema %}
