<style>
.cf-head-02-v9 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2px solid {{ section.settings.accent_color }};
}

.cf-head-02-v9-ticker {
  background: {{ section.settings.accent_color }};
  color: {{ section.settings.bg_color }};
  display: flex;
  justify-content: space-between;
  padding: 4px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase;
}

.cf-head-02-v9-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-head-02-v9-logo {
  font-size: clamp(20px, 4vw, {{ section.settings.logo_size }}px);
  font-weight: 900;
  color: {{ section.settings.logo_color }};
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: 0.1em;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.cf-head-02-v9-logo span {
  font-size: 10px;
  color: {{ section.settings.accent_color }};
  letter-spacing: 0.2em;
  margin-top: 4px;
}

.cf-head-02-v9-nav {
  display: none;
  gap: 32px;
}

.cf-head-02-v9-link {
  font-size: 13px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: 0.1em;
  transition: 0.3s;
  position: relative;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-head-02-v9-link::before {
  content: '[';
  opacity: 0;
  color: {{ section.settings.accent_color }};
  margin-right: 4px;
  transition: 0.2s;
}
.cf-head-02-v9-link::after {
  content: ']';
  opacity: 0;
  color: {{ section.settings.accent_color }};
  margin-left: 4px;
  transition: 0.2s;
}

.cf-head-02-v9-link:hover {
  color: {{ section.settings.logo_color }};
}

.cf-head-02-v9-link:hover::before, .cf-head-02-v9-link:hover::after {
  opacity: 1;
}

.cf-head-02-v9-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.cf-head-02-v9-btn {
  background: transparent;
  color: {{ section.settings.accent_color }};
  border: 1px solid {{ section.settings.accent_color }};
  padding: 8px 16px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-weight: 700;
  font-size: 12px;
  text-transform: uppercase;
  text-decoration: none;
  transition: 0.2s;
}

.cf-head-02-v9-btn:hover {
  background: {{ section.settings.accent_color }};
  color: {{ section.settings.bg_color }};
}

@media (min-width: 1024px) {
  .cf-head-02-v9-nav { display: flex; align-items: center; }
  .cf-head-02-v9-main { padding: {{ section.settings.padding_y }}px 40px; }
  .cf-head-02-v9-ticker { padding: 4px 40px; }
}
</style>

<header class="cf-head-02-v9">
  <div class="cf-head-02-v9-ticker">
    <div>SYS.OP // SECURE</div>
    <div id="cf-tech-time-{{ section.id }}">00:00:00</div>
  </div>
  <div class="cf-head-02-v9-main">
    <a href="/" class="cf-head-02-v9-logo">
      {{ section.settings.logo_text }}
      <span>V1.0.0</span>
    </a>
    <nav class="cf-head-02-v9-nav">
      <a href="{{ section.settings.link_1_url }}" class="cf-head-02-v9-link">{{ section.settings.link_1 }}</a>
      <a href="{{ section.settings.link_2_url }}" class="cf-head-02-v9-link">{{ section.settings.link_2 }}</a>
      <a href="{{ section.settings.link_3_url }}" class="cf-head-02-v9-link">{{ section.settings.link_3 }}</a>
    </nav>
    <div class="cf-head-02-v9-actions">
      <a href="/cart" class="cf-head-02-v9-btn">CART_DATA [0]</a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('cf-tech-time-{{ section.id }}');
    if (!el) return;
    setInterval(() => {
      const d = new Date();
      el.textContent = d.toISOString().substring(11, 19) + " UTC";
    }, 1000);
  });
</script>

{% schema %}
{
  "name": "09 · Tech-Wear",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"SYSTEM"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":20,"max":64,"step":2,"default":28},
    {"type":"text","id":"link_1","label":"Link 1","default":"Jackets"},
    {"type":"text","id":"link_1_url","label":"Link 1 URL","default":"/collections/jackets"},
    {"type":"text","id":"link_2","label":"Link 2","default":"Pants"},
    {"type":"text","id":"link_2_url","label":"Link 2 URL","default":"/collections/pants"},
    {"type":"text","id":"link_3","label":"Link 3","default":"Gear"},
    {"type":"text","id":"link_3_url","label":"Link 3 URL","default":"/collections/gear"},
    {"type":"color","id":"bg_color","label":"Background","default":"#000000"},
    {"type":"color","id":"logo_color","label":"Logo Color","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Link Color","default":"#888888"},
    {"type":"color","id":"accent_color","label":"Tech Accent (Orange/Lime)","default":"#f97316"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20}
  ],
  "presets": [{"name":"09 · Tech-Wear Header"}]
}
{% endschema %}
