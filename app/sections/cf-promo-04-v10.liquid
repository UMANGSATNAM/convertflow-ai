<style>
.cf-pr-04-v10 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #fff;
}

.cf-pr-04-v10-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  background: {{ section.settings.card_bg }};
  display: flex;
  border-radius: 8px;
  overflow: hidden;
}

.cf-pr-04-v10-content {
  flex: 1;
  padding: 80px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cf-pr-04-v10-tag {
  color: #93c5fd;
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 15px;
}

.cf-pr-04-v10-title {
  color: #fff;
  font-size: 40px;
  font-weight: 800;
  margin: 0 0 20px 0;
  line-height: 1.2;
}

.cf-pr-04-v10-desc {
  color: #bfdbfe;
  font-size: 16px;
  line-height: 1.6;
  margin: 0 0 30px 0;
  max-width: 400px;
}

.cf-pr-04-v10-btn {
  display: inline-block;
  background-color: #fff;
  color: {{ section.settings.card_bg }};
  padding: 16px 36px;
  border-radius: 4px;
  text-decoration: none;
  font-weight: 700;
  font-size: 15px;
  transition: opacity 0.2s;
  align-self: flex-start;
}

.cf-pr-04-v10-btn:hover {
  opacity: 0.9;
}

.cf-pr-04-v10-image {
  flex: 1;
  position: relative;
  min-height: 400px;
}

.cf-pr-04-v10-image img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
}

@media (max-width: 900px) {
  .cf-pr-04-v10-inner { flex-direction: column-reverse; }
  .cf-pr-04-v10-image { min-height: 300px; }
  .cf-pr-04-v10-content { padding: 40px 30px; }
}
</style>

<div class="cf-pr-04-v10">
  <div class="cf-pr-04-v10-inner">
    <div class="cf-pr-04-v10-content">
      <div class="cf-pr-04-v10-tag">{{ section.settings.tag }}</div>
      <h2 class="cf-pr-04-v10-title">{{ section.settings.title }}</h2>
      <p class="cf-pr-04-v10-desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-pr-04-v10-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    <div class="cf-pr-04-v10-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title }}">
      {% else %}
        <div style="width:100%;height:100%;background:#1e3a8a;display:flex;align-items:center;justify-content:center;color:#60a5fa;border-left:1px solid #3b82f6;">Image Placeholder</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · Med-Tech Trusted",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#ffffff"},
    {"type":"color","id":"card_bg","label":"Card Background (Blue)","default":"#1d4ed8"},
    {"type":"text","id":"tag","label":"Tag","default":"CLINICAL EXCELLENCE"},
    {"type":"text","id":"title","label":"Title","default":"Advanced Medical Grade Equipment."},
    {"type":"textarea","id":"desc","label":"Description","default":"Equip your facility with trusted, reliable, and cutting-edge health devices."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Equipment"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "presets": [{"name":"10 · Med-Tech Trusted Poster"}]
}
{% endschema %}
