<style>
.cf-trust-01-v5{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;border-bottom:1px solid rgba(255,255,255,0.1)}
.cf-trust-01-v5-inner{max-width:1400px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center}
.cf-trust-01-v5-title{font-size:clamp(36px, 5vw, 64px);font-weight:400;margin:0 0 60px 0;letter-spacing:0.02em}
.cf-trust-01-v5-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:40px;width:100%}
.cf-trust-01-v5-item{position:relative;padding:0 20px}
.cf-trust-01-v5-item:not(:last-child)::after{content:"";position:absolute;top:50%;right:-20px;transform:translateY(-50%);width:1px;height:40px;background:{{ section.settings.accent_color }};opacity:0.3}
.cf-trust-01-v5-item-title{font-size:20px;font-style:italic;color:{{ section.settings.accent_color }};margin:0 0 15px 0}
.cf-trust-01-v5-item-desc{font-family:sans-serif;font-size:12px;opacity:0.7;line-height:1.6;margin:0;letter-spacing:0.05em}
@media(max-width:900px){
  .cf-trust-01-v5-grid{grid-template-columns:1fr;gap:60px}
  .cf-trust-01-v5-item:not(:last-child)::after{top:auto;bottom:-30px;right:50%;transform:translateX(50%);width:40px;height:1px}
}
</style>

<div class="cf-trust-01-v5">
  <div class="cf-trust-01-v5-inner">
    <h2 class="cf-trust-01-v5-title">{{ section.settings.title }}</h2>
    <div class="cf-trust-01-v5-grid">
      {% for i in (1..3) %}
        <div class="cf-trust-01-v5-item">
          <h4 class="cf-trust-01-v5-item-title">
            {% if i == 1 %}Global Reach{% elsif i == 2 %}Secure Transit{% else %}Absolute Discretion{% endif %}
          </h4>
          <p class="cf-trust-01-v5-item-desc">
            {% if i == 1 %}Complimentary international shipping on all fine objects.{% elsif i == 2 %}Fully insured, climate-controlled logistics.{% else %}Private consulting and unmarked packaging options.{% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Trust (v5)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Ethos"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#080808"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Accent Separator","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Trust (v5)"}]
}
{% endschema %}
