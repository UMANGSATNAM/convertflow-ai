<div class="cf-auto-header-v6" style="background: {{ section.settings.bg_color }};">
  <div class="cf-auto-header-v6-container" style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column;">

    <!-- Top Row: Logo & Search -->
    <div style="padding: 20px 30px; display: flex; align-items: center; justify-content: space-between; gap: 40px; border-bottom: 1px solid rgba(0,0,0,0.05);">
      
      <!-- Logo -->
      <div class="cf-auto-header-v6-logo">
        <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 10px;">
          {% if section.settings.logo %}
            <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
          {% else %}
            <div style="background: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }}; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 22px; font-family: monospace;">{{ shop.name | slice: 0 }}</div>
            <span style="font-family: 'Oswald', sans-serif; font-size: 26px; font-weight: 700; color: {{ section.settings.text_color }}; text-transform: uppercase;">
              {{ shop.name }}
            </span>
          {% endif %}
        </a>
      </div>

      <!-- Massive Search Bar -->
      <div class="cf-auto-header-v6-search" style="flex: 1; max-width: 800px;">
        <form action="/search" method="get" style="display: flex; width: 100%; position: relative;">
          <input type="text" name="q" placeholder="Enter YMM (Year, Make, Model) or Part Name..." style="flex: 1; padding: 15px 20px; padding-left: 50px; border: 2px solid {{ section.settings.text_color }}; background: #fff; color: #000; font-size: 15px; font-family: 'Roboto', sans-serif; outline: none;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#666" stroke-width="2.5" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <button type="submit" style="background: {{ section.settings.accent_color }}; color: #fff; border: 2px solid {{ section.settings.text_color }}; border-left: none; padding: 0 30px; font-family: 'Oswald', sans-serif; font-size: 16px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; transition: background 0.2s;" class="cf-btn-hover">
            Find Parts
          </button>
        </form>
      </div>

      <!-- Mini Actions -->
      <div class="cf-auto-header-v6-actions" style="display: flex; gap: 20px;">
        <a href="/account" style="color: {{ section.settings.text_color }}; display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; font-family: 'Roboto', sans-serif;">Account</span>
        </a>
        <a href="/cart" style="color: {{ section.settings.text_color }}; display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none; position: relative;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span style="font-size: 11px; font-weight: 600; text-transform: uppercase; font-family: 'Roboto', sans-serif;">Cart</span>
          <span style="position: absolute; top: -5px; right: -5px; background: {{ section.settings.accent_color }}; color: #fff; font-size: 10px; font-weight: 800; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">{{ cart.item_count }}</span>
        </a>
      </div>

    </div>

    <!-- Bottom Row: Navigation -->
    <div class="cf-auto-header-v6-nav" style="padding: 0 30px; background: {{ section.settings.text_color }};">
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 40px; overflow-x: auto; scrollbar-width: none;">
        <li style="background: {{ section.settings.accent_color }};">
          <a href="#" style="color: #fff; text-decoration: none; font-size: 15px; font-weight: 700; font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: 1px; padding: 16px 24px; display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            All Categories
          </a>
        </li>
        {% for link in linklists[section.settings.menu].links limit: 6 %}
          <li>
            <a href="{{ link.url }}" style="color: {{ section.settings.bg_color }}; text-decoration: none; font-size: 14px; font-weight: 600; font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: 1px; padding: 18px 0; display: inline-block; white-space: nowrap; transition: color 0.2s;" class="cf-hover-accent">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&display=swap');
  
  .cf-btn-hover:hover { filter: brightness(0.9); }
  .cf-hover-accent:hover { color: {{ section.settings.accent_color }} !important; }
  
  @media (max-width: 990px) {
    .cf-auto-header-v6-container > div:first-child { flex-wrap: wrap; padding: 15px; gap: 15px; }
    .cf-auto-header-v6-search { order: 3; max-width: 100% !important; }
    .cf-auto-header-v6-nav { padding: 0 !important; }
    .cf-auto-header-v6-nav ul { gap: 20px; }
    .cf-auto-header-v6-nav li:first-child a { padding: 16px 15px; }
  }
</style>

{% schema %}
{
  "name": "06 · Massive Catalog Head",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Contrast Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0052cc"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 40
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
