<style>
.cf-cat-01-v7{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-cat-01-v7-inner{max-width:1400px;margin:0 auto}
.cf-cat-01-v7-header{margin-bottom:100px;text-align:center}
.cf-cat-01-v7-title{font-size:clamp(40px, 6vw, 84px);font-weight:400;margin:0;letter-spacing:0.02em}
.cf-cat-01-v7-row{display:flex;align-items:center;margin-bottom:120px;gap:80px}
.cf-cat-01-v7-row:nth-child(even){flex-direction:row-reverse}
.cf-cat-01-v7-img-col{flex:1.5;position:relative}
.cf-cat-01-v7-img-wrap{width:100%;aspect-ratio:4/5;background:#ececec;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,0.05)}
.cf-cat-01-v7-img{width:100%;height:100%;object-fit:cover;transition:1s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-cat-01-v7-row:hover .cf-cat-01-v7-img{transform:scale(1.05)}
.cf-cat-01-v7-text-col{flex:1;display:flex;flex-direction:column;justify-content:center}
.cf-cat-01-v7-cat-name{font-size:clamp(32px, 5vw, 64px);font-style:italic;margin:0 0 20px 0;line-height:1}
.cf-cat-01-v7-cat-desc{font-family:sans-serif;font-size:13px;line-height:1.6;opacity:0.8;margin:0 0 40px 0;max-width:350px}
.cf-cat-01-v7-btn{display:inline-block;padding-bottom:5px;border-bottom:1px solid {{ section.settings.text_color }};font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:inherit;align-self:flex-start;transition:0.3s}
.cf-cat-01-v7-btn:hover{color:{{ section.settings.accent_color }};border-bottom-color:{{ section.settings.accent_color }}}
@media(max-width:1024px){
  .cf-cat-01-v7-row, .cf-cat-01-v7-row:nth-child(even){flex-direction:column;gap:40px;margin-bottom:80px;text-align:center}
  .cf-cat-01-v7-img-col, .cf-cat-01-v7-text-col{width:100%}
  .cf-cat-01-v7-cat-desc{margin:0 auto 40px auto}
  .cf-cat-01-v7-btn{align-self:center}
}
</style>

<div class="cf-cat-01-v7">
  <div class="cf-cat-01-v7-inner">
    <div class="cf-cat-01-v7-header">
      <h2 class="cf-cat-01-v7-title">{{ section.settings.title }}</h2>
    </div>
    
    {% for i in (1..3) %}
    <div class="cf-cat-01-v7-row">
      <div class="cf-cat-01-v7-img-col">
        <div class="cf-cat-01-v7-img-wrap">
          <div class="cf-cat-01-v7-img" style="background:#555;"></div>
        </div>
      </div>
      <div class="cf-cat-01-v7-text-col">
        <h3 class="cf-cat-01-v7-cat-name">Category 0{{ i }}</h3>
        <p class="cf-cat-01-v7-cat-desc">A brief description illustrating the narrative and craftsmanship behind this exceptional collection, crafted for discerning tastes.</p>
        <a href="#" class="cf-cat-01-v7-btn">Discover Collection</a>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v7)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Index"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Category (v7)"}]
}
{% endschema %}
