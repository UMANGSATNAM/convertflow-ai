<style>
.cf-mq-03-v9 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  border-bottom: 1px solid #e5e5e5;
  display: flex;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.cf-mq-03-v9-track {
  display: flex;
  white-space: nowrap;
  animation: cf-mq-03-v9-scroll {{ section.settings.speed }}s linear infinite;
}

@keyframes cf-mq-03-v9-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.cf-mq-03-v9-item {
  display: flex;
  align-items: center;
  padding: 0 50px;
  font-size: {{ section.settings.text_size }}px;
  font-weight: 500;
  color: {{ section.settings.text_color }};
  letter-spacing: -0.01em;
}

.cf-mq-03-v9-icon {
  margin-left: 50px;
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
}

.cf-mq-03-v9-icon svg {
  width: 16px; height: 16px;
  stroke-width: 2.5;
}
</style>

<div class="cf-mq-03-v9">
  <div class="cf-mq-03-v9-track">
    {% for block in section.blocks %}
      <div class="cf-mq-03-v9-item">
        {{ block.settings.text }}
        <div class="cf-mq-03-v9-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>
    {% endfor %}
    {% for block in section.blocks %}
      <div class="cf-mq-03-v9-item">
        {{ block.settings.text }}
        <div class="cf-mq-03-v9-icon">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "09 · Clean iOS Banner",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#f9fafb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"accent_color","label":"Icon Accent","default":"#3b82f6"},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":36,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":12},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":25}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "limit": 6,
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"Pro models available now."}
      ]
    }
  ],
  "presets": [
    {
      "name": "09 · Clean iOS Banner",
      "blocks": [
        {"type": "text"},
        {"type": "text"},
        {"type": "text"},
        {"type": "text"}
      ]
    }
  ]
}
{% endschema %}
