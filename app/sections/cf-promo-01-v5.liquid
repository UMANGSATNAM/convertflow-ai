<style>
.cf-promo-01-v5{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-promo-01-v5-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;position:relative}
.cf-promo-01-v5-left{width:45%;padding-right:60px;position:relative;z-index:2;margin-top:-100px}
.cf-promo-01-v5-right{width:55%;position:relative;z-index:1}
.cf-promo-01-v5-img-wrap{width:100%;aspect-ratio:3/4;background:#f0f0f0;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,0.1)}
.cf-promo-01-v5-img{width:100%;height:100%;object-fit:cover;transition:1s}
.cf-promo-01-v5-inner:hover .cf-promo-01-v5-img{transform:scale(1.04)}
.cf-promo-01-v5-title{font-size:clamp(40px, 6vw, 84px);line-height:1;margin:0 0 30px 0;font-weight:400;letter-spacing:0.02em}
.cf-promo-01-v5-desc{font-family:sans-serif;font-size:14px;line-height:1.6;opacity:0.75;margin:0 0 40px 0;max-width:350px}
.cf-promo-01-v5-btn{display:inline-flex;align-items:center;gap:15px;font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;text-decoration:none;color:inherit;transition:0.3s}
.cf-promo-01-v5-btn::before{content:"";width:30px;height:1px;background:{{ section.settings.text_color }};transition:0.3s}
.cf-promo-01-v5-btn:hover{color:{{ section.settings.accent_color }}}
.cf-promo-01-v5-btn:hover::before{width:50px;background:{{ section.settings.accent_color }}}
@media(max-width:1024px){
  .cf-promo-01-v5-inner{flex-direction:column-reverse}
  .cf-promo-01-v5-left{width:100%;padding:40px 0 0 0;margin-top:0}
  .cf-promo-01-v5-right{width:100%}
  .cf-promo-01-v5-img-wrap{aspect-ratio:4/5}
}
</style>

<div class="cf-promo-01-v5">
  <div class="cf-promo-01-v5-inner">
    <div class="cf-promo-01-v5-left">
      <h2 class="cf-promo-01-v5-title">{{ section.settings.title | newline_to_br }}</h2>
      <p class="cf-promo-01-v5-desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-promo-01-v5-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    <div class="cf-promo-01-v5-right">
      <div class="cf-promo-01-v5-img-wrap">
        {% if section.settings.image %}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" class="cf-promo-01-v5-img" alt="">
        {% else %}
          <div class="cf-promo-01-v5-img" style="background:#555;"></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Promo (v5)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Campaign Image"},
    {"type":"textarea","id":"title","label":"Header Title","default":"The Art\nOf Detail"},
    {"type":"textarea","id":"desc","label":"Description","default":"Precious metals and flawless stones intersect in our newest fine jewelry acquisition."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Discover Pieces"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#222222"},
    {"type":"color","id":"accent_color","label":"Hover Accent Color","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Promo (v5)"}]
}
{% endschema %}
