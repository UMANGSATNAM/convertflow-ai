<style>
.cf-tb-03-v9 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-tb-03-v9-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  background: #ffffff;
  border-radius: 20px;
  padding: 40px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 40px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  border: 1px solid #eaeaea;
}

.cf-tb-03-v9-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 15px;
  flex: 1;
  min-width: 150px;
}

.cf-tb-03-v9-icon {
  width: 56px; height: 56px;
  background: #f4f4f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: {{ section.settings.icon_color }};
  transition: 0.3s;
}

.cf-tb-03-v9-item:hover .cf-tb-03-v9-icon {
  background: {{ section.settings.icon_color }};
  color: #fff;
  transform: translateY(-5px);
  box-shadow: 0 10px 15px rgba(0,0,0,0.1);
}

.cf-tb-03-v9-icon svg {
  width: 24px; height: 24px;
}

.cf-tb-03-v9-title {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 600;
  margin: 0;
}

.cf-tb-03-v9-desc {
  color: #6b7280;
  font-size: 14px;
  margin: 0;
}
</style>

<div class="cf-tb-03-v9">
  <div class="cf-tb-03-v9-inner">
    {% for block in section.blocks %}
      <div class="cf-tb-03-v9-item">
        <div class="cf-tb-03-v9-icon">
          {% if block.settings.icon == 'shield' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {% elsif block.settings.icon == 'refresh' %}
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
          {% elsif block.settings.icon == 'truck' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          {% endif %}
        </div>
        <div>
          <h3 class="cf-tb-03-v9-title">{{ block.settings.title }}</h3>
          {% if block.settings.desc != blank %}
            <p class="cf-tb-03-v9-desc">{{ block.settings.desc }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "09 · Clean Matte Icons",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#f9fafb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"icon_color","label":"Icon Accent Color","default":"#111827"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "shield", "label": "Shield"},
            {"value": "refresh", "label": "Refresh"},
            {"value": "truck", "label": "Truck"},
            {"value": "help", "label": "Help/Question"}
          ],
          "default": "shield"
        },
        {"type":"text","id":"title","label":"Title","default":"Warranty"},
        {"type":"text","id":"desc","label":"Description","default":"2 years included"}
      ]
    }
  ],
  "presets": [
    {
      "name": "09 · Clean Matte Trust Badges",
      "blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]
    }
  ]
}
{% endschema %}
