<style>
.cf-ps-02-v4 {
  width: 100%;
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  display: flex;
  justify-content: center;
}

.cf-ps-02-v4-inner {
  max-width: 1000px;
  width: 100%;
  background: #111;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  border: 2px solid {{ section.settings.border_color }};
}

.cf-ps-02-v4-marquee {
  background: {{ section.settings.accent_color }};
  color: #111;
  font-weight: 900;
  text-transform: uppercase;
  font-size: 13px;
  letter-spacing: 0.1em;
  padding: 8px 0;
  display: flex;
  white-space: nowrap;
  overflow: hidden;
  border-bottom: 2px solid #111;
}

.cf-ps-02-v4-track {
  display: flex;
  animation: cf-ps-02-v4-scroll 8s linear infinite;
}

.cf-ps-02-v4-mq-item {
  padding: 0 20px;
}

@keyframes cf-ps-02-v4-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.cf-ps-02-v4-content {
  padding: 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cf-ps-02-v4-title {
  font-size: clamp(24px, 5vw, {{ section.settings.title_size }}px);
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  margin-bottom: 20px;
  letter-spacing: -0.02em;
}

.cf-ps-02-v4-btn {
  background: {{ section.settings.border_color }};
  color: {{ section.settings.bg_color }};
  padding: 12px 28px;
  font-weight: 900;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 14px;
  transition: 0.2s;
  border: 2px solid transparent;
}

.cf-ps-02-v4-btn:hover {
  background: transparent;
  color: {{ section.settings.border_color }};
  border-color: {{ section.settings.border_color }};
}

@media (min-width: 768px) {
  .cf-ps-02-v4-content {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
    padding: 30px 40px;
  }
  .cf-ps-02-v4-title {
    margin-bottom: 0;
  }
}
</style>

<div class="cf-ps-02-v4">
  <div class="cf-ps-02-v4-inner">
    <div class="cf-ps-02-v4-marquee">
      <div class="cf-ps-02-v4-track">
        {% assign items = (1..10) %}
        {% for i in items %}
          <div class="cf-ps-02-v4-mq-item">{{ section.settings.ticker_text }} +++</div>
        {% endfor %}
      </div>
    </div>
    
    <div class="cf-ps-02-v4-content">
      <h3 class="cf-ps-02-v4-title">{{ section.settings.title }}</h3>
      <a href="{{ section.settings.btn_link }}" class="cf-ps-02-v4-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · integrated Ticker",
  "settings": [
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Ticker Text",
      "default": "DROPPING NOW"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "THE NEW CORE COLLECTION"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 20,
      "max": 64,
      "step": 2,
      "default": 36
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "VIEW DROP"
    },
    {
      "type": "text",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/collections/frontpage"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Outer Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Accent Elements Base",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Ticker Background",
      "default": "#ef4444"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "04 · Integrated Ticker Sn"
    }
  ]
}
{% endschema %}
