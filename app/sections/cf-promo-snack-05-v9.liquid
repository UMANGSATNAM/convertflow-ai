<style>
.cf-snack-05-v9 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: 'Georgia',serif;
  border-top: 1px solid {{ section.settings.border_color }};
  border-bottom: 1px solid {{ section.settings.border_color }};
}
.cf-snack-05-v9-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center; gap: 30px; flex-wrap: wrap;
}
.cf-snack-05-v9-text { font-size: 17px; font-style: italic; color: {{ section.settings.text_color }}; }
.cf-snack-05-v9-sep { color: {{ section.settings.accent_color }}; }
.cf-snack-05-v9-btn {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: {{ section.settings.accent_color }};
  text-decoration: none; font-size: 12px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.1em;
  border-bottom: 1px solid {{ section.settings.accent_color }};
  padding-bottom: 2px;
}
</style>

<div class="cf-snack-05-v9">
  <div class="cf-snack-05-v9-inner">
    <span class="cf-snack-05-v9-text">{{ section.settings.text }}</span>
    <span class="cf-snack-05-v9-sep">—</span>
    <a href="{{ section.settings.btn_link }}" class="cf-snack-05-v9-btn">{{ section.settings.btn_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "09 · Fragrance Snack",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#faf8f5"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#2c2416"},
    {"type":"color","id":"accent_color","label":"Gold Accent","default":"#b8973a"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e8e0d0"},
    {"type":"text","id":"text","label":"Message Text","default":"Receive a complimentary sample with every fragrance order"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Explore Scents"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":60,"step":5,"default":18},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1100}
  ],
  "presets": [{"name": "09 · Fragrance Snack"}]
}
{% endschema %}
