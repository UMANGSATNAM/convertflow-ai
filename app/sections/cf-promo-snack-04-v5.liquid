<style>
.cf-ps-04-v5 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: 'Playfair Display', serif;
  display: flex;
  justify-content: center;
}

.cf-ps-04-v5-inner {
  max-width: {{ section.settings.max_width }}px;
  border-top: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }};
  border-bottom: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }};
  padding: 15px 40px;
  display: flex;
  align-items: center;
  gap: 20px;
  animation: cf-ps-04-v5-fade 2s ease-in-out;
}

@keyframes cf-ps-04-v5-fade {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.cf-ps-04-v5-icon {
  color: {{ section.settings.accent_color }};
  font-size: 1.2em; /* Diamond char */
  display: flex;
  align-items: center;
  justify-content: center;
}

.cf-ps-04-v5-text {
  color: {{ section.settings.text_color }};
  font-size: 15px;
  font-style: italic;
  margin: 0;
  letter-spacing: 0.05em;
  text-align: center;
}

@media (max-width: 600px) {
  .cf-ps-04-v5-inner { padding: 12px 20px; gap: 10px; }
  .cf-ps-04-v5-text { font-size: 14px; }
}
</style>

<div class="cf-ps-04-v5">
  <div class="cf-ps-04-v5-inner">
    <div class="cf-ps-04-v5-icon">◆</div>
    <p class="cf-ps-04-v5-text">
      {{ section.settings.text }}
    </p>
    <div class="cf-ps-04-v5-icon">◆</div>
  </div>
</div>

{% schema %}
{
  "name": "05 · Spa Serenity Note",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#F7F4F0"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#5A5043"},
    {"type":"color","id":"accent_color","label":"Accent Line Color","default":"#C8BCA7"},
    {"type":"text","id":"text","label":"Text","default":"Enjoy complimentary shipping on all orders over $50."},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":2,"default":25},
    {"type":"range","id":"max_width","label":"Max Width","min":400,"max":1200,"step":50,"default":800}
  ],
  "presets": [{"name":"05 · Spa Serenity Snack"}]
}
{% endschema %}
