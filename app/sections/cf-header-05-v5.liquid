<style>
.cf-header-05-v5 {
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-header-05-v5-top {
  background: {{ section.settings.accent_color }};
  text-align: center;
  padding: 9px 20px;
  font-size: 12px;
  color: #fff;
  font-weight: 500;
  letter-spacing: 0.05em;
}
.cf-header-05-v5-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 40px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
.cf-header-05-v5-logo {
  font-size: 22px;
  font-weight: 800;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: 8px;
}
.cf-header-05-v5-logo-dot {
  width: 8px; height: 8px;
  background: {{ section.settings.accent_color }};
  border-radius: 50%;
  display: inline-block;
}
.cf-header-05-v5-nav {
  display: flex;
  gap: 30px;
  list-style: none;
  margin: 0; padding: 0;
}
.cf-header-05-v5-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s;
  position: relative;
  padding-bottom: 3px;
}
.cf-header-05-v5-nav a::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0;
  width: 0%; height: 2px;
  background: {{ section.settings.accent_color }};
  transition: width 0.3s;
}
.cf-header-05-v5-nav a:hover::after { width: 100%; }
.cf-header-05-v5-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}
.cf-header-05-v5-icon { color: {{ section.settings.text_color }}; cursor: pointer; }
.cf-header-05-v5-icon svg { width: 20px; height: 20px; stroke-width: 1.8; }
.cf-header-05-v5-badge {
  background: {{ section.settings.accent_color }};
  color: #fff;
  width: 18px; height: 18px;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-top: -10px; margin-left: -10px;
}
.cf-header-05-v5-cart-wrap { position: relative; }
@media (max-width: 900px) {
  .cf-header-05-v5-nav { display: none; }
  .cf-header-05-v5-bar { padding: 15px 20px; }
}
</style>

<div class="cf-header-05-v5">
  {% if section.settings.top_text != blank %}
    <div class="cf-header-05-v5-top">{{ section.settings.top_text }}</div>
  {% endif %}
  <div class="cf-header-05-v5-bar">
    <a href="/" class="cf-header-05-v5-logo">
      <span class="cf-header-05-v5-logo-dot"></span>
      {{ section.settings.logo_text }}
    </a>
    <nav>
      <ul class="cf-header-05-v5-nav">
        {% for block in section.blocks %}
          <li><a href="{{ block.settings.link }}">{{ block.settings.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="cf-header-05-v5-actions">
      <div class="cf-header-05-v5-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></div>
      <div class="cf-header-05-v5-cart-wrap">
        <div class="cf-header-05-v5-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "05 · K-Beauty",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#fff8f8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#2d2d2d"},
    {"type":"color","id":"accent_color","label":"Accent Color (Peach)","default":"#fb7185"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"HANUEL"},
    {"type":"text","id":"top_text","label":"Announcement Text","default":"🫧 K-Beauty Multi-Step Routines Now Available"},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "nav_item", "name": "Nav Item",
      "settings": [{"type":"text","id":"label","label":"Label","default":"Skincare"},{"type":"url","id":"link","label":"Link"}]
    }
  ],
  "presets": [{"name": "05 · K-Beauty Header","blocks": [{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"},{"type":"nav_item"}]}]
}
{% endschema %}
