<style>
.cf-mq-05-v10 { overflow: hidden; background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 0; }
.cf-mq-05-v10-track { display: flex; animation: mq05v10s {{ section.settings.speed }}s linear infinite; }
.cf-mq-05-v10-track:hover { animation-play-state: paused; }
@keyframes mq05v10s { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.cf-mq-05-v10-item {
  display: inline-flex; align-items: center; gap: 12px;
  padding: 0 35px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 600;
  color: {{ section.settings.text_color }};
  white-space: nowrap;
}
.cf-mq-05-v10-leaf { font-size: 16px; }
</style>

<div class="cf-mq-05-v10">
  <div class="cf-mq-05-v10-track">
    {% for i in (1..4) %}{% for block in section.blocks %}
      <span class="cf-mq-05-v10-item">
        <span class="cf-mq-05-v10-leaf">🌿</span>
        {{ block.settings.text }}
      </span>
    {% endfor %}{% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "10 · Sustainable Marquee",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#dcfce7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#14532d"},
    {"type":"color","id":"accent_color","label":"Leaf Color","default":"#16a34a"},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":24,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":12},
    {"type":"range","id":"speed","label":"Speed (seconds)","min":10,"max":80,"step":5,"default":35}
  ],
  "blocks": [
    {"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Zero-Waste Packaging"}]}
  ],
  "presets": [{"name": "10 · Sustainable Marquee","blocks": [{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
