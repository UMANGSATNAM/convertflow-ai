<style>
.cf-pr-11-v8{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif}
.cf-pr-11-v8-inner{max-width:1400px;margin:0 auto;display:flex;gap:40px;align-items:center}
.cf-pr-11-v8-img-col{flex:1;position:relative}
.cf-pr-11-v8-img{width:100%;height:{{ section.settings.height }}px;object-fit:cover;border-radius:4px}
.cf-pr-11-v8-badge{position:absolute;top:20px;left:-20px;background:{{ section.settings.accent_color }};color:{{ section.settings.bg_color }};padding:10px 20px;font-weight:900;text-transform:uppercase;letter-spacing:0.05em;transform:rotate(-2deg);box-shadow:4px 4px 10px rgba(0,0,0,0.2)}
.cf-pr-11-v8-text-col{flex:1;padding:20px}
.cf-pr-11-v8-title{font-size:clamp(40px,6vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;line-height:1;margin:0 0 20px 0;letter-spacing:-0.03em}
.cf-pr-11-v8-desc{font-size:16px;color:{{ section.settings.text_color }};opacity:0.8;margin-bottom:30px;line-height:1.6;max-width:480px}
.cf-pr-11-v8-features{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:40px}
.cf-pr-11-v8-feature{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;color:{{ section.settings.text_color }};text-transform:uppercase}
.cf-pr-11-v8-icon{color:{{ section.settings.accent_color }}}
.cf-pr-11-v8-btn{display:inline-block;padding:16px 32px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};text-decoration:none;font-weight:800;font-size:14px;text-transform:uppercase;letter-spacing:0.05em;border-radius:4px;transition:0.3s}
.cf-pr-11-v8-btn:hover{background:{{ section.settings.accent_color }};transform:translateY(-2px)}
@media(max-width:900px){.cf-pr-11-v8-inner{flex-direction:column}.cf-pr-11-v8-text-col{padding:0}.cf-pr-11-v8-badge{left:20px}.cf-pr-11-v8-img{height:400px}}
</style>

<div class="cf-pr-11-v8">
  <div class="cf-pr-11-v8-inner">
    <div class="cf-pr-11-v8-img-col">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="cf-pr-11-v8-img">
      {% else %}
        <div style="width:100%;height:{{ section.settings.height }}px;background:#e2e2e2" class="cf-pr-11-v8-img"></div>
      {% endif %}
      <div class="cf-pr-11-v8-badge">{{ section.settings.badge }}</div>
    </div>
    <div class="cf-pr-11-v8-text-col">
      <h2 class="cf-pr-11-v8-title">{{ section.settings.title }}</h2>
      <p class="cf-pr-11-v8-desc">{{ section.settings.desc }}</p>
      
      <div class="cf-pr-11-v8-features">
        <div class="cf-pr-11-v8-feature">
          <svg class="cf-pr-11-v8-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {{ section.settings.feature_1 }}
        </div>
        <div class="cf-pr-11-v8-feature">
          <svg class="cf-pr-11-v8-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {{ section.settings.feature_2 }}
        </div>
        <div class="cf-pr-11-v8-feature">
          <svg class="cf-pr-11-v8-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {{ section.settings.feature_3 }}
        </div>
        <div class="cf-pr-11-v8-feature">
          <svg class="cf-pr-11-v8-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          {{ section.settings.feature_4 }}
        </div>
      </div>
      
      <a href="{{ section.settings.btn_link }}" class="cf-pr-11-v8-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Promo (v8)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"badge","label":"Badge Text","default":"BACK IN STOCK"},
    {"type":"text","id":"title","label":"Title","default":"THE HEAVYWEIGHT PARKA"},
    {"type":"textarea","id":"desc","label":"Description","default":"Engineered to withstand sub-zero temperatures. Water-resistant, insulated, and cut for a tailored but relaxed fit over layers."},
    {"type":"text","id":"feature_1","label":"Feature 1","default":"Water Resistant"},
    {"type":"text","id":"feature_2","label":"Thermal Insulation"},
    {"type":"text","id":"feature_3","label":"Feature 3","default":"Multiple Pockets"},
    {"type":"text","id":"feature_4","label":"Feature 4","default":"Matte Finish"},
    {"type":"text","id":"btn_label","label":"Button Label","default":"ADD TO CART - $195"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F4F4F4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Badge/Icon/Hover","default":"#C84B31"},
    {"type":"range","id":"title_size","label":"Title Size","min":30,"max":80,"step":2,"default":54},
    {"type":"range","id":"height","label":"Image Height (px)","min":400,"max":800,"step":20,"default":600},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Promo (v8)"}]
}
{% endschema %}
