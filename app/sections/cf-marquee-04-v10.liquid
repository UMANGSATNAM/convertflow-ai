<style>
.cf-mq-04-v10 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-mq-04-v10-track {
  display: inline-flex;
  animation: cf-mq-04-v10-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v10-item {
  display: inline-flex;
  align-items: center;
  padding: 0 40px;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.cf-mq-04-v10-icon {
  margin: 0 40px;
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 50%;
  padding: 4px;
}

.cf-mq-04-v10-icon svg {
  width: 16px; height: 16px; stroke-width: 3;
}

@keyframes cf-mq-04-v10-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v10">
  <div class="cf-mq-04-v10-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v10-item">
          <span>{{ block.settings.text }}</span>
          <div class="cf-mq-04-v10-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "10 · Med-Tech Trusted",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#1e3a8a"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Cross Color","default":"#1e3a8a"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":15},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":24,"step":1,"default":14},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":2,"default":30}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"DOCTOR RECOMMENDED"}
      ]
    }
  ],
  "presets": [
    {
      "name": "10 · Med-Tech Trusted",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
