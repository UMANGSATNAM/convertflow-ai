<style>
.cf-head-06{width:100%;background:{{ section.settings.bg_color }};border-bottom:2px solid {{ section.settings.accent_color }}}
.cf-head-06-inner{max-width:1400px;margin:0 auto;display:flex;flex-wrap:wrap}
.cf-head-06-left{display:flex;align-items:center;padding:{{ section.settings.padding_y }}px 24px;border-right:1px solid rgba(255,255,255,0.1);flex:1;min-width:200px}
.cf-head-06-logo{font-family:sans-serif;font-size:clamp(22px,2vw,{{ section.settings.logo_size }}px);font-weight:900;color:{{ section.settings.logo_color }};text-decoration:none;letter-spacing:-0.05em;text-transform:uppercase;font-style:italic}
.cf-head-06-menu{display:none;flex:2;align-items:center;justify-content:center;gap:32px;padding:{{ section.settings.padding_y }}px 24px}
.cf-head-06-link{font-size:14px;font-weight:700;color:{{ section.settings.text_color }};text-transform:uppercase;text-decoration:none;letter-spacing:0.05em;transition:0.2s}
.cf-head-06-link:hover{color:{{ section.settings.accent_color }}}
.cf-head-06-right{display:flex;align-items:center;padding:{{ section.settings.padding_y }}px 24px;border-left:1px solid rgba(255,255,255,0.1)}
.cf-head-06-cart{display:flex;align-items:center;gap:8px;color:{{ section.settings.logo_color }};text-decoration:none;font-weight:700;transition:0.2s}
.cf-head-06-cart:hover{color:{{ section.settings.accent_color }}}
.cf-head-06-cart-icon{background:{{ section.settings.accent_color }};color:#000;width:32px;height:32px;border-radius:0;display:flex;align-items:center;justify-content:center}
@media(min-width:1024px){.cf-head-06-menu{display:flex}}
@media(max-width:768px){.cf-head-06-right{border-left:none}.cf-head-06-left{border-right:none}}
</style>

<header class="cf-head-06">
  <div class="cf-head-06-inner">
    <div class="cf-head-06-left">
      <a href="/" class="cf-head-06-logo" style="display: flex; align-items: center;">
        {% if section.settings.logo_image %}
          <img src="{{ section.settings.logo_image }}" alt="{{ section.settings.logo_text }}" style="max-height: {{ section.settings.logo_size | times: 1.5 }}px; width: auto; max-width: 200px;">
        {% else %}
          {{ section.settings.logo_text }}
        {% endif %}
      </a>
    </div>
    <div class="cf-head-06-menu">
      <a href="{{ section.settings.link_1_url }}" class="cf-head-06-link">{{ section.settings.link_1 }}</a>
      <a href="{{ section.settings.link_2_url }}" class="cf-head-06-link">{{ section.settings.link_2 }}</a>
      <a href="{{ section.settings.link_3_url }}" class="cf-head-06-link">{{ section.settings.link_3 }}</a>
    </div>
    <div class="cf-head-06-right">
      <a href="/cart" class="cf-head-06-cart">
        <span>CART</span>
        <div class="cf-head-06-cart-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "06 · Automotive Header",
  "settings": [
    {"type":"image_picker","id":"logo_image","label":"Logo Image (URL for now)","info":"Paste an image URL here"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"TORQUE"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":20,"max":56,"step":2,"default":36},
    {"type":"text","id":"link_1","label":"Link 1","default":"Parts"},
    {"type":"text","id":"link_1_url","label":"Link 1 URL","default":"/collections/parts"},
    {"type":"text","id":"link_2","label":"Link 2","default":"Accessories"},
    {"type":"text","id":"link_2_url","label":"Link 2 URL","default":"/collections/accessories"},
    {"type":"text","id":"link_3","label":"Link 3","default":"Garage"},
    {"type":"text","id":"link_3_url","label":"Link 3 URL","default":"/pages/garage"},
    {"type":"color","id":"bg_color","label":"Background","default":"#111111"},
    {"type":"color","id":"logo_color","label":"Logo Color","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Link Color","default":"#9ca3af"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#ef4444"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":12,"max":40,"step":2,"default":20}
  ],
  "presets": [{"name":"06 · Automotive Header"}]
}
{% endschema %}
