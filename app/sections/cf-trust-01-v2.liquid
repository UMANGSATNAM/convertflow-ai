<style>
.cf-trust-01-v2{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;border-top:1px solid {{ section.settings.border_color }};border-bottom:1px solid {{ section.settings.border_color }}}
.cf-trust-01-v2-inner{max-width:1400px;margin:0 auto;display:flex;align-items:flex-start;gap:60px}
.cf-trust-01-v2-left{flex:1;position:sticky;top:40px}
.cf-trust-01-v2-title{font-size:clamp(40px, 6vw, 72px);font-weight:400;margin:0;line-height:1.1;letter-spacing:0.02em}
.cf-trust-01-v2-right{flex:1.5;display:flex;flex-direction:column;gap:40px}
.cf-trust-01-v2-item{border-bottom:1px solid {{ section.settings.border_color }};padding-bottom:40px}
.cf-trust-01-v2-item:last-child{border-bottom:none;padding-bottom:0}
.cf-trust-01-v2-item-title{font-size:24px;font-style:italic;margin:0 0 15px 0}
.cf-trust-01-v2-item-desc{font-family:sans-serif;font-size:13px;line-height:1.6;opacity:0.8;margin:0;max-width:500px}
@media(max-width:1024px){
  .cf-trust-01-v2-inner{flex-direction:column}
  .cf-trust-01-v2-left{position:static;margin-bottom:40px}
}
</style>

<div class="cf-trust-01-v2">
  <div class="cf-trust-01-v2-inner">
    <div class="cf-trust-01-v2-left">
      <h2 class="cf-trust-01-v2-title">{{ section.settings.title | newline_to_br }}</h2>
    </div>
    <div class="cf-trust-01-v2-right">
      {% for i in (1..3) %}
        <div class="cf-trust-01-v2-item">
          <h4 class="cf-trust-01-v2-item-title">
            {% if i == 1 %}Exceptional Materials{% elsif i == 2 %}Master Craftsmanship{% else %}Bespoke Service{% endif %}
          </h4>
          <p class="cf-trust-01-v2-item-desc">
            {% if i == 1 %}Sourced exclusively from the world's most renown artisans and tanneries, ensuring unparalleled quality.{% elsif i == 2 %}Every piece is assembled by hand using centuries-old techniques perfected for the modern era.{% else %}Enjoy white-glove delivery, complimentary repairs, and a dedicated personal advisor.{% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Trust (v2)",
  "settings": [
    {"type":"textarea","id":"title","label":"Header Title","default":"The Pillars Of\nExcellence"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#E2DFD8"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Trust (v2)"}]
}
{% endschema %}
