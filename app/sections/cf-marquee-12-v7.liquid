<style>
.cf-marquee-12-v7{width:100%;height:{{ section.settings.height }}px;background:{{ section.settings.bg_color }};position:relative;overflow:hidden;font-family:serif;color:{{ section.settings.text_color }};display:flex;align-items:center}
.cf-marquee-12-v7-track{display:flex;white-space:nowrap;position:absolute;width:200%;animation:cf-scroll-12-v7 {{ section.settings.speed }}s linear infinite}
.cf-marquee-12-v7-content{display:flex;align-items:center;width:50%}
.cf-marquee-12-v7-text-main{font-size:{{ section.settings.font_size }}px;margin:0;letter-spacing:-0.03em;padding:0 20px}
.cf-marquee-12-v7-text-script{font-size:{{ section.settings.font_size | times: 1.2 }}px;font-style:italic;margin:0;padding:0 20px;color:{{ section.settings.accent_color }}}
@keyframes cf-scroll-12-v7{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-12-v7">
  <div class="cf-marquee-12-v7-track">
    <div class="cf-marquee-12-v7-content">
      {% for i in (1..3) %}
        <span class="cf-marquee-12-v7-text-main">{{ section.settings.text_main }}</span>
        <span class="cf-marquee-12-v7-text-script">{{ section.settings.text_script }}</span>
      {% endfor %}
    </div>
    <div class="cf-marquee-12-v7-content">
      {% for i in (1..3) %}
        <span class="cf-marquee-12-v7-text-main">{{ section.settings.text_main }}</span>
        <span class="cf-marquee-12-v7-text-script">{{ section.settings.text_script }}</span>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Marquee (v7)",
  "settings": [
    {"type":"text","id":"text_main","label":"Main Text","default":"THE SPRING"},
    {"type":"text","id":"text_script","label":"Script Text","default":"Collection"},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":35},
    {"type":"range","id":"font_size","label":"Base Font Size (px)","min":30,"max":120,"step":5,"default":80},
    {"type":"range","id":"height","label":"Container Height (px)","min":60,"max":200,"step":10,"default":120},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F2EBE5"},
    {"type":"color","id":"text_color","label":"Main Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Script Text Color","default":"#B59A7A"}
  ],
  "presets": [{"name":"12 · Women's Marquee (v7)"}]
}
{% endschema %}
