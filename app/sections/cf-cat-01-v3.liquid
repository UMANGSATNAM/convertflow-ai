<style>
.cf-cat-01-v3{width:100%;height:100vh;min-height:700px;display:flex;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif}
.cf-cat-01-v3-half{flex:1;position:relative;display:flex;align-items:center;justify-content:center;text-decoration:none;color:inherit;overflow:hidden}
.cf-cat-01-v3-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:1.5s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-cat-01-v3-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.3);transition:0.5s}
.cf-cat-01-v3-half:hover .cf-cat-01-v3-img{transform:scale(1.05)}
.cf-cat-01-v3-half:hover .cf-cat-01-v3-overlay{background:rgba(0,0,0,0.1)}
.cf-cat-01-v3-content{position:relative;z-index:2;text-align:center;color:#FFFFFF}
.cf-cat-01-v3-title{font-size:clamp(50px, 8vw, 120px);font-weight:400;font-style:italic;margin:0 0 20px 0;line-height:0.9;letter-spacing:0.02em}
.cf-cat-01-v3-btn{display:inline-block;border-bottom:1px solid #FFFFFF;padding-bottom:5px;font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;transition:0.3s}
.cf-cat-01-v3-half:hover .cf-cat-01-v3-btn{letter-spacing:0.25em}
@media(max-width:900px){
  .cf-cat-01-v3{flex-direction:column}
}
</style>

<div class="cf-cat-01-v3">
  <a href="#" class="cf-cat-01-v3-half">
    <img src="https://ui-avatars.com/api/?name=W&background=333&color=fff&size=1000" class="cf-cat-01-v3-img" alt="">
    <div class="cf-cat-01-v3-overlay"></div>
    <div class="cf-cat-01-v3-content">
      <h3 class="cf-cat-01-v3-title">Women</h3>
      <span class="cf-cat-01-v3-btn">Explore</span>
    </div>
  </a>
  <a href="#" class="cf-cat-01-v3-half">
    <img src="https://ui-avatars.com/api/?name=M&background=555&color=fff&size=1000" class="cf-cat-01-v3-img" alt="">
    <div class="cf-cat-01-v3-overlay"></div>
    <div class="cf-cat-01-v3-content">
      <h3 class="cf-cat-01-v3-title">Men</h3>
      <span class="cf-cat-01-v3-btn">Explore</span>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v3)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"}
  ],
  "presets": [{"name":"01 · Luxury Category (v3)"}]
}
{% endschema %}
