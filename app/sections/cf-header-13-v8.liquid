<style>
.cf-head-13-v8{width:100%;height:140px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;padding:30px 40px;position:relative}
.cf-head-13-v8-inner{max-width:1800px;margin:0 auto;height:100%;display:flex;justify-content:space-between}
.cf-head-13-v8-logo{font-size:36px;font-weight:900;letter-spacing:-0.03em;text-transform:lowercase;text-decoration:none;color:inherit;align-self:flex-start}
.cf-head-13-v8-nav{align-self:flex-end;display:flex;gap:40px;align-items:center}
.cf-head-13-v8-link{font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:inherit;text-decoration:none;position:relative;padding-bottom:5px;transition:0.3s}
.cf-head-13-v8-link::before{content:"";position:absolute;bottom:0;right:0;width:100%;height:2px;background:{{ section.settings.accent_color }};transform:scaleX(0);transform-origin:right;transition:transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)}
.cf-head-13-v8-link:hover::before{transform:scaleX(1);transform-origin:left}
.cf-head-13-v8-actions{align-self:flex-end;display:flex;gap:25px;margin-left:20px}
.cf-head-13-v8-icon{cursor:pointer;transition:0.3s}
.cf-head-13-v8-icon:hover{color:{{ section.settings.accent_color }};transform:translateY(-2px)}
.cf-head-13-v8-mobile{display:none}
@media(max-width:900px){
  .cf-head-13-v8{height:90px;padding:20px 20px}
  .cf-head-13-v8-nav{display:none}
  .cf-head-13-v8-actions{align-self:center}
  .cf-head-13-v8-logo{font-size:28px;align-self:center;flex:1}
  .cf-head-13-v8-mobile{display:block;cursor:pointer;align-self:center}
}
</style>

<div class="cf-head-13-v8">
  <div class="cf-head-13-v8-inner">
    
    <div class="cf-head-13-v8-mobile" style="margin-right:20px;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </div>

    <a href="/" class="cf-head-13-v8-logo">
      {{ section.settings.logo_text }}
    </a>

    <div class="cf-head-13-v8-nav">
      {% for link in linklists[section.settings.menu].links limit:4 %}
        <a href="{{ link.url }}" class="cf-head-13-v8-link">{{ link.title }}</a>
      {% else %}
        <a href="#" class="cf-head-13-v8-link">Collections</a>
        <a href="#" class="cf-head-13-v8-link">Footwear</a>
        <a href="#" class="cf-head-13-v8-link">Lookbook</a>
        <a href="#" class="cf-head-13-v8-link">Stores</a>
      {% endfor %}
    </div>

    <div class="cf-head-13-v8-actions">
      <div class="cf-head-13-v8-icon">
        <svg fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <div class="cf-head-13-v8-icon">
        <svg fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Header (v8)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"division"},
    {"type":"link_list","id":"menu","label":"Navigation Menu"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Underline","default":"#4422EE"}
  ],
  "presets": [{"name":"13 · Brand Header (v8)"}]
}
{% endschema %}
