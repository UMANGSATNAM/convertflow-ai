<style>
.cf-sn-03{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:monospace;border-bottom:1px solid rgba(255,255,255,0.05)}
.cf-sn-03-inner{max-width:800px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:20px;background:#0f172a;border-radius:8px;border:1px solid rgba(16,185,129,0.2);padding:16px 24px}
.cf-sn-03-icon{color:{{ section.settings.accent_color }}}
.cf-sn-03-text{color:{{ section.settings.text_color }};font-size:{{ section.settings.text_size }}px}
.cf-sn-03-code{display:inline-flex;align-items:center;gap:8px;background:rgba(16,185,129,0.1);padding:4px 12px;border-radius:4px;color:{{ section.settings.accent_color }};font-weight:700}
.cf-sn-03-copy{cursor:pointer;opacity:0.6;transition:0.2s}
.cf-sn-03-copy:hover{opacity:1;color:#fff}
@media(max-width:600px){.cf-sn-03-inner{flex-direction:column;text-align:center;gap:12px}}
</style>

<div class="cf-sn-03">
  <div class="cf-sn-03-inner">
    <div class="cf-sn-03-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg></div>
    <div class="cf-sn-03-text">{{ section.settings.text }}</div>
    <div class="cf-sn-03-code">
      {{ section.settings.code }}
      <div class="cf-sn-03-copy" onclick="navigator.clipboard.writeText('{{ section.settings.code }}');alert('Copied to clipboard!')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Tech Snack",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"SYSTEM.PROMO.DETECTED // APPLY AT CHECKOUT:"},
    {"type":"text","id":"code","label":"Promo Code","default":"CYBER25"},
    {"type":"range","id":"text_size","label":"Text Size","min":10,"max":24,"step":1,"default":14},
    {"type":"color","id":"bg_color","label":"Outer Background","default":"#020617"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#94a3b8"},
    {"type":"color","id":"accent_color","label":"Accent (Green)","default":"#10b981"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":60,"step":5,"default":20}
  ],
  "presets": [{"name":"03 · Tech Snack"}]
}
{% endschema %}
