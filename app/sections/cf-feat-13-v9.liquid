<style>
.cf-feat-13-v9{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif}
.cf-feat-13-v9-inner{max-width:1600px;margin:0 auto;display:grid;grid-template-columns:1fr 400px;gap:60px}
.cf-feat-13-v9-left{display:flex;flex-direction:column;justify-content:center}
.cf-feat-13-v9-title{font-size:clamp(60px, 10vw, 150px);font-weight:900;text-transform:uppercase;letter-spacing:-0.04em;line-height:0.8;margin:0 0 40px 0}
.cf-feat-13-v9-btn{display:inline-block;border-bottom:2px solid {{ section.settings.text_color }};padding-bottom:5px;font-size:14px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;color:inherit;align-self:flex-start;transition:0.3s}
.cf-feat-13-v9-btn:hover{color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }}}
.cf-feat-13-v9-stack{display:flex;flex-direction:column;gap:60px}
.cf-feat-13-v9-card{text-decoration:none;color:inherit;display:block}
.cf-feat-13-v9-img-wrap{width:100%;aspect-ratio:3/4;background:#f5f5f5;margin-bottom:20px;overflow:hidden}
.cf-feat-13-v9-img{width:100%;height:100%;object-fit:cover;transition:0.6s}
.cf-feat-13-v9-card:hover .cf-feat-13-v9-img{transform:scale(1.05)}
.cf-feat-13-v9-info{display:flex;justify-content:space-between;align-items:flex-end}
.cf-feat-13-v9-name{font-size:16px;font-weight:800;text-transform:uppercase;margin:0 0 5px 0;letter-spacing:-0.01em}
.cf-feat-13-v9-type{font-size:12px;opacity:0.6;margin:0}
.cf-feat-13-v9-price{font-size:16px;font-weight:800}
@media(max-width:1024px){
  .cf-feat-13-v9-inner{grid-template-columns:1fr;gap:40px}
  .cf-feat-13-v9-title{font-size:60px}
  .cf-feat-13-v9-stack{display:grid;grid-template-columns:1fr 1fr;gap:20px}
}
@media(max-width:600px){
  .cf-feat-13-v9-stack{grid-template-columns:1fr}
}
</style>

<div class="cf-feat-13-v9">
  <div class="cf-feat-13-v9-inner">
    <div class="cf-feat-13-v9-left">
      <h2 class="cf-feat-13-v9-title">{{ section.settings.title | newline_to_br }}</h2>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-feat-13-v9-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    
    <div class="cf-feat-13-v9-stack">
      {% for i in (1..3) %}
        <a href="#" class="cf-feat-13-v9-card">
          <div class="cf-feat-13-v9-img-wrap">
            <div class="cf-feat-13-v9-img" style="background:#dfdfdf;"></div>
          </div>
          <div class="cf-feat-13-v9-info">
            <div>
              <h3 class="cf-feat-13-v9-name">Signature Object 0{{ i }}</h3>
              <p class="cf-feat-13-v9-type">Accessories</p>
            </div>
            <div class="cf-feat-13-v9-price">$1,100</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Featured (v9)",
  "settings": [
    {"type":"textarea","id":"title","label":"Giant Typography (Newlines ok)","default":"OBJECTS\nOF\nDESIRE"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Explore Objects"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Featured (v9)"}]
}
{% endschema %}
