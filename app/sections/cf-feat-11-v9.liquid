<style>
.cf-feat-11-v9{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-11-v9-inner{max-width:1400px;margin:0 auto}
.cf-feat-11-v9-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px}
.cf-feat-11-v9-title{font-size:20px;font-weight:900;text-transform:uppercase;letter-spacing:0.1em;position:relative;padding-left:15px;margin:0}
.cf-feat-11-v9-title::before{content:'';position:absolute;left:0;top:-50%;height:200%;width:4px;background:{{ section.settings.text_color }}}
.cf-feat-11-v9-btn{padding:10px 20px;background:transparent;border:2px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;transition:0.3s}
.cf-feat-11-v9-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-feat-11-v9-grid{display:grid;grid-template-columns:repeat(5, 1fr);gap:15px}
.cf-feat-11-v9-card{text-decoration:none;display:flex;flex-direction:column;gap:10px}
.cf-feat-11-v9-img-wrap{width:100%;aspect-ratio:3/4;overflow:hidden;position:relative;background:#eee}
.cf-feat-11-v9-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:0.5s}
.cf-feat-11-v9-card:hover .cf-feat-11-v9-img{transform:scale(1.05)}
.cf-feat-11-v9-info{text-align:center}
.cf-feat-11-v9-name{font-size:12px;font-weight:800;text-transform:uppercase;color:{{ section.settings.text_color }};margin:0 0 5px 0;letter-spacing:0.05em}
.cf-feat-11-v9-price{font-size:14px;color:{{ section.settings.text_color }};margin:0;opacity:0.8}
@media(max-width:1024px){.cf-feat-11-v9-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:600px){.cf-feat-11-v9-grid{grid-template-columns:repeat(2,1fr)}.cf-feat-11-v9-top{flex-direction:column;gap:20px}}
</style>

<div class="cf-feat-11-v9">
  <div class="cf-feat-11-v9-inner">
    <div class="cf-feat-11-v9-top">
      <h2 class="cf-feat-11-v9-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-feat-11-v9-btn">{{ section.settings.btn_label }}</a>
    </div>
    
    <div class="cf-feat-11-v9-grid">
      {% for i in (1..5) %}
        {% capture img_key %}img_{{ i }}{% endcapture %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture price_key %}price_{{ i }}{% endcapture %}
        {% capture link_key %}link_{{ i }}{% endcapture %}
        <a href="{{ section.settings[link_key] }}" class="cf-feat-11-v9-card">
          <div class="cf-feat-11-v9-img-wrap">
             {% if section.settings[img_key] %}
               <img src="{{ section.settings[img_key] | image_url: width: 400 }}" class="cf-feat-11-v9-img">
             {% else %}
               <div style="background:#555;width:100%;height:100%"></div>
             {% endif %}
          </div>
          <div class="cf-feat-11-v9-info">
             <h3 class="cf-feat-11-v9-name">{{ section.settings[title_key] }}</h3>
             <p class="cf-feat-11-v9-price">{{ section.settings[price_key] }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Featured (v9)",
  "settings": [
    {"type":"text","id":"title","label":"Section Title","default":"BEST SELLERS"},
    {"type":"text","id":"btn_label","label":"Button Label","default":"SHOP ALL BEST SELLERS"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    
    {"type":"image_picker","id":"img_1","label":"Product 1 Image"},
    {"type":"text","id":"title_1","label":"Product 1 Title","default":"ESSENTIAL TEE"},
    {"type":"text","id":"price_1","label":"Product 1 Price","default":"$35"},
    {"type":"url","id":"link_1","label":"Product 1 Link"},
    
    {"type":"image_picker","id":"img_2","label":"Product 2 Image"},
    {"type":"text","id":"title_2","label":"Product 2 Title","default":"CHINO PANT"},
    {"type":"text","id":"price_2","label":"Product 2 Price","default":"$95"},
    {"type":"url","id":"link_2","label":"Product 2 Link"},
    
    {"type":"image_picker","id":"img_3","label":"Product 3 Image"},
    {"type":"text","id":"title_3","label":"Product 3 Title","default":"DENIM JACKET"},
    {"type":"text","id":"price_3","label":"Product 3 Price","default":"$120"},
    {"type":"url","id":"link_3","label":"Product 3 Link"},
    
    {"type":"image_picker","id":"img_4","label":"Product 4 Image"},
    {"type":"text","id":"title_4","label":"Product 4 Title","default":"CREWNECK SWEATER"},
    {"type":"text","id":"price_4","label":"Product 4 Price","default":"$85"},
    {"type":"url","id":"link_4","label":"Product 4 Link"},
    
    {"type":"image_picker","id":"img_5","label":"Product 5 Image"},
    {"type":"text","id":"title_5","label":"Product 5 Title","default":"RUNNING SNEAKER"},
    {"type":"text","id":"price_5","label":"Product 5 Price","default":"$150"},
    {"type":"url","id":"link_5","label":"Product 5 Link"},
    
    {"type":"color","id":"bg_color","label":"Background","default":"#F9F9F9"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"11 · Men's Featured (v9)"}]
}
{% endschema %}
