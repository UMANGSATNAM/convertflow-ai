<style>
.cf-cat-12-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }}}
.cf-cat-12-v4-inner{max-width:1400px;margin:0 auto;display:flex;gap:40px;align-items:center}
.cf-cat-12-v4-info{flex:0 0 350px}
.cf-cat-12-v4-sub{font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.2em;color:{{ section.settings.accent_color }};display:block;margin-bottom:20px}
.cf-cat-12-v4-title{font-size:clamp(36px, 4vw, 56px);font-weight:300;line-height:1.1;margin:0 0 30px 0}
.cf-cat-12-v4-desc{font-family:sans-serif;font-size:14px;line-height:1.6;margin:0 0 40px 0;opacity:0.8}
.cf-cat-12-v4-btn{display:inline-block;padding:12px 30px;border:1px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;text-decoration:none;transition:0.3s}
.cf-cat-12-v4-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-cat-12-v4-grid{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:20px}
.cf-cat-12-v4-card{position:relative;height:350px;text-decoration:none;overflow:hidden;border-radius:{{ section.settings.border_radius }}px}
.cf-cat-12-v4-card-large{height:{{ section.settings.large_height }}px;grid-column:1/-1}
.cf-cat-12-v4-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-cat-12-v4-card:hover .cf-cat-12-v4-img{transform:scale(1.05)}
.cf-cat-12-v4-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.15);display:flex;align-items:center;justify-content:center;transition:0.3s}
.cf-cat-12-v4-card:hover .cf-cat-12-v4-overlay{background:rgba(0,0,0,0.3)}
.cf-cat-12-v4-label{color:#fff;font-size:24px;font-style:italic;text-shadow:0 2px 10px rgba(0,0,0,0.2)}
@media(max-width:1024px){.cf-cat-12-v4-inner{flex-direction:column}.cf-cat-12-v4-info{flex:none;text-align:center;max-width:600px;margin:0 auto}}
@media(max-width:600px){.cf-cat-12-v4-grid{grid-template-columns:1fr}.cf-cat-12-v4-card-large,.cf-cat-12-v4-card{height:300px}}
</style>

<div class="cf-cat-12-v4">
  <div class="cf-cat-12-v4-inner">
    <div class="cf-cat-12-v4-info">
      <span class="cf-cat-12-v4-sub">{{ section.settings.subtitle }}</span>
      <h2 class="cf-cat-12-v4-title">{{ section.settings.title | newline_to_br }}</h2>
      <p class="cf-cat-12-v4-desc">{{ section.settings.desc }}</p>
      <a href="{{ section.settings.btn_link }}" class="cf-cat-12-v4-btn">{{ section.settings.btn_label }}</a>
    </div>
    
    <div class="cf-cat-12-v4-grid">
      <a href="#" class="cf-cat-12-v4-card cf-cat-12-v4-card-large">
        <div class="cf-cat-12-v4-img" style="background:#ddd;"></div>
        <div class="cf-cat-12-v4-overlay">
          <span class="cf-cat-12-v4-label">Shop Dresses</span>
        </div>
      </a>
      <a href="#" class="cf-cat-12-v4-card">
        <div class="cf-cat-12-v4-img" style="background:#eee;"></div>
        <div class="cf-cat-12-v4-overlay">
          <span class="cf-cat-12-v4-label">Tops</span>
        </div>
      </a>
      <a href="#" class="cf-cat-12-v4-card">
        <div class="cf-cat-12-v4-img" style="background:#ccc;"></div>
        <div class="cf-cat-12-v4-overlay">
          <span class="cf-cat-12-v4-label">Denim</span>
        </div>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Category (v4)",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"COLLECTIONS"},
    {"type":"textarea","id":"title","label":"Header Title","default":"The Ready to\nWear Edit."},
    {"type":"textarea","id":"desc","label":"Description","default":"Build your core wardrobe with our essential styles, carefully crafted to elevate the everyday."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"VIEW ALL STYLES"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Subtitle Color","default":"#957B5E"},
    {"type":"range","id":"border_radius","label":"Card Rounding","min":0,"max":20,"step":2,"default":0},
    {"type":"range","id":"large_height","label":"Large Hero Card Height","min":300,"max":600,"step":20,"default":450},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":10,"default":80}
  ],
  "presets": [{"name":"12 · Women's Category (v4)"}]
}
{% endschema %}
