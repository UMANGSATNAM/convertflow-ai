<style>
.cf-fc-05-v10 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-fc-05-v10-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-fc-05-v10-header { margin-bottom: 40px; }
.cf-fc-05-v10-eyebrow { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; color: {{ section.settings.accent_color }}; margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
.cf-fc-05-v10-eyebrow::before { content: '🌿'; }
.cf-fc-05-v10-title { font-size: 34px; font-weight: 700; color: {{ section.settings.text_color }}; margin: 0; }
.cf-fc-05-v10-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 20px; }
.cf-fc-05-v10-card { text-decoration: none; display: flex; flex-direction: column; background: #fff; border: 1px solid {{ section.settings.border_color }}; border-radius: 12px; overflow: hidden; transition: border-color 0.2s; }
.cf-fc-05-v10-card:hover { border-color: {{ section.settings.accent_color }}; }
.cf-fc-05-v10-img { aspect-ratio: 1; overflow: hidden; background: #f0fdf4; position: relative; }
.cf-fc-05-v10-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; transition: transform 0.4s; }
.cf-fc-05-v10-card:hover .cf-fc-05-v10-img img { transform: scale(1.05); }
.cf-fc-05-v10-info { padding: 15px; flex: 1; }
.cf-fc-05-v10-cert { font-size: 11px; color: {{ section.settings.accent_color }}; font-weight: 700; text-transform: uppercase; margin-bottom: 5px; }
.cf-fc-05-v10-name { color: {{ section.settings.text_color }}; font-size: 15px; font-weight: 700; margin: 0 0 8px 0; }
.cf-fc-05-v10-price { color: {{ section.settings.text_color }}; font-weight: 700; font-size: 15px; }
@media (max-width: 900px) { .cf-fc-05-v10-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-fc-05-v10">
  <div class="cf-fc-05-v10-inner">
    <div class="cf-fc-05-v10-header">
      <div class="cf-fc-05-v10-eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="cf-fc-05-v10-title">{{ section.settings.title }}</h2>
    </div>
    <div class="cf-fc-05-v10-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.url }}" class="cf-fc-05-v10-card">
        <div class="cf-fc-05-v10-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-fc-05-v10-info">
          {% if block.settings.cert != blank %}<div class="cf-fc-05-v10-cert">{{ block.settings.cert }}</div>{% endif %}
          <div class="cf-fc-05-v10-name">{{ block.settings.title }}</div>
          <div class="cf-fc-05-v10-price">{{ block.settings.price }}</div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "10 · Sustainable Products","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#f0fdf4"},{"type":"color","id":"text_color","label":"Text Color","default":"#14532d"},{"type":"color","id":"border_color","label":"Border Color","default":"#bbf7d0"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#16a34a"},{"type":"text","id":"eyebrow","label":"Eyebrow Text","default":"Eco-Certified"},{"type":"text","id":"title","label":"Title","default":"Better for You, Better for Earth"},{"type":"range","id":"cols","label":"Columns","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "product","name": "Product","settings": [{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"cert","label":"Certification","default":"ECOCERT Organic"},{"type":"text","id":"title","label":"Title","default":"Refillable Serum"},{"type":"text","id":"price","label":"Price","default":"$45.00"},{"type":"url","id":"url","label":"Link"}]}],"presets": [{"name": "10 · Sustainable Products","blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}{% endschema %}
