<style>
.cf-snack-01-v9{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;text-align:center;padding:{{ section.settings.padding_y }}px 20px;border-bottom:3px solid {{ section.settings.accent_color }}}
.cf-snack-01-v9-inner{max-width:800px;margin:0 auto;display:flex;flex-direction:column;align-items:center}
.cf-snack-01-v9-icon{margin-bottom:20px;color:{{ section.settings.accent_color }}}
.cf-snack-01-v9-icon svg{width:28px;height:28px;fill:none;stroke:currentColor;stroke-width:1.5}
.cf-snack-01-v9-title{font-size:20px;font-style:italic;margin:0 0 10px 0;letter-spacing:0.02em}
.cf-snack-01-v9-action{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:{{ section.settings.accent_color }};text-decoration:none;transition:0.3s}
.cf-snack-01-v9-action:hover{opacity:0.7}
</style>

<div class="cf-snack-01-v9">
  <div class="cf-snack-01-v9-inner">
    <div class="cf-snack-01-v9-icon">
      <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    </div>
    <h3 class="cf-snack-01-v9-title">{{ section.settings.title }}</h3>
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="cf-snack-01-v9-action">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Snack (v9)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"All items are authenticated by our experts."},
    {"type":"text","id":"btn_text","label":"Button/Link Text","default":"Read about our process"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent & Border Color","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"01 · Luxury Snack (v9)"}]
}
{% endschema %}
