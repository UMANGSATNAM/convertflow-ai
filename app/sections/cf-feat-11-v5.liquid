<style>
.cf-feat-11-v5{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-11-v5-inner{max-width:1400px;margin:0 auto}
.cf-feat-11-v5-list{display:flex;flex-direction:column}
.cf-feat-11-v5-row{display:flex;align-items:center;justify-content:space-between;padding:30px 0;border-bottom:1px solid {{ section.settings.border_color }};text-decoration:none;transition:0.3s;position:relative}
.cf-feat-11-v5-row:hover{padding-left:20px;padding-right:20px;background:{{ section.settings.hover_bg }};border-radius:4px}
.cf-feat-11-v5-row:first-child{border-top:1px solid {{ section.settings.border_color }}}
.cf-feat-11-v5-left{display:flex;align-items:center;gap:30px}
.cf-feat-11-v5-img-wrap{width:80px;height:100px;background:#e5e5e5;overflow:hidden;border-radius:2px}
.cf-feat-11-v5-img{width:100%;height:100%;object-fit:cover;transition:0.4s}
.cf-feat-11-v5-row:hover .cf-feat-11-v5-img{transform:scale(1.1)}
.cf-feat-11-v5-name{font-size:24px;font-weight:900;text-transform:uppercase;color:{{ section.settings.text_color }};margin:0;letter-spacing:-0.01em}
.cf-feat-11-v5-right{display:flex;align-items:center;gap:40px}
.cf-feat-11-v5-price{font-size:18px;font-weight:700;color:{{ section.settings.text_color }}}
.cf-feat-11-v5-btn{display:inline-block;padding:12px 30px;background:none;border:2px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;border-radius:40px;transition:0.3s}
.cf-feat-11-v5-row:hover .cf-feat-11-v5-btn{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
@media(max-width:768px){.cf-feat-11-v5-row{flex-direction:column;align-items:flex-start;gap:20px}.cf-feat-11-v5-right{width:100%;justify-content:space-between}.cf-feat-11-v5-row:hover{padding:20px}}
</style>

<div class="cf-feat-11-v5">
  <div class="cf-feat-11-v5-inner">
    <div class="cf-feat-11-v5-list">
      {% for i in (1..5) %}
        {% capture img_key %}img_{{ i }}{% endcapture %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture price_key %}price_{{ i }}{% endcapture %}
        {% capture link_key %}link_{{ i }}{% endcapture %}
        
        <a href="{{ section.settings[link_key] }}" class="cf-feat-11-v5-row">
          <div class="cf-feat-11-v5-left">
            <div class="cf-feat-11-v5-img-wrap">
              {% if section.settings[img_key] %}
                <img src="{{ section.settings[img_key] | image_url: width: 200 }}" class="cf-feat-11-v5-img">
              {% else %}
                <div style="background:#555;width:100%;height:100%"></div>
              {% endif %}
            </div>
            <h3 class="cf-feat-11-v5-name">{{ section.settings[title_key] }}</h3>
          </div>
          <div class="cf-feat-11-v5-right">
            <span class="cf-feat-11-v5-price">{{ section.settings[price_key] }}</span>
            <span class="cf-feat-11-v5-btn">VIEW</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Featured (v5)",
  "settings": [
    {"type":"image_picker","id":"img_1","label":"Product 1 Image"},
    {"type":"text","id":"title_1","label":"Product 1 Title","default":"WATERPROOF MAC"},
    {"type":"text","id":"price_1","label":"Product 1 Price","default":"$260"},
    {"type":"url","id":"link_1","label":"Product 1 Link"},
    {"type":"image_picker","id":"img_2","label":"Product 2 Image"},
    {"type":"text","id":"title_2","label":"Product 2 Title","default":"CASHMERE CREWNECK"},
    {"type":"text","id":"price_2","label":"Product 2 Price","default":"$180"},
    {"type":"url","id":"link_2","label":"Product 2 Link"},
    {"type":"image_picker","id":"img_3","label":"Product 3 Image"},
    {"type":"text","id":"title_3","label":"Product 3 Title","default":"SLIM SELVEDGE JEANS"},
    {"type":"text","id":"price_3","label":"Product 3 Price","default":"$145"},
    {"type":"url","id":"link_3","label":"Product 3 Link"},
    {"type":"image_picker","id":"img_4","label":"Product 4 Image"},
    {"type":"text","id":"title_4","label":"Product 4 Title","default":"LEATHER SNEAKERS"},
    {"type":"text","id":"price_4","label":"Product 4 Price","default":"$190"},
    {"type":"url","id":"link_4","label":"Product 4 Link"},
    {"type":"image_picker","id":"img_5","label":"Product 5 Image"},
    {"type":"text","id":"title_5","label":"Product 5 Title","default":"WEEKENDER DUFFLE"},
    {"type":"text","id":"price_5","label":"Product 5 Price","default":"$320"},
    {"type":"url","id":"link_5","label":"Product 5 Link"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"hover_bg","label":"Row Hover Background","default":"#F6F6F6"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Divider Line","default":"#E2E2E2"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"11 · Men's Featured (v5)"}]
}
{% endschema %}
