<style>
.cf-cat-04-v4 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-cat-04-v4-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v4-title {
  font-size: 28px;
  font-weight: 800;
  color: {{ section.settings.text_color }};
  text-align: center;
  margin: 0 0 40px 0;
  letter-spacing: -0.02em;
}

.cf-cat-04-v4-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 20px;
}

.cf-cat-04-v4-item {
  background: #fff;
  border: 1px solid {{ section.settings.border_color }};
  padding: 30px;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 20px;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.cf-cat-04-v4-item:hover {
  border-color: {{ section.settings.accent_color }};
  box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

.cf-cat-04-v4-icon {
  width: 50px;
  height: 50px;
  background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  color: {{ section.settings.accent_color }};
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cf-cat-04-v4-icon svg {
  width: 24px; height: 24px; stroke-width: 2;
}

.cf-cat-04-v4-info {
  flex: 1;
}

.cf-cat-04-v4-name {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 700;
  margin: 0 0 5px 0;
}

.cf-cat-04-v4-count {
  font-size: 13px;
  color: #64748b;
  margin: 0;
}

@media (max-width: 900px) {
  .cf-cat-04-v4-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .cf-cat-04-v4-grid { grid-template-columns: 1fr; }
}
</style>

<div class="cf-cat-04-v4">
  <div class="cf-cat-04-v4-inner">
    <h2 class="cf-cat-04-v4-title">{{ section.settings.title }}</h2>

    <div class="cf-cat-04-v4-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v4-item">
          <div class="cf-cat-04-v4-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          </div>
          <div class="cf-cat-04-v4-info">
            <h3 class="cf-cat-04-v4-name">{{ block.settings.title }}</h3>
            <p class="cf-cat-04-v4-count">{{ block.settings.count }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Clinical Categories",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f8fafc"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#2563eb"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},
    {"type":"text","id":"title","label":"Title","default":"Targeted Treatments"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":4,"step":1,"default":3},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Category Name","default":"Joint Support"},
        {"type":"text","id":"count","label":"Item Count Text","default":"12 Formulations"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "04 · Clinical Categories",
      "blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]
    }
  ]
}
{% endschema %}
