<style>
.cf-trust-13-v7{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};display:flex;justify-content:center;text-align:center;font-family:serif}
.cf-trust-13-v7-inner{max-width:900px}
.cf-trust-13-v7-icon{margin-bottom:30px}
.cf-trust-13-v7-icon svg{width:40px;height:40px;stroke-width:1;stroke:{{ section.settings.text_color }};fill:none}
.cf-trust-13-v7-title{font-size:clamp(28px, 4vw, 48px);font-weight:400;font-style:italic;line-height:1.2;margin:0 0 30px 0;letter-spacing:0.02em}
.cf-trust-13-v7-desc{font-size:14px;font-family:sans-serif;line-height:1.6;opacity:0.8;margin:0 0 40px 0;text-transform:uppercase;letter-spacing:0.1em}
.cf-trust-13-v7-signature{font-family:'Brush Script MT', cursive, serif;font-size:32px;opacity:0.6}
</style>

<div class="cf-trust-13-v7">
  <div class="cf-trust-13-v7-inner">
    <div class="cf-trust-13-v7-icon">
      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
    </div>
    <h2 class="cf-trust-13-v7-title">{{ section.settings.title }}</h2>
    <p class="cf-trust-13-v7-desc">{{ section.settings.desc }}</p>
    <div class="cf-trust-13-v7-signature">{{ section.settings.signature }}</div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Trust (v7)",
  "settings": [
    {"type":"text","id":"title","label":"Warranty/Ethos Statement","default":"A Commitment to Enduring Quality"},
    {"type":"textarea","id":"desc","label":"Description","default":"EVERY GARMENT CARRIES A LIFETIME GUARANTEE AGAINST STRUCTURAL DEFECTS."},
    {"type":"text","id":"signature","label":"Signature Sign-off","default":"The Studio Team"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#F4ECE4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#1A1A1A"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Trust (v7)"}]
}
{% endschema %}
