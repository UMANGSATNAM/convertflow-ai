<style>
.cf-mq-03-v10 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  display: flex;
  font-family: 'Inter', sans-serif;
  border-top: 1px solid #111;
  border-bottom: 1px solid #111;
}

.cf-mq-03-v10-track {
  display: flex;
  white-space: nowrap;
  animation: cf-mq-03-v10-scroll {{ section.settings.speed }}s linear infinite;
}

@keyframes cf-mq-03-v10-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.cf-mq-03-v10-item {
  display: flex;
  align-items: center;
  padding: 0 40px;
  font-size: {{ section.settings.text_size }}px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-style: italic;
  /* RGB Gradient Text Animation */
  background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: cf-mq-03-v10-rgb {{ section.settings.rgb_speed }}s linear infinite;
}

@keyframes cf-mq-03-v10-rgb {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

.cf-mq-03-v10-separator {
  color: #333;
  margin-left: 40px;
  font-size: {{ section.settings.text_size | times: 1.2 }}px;
}
</style>

<div class="cf-mq-03-v10">
  <div class="cf-mq-03-v10-track">
    {% for block in section.blocks %}
      <div class="cf-mq-03-v10-item">{{ block.settings.text }}</div>
      <div class="cf-mq-03-v10-separator">•</div>
    {% endfor %}
    {% for block in section.blocks %}
      <div class="cf-mq-03-v10-item">{{ block.settings.text }}</div>
      <div class="cf-mq-03-v10-separator">•</div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "10 · Gamer RGB Sync",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#0b0b0f"},
    {"type":"range","id":"text_size","label":"Text Size","min":16,"max":72,"step":2,"default":32},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":5,"default":20},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":20},
    {"type":"range","id":"rgb_speed","label":"RGB Shift Speed (Seconds)","min":1,"max":10,"step":1,"default":3}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "limit": 6,
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"GEAR UP AND CONQUER"}
      ]
    }
  ],
  "presets": [
    {
      "name": "10 · Gamer RGB Sync Marquee",
      "blocks": [
        {"type": "text"},
        {"type": "text"},
        {"type": "text"}
      ]
    }
  ]
}
{% endschema %}
