<style>
.cf-h-11-v8{width:100%;font-family:sans-serif;position:relative}
.cf-h-11-v8-bar{background:{{ section.settings.accent_color }};color:{{ section.settings.bg_color }};text-align:center;padding:10px;font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase}
.cf-h-11-v8-main{background:{{ section.settings.bg_color }};padding:0 50px;height:{{ section.settings.height }}px;display:flex;align-items:center;color:{{ section.settings.text_color }}}
.cf-h-11-v8-col{flex:1;display:flex;align-items:center}
.cf-h-11-v8-logo{font-size:22px;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;text-decoration:none;color:inherit}
.cf-h-11-v8-nav{display:flex;gap:35px}
.cf-h-11-v8-link{text-decoration:none;color:inherit;font-size:12px;font-weight:600;text-transform:uppercase;transition:color 0.3s;position:relative}
.cf-h-11-v8-link:hover{color:{{ section.settings.accent_color }}}
.cf-h-11-v8-mobile{display:none;background:none;border:none;color:inherit}
.cf-h-11-v8-icon-btn{color:inherit;transition:0.3s;background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700;text-transform:uppercase;text-decoration:none}
.cf-h-11-v8-icon-btn:hover{color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-h-11-v8-nav{display:none}.cf-h-11-v8-mobile{display:block}.cf-h-11-v8-main{padding:0 20px}.cf-h-11-v8-icon-btn span{display:none}}
</style>

<div class="cf-h-11-v8">
  <div class="cf-h-11-v8-bar">{{ section.settings.promo_text }}</div>
  
  <div class="cf-h-11-v8-main">
    <div class="cf-h-11-v8-col">
       <button class="cf-h-11-v8-mobile" aria-label="Menu">
         <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
       </button>
       <div class="cf-h-11-v8-nav">
        {% for link in linklists[section.settings.menu].links limit:4 %}
          <a href="{{ link.url }}" class="cf-h-11-v8-link">{{ link.title }}</a>
        {% else %}
          <a href="#" class="cf-h-11-v8-link">Just In</a>
          <a href="#" class="cf-h-11-v8-link">Apparel</a>
          <a href="#" class="cf-h-11-v8-link">Grooming</a>
        {% endfor %}
       </div>
    </div>
    
    <div class="cf-h-11-v8-col" style="justify-content:center;">
      <a href="/" class="cf-h-11-v8-logo">{{ section.settings.logo_text }}</a>
    </div>
    
    <div class="cf-h-11-v8-col" style="justify-content:flex-end;gap:20px;">
      <a href="/search" class="cf-h-11-v8-icon-btn">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
         <span>Search</span>
      </a>
      <a href="/cart" class="cf-h-11-v8-icon-btn">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
         <span>Cart [0]</span>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Header (v8)",
  "settings": [
    {"type":"text","id":"promo_text","label":"Promo Bar Text","default":"SEASON END SALE - UP TO 40% OFF"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"GENTLEMAN"},
    {"type":"link_list","id":"menu","label":"Left Navigation"},
    {"type":"color","id":"bg_color","label":"Background","default":"#1C1C1C"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#F2F2F2"},
    {"type":"color","id":"accent_color","label":"Accent / Promo Bg","default":"#A37B5C"},
    {"type":"range","id":"height","label":"Main Height","min":60,"max":120,"step":5,"default":85}
  ],
  "presets": [{"name":"11 · Men's Header (v8)"}]
}
{% endschema %}
