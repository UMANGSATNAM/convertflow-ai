<style>
.cf-mq-04-v3 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: 'Georgia', serif;
}

.cf-mq-04-v3-track {
  display: inline-flex;
  animation: cf-mq-04-v3-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v3-item {
  display: inline-flex;
  align-items: center;
  padding: 0 40px;
  font-size: {{ section.settings.font_size }}px;
  font-style: italic;
  letter-spacing: 0.02em;
}

.cf-mq-04-v3-icon {
  margin: 0 40px;
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
}

.cf-mq-04-v3-icon svg {
  width: 20px; height: 20px;
}

@keyframes cf-mq-04-v3-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v3">
  <div class="cf-mq-04-v3-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v3-item">
          <span>{{ block.settings.text }}</span>
          <div class="cf-mq-04-v3-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c0-8 8-10 8-14a8 8 0 0 0-16 0c0 4 8 6 8 14z"/></svg>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "03 · Organic Flow",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4A4A4A"},
    {"type":"color","id":"accent_color","label":"Leaf Icon Color","default":"#A3B18A"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20},
    {"type":"range","id":"font_size","label":"Font Size","min":14,"max":36,"step":1,"default":22},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":2,"default":30}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"100% Organic Ingredients"}
      ]
    }
  ],
  "presets": [
    {
      "name": "03 · Organic Flow",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
