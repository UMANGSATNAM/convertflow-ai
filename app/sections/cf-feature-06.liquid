<style>
.cf-ft-06{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif;overflow:hidden}
.cf-ft-06-inner{max-width:1400px;margin:0 auto}
.cf-ft-06-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px}
.cf-ft-06-title{font-size:clamp(32px,6vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;font-style:italic;line-height:0.9;margin:0;letter-spacing:-0.03em}
.cf-ft-06-link{color:{{ section.settings.accent_color }};font-weight:900;text-transform:uppercase;font-style:italic;text-decoration:none;font-size:18px;transition:0.2s}
.cf-ft-06-link:hover{color:#fff}
.cf-ft-06-grid{display:grid;grid-template-columns:repeat({{ section.settings.cols }}, 1fr);gap:20px}
.cf-ft-06-card{text-decoration:none;display:flex;flex-direction:column;background:#1a1a1a;transform:skewX(-5deg);border:3px solid transparent;transition:0.3s}
.cf-ft-06-card-inner{transform:skewX(5deg);display:flex;flex-direction:column;height:100%}
.cf-ft-06-img-wrap{aspect-ratio:4/3;background:#111;position:relative;overflow:hidden}
.cf-ft-06-img{width:100%;height:100%;object-fit:cover;opacity:0.6;transition:0.4s;filter:grayscale(100%)}
.cf-ft-06-card:hover{border-color:{{ section.settings.accent_color }}}
.cf-ft-06-card:hover .cf-ft-06-img{opacity:1;filter:grayscale(0%);transform:scale(1.1)}
.cf-ft-06-info{padding:25px;display:flex;flex-direction:column;flex:1}
.cf-ft-06-name{font-size:20px;color:#fff;font-weight:900;text-transform:uppercase;font-style:italic;margin-bottom:5px}
.cf-ft-06-price{font-size:18px;color:#888;font-weight:700;margin-bottom:20px}
.cf-ft-06-btn{margin-top:auto;display:block;text-align:center;padding:12px;background:{{ section.settings.accent_color }};color:#fff;font-weight:900;text-transform:uppercase;font-style:italic;transition:0.2s}
.cf-ft-06-card:hover .cf-ft-06-btn{background:#fff;color:#000}
@media(max-width:1024px){.cf-ft-06-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:768px){.cf-ft-06-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.cf-ft-06-grid{grid-template-columns:1fr}.cf-ft-06-header{flex-direction:column;align-items:flex-start;gap:15px}}
</style>

<div class="cf-ft-06">
  <div class="cf-ft-06-inner">
    <div class="cf-ft-06-header">
      <h2 class="cf-ft-06-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.link }}" class="cf-ft-06-link">VIEW ALL RACING PARTS -></a>
    </div>
    
    <div class="cf-ft-06-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="cf-ft-06-card">
             <div class="cf-ft-06-card-inner">
              <div class="cf-ft-06-img-wrap">
                <img class="cf-ft-06-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
              </div>
              <div class="cf-ft-06-info">
                <div class="cf-ft-06-name">{{ product.title }}</div>
                <div class="cf-ft-06-price">{{ product.price | money }}</div>
                <div class="cf-ft-06-btn">BUY NOW</div>
              </div>
             </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <a href="#" class="cf-ft-06-card">
             <div class="cf-ft-06-card-inner">
              <div class="cf-ft-06-img-wrap">
                 <div style="width:100%;height:100%;background:linear-gradient(45deg,#222,#111);display:flex;align-items:center;justify-content:center;color:#444;font-weight:900;font-style:italic;font-size:24px">PART #00{{ i }}</div>
              </div>
              <div class="cf-ft-06-info">
                <div class="cf-ft-06-name">Performance Intake System {{ i }}</div>
                <div class="cf-ft-06-price">$399.00</div>
                <div class="cf-ft-06-btn">BUY NOW</div>
              </div>
             </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Auto Parts",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"FEATURED UPGRADES"},
    {"type":"range","id":"title_size","label":"Title Size","min":32,"max":100,"step":4,"default":64},
    {"type":"text","id":"link","label":"Link","default":"/collections/all"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product Limit","min":2,"max":12,"step":1,"default":4},
    {"type":"range","id":"cols","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"color","id":"bg_color","label":"Background","default":"#111111"},
    {"type":"color","id":"text_color","label":"Title Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Accent (Red)","default":"#ef4444"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"06 · Auto Parts"}]
}
{% endschema %}
