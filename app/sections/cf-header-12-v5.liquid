<style>
.cf-header-12-v5{width:100%;font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-header-12-v5-top{background:{{ section.settings.bg_color }};padding:15px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-header-12-v5-top-nav{display:flex;gap:20px}
.cf-header-12-v5-top-link{font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:{{ section.settings.text_color }};text-decoration:none;opacity:0.7}
.cf-header-12-v5-top-link:hover{opacity:1}
.cf-header-12-v5-logo{text-decoration:none}
.cf-header-12-v5-logo img{max-height:{{ section.settings.logo_height }}px}
.cf-header-12-v5-logo h1{margin:0;font-size:24px;font-weight:900;letter-spacing:0.15em;text-transform:uppercase;color:{{ section.settings.text_color }}}
.cf-header-12-v5-icons{display:flex;gap:15px}
.cf-header-12-v5-icon{color:{{ section.settings.text_color }};cursor:pointer}
.cf-header-12-v5-bottom{background:{{ section.settings.bottom_bg }};padding:15px 20px;text-align:center}
.cf-header-12-v5-main-nav{display:flex;justify-content:center;gap:40px}
.cf-header-12-v5-main-link{font-size:14px;color:{{ section.settings.bottom_text }};text-decoration:none;text-transform:uppercase;letter-spacing:0.05em;font-weight:600;transition:0.3s}
.cf-header-12-v5-main-link:hover{color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-header-12-v5-top-nav,.cf-header-12-v5-bottom{display:none}}
</style>

<div class="cf-header-12-v5">
  <div class="cf-header-12-v5-top">
    <div class="cf-header-12-v5-top-nav">
       <a href="#" class="cf-header-12-v5-top-link">Find a Store</a>
       <a href="#" class="cf-header-12-v5-top-link">Help</a>
    </div>
    
    <a href="/" class="cf-header-12-v5-logo">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% else %}
        <h1>{{ section.settings.logo_text }}</h1>
      {% endif %}
    </a>
    
    <div class="cf-header-12-v5-icons">
      <div class="cf-header-12-v5-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <div class="cf-header-12-v5-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </div>
      <div class="cf-header-12-v5-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </div>
    </div>
  </div>
  
  <div class="cf-header-12-v5-bottom">
    <div class="cf-header-12-v5-main-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="cf-header-12-v5-main-link">{{ link.title }}</a>
      {% else %}
        <a href="#" class="cf-header-12-v5-main-link">New Arrivals</a>
        <a href="#" class="cf-header-12-v5-main-link">Clothing</a>
        <a href="#" class="cf-header-12-v5-main-link">Shoes</a>
        <a href="#" class="cf-header-12-v5-main-link">Bags</a>
        <a href="#" class="cf-header-12-v5-main-link">Jewelry</a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Header (v5)",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo Image"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"STUDIO NOIR"},
    {"type":"range","id":"logo_height","label":"Logo Height","min":20,"max":100,"step":5,"default":30},
    {"type":"link_list","id":"menu","label":"Main Menu"},
    {"type":"color","id":"bg_color","label":"Top Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Top Text","default":"#111111"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#ECECEC"},
    {"type":"color","id":"bottom_bg","label":"Bottom Background","default":"#FAFAFA"},
    {"type":"color","id":"bottom_text","label":"Bottom Text","default":"#333333"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#B59A7A"}
  ],
  "presets": [{"name":"12 · Women's Header (v5)"}]
}
{% endschema %}
