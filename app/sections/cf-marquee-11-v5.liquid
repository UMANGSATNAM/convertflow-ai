<style>
.cf-mq-11-v5{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;display:flex;border-top:4px solid {{ section.settings.border_color }};border-bottom:4px solid {{ section.settings.border_color }}}
.cf-mq-11-v5-track{display:flex;white-space:nowrap;animation:cf-mq-11-v5-scroll {{ section.settings.speed }}s linear infinite}
.cf-mq-11-v5-item{display:inline-flex;align-items:center;padding:0 40px;font-family:monospace;font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};font-weight:700;letter-spacing:0.1em;text-transform:uppercase}
.cf-mq-11-v5-line{width:50px;height:2px;background:{{ section.settings.text_color }};margin:0 40px}
@keyframes cf-mq-11-v5-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<div class="cf-mq-11-v5">
  <div class="cf-mq-11-v5-track">
    {% for i in (1..8) %}
      <div class="cf-mq-11-v5-item">
        {{ section.settings.text }}
        <div class="cf-mq-11-v5-line"></div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Marquee (v5)",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"S/S 2026 COLLECTION"},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":64,"step":2,"default":18},
    {"type":"color","id":"bg_color","label":"Background","default":"#F0F0F0"},
    {"type":"color","id":"text_color","label":"Text & Line Color","default":"#333333"},
    {"type":"color","id":"border_color","label":"Thick Border Color","default":"#333333"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":20},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":100,"step":5,"default":45}
  ],
  "presets": [{"name":"11 · Men's Marquee (v5)"}]
}
{% endschema %}
