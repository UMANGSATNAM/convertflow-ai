<style>
.cf-marquee-01-v10{width:100%;overflow:hidden;display:flex;flex-direction:column}
.cf-marquee-01-v10-band-1{background:{{ section.settings.bg_1 }};color:{{ section.settings.text_1 }};padding:20px 0;width:100%;overflow:hidden}
.cf-marquee-01-v10-band-2{background:{{ section.settings.bg_2 }};color:{{ section.settings.text_2 }};padding:20px 0;width:100%;overflow:hidden}
.cf-marquee-01-v10-track-1{display:flex;white-space:nowrap;animation:cf-marquee-01-v10-scroll-1 {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v10-track-2{display:flex;white-space:nowrap;animation:cf-marquee-01-v10-scroll-2 {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v10-item{display:inline-flex;align-items:center;padding:0 40px;font-family:serif;font-size:16px;letter-spacing:0.15em;text-transform:uppercase}
.cf-marquee-01-v10-sep{margin:0 40px;font-size:10px;opacity:0.5}
@keyframes cf-marquee-01-v10-scroll-1{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
@keyframes cf-marquee-01-v10-scroll-2{0%{transform:translateX(-50%)} 100%{transform:translateX(0)}}
</style>

<div class="cf-marquee-01-v10">
  <div class="cf-marquee-01-v10-band-1">
    <div class="cf-marquee-01-v10-track-1">
      {% for j in (1..3) %}
        {% for i in (1..5) %}
          <div class="cf-marquee-01-v10-item">
            {{ section.settings.msg_1 }} <span class="cf-marquee-01-v10-sep">|</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="cf-marquee-01-v10-band-2">
    <div class="cf-marquee-01-v10-track-2">
      {% for j in (1..3) %}
        {% for i in (1..5) %}
          <div class="cf-marquee-01-v10-item">
            {{ section.settings.msg_2 }} <span class="cf-marquee-01-v10-sep">|</span>
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v10)",
  "settings": [
    {"type":"text","id":"msg_1","label":"Top Row Text","default":"ELEVATE YOUR ESSENTIALS"},
    {"type":"text","id":"msg_2","label":"Bottom Row Text","default":"CRAFTED WITH INTENT"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":40},
    {"type":"color","id":"bg_1","label":"Top Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_1","label":"Top Text Color","default":"#111111"},
    {"type":"color","id":"bg_2","label":"Bottom Canvas","default":"#111111"},
    {"type":"color","id":"text_2","label":"Bottom Text Color","default":"#FDFBF7"}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v10)"}]
}
{% endschema %}
