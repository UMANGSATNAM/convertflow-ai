<style>
.cf-pr-11-v5{width:100%;height:{{ section.settings.height }}vh;display:flex;background:{{ section.settings.bg_color }};font-family:sans-serif;overflow:hidden}
.cf-pr-11-v5-img-wrap{flex:1;position:relative}
.cf-pr-11-v5-img{width:100%;height:100%;object-fit:cover}
.cf-pr-11-v5-text-wrap{width:120px;display:flex;align-items:center;justify-content:center;border-left:2px solid {{ section.settings.border_color }};position:relative;background:{{ section.settings.text_bg }}}
.cf-pr-11-v5-title{font-size:{{ section.settings.title_size }}px;font-weight:900;text-transform:uppercase;color:{{ section.settings.text_color }};white-space:nowrap;transform:rotate(-90deg);letter-spacing:0.02em}
.cf-pr-11-v5-btn{position:absolute;bottom:40px;left:50%;transform:translateX(-50%);background:{{ section.settings.text_color }};color:{{ section.settings.text_bg }};width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;transition:0.3s}
.cf-pr-11-v5-btn:hover{background:{{ section.settings.accent_color }}}
@media(max-width:768px){.cf-pr-11-v5{flex-direction:column}.cf-pr-11-v5-text-wrap{width:100%;height:80px;border-left:none;border-top:2px solid {{ section.settings.border_color }}}.cf-pr-11-v5-title{transform:rotate(0)}.cf-pr-11-v5-btn{bottom:auto;right:20px;left:auto;transform:translateY(-50%);top:50%;width:50px;height:50px}}
</style>

<div class="cf-pr-11-v5">
  <div class="cf-pr-11-v5-img-wrap">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" class="cf-pr-11-v5-img">
    {% else %}
      <div style="width:100%;height:100%;background:#d4d4d4"></div>
    {% endif %}
  </div>
  <div class="cf-pr-11-v5-text-wrap">
    <div class="cf-pr-11-v5-title">{{ section.settings.title }}</div>
    <a href="{{ section.settings.btn_link }}" class="cf-pr-11-v5-btn">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Promo (v5)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"title","label":"Vertical Title","default":"NEW SEASON DEBUT"},
    {"type":"range","id":"title_size","label":"Title Size","min":20,"max":100,"step":2,"default":48},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F7F7F7"},
    {"type":"color","id":"text_bg","label":"Text Bar Background","default":"#F7F7F7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Button Hover Color","default":"#555555"},
    {"type":"color","id":"border_color","label":"Border Separator","default":"#111111"},
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Promo (v5)"}]
}
{% endschema %}
