<style>
.cf-trust-12-v7{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-trust-12-v7-inner{max-width:1400px;margin:0 auto;display:flex;gap:60px;align-items:center}
.cf-trust-12-v7-info{flex:0 0 350px}
.cf-trust-12-v7-sub{font-size:12px;text-transform:uppercase;letter-spacing:0.2em;color:{{ section.settings.accent_color }};margin-bottom:15px;display:block;font-weight:700}
.cf-trust-12-v7-title{font-family:serif;font-size:clamp(36px, 4vw, 56px);font-weight:400;margin:0 0 20px 0;line-height:1.1}
.cf-trust-12-v7-desc{font-size:14px;line-height:1.6;margin:0;opacity:0.8}
.cf-trust-12-v7-grid{flex:1;display:grid;grid-template-columns:repeat(2, 1fr);gap:20px}
.cf-trust-12-v7-card{background:{{ section.settings.card_bg }};padding:40px;border-radius:{{ section.settings.border_radius }}px;border:1px solid {{ section.settings.border_color }};transition:0.3s}
.cf-trust-12-v7-card:hover{box-shadow:0 10px 30px rgba(0,0,0,0.03);transform:translateY(-5px)}
.cf-trust-12-v7-icon{width:50px;height:50px;display:flex;align-items:center;justify-content:center;color:{{ section.settings.accent_color }};margin-bottom:20px}
.cf-trust-12-v7-card-title{font-family:serif;font-size:22px;margin:0 0 10px 0;font-weight:400;font-style:italic}
.cf-trust-12-v7-card-desc{font-size:13px;opacity:0.7;margin:0;line-height:1.5}
@media(max-width:1024px){.cf-trust-12-v7-inner{flex-direction:column;align-items:flex-start}.cf-trust-12-v7-info{flex:none;max-width:600px;margin-bottom:20px}}
@media(max-width:600px){.cf-trust-12-v7-grid{grid-template-columns:1fr}}
</style>

<div class="cf-trust-12-v7">
  <div class="cf-trust-12-v7-inner">
    <div class="cf-trust-12-v7-info">
      <span class="cf-trust-12-v7-sub">{{ section.settings.subtitle }}</span>
      <h2 class="cf-trust-12-v7-title">{{ section.settings.title }}</h2>
      <p class="cf-trust-12-v7-desc">{{ section.settings.desc }}</p>
    </div>
    
    <div class="cf-trust-12-v7-grid">
      {% for i in (1..4) %}
        <div class="cf-trust-12-v7-card">
          <div class="cf-trust-12-v7-icon">
             {% if i == 1 %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {% elsif i == 2 %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            {% elsif i == 3 %}
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            {% else %}
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            {% endif %}
          </div>
          <h3 class="cf-trust-12-v7-card-title">
            {% if i == 1 %}Free Returns{% elsif i == 2 %}24/7 Security{% elsif i == 3 %}Carbon Neutral{% else %}Original Quality{% endif %}
          </h3>
          <p class="cf-trust-12-v7-card-desc">
            {% if i == 1 %}Shop securely knowing returns are on us.{% elsif i == 2 %}Your checkout process is 100% encrypted.{% elsif i == 3 %}We offset the carbon footprint on every order.{% else %}Direct from the artisans, no middleman.{% endif %}
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Trust (v7)",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"WHY CHOOSE US"},
    {"type":"text","id":"title","label":"Header Title","default":"The Studio Promise"},
    {"type":"textarea","id":"desc","label":"Description","default":"Every piece we create is built with care, designed to bring joy and lasting quality to your wardrobe."},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon Colors","default":"#A38971"},
    {"type":"color","id":"border_color","label":"Grid Border Color","default":"#EAEAEE"},
    {"type":"range","id":"border_radius","label":"Card Rounding","min":0,"max":20,"step":2,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":10,"default":80}
  ],
  "presets": [{"name":"12 · Women's Trust (v7)"}]
}
{% endschema %}
