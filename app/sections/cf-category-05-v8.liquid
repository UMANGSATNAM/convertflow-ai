<style>
.cf-cat-05-v8 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-cat-05-v8-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-cat-05-v8-header { text-align: center; margin-bottom: 40px; }
.cf-cat-05-v8-title { font-size: 36px; font-weight: 800; color: {{ section.settings.text_color }}; margin: 0; }
.cf-cat-05-v8-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 20px; }
.cf-cat-05-v8-card { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; }
.cf-cat-05-v8-img { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; margin-bottom: 15px; background: border-box {{ section.settings.accent_color | color_modify: 'alpha', 0.15 }}; position: relative; transition: transform 0.3s; }
.cf-cat-05-v8-card:hover .cf-cat-05-v8-img { transform: scale(1.08); }
.cf-cat-05-v8-img img { width: 100%; height: 100%; object-fit: cover; }
.cf-cat-05-v8-name { font-size: 15px; font-weight: 700; color: {{ section.settings.text_color }}; margin-bottom: 4px; }
.cf-cat-05-v8-count { font-size: 12px; color: {{ section.settings.accent_color }}; font-weight: 600; }
@media (max-width: 900px) { .cf-cat-05-v8-grid { grid-template-columns: repeat(3,1fr); gap: 20px; } }
@media (max-width: 600px) { .cf-cat-05-v8-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-cat-05-v8">
  <div class="cf-cat-05-v8-inner">
    <div class="cf-cat-05-v8-header"><h2 class="cf-cat-05-v8-title">{{ section.settings.title }}</h2></div>
    <div class="cf-cat-05-v8-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-05-v8-card">
        <div class="cf-cat-05-v8-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-cat-05-v8-name">{{ block.settings.title }}</div>
        {% if block.settings.count != blank %}<div class="cf-cat-05-v8-count">{{ block.settings.count }} products</div>{% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "08 · Nail Art Grid","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#fdf2f8"},{"type":"color","id":"text_color","label":"Text Color","default":"#831843"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#ec4899"},{"type":"text","id":"title","label":"Title","default":"Nail Styles"},{"type":"range","id":"cols","label":"Columns","min":3,"max":8,"step":1,"default":5},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1100}],"blocks": [{"type": "category","name": "Category","settings": [{"type":"text","id":"title","label":"Name","default":"Chrome"},{"type":"text","id":"count","label":"Product Count","default":"24"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets": [{"name": "08 · Nail Grid","blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
