<style>
.cf-trust-11-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-trust-11-v4-inner{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1fr 2fr;gap:60px;align-items:center}
.cf-trust-11-v4-left{max-width:400px}
.cf-trust-11-v4-title{font-size:40px;font-weight:900;text-transform:uppercase;margin:0 0 20px 0;letter-spacing:-0.03em;line-height:1}
.cf-trust-11-v4-desc{font-size:16px;opacity:0.8;margin:0 0 30px 0;line-height:1.6}
.cf-trust-11-v4-btn{display:inline-block;padding:12px 24px;background:transparent;border:2px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;border-radius:40px;transition:0.3s}
.cf-trust-11-v4-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-trust-11-v4-grid{display:grid;grid-template-columns:repeat(2, 1fr);gap:30px}
.cf-trust-11-v4-item{display:flex;align-items:flex-start;gap:20px}
.cf-trust-11-v4-icon{width:32px;height:32px;color:{{ section.settings.accent_color }};margin-top:2px}
.cf-trust-11-v4-info{display:flex;flex-direction:column;gap:8px}
.cf-trust-11-v4-name{font-size:18px;font-weight:900;text-transform:uppercase;margin:0;letter-spacing:0.02em}
.cf-trust-11-v4-detail{font-size:14px;opacity:0.7;margin:0;line-height:1.5}
@media(max-width:900px){.cf-trust-11-v4-inner{grid-template-columns:1fr;gap:40px}.cf-trust-11-v4-left{max-width:100%;text-align:center}.cf-trust-11-v4-grid{max-width:800px;margin:0 auto}}
@media(max-width:600px){.cf-trust-11-v4-grid{grid-template-columns:1fr}}
</style>

<div class="cf-trust-11-v4">
  <div class="cf-trust-11-v4-inner">
    <div class="cf-trust-11-v4-left">
      <h2 class="cf-trust-11-v4-title">{{ section.settings.title }}</h2>
      <p class="cf-trust-11-v4-desc">{{ section.settings.desc }}</p>
      <a href="{{ section.settings.btn_link }}" class="cf-trust-11-v4-btn">{{ section.settings.btn_label }}</a>
    </div>
    
    <div class="cf-trust-11-v4-grid">
      {% for i in (1..4) %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture desc_key %}desc_{{ i }}{% endcapture %}
        {% capture icon_key %}icon_{{ i }}{% endcapture %}
        
        <div class="cf-trust-11-v4-item">
          <div class="cf-trust-11-v4-icon">{{ section.settings[icon_key] }}</div>
          <div class="cf-trust-11-v4-info">
            <h3 class="cf-trust-11-v4-name">{{ section.settings[title_key] }}</h3>
            <p class="cf-trust-11-v4-detail">{{ section.settings[desc_key] }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Trust (v4)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"WHY CHOOSE THE BRAND"},
    {"type":"textarea","id":"desc","label":"Header Desc","default":"We obsess over the details so you don't have to. Every garment is rigorously tested for durability and cut for the modern form."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"READ OUR STORY"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    
    {"type":"html","id":"icon_1","label":"Icon 1 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'></path><line x1='7' y1='7' x2='7.01' y2='7'></line></svg>"},
    {"type":"text","id":"title_1","label":"Title 1","default":"SUSTAINABLE FABRICS"},
    {"type":"textarea","id":"desc_1","label":"Desc 1","default":"100% GOTS certified organic cottons and recycled synthetics."},
    
    {"type":"html","id":"icon_2","label":"Icon 2 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'></path><path d='M3.27 6.96L12 12.01l8.73-5.05'></path><path d='M12 22.08V12'></path></svg>"},
    {"type":"text","id":"title_2","label":"Title 2","default":"EXPERTLY TAILORED"},
    {"type":"textarea","id":"desc_2","label":"Desc 2","default":"Pre-shrunk and cut specifically to maintain shape wash after wash."},
    
    {"type":"html","id":"icon_3","label":"Icon 3 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='10'></circle><path d='M16 12l-4-4-4 4'></path><path d='M12 16V8'></path></svg>"},
    {"type":"text","id":"title_3","label":"Title 3","default":"CARBON NEUTRAL"},
    {"type":"textarea","id":"desc_3","label":"Desc 3","default":"We offset 100% of our carbon footprint from factory to your door."},
    
    {"type":"html","id":"icon_4","label":"Icon 4 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line><polyline points='10 9 9 9 8 9'></polyline></svg>"},
    {"type":"text","id":"title_4","label":"Title 4","default":"CERTIFIED B-CORP"},
    {"type":"textarea","id":"desc_4","label":"Desc 4","default":"Meeting the highest standards of verified social and environmental performance."},
    
    {"type":"color","id":"bg_color","label":"Background","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon Color","default":"#A37B5C"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Trust (v4)"}]
}
{% endschema %}
