<style>
.cf-ps-02-v10 {
  width: 100%;
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  display: flex;
  justify-content: center;
}

.cf-ps-02-v10-inner {
  max-width: 1000px;
  width: 100%;
  padding: 16px; /* Frame thickness */
  /* Camo effect frame */
  background-image: radial-gradient(circle at 0% 0%, {{ section.settings.camo_1 }} 0%, transparent 40%),
                    radial-gradient(circle at 100% 0%, {{ section.settings.camo_2 }} 0%, transparent 40%),
                    radial-gradient(circle at 100% 100%, {{ section.settings.camo_1 }} 0%, transparent 40%),
                    radial-gradient(circle at 0% 100%, {{ section.settings.camo_2 }} 0%, transparent 40%),
                    radial-gradient(circle at 50% 50%, {{ section.settings.camo_3 }} 0%, transparent 60%);
  background-color: {{ section.settings.camo_base }};
  display: flex;
  flex-direction: column;
}

.cf-ps-02-v10-content {
  background: {{ section.settings.box_bg }};
  padding: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 4px solid #111;
  flex: 1;
}

.cf-ps-02-v10-eyebrow {
  display: inline-block;
  background: #111;
  color: #fff;
  padding: 4px 12px;
  font-weight: 900;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 0.1em;
  margin-bottom: 20px;
}

.cf-ps-02-v10-title {
  font-size: clamp(28px, 6vw, {{ section.settings.title_size }}px);
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  letter-spacing: -0.05em;
  line-height: 1;
  margin-bottom: 20px;
}

.cf-ps-02-v10-btn {
  background: transparent;
  color: {{ section.settings.text_color }};
  border: 4px solid {{ section.settings.text_color }};
  padding: 14px 40px;
  font-weight: 900;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 15px;
  letter-spacing: 0.05em;
  transition: all 0.2s;
}

.cf-ps-02-v10-btn:hover {
  background: {{ section.settings.text_color }};
  color: {{ section.settings.box_bg }};
}

@media (min-width: 768px) {
  .cf-ps-02-v10-content {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
    padding: 50px;
  }
  .cf-ps-02-text-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .cf-ps-02-v10-btn {
    align-self: center;
    margin-left: 40px;
  }
  .cf-ps-02-v10-title {
    margin-bottom: 0;
  }
}
</style>

<div class="cf-ps-02-v10">
  <div class="cf-ps-02-v10-inner">
    <div class="cf-ps-02-v10-content">
      <div class="cf-ps-02-text-wrap">
        <div class="cf-ps-02-v10-eyebrow">{{ section.settings.eyebrow }}</div>
        <h3 class="cf-ps-02-v10-title">{{ section.settings.title | newline_to_br }}</h3>
      </div>
      <a href="{{ section.settings.btn_link }}" class="cf-ps-02-v10-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · Camo Frame",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow Tag","default":"MILSURP"},
    {"type":"textarea","id":"title","label":"Title","default":"UTILITY\nRESTOCKED"},
    {"type":"range","id":"title_size","label":"Title Size","min":20,"max":80,"step":2,"default":48},
    {"type":"text","id":"btn_label","label":"Button Label","default":"VIEW GEAR"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/gear"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#F1F1F1"},
    {"type":"color","id":"box_bg","label":"Inner Box Base","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"camo_base","label":"Camo Frame Base","default":"#4b5320"},
    {"type":"color","id":"camo_1","label":"Camo Spot 1","default":"#293014"},
    {"type":"color","id":"camo_2","label":"Camo Spot 2","default":"#111111"},
    {"type":"color","id":"camo_3","label":"Camo Spot 3","default":"#737b42"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"10 · Camo Frame Snack"}]
}
{% endschema %}
