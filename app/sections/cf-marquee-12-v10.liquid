<style>
.cf-marquee-12-v10{width:100%;height:{{ section.settings.height }}px;position:relative;overflow:hidden;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;font-family:serif;color:{{ section.settings.text_color }};display:flex;align-items:center}
.cf-marquee-12-v10-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }})}
.cf-marquee-12-v10-track{display:flex;white-space:nowrap;position:absolute;top:50%;left:0;transform:translateY(-50%);width:200%;animation:cf-scroll-12-v10 {{ section.settings.speed }}s linear infinite;z-index:2}
.cf-marquee-12-v10-content{display:flex;align-items:center;width:50%}
.cf-marquee-12-v10-text{font-size:{{ section.settings.font_size }}px;margin:0;padding:0 40px;letter-spacing:0.05em;font-weight:300;text-transform:uppercase}
.cf-marquee-12-v10-circle{width:12px;height:12px;background:{{ section.settings.text_color }};border-radius:50%}
@keyframes cf-scroll-12-v10{0%{transform:translate(0,-50%)}100%{transform:translate(-50%,-50%)}}
</style>

<div class="cf-marquee-12-v10">
  <div class="cf-marquee-12-v10-overlay"></div>
  <div class="cf-marquee-12-v10-track">
    <div class="cf-marquee-12-v10-content">
      {% for i in (1..3) %}
        <span class="cf-marquee-12-v10-text">{{ section.settings.text }}</span>
        <div class="cf-marquee-12-v10-circle"></div>
      {% endfor %}
    </div>
    <div class="cf-marquee-12-v10-content">
      {% for i in (1..3) %}
         <span class="cf-marquee-12-v10-text">{{ section.settings.text }}</span>
         <div class="cf-marquee-12-v10-circle"></div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Marquee (v10",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Darkness",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "VALERIE CAMPAIGN FW26"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed (Seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "min": 30,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "height",
      "label": "Container Height (px)",
      "min": 100,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "12 · Women's Marquee (v10"
    }
  ]
}
{% endschema %}
