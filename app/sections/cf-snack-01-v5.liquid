<style>
.cf-snack-01-v5{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:serif;text-align:center}
.cf-snack-01-v5-inner{max-width:800px;margin:0 auto;display:flex;flex-direction:column;align-items:center}
.cf-snack-01-v5-title{font-size:clamp(32px, 5vw, 48px);font-style:italic;font-weight:400;margin:0 0 20px 0;letter-spacing:0.02em}
.cf-snack-01-v5-desc{font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;margin:0 0 40px 0;color:{{ section.settings.accent_color }}}
.cf-snack-01-v5-btn{display:inline-block;padding:15px 40px;border:1px solid {{ section.settings.text_color }};font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:inherit;transition:0.3s}
.cf-snack-01-v5-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
</style>

<div class="cf-snack-01-v5">
  <div class="cf-snack-01-v5-inner">
    <h3 class="cf-snack-01-v5-title">{{ section.settings.title }}</h3>
    <p class="cf-snack-01-v5-desc">{{ section.settings.subtitle }}</p>
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="cf-snack-01-v5-btn">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Snack (v5)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"Complimentary Monogramming"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"MAKE IT UNMISTAKABLY YOURS"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Personalize Now"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":150,"step":5,"default":80}
  ],
  "presets": [{"name":"01 · Luxury Snack (v5)"}]
}
{% endschema %}
