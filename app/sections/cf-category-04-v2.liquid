<style>
.cf-cat-04-v2 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-cat-04-v2-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v2-heading {
  text-align: center;
  margin-bottom: 50px;
}

.cf-cat-04-v2-title {
  font-size: 32px;
  font-weight: 700;
  color: {{ section.settings.text_color }};
  margin: 0 0 10px 0;
  letter-spacing: -0.02em;
}

.cf-cat-04-v2-subtitle {
  font-size: 16px;
  color: #6b7280;
  margin: 0;
}

.cf-cat-04-v2-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 30px;
}

.cf-cat-04-v2-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  group: hover;
}

.cf-cat-04-v2-image-wrap {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f4f6;
  position: relative;
  margin-bottom: 20px;
  border: 4px solid #fff;
  box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
}

.cf-cat-04-v2-item:hover .cf-cat-04-v2-image-wrap {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(0,0,0,0.1);
}

.cf-cat-04-v2-image-wrap img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.6s ease;
}

.cf-cat-04-v2-item:hover .cf-cat-04-v2-image-wrap img {
  transform: scale(1.05);
}

.cf-cat-04-v2-name {
  color: {{ section.settings.text_color }};
  font-size: 18px;
  font-weight: 600;
  margin: 0;
  transition: color 0.2s;
}

.cf-cat-04-v2-item:hover .cf-cat-04-v2-name {
  color: {{ section.settings.accent_color }};
}

@media (max-width: 900px) {
  .cf-cat-04-v2-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .cf-cat-04-v2-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .cf-cat-04-v2-title { font-size: 28px; }
}
</style>

<div class="cf-cat-04-v2">
  <div class="cf-cat-04-v2-inner">
    {% if section.settings.title != blank %}
      <div class="cf-cat-04-v2-heading">
        <h2 class="cf-cat-04-v2-title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="cf-cat-04-v2-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="cf-cat-04-v2-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v2-item">
          <div class="cf-cat-04-v2-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#9ca3af;">Image</div>
            {% endif %}
          </div>
          <h3 class="cf-cat-04-v2-name">{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "02 · Minimal Categories",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9fafb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#10b981"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Targeted solutions for your well-being."
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (Desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Immunity"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "02 · Minimal Wellness Cat",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
