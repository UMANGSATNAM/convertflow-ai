<style>
.cf-fc-05-v7 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-fc-05-v7-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-fc-05-v7-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
.cf-fc-05-v7-title { font-size: 28px; font-weight: 800; color: {{ section.settings.text_color }}; }
.cf-fc-05-v7-btn-top { background: {{ section.settings.accent_color }}; color: #fff; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 700; }
.cf-fc-05-v7-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 20px; }
.cf-fc-05-v7-card { text-decoration: none; display: flex; flex-direction: column; border: 1px solid {{ section.settings.border_color }}; border-radius: 8px; overflow: hidden; transition: border-color 0.2s; background: #fff; }
.cf-fc-05-v7-card:hover { border-color: {{ section.settings.accent_color }}; }
.cf-fc-05-v7-img { aspect-ratio: 1; position: relative; overflow: hidden; background: #f0fdfa; }
.cf-fc-05-v7-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; transition: transform 0.4s; }
.cf-fc-05-v7-card:hover .cf-fc-05-v7-img img { transform: scale(1.04); }
.cf-fc-05-v7-info { padding: 15px; display: flex; flex-direction: column; flex: 1; }
.cf-fc-05-v7-name { color: {{ section.settings.text_color }}; font-size: 15px; font-weight: 600; margin: 0 0 5px 0; }
.cf-fc-05-v7-concern { font-size: 12px; color: {{ section.settings.accent_color }}; font-weight: 600; margin-bottom: 10px; text-transform: uppercase; }
.cf-fc-05-v7-price { color: {{ section.settings.text_color }}; font-weight: 700; font-size: 16px; margin-top: auto; }
@media (max-width: 900px) { .cf-fc-05-v7-grid { grid-template-columns: repeat(2,1fr); } .cf-fc-05-v7-header { flex-direction: column; gap: 15px; align-items: flex-start; } }
</style>
<div class="cf-fc-05-v7">
  <div class="cf-fc-05-v7-inner">
    <div class="cf-fc-05-v7-header">
      <h2 class="cf-fc-05-v7-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-fc-05-v7-btn-top">{{ section.settings.btn_text }}</a>
    </div>
    <div class="cf-fc-05-v7-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.url }}" class="cf-fc-05-v7-card">
        <div class="cf-fc-05-v7-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-fc-05-v7-info">
          {% if block.settings.concern != blank %}<div class="cf-fc-05-v7-concern">{{ block.settings.concern }}</div>{% endif %}
          <div class="cf-fc-05-v7-name">{{ block.settings.title }}</div>
          <div class="cf-fc-05-v7-price">{{ block.settings.price }}</div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "07 · Dermatology Products","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#f8fafc"},{"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#0d9488"},{"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},{"type":"text","id":"title","label":"Title","default":"Science-Backed Solutions"},{"type":"text","id":"btn_text","label":"Button Text","default":"Shop All"},{"type":"url","id":"btn_link","label":"Button Link"},{"type":"range","id":"cols","label":"Columns","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "product","name": "Product","settings": [{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"concern","label":"Target Concern","default":"Hydration"},{"type":"text","id":"title","label":"Title","default":"Barrier Repair Moisturizer"},{"type":"text","id":"price","label":"Price","default":"$68.00"},{"type":"url","id":"url","label":"Link"}]}],"presets": [{"name": "07 · Derm Products","blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}{% endschema %}
