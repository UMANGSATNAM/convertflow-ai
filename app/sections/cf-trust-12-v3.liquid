<style>
.cf-trust-12-v3{width:100%;background:{{ section.settings.bg_color }};font-family:serif;}
.cf-trust-12-v3-inner{display:grid;grid-template-columns:repeat(3, 1fr);color:#fff}
.cf-trust-12-v3-card{position:relative;height:300px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;overflow:hidden;group}
.cf-trust-12-v3-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:0;transition:0.8s}
.cf-trust-12-v3-card:hover .cf-trust-12-v3-img{transform:scale(1.05)}
.cf-trust-12-v3-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);z-index:1;transition:0.3s}
.cf-trust-12-v3-card:hover .cf-trust-12-v3-overlay{background:rgba(0,0,0,0.5)}
.cf-trust-12-v3-content{position:relative;z-index:2}
.cf-trust-12-v3-icon{margin-bottom:20px;display:inline-flex;color:{{ section.settings.icon_col }}}
.cf-trust-12-v3-title{font-size:24px;margin:0 0 10px 0;font-style:italic;font-weight:400}
.cf-trust-12-v3-desc{font-family:sans-serif;font-size:12px;opacity:0.8;margin:0;line-height:1.5;max-width:250px}
@media(max-width:900px){.cf-trust-12-v3-inner{grid-template-columns:1fr}}
</style>

<div class="cf-trust-12-v3">
  <div class="cf-trust-12-v3-inner">
    {% for i in (1..3) %}
      <div class="cf-trust-12-v3-card">
        <div class="cf-trust-12-v3-img" style="background:#{{ forloop.index | times: 111 }}#333"></div>
        <div class="cf-trust-12-v3-overlay"></div>
        <div class="cf-trust-12-v3-content">
          <div class="cf-trust-12-v3-icon">
            {% if i == 1 %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path><path d="M2 12h20"></path></svg>
            {% elsif i == 2 %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            {% else %}
               <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            {% endif %}
          </div>
          <h3 class="cf-trust-12-v3-title">
             {% if i == 1 %}Global Shipping{% elsif i == 2 %}Premium Materials{% else %}Award Winning{% endif %}
          </h3>
          <p class="cf-trust-12-v3-desc">
             {% if i == 1 %}Fast, reliable delivery worldwide.{% elsif i == 2 %}Crafted using only the finest fabrics.{% else %}Recognized for excellence in design.{% endif %}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Trust (v3)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#FDFBF7"},
    {"type":"color","id":"icon_col","label":"Icon Color","default":"#FFFFFF"}
  ],
  "presets": [{"name":"12 · Women's Trust (v3)"}]
}
{% endschema %}
