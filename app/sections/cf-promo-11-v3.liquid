<style>
.cf-pr-11-v3{width:100%;height:{{ section.settings.height }}vh;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;display:flex;flex-direction:column;justify-content:flex-end;position:relative;font-family:sans-serif}
.cf-pr-11-v3-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to bottom, transparent 40%, rgba(0,0,0,0.8) 100%);z-index:1}
.cf-pr-11-v3-content{position:relative;z-index:2;width:100%;padding:40px 60px;display:flex;align-items:flex-end;justify-content:space-between;gap:30px}
.cf-pr-11-v3-title{font-size:clamp(40px,7vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;line-height:1;margin:0;letter-spacing:-0.03em}
.cf-pr-11-v3-right{display:flex;flex-direction:column;align-items:flex-end;gap:20px;max-width:400px;text-align:right}
.cf-pr-11-v3-desc{font-size:16px;color:{{ section.settings.text_color }};opacity:0.9;line-height:1.5;margin:0}
.cf-pr-11-v3-btn{display:inline-block;padding:12px 0;color:{{ section.settings.text_color }};text-decoration:none;font-size:14px;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;border-bottom:2px solid {{ section.settings.text_color }};transition:0.3s}
.cf-pr-11-v3-btn:hover{color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-pr-11-v3-content{flex-direction:column;align-items:flex-start;padding:30px 20px}.cf-pr-11-v3-right{align-items:flex-start;text-align:left}}
</style>

<div class="cf-pr-11-v3">
  <div class="cf-pr-11-v3-overlay"></div>
  <div class="cf-pr-11-v3-content">
    <h2 class="cf-pr-11-v3-title">{{ section.settings.title | newline_to_br }}</h2>
    <div class="cf-pr-11-v3-right">
      <p class="cf-pr-11-v3-desc">{{ section.settings.desc }}</p>
      <a href="{{ section.settings.btn_link }}" class="cf-pr-11-v3-btn">{{ section.settings.btn_label }} &rarr;</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Promo (v3)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Image"},
    {"type":"textarea","id":"title","label":"Huge Title (Use Linebreaks)","default":"ENGINEERED\nFOR MOTION"},
    {"type":"range","id":"title_size","label":"Title Size","min":60,"max":160,"step":5,"default":100},
    {"type":"textarea","id":"desc","label":"Description","default":"Performance fabrics built into classic silhouettes. Move without restriction."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"VIEW LOOKBOOK"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#AAAAAA"},
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":85}
  ],
  "presets": [{"name":"11 · Men's Promo (v3)"}]
}
{% endschema %}
