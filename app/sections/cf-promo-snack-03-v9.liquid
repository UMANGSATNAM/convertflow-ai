<style>
.cf-ps-03-v9 {
  width: 100%;
  padding: {{ section.settings.padding_y }}px 20px;
  background: transparent;
  display: flex;
  justify-content: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.cf-ps-03-v9-inner {
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  border-radius: 30px;
  padding: 10px 24px;
  display: inline-flex;
  align-items: center;
  gap: 15px;
  font-size: {{ section.settings.text_size }}px;
  font-weight: 500;
  box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  border: 1px solid #eaeaea;
}

.cf-ps-03-v9-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: {{ section.settings.accent_color }};
  box-shadow: 0 0 8px {{ section.settings.accent_color }};
  animation: cf-ps-03-v9-pulse 2s infinite;
}

@keyframes cf-ps-03-v9-pulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(37, 99, 235, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
}

.cf-ps-03-v9-link {
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4px;
  transition: 0.2s;
}

.cf-ps-03-v9-link:hover {
  opacity: 0.8;
}

.cf-ps-03-v9-link svg {
  width: 14px; height: 14px;
}
</style>

<div class="cf-ps-03-v9">
  <div class="cf-ps-03-v9-inner">
    <div class="cf-ps-03-v9-dot"></div>
    <span>{{ section.settings.text }}</span>
    {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url }}" class="cf-ps-03-v9-link">
        {{ section.settings.link_text }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "09 · Clean Minimal Drop",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#2563eb"},
    {"type":"text","id":"text","label":"Text","default":"The Studio Desk setup is finally back in stock."},
    {"type":"text","id":"link_text","label":"Link Text","default":"Order yours"},
    {"type":"url","id":"link_url","label":"Link URL"},
    {"type":"range","id":"text_size","label":"Text Size","min":10,"max":24,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Container Vertical Padding","min":5,"max":40,"step":1,"default":15}
  ],
  "presets": [{"name":"09 · Clean Minimal Drop"}]
}
{% endschema %}
