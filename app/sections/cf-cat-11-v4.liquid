<style>
.cf-cat-11-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif}
.cf-cat-11-v4-inner{max-width:1400px;margin:0 auto}
.cf-cat-11-v4-grid{display:grid;grid-template-columns:1fr 2fr 1fr;gap:20px;height:{{ section.settings.height }}px}
.cf-cat-11-v4-card{position:relative;display:flex;align-items:center;justify-content:center;text-decoration:none;overflow:hidden;background:#e5e5e5;border-radius:4px}
.cf-cat-11-v4-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:0.6s}
.cf-cat-11-v4-card:hover .cf-cat-11-v4-img{transform:scale(1.03)}
.cf-cat-11-v4-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.3);transition:0.3s}
.cf-cat-11-v4-card:hover .cf-cat-11-v4-overlay{background:rgba(0,0,0,0.5)}
.cf-cat-11-v4-content{position:relative;z-index:2;text-align:center;padding:20px;width:100%}
.cf-cat-11-v4-label{font-size:clamp(20px,3vw,32px);color:#fff;font-weight:900;text-transform:uppercase;letter-spacing:0.02em;margin:0 0 10px 0}
.cf-cat-11-v4-btn{display:inline-block;padding:8px 24px;background:#fff;color:#111;font-size:11px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;border-radius:40px;opacity:0;transform:translateY(10px);transition:0.3s}
.cf-cat-11-v4-card:hover .cf-cat-11-v4-btn{opacity:1;transform:translateY(0)}
@media(max-width:900px){.cf-cat-11-v4-grid{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;height:calc({{ section.settings.height }}px * 1.5)}.cf-cat-11-v4-card:nth-child(2){grid-column:1/-1}}
@media(max-width:600px){.cf-cat-11-v4-grid{grid-template-columns:1fr;grid-template-rows:repeat(3,300px);height:auto}}
</style>

<div class="cf-cat-11-v4">
  <div class="cf-cat-11-v4-inner">
    <div class="cf-cat-11-v4-grid">
      {% for i in (1..3) %}
        {% capture img_key %}img_{{ i }}{% endcapture %}
        {% capture label_key %}label_{{ i }}{% endcapture %}
        {% capture link_key %}link_{{ i }}{% endcapture %}
        <a href="{{ section.settings[link_key] }}" class="cf-cat-11-v4-card">
          {% if section.settings[img_key] %}
            <img src="{{ section.settings[img_key] | image_url: width: 1000 }}" class="cf-cat-11-v4-img">
          {% else %}
            <div style="background:#555" class="cf-cat-11-v4-img"></div>
          {% endif %}
          <div class="cf-cat-11-v4-overlay"></div>
          <div class="cf-cat-11-v4-content">
            <h3 class="cf-cat-11-v4-label">{{ section.settings[label_key] }}</h3>
            <span class="cf-cat-11-v4-btn">EXPLORE &rarr;</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Category (v4)",
  "settings": [
    {"type":"image_picker","id":"img_1","label":"Image 1"},
    {"type":"text","id":"label_1","label":"Label 1","default":"BASICS"},
    {"type":"url","id":"link_1","label":"Link 1"},
    {"type":"image_picker","id":"img_2","label":"Image 2 (Center Large)"},
    {"type":"text","id":"label_2","label":"Label 2","default":"THE NEW COLLECTION"},
    {"type":"url","id":"link_2","label":"Link 2"},
    {"type":"image_picker","id":"img_3","label":"Image 3"},
    {"type":"text","id":"label_3","label":"Label 3","default":"OUTERWEAR"},
    {"type":"url","id":"link_3","label":"Link 3"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"range","id":"height","label":"Grid Height (px)","min":400,"max":800,"step":20,"default":600},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "presets": [{"name":"11 · Men's Category (v4)"}]
}
{% endschema %}
