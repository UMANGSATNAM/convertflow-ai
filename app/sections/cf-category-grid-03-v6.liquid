<style>
.cf-cg-03-v6 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  border-top: 1px solid {{ section.settings.border_color }};
  border-bottom: 1px solid {{ section.settings.border_color }};
}

.cf-cg-03-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cg-03-v6-track {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  padding-bottom: 20px;
  scrollbar-width: thin;
  scrollbar-color: {{ section.settings.accent_color }} {{ section.settings.bg_color }};
}

.cf-cg-03-v6-track::-webkit-scrollbar {
  height: 4px;
}
.cf-cg-03-v6-track::-webkit-scrollbar-track {
  background: {{ section.settings.bg_color }};
}
.cf-cg-03-v6-track::-webkit-scrollbar-thumb {
  background: {{ section.settings.accent_color }};
  border-radius: 4px;
}

.cf-cg-03-v6-tab {
  flex: 0 0 auto;
  background: transparent;
  border: 1px solid {{ section.settings.border_color }};
  color: {{ section.settings.text_color }};
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 12px 24px;
  text-decoration: none;
  transition: 0.3s;
  display: flex;
  align-items: center;
  gap: 10px;
}

.cf-cg-03-v6-tab:hover {
  background: {{ section.settings.accent_color }};
  color: #000;
  border-color: {{ section.settings.accent_color }};
  box-shadow: 0 0 15px {{ section.settings.accent_color }}80;
}

.cf-cg-03-v6-tab svg {
  width: 16px; height: 16px;
  opacity: 0.5;
  transition: 0.3s;
}

.cf-cg-03-v6-tab:hover svg {
  opacity: 1;
}

.cf-cg-03-v6-count {
  font-size: 10px;
  opacity: 0.5;
}
.cf-cg-03-v6-tab:hover .cf-cg-03-v6-count {
  opacity: 1;
}
</style>

<div class="cf-cg-03-v6">
  <div class="cf-cg-03-v6-inner">
    <div class="cf-cg-03-v6-track">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cg-03-v6-tab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          {{ block.settings.title }}
          <span class="cf-cg-03-v6-count">[{{ forloop.index | prepend: '0' | slice: -2, 2 }}]</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Neon Tab Menu",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#000000"},
    {"type":"color","id":"border_color","label":"Border Base","default":"#333333"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Neon Hover Accent","default":"#00ffff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":5,"default":30},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 12,
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Peripherals"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "06 · Neon Tab Menu",
      "blocks": [
        {"type": "category"},{"type": "category"},{"type": "category"},{"type": "category"},{"type": "category"}
      ]
    }
  ]
}
{% endschema %}
