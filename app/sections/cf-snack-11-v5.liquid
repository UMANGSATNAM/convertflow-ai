<style>
.cf-sn-11-v5{width:100%;height:{{ section.settings.height }}px;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;position:relative;font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-sn-11-v5-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});z-index:1}
.cf-sn-11-v5-content{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;text-align:center;gap:15px;padding:0 20px}
.cf-sn-11-v5-title{font-size:clamp(28px,4vw,{{ section.settings.title_size }}px);font-weight:900;text-transform:uppercase;margin:0;letter-spacing:-0.02em}
.cf-sn-11-v5-form{display:flex;width:100%;max-width:400px;margin-top:10px}
.cf-sn-11-v5-input{flex:1;padding:12px 15px;border:1px solid {{ section.settings.text_color }};background:transparent;color:{{ section.settings.text_color }};font-size:14px;outline:none;font-family:sans-serif}
.cf-sn-11-v5-input::placeholder{color:{{ section.settings.text_color }};opacity:0.7}
.cf-sn-11-v5-btn{padding:12px 25px;background:{{ section.settings.text_color }};color:#111;border:none;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.05em;cursor:pointer;transition:0.3s}
.cf-sn-11-v5-btn:hover{background:transparent;color:{{ section.settings.text_color }};border:1px solid {{ section.settings.text_color }}}
@media(max-width:600px){.cf-sn-11-v5-form{flex-direction:column;gap:10px}.cf-sn-11-v5-btn{width:100%}}
</style>

<div class="cf-sn-11-v5">
  <div class="cf-sn-11-v5-overlay"></div>
  <div class="cf-sn-11-v5-content">
    <h3 class="cf-sn-11-v5-title">{{ section.settings.title }}</h3>
    <p style="margin:0;font-size:14px;opacity:0.9;">{{ section.settings.desc }}</p>
    <form class="cf-sn-11-v5-form">
      <input type="email" placeholder="{{ section.settings.placeholder }}" class="cf-sn-11-v5-input" required>
      <button type="submit" class="cf-sn-11-v5-btn">{{ section.settings.btn_label }}</button>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Snack (v5)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Image"},
    {"type":"range","id":"overlay_opacity","label":"Overlay Opacity","min":0,"max":100,"step":5,"default":60},
    {"type":"text","id":"title","label":"Title","default":"JOIN THE CLUB"},
    {"type":"range","id":"title_size","label":"Title Size","min":20,"max":80,"step":2,"default":40},
    {"type":"text","id":"desc","label":"Description","default":"Sign up for 15% off your first order & exclusive access."},
    {"type":"text","id":"placeholder","label":"Input Placeholder","default":"Email address..."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"SUBSCRIBE"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"range","id":"height","label":"Height (px)","min":100,"max":600,"step":10,"default":300}
  ],
  "presets": [{"name":"11 · Men's Snack (v5)"}]
}
{% endschema %}
