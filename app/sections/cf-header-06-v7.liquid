<div class="cf-auto-header-v7" style="background: {{ section.settings.bg_color }}; border-bottom: 2px solid rgba(255,255,255,0.05);">
  <div class="cf-auto-header-v7-container" style="max-width: 1400px; margin: 0 auto; padding: 15px 30px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 40px;">

    <!-- Logo (Left) -->
    <div class="cf-auto-header-v7-logo">
      <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 15px;">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <div style="width: 44px; height: 44px; border: 3px solid {{ section.settings.accent_color }}; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative;">
            <div style="width: 24px; height: 2px; background: {{ section.settings.text_color }}; position: absolute; transform: rotate(45deg);"></div>
            <div style="width: 24px; height: 2px; background: {{ section.settings.text_color }}; position: absolute; transform: rotate(-45deg);"></div>
          </div>
          <span style="font-family: 'Rajdhani', sans-serif; font-size: 28px; font-weight: 700; color: {{ section.settings.text_color }}; letter-spacing: 2px; text-transform: uppercase;">
            {{ shop.name }}
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Centered Nav & Search Hybrid -->
    <div class="cf-auto-header-v7-center" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
      
      <!-- Nav -->
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 30px;">
        {% for link in linklists[section.settings.menu].links limit: 5 %}
          <li>
            <a href="{{ link.url }}" style="color: {{ section.settings.text_color }}; text-decoration: none; font-size: 14px; font-weight: 600; font-family: 'Rajdhani', sans-serif; text-transform: uppercase; letter-spacing: 1.5px; transition: color 0.2s;" class="cf-hover-accent">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>

      <!-- Subtle Search -->
      <form action="/search" method="get" style="width: 100%; max-width: 500px; position: relative;">
        <input type="text" name="q" placeholder="SEARCH OFF-ROAD GEAR..." style="width: 100%; padding: 8px 15px; padding-left: 35px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; color: {{ section.settings.text_color }}; font-family: 'Rajdhani', sans-serif; font-size: 13px; letter-spacing: 1px; outline: none; transition: border-color 0.3s;" class="cf-input-hover">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: rgba(255,255,255,0.5);"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </form>

    </div>

    <!-- Actions (Right) -->
    <div class="cf-auto-header-v7-actions" style="display: flex; align-items: center; gap: 20px;">
      <a href="/account" class="cf-icon-ring" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05); border-radius: 50%; color: {{ section.settings.text_color }}; text-decoration: none; transition: all 0.2s;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>
      <a href="/cart" class="cf-icon-ring" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: {{ section.settings.accent_color }}; border-radius: 50%; color: #000; text-decoration: none; position: relative; transition: all 0.2s;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span style="position: absolute; top: -5px; right: -5px; background: #fff; color: #000; font-family: 'Rajdhani', sans-serif; font-size: 11px; font-weight: 800; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border-radius: 50%; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap');
  
  .cf-hover-accent:hover { color: {{ section.settings.accent_color }} !important; }
  .cf-input-hover:focus { border-color: {{ section.settings.accent_color }} !important; }
  .cf-icon-ring:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(0,0,0,0.3); }

  @media (max-width: 900px) {
    .cf-auto-header-v7-container { grid-template-columns: 1fr auto; padding: 15px; }
    .cf-auto-header-v7-center { display: none; }
  }
</style>

{% schema %}
{
  "name": "06 · Off-Road Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#f59e0b"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Height",
      "default": 40
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
