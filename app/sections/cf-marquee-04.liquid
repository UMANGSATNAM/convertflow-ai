<style>
.cf-mq-04{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0}
.cf-mq-04-wrap{display:flex;white-space:nowrap;animation:cf-mq-04-s {{ section.settings.speed }}s linear infinite}
.cf-mq-04-item{font-family:sans-serif;color:{{ section.settings.text_color }};font-size:{{ section.settings.text_size }}px;font-weight:500;padding:0 40px;display:flex;align-items:center;gap:40px}
.cf-mq-04-icon{color:{{ section.settings.accent_color }};display:flex;align-items:center}
@keyframes cf-mq-04-s{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>
<div class="cf-mq-04">
  <div class="cf-mq-04-wrap">
    {% assign reps = (1..15) %}
    {% for i in reps %}
      <div class="cf-mq-04-item">
        <span>{{ section.settings.text }}</span>
        <div class="cf-mq-04-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "04 · Health Marquee",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"100% ORGANIC & CRUELTY FREE"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ecfccb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#3f6212"},
    {"type":"color","id":"accent_color","label":"Icon Color","default":"#65a30d"},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":60,"step":2,"default":25},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":32,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":16}
  ],
  "presets": [{"name":"04 · Health Marquee"}]
}
{% endschema %}
