<style>
.cf-tr-11{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif;border-top:1px solid {{ section.settings.border_color }};border-bottom:1px solid {{ section.settings.border_color }}}
.cf-tr-11-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:center;gap:40px;flex-wrap:wrap}
.cf-tr-11-item{display:flex;flex-direction:column;align-items:flex-start;flex:1;min-width:200px}
.cf-tr-11-icon{margin-bottom:15px;color:{{ section.settings.text_color }};opacity:0.8}
.cf-tr-11-title{font-size:12px;color:{{ section.settings.text_color }};font-weight:600;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:8px}
.cf-tr-11-desc{font-size:14px;color:#64748b;line-height:1.5}
@media(max-width:768px){.cf-tr-11-inner{flex-direction:column;gap:30px}}
</style>

<div class="cf-tr-11">
  <div class="cf-tr-11-inner">
    {% for block in section.blocks %}
    <div class="cf-tr-11-item">
      <div class="cf-tr-11-icon">
        {% if block.settings.icon == 'shield' %}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        {% elsif block.settings.icon == 'box' %}
           <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        {% else %}
           <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
        {% endif %}
      </div>
      <div class="cf-tr-11-title">{{ block.settings.title }}</div>
      <div class="cf-tr-11-desc">{{ block.settings.desc }}</div>
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Trust",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"border_color","label":"Border","default":"#e2e8f0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust Item",
      "limit": 4,
      "settings": [
        {"type":"select","id":"icon","label":"Icon","options":[{"value":"shield","label":"Shield"},{"value":"box","label":"Box"},{"value":"database","label":"Database"}],"default":"shield"},
        {"type":"text","id":"title","label":"Title","default":"Secure Checkout"},
        {"type":"text","id":"desc","label":"Description","default":"Encrypted processing."}
      ]
    }
  ],
  "presets": [
    {
      "name": "11 · Men's Trust",
      "blocks": [
        {"type":"trust","settings":{"icon":"shield","title":"Authenticity","desc":"Guaranteed origin & quality."}},
        {"type":"trust","settings":{"icon":"box","title":"Global Shipping","desc":"Insured & tracked worldwide."}},
        {"type":"trust","settings":{"icon":"database","title":"Data Privacy","desc":"We never share your info."}}
      ]
    }
  ]
}
{% endschema %}
