<div class="cf-auto-snack-v8" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 40px 20px;">
  <div class="cf-auto-snack-v8-container" style="max-width: 1000px; margin: 0 auto; background: {{ section.settings.card_bg }}; padding: 4px; display: flex; align-items: stretch; position: relative;">
    
    <!-- Outer thick border illusion using padding -->
    <div style="width: 100%; border: 1px dashed {{ section.settings.border_color }}; display: flex; align-items: center; justify-content: space-between; padding: 25px 40px; background: {{ section.settings.card_bg }};">
      
      <div>
        <h3 style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 20px; font-weight: 700; text-transform: uppercase; margin: 0 0 5px 0; letter-spacing: 1px;">
          {{ section.settings.title }}
        </h3>
        <p style="font-family: Georgia, serif; font-size: 15px; font-style: italic; opacity: 0.8; margin: 0;">
          {{ section.settings.subtitle }}
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 20px;">
        <div style="background: {{ section.settings.bg_color }}; padding: 10px 20px; border: 1px solid {{ section.settings.border_color }}; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 700; letter-spacing: 2px;">
          {{ section.settings.code }}
        </div>
        <a href="{{ section.settings.btn_link }}" class="cf-btn-snack-v8" style="display: inline-block; background: transparent; color: {{ section.settings.text_color }}; padding: 12px 0; border-bottom: 2px solid {{ section.settings.text_color }}; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; text-decoration: none; transition: color 0.2s, border-color 0.2s;">
          {{ section.settings.btn_text }}
        </a>
      </div>

    </div>

  </div>
</div>

<style>
  .cf-btn-snack-v8:hover {
    color: {{ section.settings.accent_color }} !important;
    border-color: {{ section.settings.accent_color }} !important;
  }
  @media (max-width: 800px) {
    .cf-auto-snack-v8-container > div { flex-direction: column; text-align: center; gap: 20px; padding: 30px 20px !important; }
    .cf-auto-snack-v8-container > div > div:last-child { flex-direction: column; }
  }
</style>

{% schema %}
{
  "name": "06 · Classic Ticket Snack",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Ticket Background",
      "default": "#fcfcfc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#d9534f"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border/Dashed Color",
      "default": "#cccccc"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "COMPLIMENTARY SHIPPING"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Valid on all parts orders over $150."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Promo Code",
      "default": "FREESHIP150"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Link Text",
      "default": "APPLY AT CHECKOUT"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
