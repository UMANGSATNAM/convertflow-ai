<style>
.cf-cat-05-v9 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: 'Baskerville','Georgia',serif; }
.cf-cat-05-v9-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-cat-05-v9-header { text-align: center; margin-bottom: 50px; }
.cf-cat-05-v9-title { font-size: 42px; font-weight: normal; font-style: italic; color: {{ section.settings.text_color }}; margin: 0; }
.cf-cat-05-v9-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 10px; }
.cf-cat-05-v9-card { display: block; text-decoration: none; position: relative; aspect-ratio: 2/3; overflow: hidden; }
.cf-cat-05-v9-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; transition: transform 0.6s; }
.cf-cat-05-v9-card:hover .cf-cat-05-v9-img img { transform: scale(1.06); }
.cf-cat-05-v9-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, rgba(44,36,22,0.75) 100%); display: flex; align-items: flex-end; padding: 25px; }
.cf-cat-05-v9-name { color: #faf8f5; font-size: 22px; font-weight: normal; font-style: italic; }
@media (max-width: 900px) { .cf-cat-05-v9-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-cat-05-v9">
  <div class="cf-cat-05-v9-inner">
    <div class="cf-cat-05-v9-header"><h2 class="cf-cat-05-v9-title">{{ section.settings.title }}</h2></div>
    <div class="cf-cat-05-v9-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-05-v9-card">
        <div class="cf-cat-05-v9-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-cat-05-v9-overlay"><span class="cf-cat-05-v9-name">{{ block.settings.title }}</span></div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "09 · Fragrance Grid","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#faf8f5"},{"type":"color","id":"text_color","label":"Text Color","default":"#2c2416"},{"type":"text","id":"title","label":"Title","default":"Nos Familles Olfactives"},{"type":"range","id":"cols","label":"Columns","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1400}],"blocks": [{"type": "category","name": "Category","settings": [{"type":"text","id":"title","label":"Name","default":"Floral"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets": [{"name": "09 · Fragrance Grid","blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
