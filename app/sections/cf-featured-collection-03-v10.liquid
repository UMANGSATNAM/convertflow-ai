<style>
.cf-fc-03-v10 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: 'Inter', sans-serif;
}

.cf-fc-03-v10-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-03-v10-heading {
  font-size: clamp(32px, 5vw, 48px);
  color: {{ section.settings.text_color }};
  font-weight: 900;
  text-transform: uppercase;
  font-style: italic;
  text-align: center;
  margin: 0 0 50px 0;
  letter-spacing: -0.02em;
}

.cf-fc-03-v10-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 30px;
}

.cf-fc-03-v10-card-wrap {
  position: relative;
  padding: 3px; 
  border-radius: 12px;
  background: #222; /* Fallback/Default border */
  z-index: 1;
  transition: 0.4s;
}

.cf-fc-03-v10-card-wrap:hover {
  background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
  background-size: 400% 400%;
  animation: cf-fc-03-v10-rgb 2s linear infinite;
  box-shadow: 0 10px 30px rgba(255,255,255,0.1);
  transform: translateY(-5px);
}

@keyframes cf-fc-03-v10-rgb {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.cf-fc-03-v10-card {
  background: #0b0b0f;
  border-radius: 9px;
  display: flex;
  flex-direction: column;
  padding: 30px;
  text-decoration: none;
  height: 100%;
  position: relative;
  z-index: 2;
}

.cf-fc-03-v10-img-wrap {
  width: 100%;
  aspect-ratio: 1/1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.cf-fc-03-v10-img {
  width: 100%; height: 100%; object-fit: contain;
  filter: drop-shadow(0 0 10px rgba(255,255,255,0.05));
  transition: 0.3s;
}

.cf-fc-03-v10-card-wrap:hover .cf-fc-03-v10-img {
  transform: scale(1.05);
  filter: drop-shadow(0 10px 20px rgba(255,255,255,0.2));
}

.cf-fc-03-v10-title {
  color: {{ section.settings.text_color }};
  font-size: 20px;
  font-weight: 800;
  text-transform: uppercase;
  font-style: italic;
  margin: 0 0 10px 0;
  line-height: 1.2;
}

.cf-fc-03-v10-price {
  color: {{ section.settings.text_color }};
  font-size: 18px;
  opacity: 0.8;
  margin-top: auto;
}

.cf-fc-03-v10-btn {
  margin-top: 20px;
  display: inline-block;
  background: transparent;
  color: {{ section.settings.text_color }};
  border: 2px solid {{ section.settings.text_color }};
  padding: 10px 20px;
  text-align: center;
  font-weight: 800;
  text-transform: uppercase;
  font-style: italic;
  border-radius: 4px;
  transition: 0.3s;
}

.cf-fc-03-v10-card-wrap:hover .cf-fc-03-v10-btn {
  background: {{ section.settings.text_color }};
  color: #000;
}

</style>

<div class="cf-fc-03-v10">
  <div class="cf-fc-03-v10-inner">
    <h2 class="cf-fc-03-v10-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-fc-03-v10-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <div class="cf-fc-03-v10-card-wrap">
            <a href="{{ product.url }}" class="cf-fc-03-v10-card">
              <div class="cf-fc-03-v10-img-wrap">
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="cf-fc-03-v10-img">
              </div>
              <h3 class="cf-fc-03-v10-title">{{ product.title }}</h3>
              <div class="cf-fc-03-v10-price">{{ product.price | money }}</div>
              <div class="cf-fc-03-v10-btn">SELECT GEAR</div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <div class="cf-fc-03-v10-card-wrap">
            <a href="#" class="cf-fc-03-v10-card">
              <div class="cf-fc-03-v10-img-wrap">
                <div style="width:120px; height:120px; background:#222; border-radius:10px;"></div>
              </div>
              <h3 class="cf-fc-03-v10-title">RGB Accessory {{ i }}</h3>
              <div class="cf-fc-03-v10-price">$129.99</div>
              <div class="cf-fc-03-v10-btn">SELECT GEAR</div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · RGB Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRO GEAR SHOWCASE"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "10 · RGB Showcase Collect"
    }
  ]
}
{% endschema %}
