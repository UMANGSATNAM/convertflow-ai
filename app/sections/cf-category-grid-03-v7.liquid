<style>
.cf-cg-03-v7 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-cg-03-v7-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cg-03-v7-heading {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: clamp(32px, 5vw, 48px);
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  margin: 0 0 50px 0;
  text-align: center;
}

.cf-cg-03-v7-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 30px;
}

.cf-cg-03-v7-card {
  position: relative;
  text-decoration: none;
  background: #111;
  aspect-ratio: 4/3;
  /* Cybercut corners */
  clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  overflow: hidden;
  transition: 0.3s;
}

.cf-cg-03-v7-card::before {
  content: '';
  position: absolute;
  top: 2px; left: 2px; right: 2px; bottom: 2px;
  background: {{ section.settings.panel_bg }};
  clip-path: polygon(19px 0, 100% 0, 100% calc(100% - 19px), calc(100% - 19px) 100%, 0 100%, 0 19px);
  z-index: 1;
}

.cf-cg-03-v7-card:hover {
  transform: translateY(-5px);
}

.cf-cg-03-v7-card:hover::before {
  background: {{ section.settings.accent_color }};
  opacity: 0.1;
}

.cf-cg-03-v7-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: {{ section.settings.accent_color }};
  clip-path: polygon(0 0, 20px 0, 0 20px);
  z-index: 5;
}

.cf-cg-03-v7-img {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover;
  z-index: 2;
  opacity: 0.6;
  filter: grayscale(0.5);
  transition: 0.4s;
}

.cf-cg-03-v7-card:hover .cf-cg-03-v7-img {
  opacity: 0.9;
  filter: grayscale(0);
  transform: scale(1.05);
}

.cf-cg-03-v7-content {
  position: absolute;
  bottom: 20px; right: 20px;
  z-index: 3;
  text-align: right;
}

.cf-cg-03-v7-title {
  color: {{ section.settings.text_color }};
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: 24px;
  text-transform: uppercase;
  margin: 0;
  /* Stroke effect */
  text-shadow: 2px 2px 0 #000;
  transition: 0.3s;
}

.cf-cg-03-v7-card:hover .cf-cg-03-v7-title {
  color: {{ section.settings.accent_color }};
  text-shadow: 2px 2px 0 {{ section.settings.bg_color }}, 4px 4px 0 {{ section.settings.text_color }};
}
</style>

<div class="cf-cg-03-v7">
  <div class="cf-cg-03-v7-inner">
    <h2 class="cf-cg-03-v7-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-cg-03-v7-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cg-03-v7-card">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" class="cf-cg-03-v7-img">
          {% else %}
            <div class="cf-cg-03-v7-img" style="background:#222;"></div>
          {% endif %}
          <div class="cf-cg-03-v7-content">
            <h3 class="cf-cg-03-v7-title">{{ block.settings.title }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "07 · Cyber Angular Cards",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"CATEGORIES_"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#08080c"},
    {"type":"color","id":"panel_bg","label":"Panel Base","default":"#16161c"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Cyber Accent","default":"#ff003c"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 6,
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Neon Synth"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "07 · Cyber Angular Cards",
      "blocks": [
        {"type": "category"},{"type": "category"},{"type": "category"}
      ]
    }
  ]
}
{% endschema %}
