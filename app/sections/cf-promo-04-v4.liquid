<style>
.cf-pr-04-v4 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-pr-04-v4-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex;
  background: #fff;
  border: 1px solid {{ section.settings.border_color }};
  box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
}

.cf-pr-04-v4-image {
  width: 45%;
  position: relative;
  background: #f8fafc;
}

.cf-pr-04-v4-image img {
  width: 100%; height: 100%; object-fit: cover;
  position: absolute; top: 0; left: 0;
}

.cf-pr-04-v4-content {
  width: 55%;
  padding: 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cf-pr-04-v4-tag {
  color: {{ section.settings.accent_color }};
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.cf-pr-04-v4-title {
  color: {{ section.settings.text_color }};
  font-size: 38px;
  font-weight: 800;
  margin: 0 0 25px 0;
  line-height: 1.1;
  letter-spacing: -0.03em;
}

.cf-pr-04-v4-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  margin-bottom: 40px;
  border-left: 3px solid {{ section.settings.accent_color }};
  padding-left: 20px;
}

.cf-pr-04-v4-stat {
  display: flex;
  flex-direction: column;
}

.cf-pr-04-v4-stat-val {
  font-size: 32px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  margin-bottom: 5px;
}

.cf-pr-04-v4-stat-label {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.4;
}

.cf-pr-04-v4-btn {
  display: inline-block;
  background-color: {{ section.settings.accent_color }};
  color: #fff;
  padding: 14px 30px;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  text-align: center;
  border-radius: 4px;
  transition: opacity 0.3s;
  align-self: flex-start;
}

.cf-pr-04-v4-btn:hover {
  opacity: 0.9;
}

@media (max-width: 900px) {
  .cf-pr-04-v4-inner { flex-direction: column; }
  .cf-pr-04-v4-image { width: 100%; min-height: 300px; }
  .cf-pr-04-v4-content { width: 100%; padding: 40px 20px; }
  .cf-pr-04-v4-stats { grid-template-columns: 1fr; gap: 20px; }
}
</style>

<div class="cf-pr-04-v4">
  <div class="cf-pr-04-v4-inner">
    <div class="cf-pr-04-v4-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}">
      {% else %}
        <div style="width:100%;height:100%;position:absolute;display:flex;align-items:center;justify-content:center;color:#94a3b8;">Image Placeholder</div>
      {% endif %}
    </div>
    <div class="cf-pr-04-v4-content">
      <div class="cf-pr-04-v4-tag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        {{ section.settings.tag }}
      </div>
      <h2 class="cf-pr-04-v4-title">{{ section.settings.title }}</h2>
      
      <div class="cf-pr-04-v4-stats">
        {% for block in section.blocks %}
          <div class="cf-pr-04-v4-stat">
            <div class="cf-pr-04-v4-stat-val">{{ block.settings.val }}</div>
            <div class="cf-pr-04-v4-stat-label">{{ block.settings.label }}</div>
          </div>
        {% endfor %}
      </div>
      
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-pr-04-v4-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Clinical Proof Board",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f8fafc"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#2563eb"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},
    {"type":"text","id":"tag","label":"Tag","default":"CLINICALLY PROVEN"},
    {"type":"text","id":"title","label":"Title","default":"Backed by science. Driven by results."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Read the Study"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 2,
      "settings": [
        {"type":"text","id":"val","label":"Value","default":"94%"},
        {"type":"text","id":"label","label":"Label","default":"report clearer skin within 14 days."}
      ]
    }
  ],
  "presets": [
    {
      "name": "04 · Clinical Proof Board",
      "blocks": [{"type":"stat"},{"type":"stat"}]
    }
  ]
}
{% endschema %}
