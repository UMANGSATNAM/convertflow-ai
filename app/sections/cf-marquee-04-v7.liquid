<style>
.cf-mq-04-v7 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  text-transform: uppercase;
}

.cf-mq-04-v7-track {
  display: inline-flex;
  animation: cf-mq-04-v7-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v7-item {
  display: inline-flex;
  align-items: center;
  padding: 0 50px;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 0.05em;
}

.cf-mq-04-v7-icon {
  margin: 0 50px;
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
  transform: skewX(-15deg);
}

.cf-mq-04-v7-icon svg {
  width: 28px; height: 28px; stroke-width: 3;
}

@keyframes cf-mq-04-v7-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v7">
  <div class="cf-mq-04-v7-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v7-item">
          <span>{{ block.settings.text }}</span>
          <div class="cf-mq-04-v7-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "07 · Active Pulse",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#111827"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Lightning Color","default":"#f97316"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20},
    {"type":"range","id":"font_size","label":"Font Size","min":16,"max":48,"step":2,"default":28},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":5,"max":40,"step":1,"default":15}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"FUEL YOUR POTENTIAL"}
      ]
    }
  ],
  "presets": [
    {
      "name": "07 · Active Pulse",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
