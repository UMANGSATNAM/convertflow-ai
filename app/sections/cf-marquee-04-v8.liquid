<style>
.cf-mq-04-v8 {
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.cf-mq-04-v8-track {
  display: inline-flex;
  animation: cf-mq-04-v8-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v8-item {
  display: inline-flex;
  align-items: center;
  padding: 0 80px;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 300;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: {{ section.settings.text_color }};
  text-shadow: 0 0 10px {{ section.settings.text_color | color_modify: 'alpha', 0.2 }};
}

.cf-mq-04-v8-icon {
  margin: 0 80px;
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
}

.cf-mq-04-v8-icon svg {
  width: 14px; height: 14px; stroke-width: 1.5;
}

@keyframes cf-mq-04-v8-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v8">
  <div class="cf-mq-04-v8-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v8-item">
          <span>{{ block.settings.text }}</span>
          <div class="cf-mq-04-v8-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4"></circle></svg>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "08 · Holistic Aura",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F9F9F9"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#8E9E94"},
    {"type":"color","id":"accent_color","label":"Icon Color","default":"#CBD5CF"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":2,"default":30},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":32,"step":1,"default":16},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":100,"step":5,"default":60}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"BALANCE BODY & MIND"}
      ]
    }
  ],
  "presets": [
    {
      "name": "08 · Holistic Aura",
      "blocks": [{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
