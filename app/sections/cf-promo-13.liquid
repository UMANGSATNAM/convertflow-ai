<style>
.cf-pr-13{width:100%;height:{{ section.settings.height }}vh;background:{{ section.settings.bg_color }};display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;font-family:sans-serif}
.cf-pr-13-grid{position:absolute;top:0;left:0;width:100%;height:100%;display:grid;grid-template-columns:1fr 1.5fr 1fr;grid-template-rows:1fr 1fr;gap:10px;padding:20px;box-sizing:border-box}
.cf-pr-13-img{width:100%;height:100%;object-fit:cover;transition:0.5s}
.cf-pr-13-img-1{grid-column:1 / 2;grid-row:1 / 3}
.cf-pr-13-img-2{grid-column:2 / 3;grid-row:1 / 3;object-position:top}
.cf-pr-13-img-3{grid-column:3 / 4;grid-row:1 / 2}
.cf-pr-13-img-4{grid-column:3 / 4;grid-row:2 / 3}
.cf-pr-13:hover .cf-pr-13-img{transform:scale(1.02)}
.cf-pr-13-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.4);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px}
.cf-pr-13-title{font-size:clamp(50px,8vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;line-height:0.9;margin:0 0 30px 0;letter-spacing:-0.03em;text-shadow:2px 2px 4px rgba(0,0,0,0.5)}
.cf-pr-13-btn{display:inline-block;padding:18px 50px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};text-decoration:none;font-size:14px;font-weight:900;text-transform:uppercase;letter-spacing:0.05em;transition:0.3s;box-shadow:0 10px 30px rgba(0,0,0,0.3)}
.cf-pr-13-btn:hover{background:{{ section.settings.accent_color }};color:{{ section.settings.text_color }};transform:translateY(-5px)}
@media(max-width:768px){.cf-pr-13-grid{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr 1fr}.cf-pr-13-img-1{grid-column:1/3;grid-row:1/2}.cf-pr-13-img-2{grid-column:1/3;grid-row:2/3}.cf-pr-13-img-3{grid-column:1/2;grid-row:3/4}.cf-pr-13-img-4{grid-column:2/3;grid-row:3/4}}
</style>

<div class="cf-pr-13">
  <div class="cf-pr-13-grid">
    {% if section.settings.img_1 %}<img src="{{ section.settings.img_1 | image_url: width: 800 }}" class="cf-pr-13-img cf-pr-13-img-1">{% else %}<div style="background:#e5e5e5;width:100%;height:100%;" class="cf-pr-13-img cf-pr-13-img-1"></div>{% endif %}
    {% if section.settings.img_2 %}<img src="{{ section.settings.img_2 | image_url: width: 1200 }}" class="cf-pr-13-img cf-pr-13-img-2">{% else %}<div style="background:#d4d4d4;width:100%;height:100%;" class="cf-pr-13-img cf-pr-13-img-2"></div>{% endif %}
    {% if section.settings.img_3 %}<img src="{{ section.settings.img_3 | image_url: width: 600 }}" class="cf-pr-13-img cf-pr-13-img-3">{% else %}<div style="background:#a3a3a3;width:100%;height:100%;" class="cf-pr-13-img cf-pr-13-img-3"></div>{% endif %}
    {% if section.settings.img_4 %}<img src="{{ section.settings.img_4 | image_url: width: 600 }}" class="cf-pr-13-img cf-pr-13-img-4">{% else %}<div style="background:#737373;width:100%;height:100%;" class="cf-pr-13-img cf-pr-13-img-4"></div>{% endif %}
  </div>
  
  <div class="cf-pr-13-overlay">
    <h2 class="cf-pr-13-title">{{ section.settings.title }}</h2>
    <a href="{{ section.settings.btn_link }}" class="cf-pr-13-btn">{{ section.settings.btn_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Promo",
  "settings": [
    {"type":"image_picker","id":"img_1","label":"Image 1 (Left Tall)"},
    {"type":"image_picker","id":"img_2","label":"Image 2 (Center Hero)"},
    {"type":"image_picker","id":"img_3","label":"Image 3 (Right Top)"},
    {"type":"image_picker","id":"img_4","label":"Image 4 (Right Bottom)"},
    {"type":"text","id":"title","label":"Title","default":"DROP ZERO // THE ARCHIVES"},
    {"type":"range","id":"title_size","label":"Title Size","min":40,"max":160,"step":5,"default":100},
    {"type":"text","id":"btn_label","label":"Button Label","default":"Shop The Drop"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Background Elements","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Button Hover Color","default":"#dc2626"},
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":85}
  ],
  "presets": [{"name":"13 · Brand Promo"}]
}
{% endschema %}
