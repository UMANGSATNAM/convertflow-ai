<style>
.cf-ps-04-v4 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  display: flex;
  justify-content: center;
}

.cf-ps-04-v4-inner {
  max-width: {{ section.settings.max_width }}px;
  background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  border-left: 4px solid {{ section.settings.accent_color }};
  padding: 12px 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  width: 100%;
}

.cf-ps-04-v4-icon {
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
  justify-content: center;
}

.cf-ps-04-v4-icon svg {
  width: 22px; height: 22px; stroke-width: 2;
}

.cf-ps-04-v4-text {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  font-weight: 500;
  margin: 0;
}

.cf-ps-04-v4-text strong {
  font-weight: 800;
  color: {{ section.settings.text_color }};
}

@media (max-width: 600px) {
  .cf-ps-04-v4-text { font-size: 13px; }
}
</style>

<div class="cf-ps-04-v4">
  <div class="cf-ps-04-v4-inner">
    <div class="cf-ps-04-v4-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <p class="cf-ps-04-v4-text">
      {{ section.settings.text | replace: '[', '<strong>' | replace: ']', '</strong>' }}
    </p>
  </div>
</div>

{% schema %}
{
  "name": "04 · Clinical Alert",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Wrappper","default":"#f8fafc"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#2563eb"},
    {"type":"text","id":"text","label":"Text (use [brackets] to bold)","default":"[Free clinical consultation] with any purchase today."},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":400,"max":1200,"step":50,"default":800}
  ],
  "presets": [{"name":"04 · Clinical Proof Snack"}]
}
{% endschema %}
