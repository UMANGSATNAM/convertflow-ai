<style>
.cf-promo-05-v4 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: 'Didot','Playfair Display','Georgia',serif;
}
.cf-promo-05-v4-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.cf-promo-05-v4-image {
  aspect-ratio: 3/4;
  position: relative;
  overflow: hidden;
}
.cf-promo-05-v4-image img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(15%); }
.cf-promo-05-v4-image::after {
  content: '';
  position: absolute;
  inset: 15px;
  border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
  pointer-events: none;
}
.cf-promo-05-v4-content {}
.cf-promo-05-v4-label {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 11px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
  margin-bottom: 20px;
}
.cf-promo-05-v4-title {
  font-size: clamp(36px, 4vw, 60px);
  font-weight: normal;
  font-style: italic;
  color: {{ section.settings.text_color }};
  margin: 0 0 25px 0;
  line-height: 1.15;
}
.cf-promo-05-v4-divider {
  width: 50px; height: 1px;
  background: {{ section.settings.accent_color }};
  margin-bottom: 25px;
}
.cf-promo-05-v4-desc {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #888;
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 35px;
}
.cf-promo-05-v4-btn {
  display: inline-block;
  border: 1px solid {{ section.settings.accent_color }};
  color: {{ section.settings.accent_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  text-decoration: none;
  padding: 14px 35px;
  font-size: 12px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  transition: all 0.3s;
}
.cf-promo-05-v4-btn:hover { background: {{ section.settings.accent_color }}; color: {{ section.settings.bg_color }}; }
@media (max-width: 768px) { .cf-promo-05-v4-inner { grid-template-columns: 1fr; gap: 30px; } }
</style>

<div class="cf-promo-05-v4">
  <div class="cf-promo-05-v4-inner">
    <div class="cf-promo-05-v4-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}">
      {% endif %}
    </div>
    <div class="cf-promo-05-v4-content">
      <div class="cf-promo-05-v4-label">{{ section.settings.label }}</div>
      <h2 class="cf-promo-05-v4-title">{{ section.settings.title }}</h2>
      <div class="cf-promo-05-v4-divider"></div>
      <p class="cf-promo-05-v4-desc">{{ section.settings.desc }}</p>
      <a href="{{ section.settings.btn_link }}" class="cf-promo-05-v4-btn">{{ section.settings.btn_text }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Luxury Cosmetics Pro",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#e8d5b7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold Accent",
      "default": "#d4af37"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Édition Limitée"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Art of\nTimeless Beauty"
    },
    {
      "type": "textarea",
      "id": "desc",
      "label": "Description",
      "default": "A curation of our most coveted formulas, crafted with rare botanical extracts."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1300
    }
  ],
  "presets": [
    {
      "name": "04 · Luxury Cosmetics Pro"
    }
  ]
}
{% endschema %}
