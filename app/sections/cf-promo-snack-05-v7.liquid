<style>
.cf-snack-05-v7 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  border-left: 4px solid {{ section.settings.accent_color }};
}
.cf-snack-05-v7-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
}
.cf-snack-05-v7-left { display: flex; align-items: center; gap: 15px; }
.cf-snack-05-v7-icon { color: {{ section.settings.accent_color }}; }
.cf-snack-05-v7-icon svg { width: 22px; height: 22px; stroke-width: 2; }
.cf-snack-05-v7-text { font-size: 14px; color: {{ section.settings.text_color }}; font-weight: 600; }
.cf-snack-05-v7-btn {
  background: {{ section.settings.accent_color }}; color: #fff;
  text-decoration: none; padding: 8px 18px; border-radius: 4px;
  font-size: 13px; font-weight: 700; white-space: nowrap; transition: opacity 0.2s;
}
.cf-snack-05-v7-btn:hover { opacity: 0.85; }
@media (max-width: 600px) { .cf-snack-05-v7-inner { flex-direction: column; } }
</style>

<div class="cf-snack-05-v7">
  <div class="cf-snack-05-v7-inner">
    <div class="cf-snack-05-v7-left">
      <div class="cf-snack-05-v7-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <span class="cf-snack-05-v7-text">{{ section.settings.text }}</span>
    </div>
    <a href="{{ section.settings.btn_link }}" class="cf-snack-05-v7-btn">{{ section.settings.btn_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "07 · Derm Promo Snack",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#f0fdfa"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#134e4a"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#0d9488"},
    {"type":"text","id":"text","label":"Message Text","default":"Now with 3.5% Retinol Complex — clinically tested for visible results"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Now"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":60,"step":5,"default":18},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "presets": [{"name": "07 · Derm Promo Snack"}]
}
{% endschema %}
