<style>
.cf-ps-03-v3 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: {{ section.settings.text_size }}px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: {{ section.settings.padding_y }}px 20px;
  text-align: center;
  position: relative;
  border-bottom: 2px solid {{ section.settings.border_color }};
  transition: 0.3s;
}

.cf-ps-03-v3:hover {
  text-shadow: 2px 0 0 #ff003c, -2px 0 0 #00ffff;
}

.cf-ps-03-v3-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

.cf-ps-03-v3-label {
  background: {{ section.settings.accent_color }};
  color: #000;
  padding: 2px 8px;
  font-size: 0.8em;
  transform: skewX(-10deg);
}

.cf-ps-03-v3-link {
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  border-bottom: 2px solid {{ section.settings.accent_color }};
  transition: 0.2s;
}

.cf-ps-03-v3-link:hover {
  background: {{ section.settings.accent_color }};
  color: #000;
}
</style>

<div class="cf-ps-03-v3">
  <div class="cf-ps-03-v3-inner">
    <div class="cf-ps-03-v3-label">{{ section.settings.label }}</div>
    <span>{{ section.settings.text }}</span>
    {% if section.settings.link_text != blank %}
      <a href="{{ section.settings.link_url }}" class="cf-ps-03-v3-link">{{ section.settings.link_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "03 · Glitch Notification",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#16161c"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#333333"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#ff003c"},
    {"type":"text","id":"label","label":"Badge Label","default":"OVERRIDE"},
    {"type":"text","id":"text","label":"Text","default":"Flash sale ends in 00:59:59"},
    {"type":"text","id":"link_text","label":"Link Text","default":"ACTIVATE"},
    {"type":"url","id":"link_url","label":"Link URL"},
    {"type":"range","id":"text_size","label":"Text Size","min":10,"max":24,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":30,"step":1,"default":12}
  ],
  "presets": [{"name":"03 · Glitch Notification"}]
}
{% endschema %}
