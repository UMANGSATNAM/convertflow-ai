<style>
.cf-promo-05-v6 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-promo-05-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
}
.cf-promo-05-v6-image { aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: #f5f3ff; }
.cf-promo-05-v6-image img { width: 100%; height: 100%; object-fit: cover; }
.cf-promo-05-v6-content { order: 2; }
.cf-promo-05-v6-badge {
  display: inline-block; background: {{ section.settings.accent_color }};
  color: #fff; font-size: 12px; font-weight: 700;
  padding: 5px 14px; border-radius: 4px; margin-bottom: 20px;
  text-transform: uppercase; letter-spacing: 0.08em;
}
.cf-promo-05-v6-title {
  font-size: clamp(28px, 3vw, 46px); font-weight: 900;
  color: {{ section.settings.text_color }}; margin: 0 0 15px 0; line-height: 1.1;
}
.cf-promo-05-v6-desc { color: #6b7280; font-size: 16px; line-height: 1.7; margin-bottom: 30px; }
.cf-promo-05-v6-actions { display: flex; gap: 15px; flex-wrap: wrap; }
.cf-promo-05-v6-btn {
  background: {{ section.settings.accent_color }}; color: #fff; text-decoration: none;
  padding: 14px 28px; border-radius: 6px; font-weight: 700; font-size: 14px;
  transition: opacity 0.2s;
}
.cf-promo-05-v6-btn:hover { opacity: 0.85; }
@media (max-width: 768px) { .cf-promo-05-v6-inner { grid-template-columns: 1fr; gap: 30px; } .cf-promo-05-v6-content { order: 1; } .cf-promo-05-v6-image { order: 2; } }
</style>

<div class="cf-promo-05-v6">
  <div class="cf-promo-05-v6-inner">
    <div class="cf-promo-05-v6-image">
      {% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.title }}">{% endif %}
    </div>
    <div class="cf-promo-05-v6-content">
      <div class="cf-promo-05-v6-badge">{{ section.settings.badge }}</div>
      <h2 class="cf-promo-05-v6-title">{{ section.settings.title }}</h2>
      <p class="cf-promo-05-v6-desc">{{ section.settings.desc }}</p>
      <div class="cf-promo-05-v6-actions">
        <a href="{{ section.settings.btn_link }}" class="cf-promo-05-v6-btn">{{ section.settings.btn_text }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Indie Brand Promo",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#fffbf5"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#18181b"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#7c3aed"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"badge","label":"Badge","default":"Limited Run"},
    {"type":"text","id":"title","label":"Title","default":"Where Art Meets Beauty"},
    {"type":"textarea","id":"desc","label":"Description","default":"Each batch is hand-poured, small-batch, and made with intention."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop the Studio"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "presets": [{"name": "06 · Indie Promo"}]
}
{% endschema %}
