<style>
.cf-hero-07{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;width:100%;min-height:{{ section.settings.height }}px;background:{{ section.settings.bg_color }};position:relative;overflow:hidden;display:flex;align-items:center}
.cf-hero-07-inner{width:100%;max-width:1200px;margin:0 auto;padding:80px 40px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.cf-hero-07-tag{font-size:12px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:{{ section.settings.accent }};margin-bottom:16px}
.cf-hero-07 h1{font-size:clamp(30px,4vw,{{ section.settings.heading_size }}px);font-weight:800;color:{{ section.settings.heading_color }};margin:0 0 20px;line-height:1.1;letter-spacing:-0.02em}
.cf-hero-07 p{font-size:16px;color:{{ section.settings.text_color }};line-height:1.7;margin:0 0 32px}
.cf-hero-07-features{display:flex;flex-direction:column;gap:16px;margin-bottom:36px}
.cf-hero-07-feat{display:flex;align-items:center;gap:12px;font-size:14px;color:{{ section.settings.heading_color }};font-weight:500}
.cf-hero-07-feat svg{flex-shrink:0;color:{{ section.settings.accent }}}
.cf-hero-07-btn{display:inline-flex;padding:14px 32px;border-radius:8px;font-size:15px;font-weight:600;background:{{ section.settings.accent }};color:#fff;text-decoration:none;border:none;cursor:pointer;transition:0.2s}
.cf-hero-07-btn:hover{opacity:0.9;transform:translateY(-2px)}
.cf-hero-07-video{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:4/3;background:#000;box-shadow:0 20px 60px rgba(0,0,0,0.12)}
.cf-hero-07-video img{width:100%;height:100%;object-fit:cover}
.cf-hero-07-play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;cursor:pointer}
.cf-hero-07-play-btn{width:72px;height:72px;border-radius:50%;background:rgba(255,255,255,0.95);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 30px rgba(0,0,0,0.2);transition:0.2s}
.cf-hero-07-play-btn:hover{transform:scale(1.08)}
@media(max-width:768px){.cf-hero-07-inner{grid-template-columns:1fr;padding:40px 24px}}
</style>

<section class="cf-hero-07">
  <div class="cf-hero-07-inner">
    <div>
      <div class="cf-hero-07-tag">{{ section.settings.tag }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="cf-hero-07-features">
        {%- assign features = section.settings.features | split: '|' -%}
        {%- for feat in features -%}
        <div class="cf-hero-07-feat">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {{ feat | strip }}
        </div>
        {%- endfor -%}
      </div>
      <a href="{{ section.settings.btn_link }}" class="cf-hero-07-btn">{{ section.settings.btn_text }}</a>
    </div>
    <div class="cf-hero-07-video">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Video thumbnail">
      {% else %}
        <div style="width:100%;height:100%;background:linear-gradient(135deg,#0f172a,#334155)"></div>
      {% endif %}
      <div class="cf-hero-07-play">
        <div class="cf-hero-07-play-btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#111"><polygon points="10,8 16,12 10,16"/></svg>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "07 · Video Hero",
  "settings": [
    {"type":"range","id":"padding_top","label":"Padding Top","min":0,"max":200,"step":5,"default":0},
    {"type":"range","id":"padding_bottom","label":"Padding Bottom","min":0,"max":200,"step":5,"default":0},
    {"type":"text","id":"tag","label":"Tag","default":"WHY CHOOSE US"},
    {"type":"text","id":"heading","label":"Heading","default":"Premium Quality You Can Trust"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Our products are ethically sourced and crafted with attention to every detail."},
    {"type":"textarea","id":"features","label":"Features (| separated)","default":"Free shipping on all orders|30-day money-back guarantee|Ethically sourced materials|24/7 customer support"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Now"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"image_picker","id":"image","label":"Video Thumbnail"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"heading_color","label":"Heading Color","default":"#0f172a"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#64748b"},
    {"type":"color","id":"accent","label":"Accent","default":"#10b981"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":28,"max":60,"step":2,"default":44},
    {"type":"range","id":"height","label":"Min Height","min":400,"max":700,"step":50,"default":550}
  ],
  "presets": [{"name":"07 · Video Hero"}]
}
{% endschema %}
