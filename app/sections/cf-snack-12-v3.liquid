<style>
.cf-snack-12-v3{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:12px 20px;font-family:serif;text-align:center;border-bottom:1px solid {{ section.settings.border_color }};position:relative}
.cf-snack-12-v3-inner{display:flex;align-items:center;justify-content:center;gap:20px}
.cf-snack-12-v3-text{font-size:14px;margin:0;letter-spacing:0.05em;font-style:italic}
.cf-snack-12-v3-copy{background:transparent;border:1px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};padding:4px 15px;font-family:sans-serif;font-size:10px;text-transform:uppercase;letter-spacing:0.1em;cursor:pointer;transition:0.3s;font-weight:600}
.cf-snack-12-v3-copy:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-snack-12-v3-close{position:absolute;right:20px;top:50%;transform:translateY(-50%);background:none;border:none;color:{{ section.settings.text_color }};cursor:pointer;padding:5px}
@media(max-width:600px){.cf-snack-12-v3-inner{flex-direction:column;gap:10px}}
</style>

<div class="cf-snack-12-v3" id="cf-snack-12-v3-{{ section.id }}">
  <div class="cf-snack-12-v3-inner">
    <p class="cf-snack-12-v3-text">{{ section.settings.text }}</p>
    <button class="cf-snack-12-v3-copy" onclick="navigator.clipboard.writeText('{{ section.settings.code }}'); this.innerText='COPIED!'">
      USE CODE: {{ section.settings.code }}
    </button>
  </div>
  <button class="cf-snack-12-v3-close" onclick="document.getElementById('cf-snack-12-v3-{{ section.id }}').style.display='none'">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
</div>

{% schema %}
{
  "name": "12 · Women's Snack (v3)",
  "settings": [
    {"type":"text","id":"text","label":"Announcement Text","default":"Enjoy complimentary shipping & returns on all orders."},
    {"type":"text","id":"code","label":"Promo Code","default":"FREESHIP"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#EAEAEE"}
  ],
  "presets": [{"name":"12 · Women's Snack (v3)"}]
}
{% endschema %}
