<style>
.cf-tb-05-v7 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-tb-05-v7-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }
.cf-tb-05-v7-badge {
  background: #fff; border: 1px solid {{ section.settings.border_color }};
  border-radius: 8px; padding: 15px 25px;
  display: flex; align-items: center; gap: 12px;
}
.cf-tb-05-v7-icon { color: {{ section.settings.accent_color }}; }
.cf-tb-05-v7-icon svg { width: 22px; height: 22px; stroke-width: 2; }
.cf-tb-05-v7-label { font-size: 14px; font-weight: 700; color: {{ section.settings.text_color }}; }
</style>
<div class="cf-tb-05-v7">
  <div class="cf-tb-05-v7-inner">
    {% for block in section.blocks %}
    <div class="cf-tb-05-v7-badge">
      <div class="cf-tb-05-v7-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div>
      <span class="cf-tb-05-v7-label">{{ block.settings.label }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{% schema %}{"name": "07 · Dermatology Badges","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#f8fafc"},{"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},{"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#0d9488"},{"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":40},{"type":"range","id":"max_width","label":"Max Width","min":600,"max":1400,"step":50,"default":1100}],"blocks": [{"type": "badge","name": "Badge","settings": [{"type":"text","id":"label","label":"Label","default":"Dermatologist Tested"}]}],"presets": [{"name": "07 · Derm Badges","blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]}]}{% endschema %}
