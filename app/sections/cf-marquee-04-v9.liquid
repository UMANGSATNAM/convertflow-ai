<style>
.cf-mq-04-v9 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  border-top: 1px dashed {{ section.settings.border_color }};
  border-bottom: 1px dashed {{ section.settings.border_color }};
}

.cf-mq-04-v9-track {
  display: inline-flex;
  animation: cf-mq-04-v9-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v9-item {
  display: inline-flex;
  align-items: center;
  padding: 0 35px;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cf-mq-04-v9-highlight {
  color: {{ section.settings.accent_color }};
}

.cf-mq-04-v9-icon {
  margin: 0 35px;
  color: {{ section.settings.border_color }};
  display: flex;
  align-items: center;
}

.cf-mq-04-v9-icon svg {
  width: 22px; height: 22px; stroke-width: 2;
}

@keyframes cf-mq-04-v9-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v9">
  <div class="cf-mq-04-v9-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v9-item">
          <span class="cf-mq-04-v9-highlight">{{ block.settings.highlight }}&nbsp;</span>
          <span>{{ block.settings.text }}</span>
          <div class="cf-mq-04-v9-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="2" y="7" width="20" height="10" rx="5" ry="5"></rect><line x1="12" y1="7" x2="12" y2="17"></line></svg>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "09 · Supplements Banner",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#18181b"},
    {"type":"color","id":"accent_color","label":"Highlight Color","default":"#ef4444"},
    {"type":"color","id":"border_color","label":"Border/Icon Color","default":"#d4d4d8"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20},
    {"type":"range","id":"font_size","label":"Font Size","min":14,"max":32,"step":1,"default":20},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":2,"default":25}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {"type":"text","id":"highlight","label":"Highlighted Word","default":"NON-GMO"},
        {"type":"text","id":"text","label":"Remaining Text","default":"FORMULA"}
      ]
    }
  ],
  "presets": [
    {
      "name": "09 · Supplements Banner",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
