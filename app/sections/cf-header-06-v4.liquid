<div class="cf-auto-header-v4" style="background: {{ section.settings.bg_color }}; border-bottom: 1px solid {{ section.settings.border_color }};">
  
  <!-- Top utility bar -->
  <div style="background: #000; color: #fff; padding: 8px 20px; font-size: 12px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; gap: 20px;">
        <span style="display: flex; align-items: center; gap: 6px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> {{ section.settings.location }}</span>
        <span style="display: flex; align-items: center; gap: 6px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> {{ section.settings.support_phone }}</span>
      </div>
      <div>
        Free shipping on orders over $150
      </div>
    </div>
  </div>

  <div class="cf-auto-header-v4-container" style="max-width: 1200px; margin: 0 auto; padding: 25px 20px; display: flex; align-items: center; gap: 40px;">
    
    <!-- Logo -->
    <div class="cf-auto-header-v4-logo" style="flex: 0 0 auto;">
      <a href="/" style="text-decoration: none;">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 36px; height: 36px; background: {{ section.settings.accent_color }}; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 20px; transform: skewX(-15deg);">{{ shop.name | slice: 0 }}</div>
            <span style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 24px; font-weight: 900; color: {{ section.settings.text_color }}; letter-spacing: -0.5px; text-transform: uppercase; transform: skewX(-15deg);">
              {{ shop.name }}
            </span>
          </div>
        {% endif %}
      </a>
    </div>

    <!-- Main Navigation -->
    <div class="cf-auto-header-v4-nav" style="flex: 1;">
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 35px;">
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a href="{{ link.url }}" style="color: {{ section.settings.text_color }}; text-decoration: none; font-size: 15px; font-weight: 700; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; text-transform: uppercase; letter-spacing: 0.5px; transition: color 0.2s;" class="cf-hover-red">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- Actions (Search, User, Cart) -->
    <div class="cf-auto-header-v4-actions" style="display: flex; gap: 24px; align-items: center;">
      <!-- Search Input -->
      <div style="position: relative; border-bottom: 2px solid {{ section.settings.border_color }};">
        <form action="/search" method="get" style="display: flex; align-items: center; padding-bottom: 5px;">
          <input type="text" name="q" placeholder="Type to search..." style="border: none; background: transparent; font-size: 14px; font-weight: 500; color: {{ section.settings.text_color }}; outline: none; width: 150px; transition: width 0.3s;" class="cf-search-expand">
          <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer; color: {{ section.settings.text_color }};">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </form>
      </div>

      <a href="/account" style="color: {{ section.settings.text_color }}; transition: color 0.2s;" class="cf-hover-red">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>

      <a href="/cart" style="color: {{ section.settings.text_color }}; position: relative; transition: color 0.2s;" class="cf-hover-red">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <div style="position: absolute; top: -6px; right: -8px; background: {{ section.settings.accent_color }}; color: #fff; font-size: 11px; font-weight: 800; padding: 2px 6px; border-radius: 10px;">{{ cart.item_count }}</div>
      </a>
    </div>

  </div>
</div>

<style>
  .cf-hover-red:hover {
    color: {{ section.settings.accent_color }} !important;
  }
  .cf-search-expand:focus {
    width: 250px !important;
  }
  @media (max-width: 900px) {
    .cf-auto-header-v4-nav { display: none; }
    .cf-auto-header-v4-actions .cf-search-expand { display: none; }
  }
</style>

{% schema %}
{
  "name": "06 · Racing Gear Head",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e60000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 35
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Store Location",
      "default": "Detroit, MI"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support Phone",
      "default": "1-888-RACING-1"
    }
  ]
}
{% endschema %}
