<style>
.cf-fc-03-v5 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  background-image: linear-gradient({{ section.settings.grid_color }} 1px, transparent 1px),
                    linear-gradient(90deg, {{ section.settings.grid_color }} 1px, transparent 1px);
  background-size: 20px 20px;
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-fc-03-v5-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  background: {{ section.settings.bg_color }};
  border: 1px solid {{ section.settings.border_color }};
}

.cf-fc-03-v5-header {
  padding: 20px;
  border-bottom: 2px solid {{ section.settings.border_color }};
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(0,0,0,0.5);
}

.cf-fc-03-v5-heading {
  font-size: 20px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.cf-fc-03-v5-table {
  width: 100%;
  border-collapse: collapse;
}

.cf-fc-03-v5-th {
  text-align: left;
  padding: 15px 20px;
  border-bottom: 1px dashed {{ section.settings.border_color }};
  color: {{ section.settings.text_color }};
  font-size: 12px;
  text-transform: uppercase;
  opacity: 0.5;
}

.cf-fc-03-v5-tr {
  transition: 0.2s;
  border-bottom: 1px solid {{ section.settings.border_color }};
}

.cf-fc-03-v5-tr:hover {
  background: rgba(255,255,255,0.02);
}

.cf-fc-03-v5-td {
  padding: 15px 20px;
  color: {{ section.settings.text_color }};
  font-size: 14px;
}

.cf-fc-03-v5-img {
  width: 50px; height: 50px;
  object-fit: cover;
  border: 1px solid {{ section.settings.border_color }};
  background: #111;
}

.cf-fc-03-v5-title {
  font-weight: 700;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  transition: 0.2s;
}

.cf-fc-03-v5-title:hover {
  color: {{ section.settings.accent_color }};
}

.cf-fc-03-v5-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
}
.cf-fc-03-v5-status::before {
  content: ''; width: 6px; height: 6px; border-radius: 50%;
  background: {{ section.settings.accent_color }};
}

.cf-fc-03-v5-btn {
  display: inline-block;
  background: transparent;
  border: 1px solid {{ section.settings.text_color }};
  color: {{ section.settings.text_color }};
  padding: 6px 12px;
  font-size: 12px;
  text-decoration: none;
  transition: 0.2s;
}

.cf-fc-03-v5-btn:hover {
  background: {{ section.settings.text_color }};
  color: #000;
}

@media (max-width: 768px) {
  .cf-fc-03-v5-table, .cf-fc-03-v5-tbody, .cf-fc-03-v5-tr, .cf-fc-03-v5-td {
    display: block;
  }
  .cf-fc-03-v5-thead { display: none; }
  .cf-fc-03-v5-tr {
    padding: 15px;
    position: relative;
  }
  .cf-fc-03-v5-td {
    padding: 5px 0;
  }
}
</style>

<div class="cf-fc-03-v5">
  <div class="cf-fc-03-v5-inner">
    <div class="cf-fc-03-v5-header">
      <h2 class="cf-fc-03-v5-heading">{{ section.settings.heading }}</h2>
      <span style="color: {{ section.settings.text_color }}; font-size: 12px; opacity: 0.5;">[DATA_SYNCED]</span>
    </div>
    
    <table class="cf-fc-03-v5-table">
      <thead class="cf-fc-03-v5-thead">
        <tr>
          <th class="cf-fc-03-v5-th" style="width: 80px;">Unit</th>
          <th class="cf-fc-03-v5-th">Designation</th>
          <th class="cf-fc-03-v5-th">Status</th>
          <th class="cf-fc-03-v5-th">Value</th>
          <th class="cf-fc-03-v5-th" style="text-align: right;">Action</th>
        </tr>
      </thead>
      <tbody class="cf-fc-03-v5-tbody">
        {% assign collection = collections[section.settings.collection] %}
        {% if collection != blank %}
          {% for product in collection.products limit: section.settings.limit %}
            <tr class="cf-fc-03-v5-tr">
              <td class="cf-fc-03-v5-td">
                <img src="{{ product.featured_image | image_url: width: 100 }}" alt="{{ product.title }}" class="cf-fc-03-v5-img">
              </td>
              <td class="cf-fc-03-v5-td">
                <a href="{{ product.url }}" class="cf-fc-03-v5-title">{{ product.title }}</a>
              </td>
              <td class="cf-fc-03-v5-td">
                <div class="cf-fc-03-v5-status">ONLINE</div>
              </td>
              <td class="cf-fc-03-v5-td" style="color: {{ section.settings.accent_color }}; font-weight: bold;">
                {{ product.price | money }}
              </td>
              <td class="cf-fc-03-v5-td" style="text-align: right;">
                <a href="{{ product.url }}" class="cf-fc-03-v5-btn">EXTRACT</a>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <tr class="cf-fc-03-v5-tr">
              <td class="cf-fc-03-v5-td"><div class="cf-fc-03-v5-img"></div></td>
              <td class="cf-fc-03-v5-td"><a href="#" class="cf-fc-03-v5-title">Component Build {{ i }}</a></td>
              <td class="cf-fc-03-v5-td"><div class="cf-fc-03-v5-status">ONLINE</div></td>
              <td class="cf-fc-03-v5-td" style="color: {{ section.settings.accent_color }}; font-weight: bold;">$149.00</td>
              <td class="cf-fc-03-v5-td" style="text-align: right;"><a href="#" class="cf-fc-03-v5-btn">EXTRACT</a></td>
            </tr>
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "05 · Data Table Layout",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"AVAILABLE_UNITS"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":12,"step":1,"default":5},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#0a0a0a"},
    {"type":"color","id":"grid_color","label":"Grid Pattern Base","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#e5e5e5"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#3b82f6"},
    {"type":"color","id":"border_color","label":"Borders","default":"#333333"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1000}
  ],
  "presets": [{"name":"05 · Data Table Collection"}]
}
{% endschema %}
