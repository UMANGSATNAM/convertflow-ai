<style>
.cf-trust-01-v10{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;display:flex;justify-content:center}
.cf-trust-01-v10-inner{max-width:800px;width:100%;position:relative;text-align:center}
.cf-trust-01-v10-portal{width:100%;aspect-ratio:3/4;border-radius:300px 300px 0 0;overflow:hidden;background:#ccc;margin-bottom:-100px;position:relative;z-index:1}
.cf-trust-01-v10-img{width:100%;height:100%;object-fit:cover;transition:1.5s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-trust-01-v10-inner:hover .cf-trust-01-v10-img{transform:scale(1.05)}
.cf-trust-01-v10-content{position:relative;z-index:2;background:{{ section.settings.bg_color }};padding:60px;margin:0 40px;box-shadow:0 -10px 40px rgba(0,0,0,0.05)}
.cf-trust-01-v10-title{font-size:clamp(32px, 5vw, 48px);font-style:italic;margin:0 0 15px 0;letter-spacing:0.02em}
.cf-trust-01-v10-desc{font-family:sans-serif;font-size:12px;line-height:1.6;opacity:0.8;margin:0}
.cf-trust-01-v10-icon{font-size:24px;color:{{ section.settings.accent_color }};margin-bottom:20px}
@media(max-width:768px){
  .cf-trust-01-v10-content{margin:0 20px;padding:40px 20px}
  .cf-trust-01-v10-portal{margin-bottom:-60px}
}
</style>

<div class="cf-trust-01-v10">
  <div class="cf-trust-01-v10-inner">
    <div class="cf-trust-01-v10-portal">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" class="cf-trust-01-v10-img" alt="">
      {% else %}
        <div class="cf-trust-01-v10-img" style="background:#555;"></div>
      {% endif %}
    </div>
    <div class="cf-trust-01-v10-content">
      <div class="cf-trust-01-v10-icon">✧</div>
      <h3 class="cf-trust-01-v10-title">{{ section.settings.title }}</h3>
      <p class="cf-trust-01-v10-desc">{{ section.settings.desc }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Trust (v10)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Atmospheric Image"},
    {"type":"text","id":"title","label":"Header Title","default":"The Guarantee"},
    {"type":"textarea","id":"desc","label":"Description","default":"We stand by the immaculate quality of our products, offering a lifetime guarantee against any defects in craftsmanship."},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon/Accent","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Trust (v10)"}]
}
{% endschema %}
