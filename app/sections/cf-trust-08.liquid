<style>
.cf-tr-08{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:'Comic Sans MS', 'Fredoka One', cursive}
.cf-tr-08-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:center;gap:30px;flex-wrap:wrap}
.cf-tr-08-item{background:{{ section.settings.card_bg }};border:4px solid {{ section.settings.border_color }};border-radius:24px;padding:25px;display:flex;flex-direction:column;align-items:center;text-align:center;box-shadow:6px 6px 0 {{ section.settings.border_color }};flex:1;min-width:250px;transition:0.3s}
.cf-tr-08-item:nth-child(even){background:{{ section.settings.card_bg_2 }}}
.cf-tr-08-item:hover{transform:translateY(-5px) rotate(-1deg)}
.cf-tr-08-icon{font-size:40px;margin-bottom:15px;animation:cf-tr-08-wiggle 3s infinite}
.cf-tr-08-title{font-size:20px;font-weight:900;color:#fff;text-shadow:2px 2px 0 {{ section.settings.border_color }};text-transform:uppercase;margin-bottom:8px}
.cf-tr-08-desc{font-size:14px;color:{{ section.settings.border_color }};font-weight:700;line-height:1.4}
@keyframes cf-tr-08-wiggle{0%,100%{transform:rotate(0)}25%{transform:rotate(10deg)}75%{transform:rotate(-10deg)}}
@media(max-width:768px){.cf-tr-08-inner{gap:20px}}
</style>

<div class="cf-tr-08">
  <div class="cf-tr-08-inner">
    {% for block in section.blocks %}
    <div class="cf-tr-08-item">
      <div class="cf-tr-08-icon">{{ block.settings.emoji }}</div>
      <div class="cf-tr-08-title">{{ block.settings.title }}</div>
      <div class="cf-tr-08-desc">{{ block.settings.desc }}</div>
    </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "08 · Kids Trust",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#fef3c7"},
    {"type":"color","id":"border_color","label":"Border/Shadow","default":"#111111"},
    {"type":"color","id":"card_bg","label":"Card Color 1","default":"#60a5fa"},
    {"type":"color","id":"card_bg_2","label":"Card Color 2","default":"#34d399"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60}
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust Item",
      "limit": 4,
      "settings": [
        {"type":"text","id":"emoji","label":"Emoji","default":"🛡️"},
        {"type":"text","id":"title","label":"Title","default":"Child Safe"},
        {"type":"text","id":"desc","label":"Description","default":"Tested to exceed safety standards."}
      ]
    }
  ],
  "presets": [
    {
      "name": "08 · Kids Trust",
      "blocks": [
        {"type":"trust","settings":{"emoji":"🛡️","title":"100% Kid Safe","desc":"Non-toxic & rigorously tested."}},
        {"type":"trust","settings":{"emoji":"✨","title":"Washable","desc":"Easy to clean up messes."}},
        {"type":"trust","settings":{"emoji":"🎁","title":"Great Gifts","desc":"Free wrapping included."}}
      ]
    }
  ]
}
{% endschema %}
