<style>
.cf-header-03-v7 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  position: relative;
  border-bottom: 2px solid {{ section.settings.accent_color }};
  overflow: hidden;
}

/* Angular cutout background */
.cf-header-03-v7::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: {{ section.settings.panel_bg }};
  clip-path: polygon(0 0, 100% 0, 100% 100%, 75% 100%, 73% calc(100% - 15px), 27% calc(100% - 15px), 25% 100%, 0 100%);
  z-index: 1;
}

.cf-header-03-v7-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.cf-header-03-v7-logo {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: {{ section.settings.logo_size }}px;
  font-weight: 900;
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-shadow: 2px 2px 0px rgba(0, 255, 255, 0.5); /* Cyan shadow */
}

.cf-header-03-v7-nav {
  display: none;
  align-items: center;
  gap: 20px;
}

.cf-header-03-v7-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 15px;
  font-weight: bold;
  text-transform: uppercase;
  padding: 8px 16px;
  border: 1px solid transparent;
  transition: 0.3s;
  background: rgba(0,0,0,0.5);
  clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
}

.cf-header-03-v7-nav a:hover {
  background: {{ section.settings.accent_color }};
  color: #000;
}

.cf-header-03-v7-actions {
  display: flex;
  gap: 15px;
}

.cf-header-03-v7-icon {
  color: {{ section.settings.text_color }};
  border: 2px solid {{ section.settings.accent_color }};
  background: rgba(0,0,0,0.8);
  width: 44px; height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%); /* Hexagon */
  transition: 0.3s;
  text-decoration: none;
}

.cf-header-03-v7-icon:hover {
  background: {{ section.settings.accent_color }};
  color: #000;
}

.cf-header-03-v7-icon svg {
  width: 18px; height: 18px;
}

@media (min-width: 768px) {
  .cf-header-03-v7-nav { display: flex; }
  .cf-header-03-v7-inner { padding: {{ section.settings.padding_y }}px 40px; }
}
</style>

<div class="cf-header-03-v7">
  <div class="cf-header-03-v7-inner">
    <a href="/" class="cf-header-03-v7-logo">{{ section.settings.logo_text }}</a>
    
    <nav class="cf-header-03-v7-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="cf-header-03-v7-actions">
      <a href="/search" class="cf-header-03-v7-icon" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="/cart" class="cf-header-03-v7-icon" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "07 · Cyberpunk Hexagon",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Fill","default":"#000000"},
    {"type":"color","id":"panel_bg","label":"Panel Background","default":"#16161c"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"NIGHTCITY"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":16,"max":48,"step":2,"default":32},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Cyber Neon Accent","default":"#ff003c"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":50,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1800,"step":100,"default":1400}
  ],
  "presets": [{"name":"07 · Cyberpunk Hexagon Header"}]
}
{% endschema %}
