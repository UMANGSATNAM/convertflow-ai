<style>
.cf-snack-01-v6{width:100%;padding:{{ section.settings.padding_y }}px 40px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-snack-01-v6-title{font-size:20px;font-style:italic;margin:0}
.cf-snack-01-v6-line{flex:1;height:1px;background:{{ section.settings.text_color }};opacity:0.2;margin:0 40px}
.cf-snack-01-v6-btn{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:inherit;transition:0.3s}
.cf-snack-01-v6-btn:hover{color:{{ section.settings.accent_color }}}
@media(max-width:768px){
  .cf-snack-01-v6{flex-direction:column;gap:20px;text-align:center;padding:{{ section.settings.padding_y }}px 20px}
  .cf-snack-01-v6-line{display:none}
}
</style>

<div class="cf-snack-01-v6">
  <h3 class="cf-snack-01-v6-title">{{ section.settings.title }}</h3>
  <div class="cf-snack-01-v6-line"></div>
  <a href="{{ section.settings.btn_link }}" class="cf-snack-01-v6-btn">{{ section.settings.btn_text }}</a>
</div>

{% schema %}
{
  "name": "01 · Luxury Snack (v6)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Gifting Concierge"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Speak to an Advisor"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#D4AF37"},
    {"type":"color","id":"border_color","label":"Border Separator","default":"#EEEEEE"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":40}
  ],
  "presets": [{"name":"01 · Luxury Snack (v6)"}]
}
{% endschema %}
