<style>
.cf-pr-03-v7 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-pr-03-v7-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  background: {{ section.settings.panel_bg }};
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  /* Cyberpunk hex pattern background */
  background-image: radial-gradient({{ section.settings.accent_color }}20 1px, transparent 1px);
  background-size: 20px 20px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.5);
}

.cf-pr-03-v7-img-container {
  width: 100%;
  aspect-ratio: 16/9;
  position: relative;
}

/* Angular cut on image */
.cf-pr-03-v7-img-container::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; width: 100%; height: 100px;
  background: linear-gradient(to top right, {{ section.settings.panel_bg }} 49%, transparent 51%);
  pointer-events: none;
}

.cf-pr-03-v7-img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: contrast(1.2) saturate(1.5) hue-rotate(20deg);
}

.cf-pr-03-v7-content {
  padding: 40px;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 2;
  margin-top: -60px; /* Pull text up over the cut */
}

.cf-pr-03-v7-label {
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 12px;
  font-weight: bold;
  color: {{ section.settings.accent_color }};
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.cf-pr-03-v7-label::before {
  content: '';
  width: 30px; height: 2px;
  background: {{ section.settings.accent_color }};
}

.cf-pr-03-v7-heading {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: clamp(32px, 6vw, {{ section.settings.title_size }}px);
  color: {{ section.settings.text_color }};
  margin: 0 0 20px 0;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.cf-pr-03-v7-desc {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 16px;
  color: {{ section.settings.text_color }};
  opacity: 0.8;
  line-height: 1.5;
  margin: 0 0 30px 0;
  max-width: 500px;
}

.cf-pr-03-v7-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: {{ section.settings.accent_color }};
  color: #000;
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 14px;
  font-weight: 900;
  text-transform: uppercase;
  text-decoration: none;
  padding: 14px 30px;
  align-self: flex-start;
  clip-path: polygon(15px 0, 100% 0, 100% calc(100% - 15px), calc(100% - 15px) 100%, 0 100%, 0 15px);
  transition: 0.3s;
}

.cf-pr-03-v7-btn:hover {
  background: #fff;
  color: #000;
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(0,255,255,0.3);
}

@media (min-width: 768px) {
  .cf-pr-03-v7-inner {
    flex-direction: row;
    align-items: stretch;
  }
  .cf-pr-03-v7-img-container {
    flex: 1;
    aspect-ratio: auto;
  }
  .cf-pr-03-v7-img-container::after {
    background: linear-gradient(to top left, {{ section.settings.panel_bg }} 49%, transparent 51%);
    width: 150px; height: 100%; top: 0; bottom: auto; left: auto; right: 0;
  }
  .cf-pr-03-v7-content {
    flex: 1;
    margin-top: 0;
    justify-content: center;
    padding: 60px;
  }
}
</style>

<div class="cf-pr-03-v7">
  <div class="cf-pr-03-v7-inner">
    <div class="cf-pr-03-v7-img-container">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="Promo Image" class="cf-pr-03-v7-img">
      {% else %}
        <div class="cf-pr-03-v7-img" style="background: linear-gradient(45deg, #111, #333);"></div>
      {% endif %}
    </div>
    <div class="cf-pr-03-v7-content">
      <div class="cf-pr-03-v7-label">{{ section.settings.label }}</div>
      <h2 class="cf-pr-03-v7-heading">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="cf-pr-03-v7-desc">{{ section.settings.subheading }}</p>
      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url }}" class="cf-pr-03-v7-btn">{{ section.settings.link_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "07 · Cyber Hexa-Drop",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "SYSTEM_ALERT // SALE"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "NEON\nNIGHTS"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 32,
      "max": 80,
      "step": 2,
      "default": 64
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Level up your battlestation with our latest drop of RGB peripherals and custom keycaps."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "ACCESS PORTAL"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#08080c"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel Background",
      "default": "#121216"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cyan/Neon Accent",
      "default": "#00ffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "07 · Cyber Hexa-Drop Prom"
    }
  ]
}
{% endschema %}
