<style>
.cf-fc-03-v3 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  position: relative;
  overflow: hidden;
}

.cf-fc-03-v3::before {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: radial-gradient(circle at top right, {{ section.settings.accent_color }}20, transparent 40%),
              radial-gradient(circle at bottom left, #ff00ff20, transparent 40%);
  pointer-events: none;
}

.cf-fc-03-v3-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.cf-fc-03-v3-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40px;
  border-bottom: 2px solid {{ section.settings.accent_color }};
  padding-bottom: 10px;
}

.cf-fc-03-v3-heading {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: clamp(28px, 5vw, 48px);
  color: {{ section.settings.text_color }};
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-shadow: 2px 2px 0 {{ section.settings.accent_color }};
}

.cf-fc-03-v3-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 40px;
}

.cf-fc-03-v3-card {
  background: {{ section.settings.panel_bg }};
  border: 1px solid #333;
  padding: 20px;
  position: relative;
  /* Angular Cutout */
  clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  transition: 0.3s;
  display: flex;
  flex-direction: column;
  text-decoration: none;
}

.cf-fc-03-v3-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border: 2px solid transparent;
  clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  pointer-events: none;
  transition: 0.3s;
}

.cf-fc-03-v3-card:hover {
  transform: translateY(-5px);
  background: #1a1a24;
}

.cf-fc-03-v3-card:hover::after {
  border-color: {{ section.settings.accent_color }};
  box-shadow: inset 0 0 20px {{ section.settings.accent_color }}40;
}

.cf-fc-03-v3-img-wrap {
  width: 100%;
  aspect-ratio: 1/1;
  background: #000;
  margin-bottom: 20px;
  position: relative;
  overflow: hidden;
  clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
}

.cf-fc-03-v3-img {
  width: 100%; height: 100%; object-fit: cover;
  transition: 0.5s;
  filter: contrast(1.2);
}

.cf-fc-03-v3-card:hover .cf-fc-03-v3-img {
  transform: scale(1.1);
}

.cf-fc-03-v3-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.cf-fc-03-v3-title {
  color: {{ section.settings.text_color }};
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 16px;
  font-weight: 700;
  text-transform: uppercase;
  margin: 0 0 10px 0;
}

.cf-fc-03-v3-price {
  color: {{ section.settings.accent_color }};
  font-size: 18px;
  font-weight: 900;
  font-family: 'Impact', 'Arial Black', sans-serif;
  margin-top: auto;
  border-top: 1px dashed #444;
  padding-top: 15px;
}
</style>

<div class="cf-fc-03-v3">
  <div class="cf-fc-03-v3-inner">
    <div class="cf-fc-03-v3-header">
      <h2 class="cf-fc-03-v3-heading">{{ section.settings.heading }}</h2>
    </div>
    
    <div class="cf-fc-03-v3-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="cf-fc-03-v3-card">
            <div class="cf-fc-03-v3-img-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="cf-fc-03-v3-img">
            </div>
            <div class="cf-fc-03-v3-info">
              <h3 class="cf-fc-03-v3-title">{{ product.title }}</h3>
              <div class="cf-fc-03-v3-price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <a href="#" class="cf-fc-03-v3-card">
            <div class="cf-fc-03-v3-img-wrap">
              <div style="width:100%; height:100%; background: linear-gradient(45deg, #111, {{ section.settings.accent_color | color_modify: 'alpha', 0.2 }});"></div>
            </div>
            <div class="cf-fc-03-v3-info">
              <h3 class="cf-fc-03-v3-title">Cybernetic Implant 0{{ i }}</h3>
              <div class="cf-fc-03-v3-price">$299.00</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Cyber Hexa-Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST INVENTORY"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#08080c"
    },
    {
      "type": "color",
      "id": "panel_bg",
      "label": "Panel Background",
      "default": "#111116"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cyan/Neon Accent",
      "default": "#00ffff"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "03 · Cyber Hexa-Grid Coll"
    }
  ]
}
{% endschema %}
