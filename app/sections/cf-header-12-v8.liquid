<style>
.cf-header-12-v8{width:100%;font-family:serif;color:{{ section.settings.text_color }}}
.cf-header-12-v8-top{background:{{ section.settings.bg_color }};padding:25px 20px;text-align:center;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-header-12-v8-logo{text-decoration:none;display:inline-block}
.cf-header-12-v8-logo img{max-height:{{ section.settings.logo_height }}px;height:auto}
.cf-header-12-v8-logo h1{font-size:42px;font-style:italic;font-weight:400;margin:0;letter-spacing:0.02em;color:{{ section.settings.text_color }}}
.cf-header-12-v8-icons{position:absolute;top:35px;right:20px;display:flex;gap:15px;align-items:center}
.cf-header-12-v8-search{position:absolute;top:35px;left:20px;display:flex;gap:15px;align-items:center}
.cf-header-12-v8-icon{color:{{ section.settings.text_color }};cursor:pointer;opacity:0.8;transition:0.3s}
.cf-header-12-v8-icon:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-header-12-v8-bottom{background:{{ section.settings.bottom_bg }};padding:12px 20px;}
.cf-header-12-v8-nav{display:flex;justify-content:center;gap:35px}
.cf-header-12-v8-link{font-size:11px;color:{{ section.settings.bottom_text }};text-decoration:none;text-transform:uppercase;letter-spacing:0.2em;font-family:sans-serif;font-weight:600;transition:0.3s}
.cf-header-12-v8-link:hover{color:{{ section.settings.accent_color }}}
@media(max-width:900px){.cf-header-12-v8-bottom{display:none}.cf-header-12-v8-search{display:none}.cf-header-12-v8-logo h1{font-size:32px}.cf-header-12-v8-icons{top:30px}}
</style>

<div class="cf-header-12-v8" style="position:relative;">
  <div class="cf-header-12-v8-search">
    <div class="cf-header-12-v8-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    </div>
  </div>
  
  <div class="cf-header-12-v8-top">
    <a href="/" class="cf-header-12-v8-logo">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% else %}
        <h1>{{ section.settings.logo_text }}</h1>
      {% endif %}
    </a>
  </div>
  
  <div class="cf-header-12-v8-icons">
    <div class="cf-header-12-v8-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </div>
    <div class="cf-header-12-v8-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </div>
  </div>
  
  <div class="cf-header-12-v8-bottom">
    <div class="cf-header-12-v8-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="cf-header-12-v8-link">{{ link.title }}</a>
      {% else %}
        <a href="#" class="cf-header-12-v8-link">Just In</a>
        <a href="#" class="cf-header-12-v8-link">Designers</a>
        <a href="#" class="cf-header-12-v8-link">Clothing</a>
        <a href="#" class="cf-header-12-v8-link">Shoes</a>
        <a href="#" class="cf-header-12-v8-link">Bags</a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Header (v8)",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo Image"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"CELINE"},
    {"type":"range","id":"logo_height","label":"Logo Height","min":20,"max":120,"step":5,"default":45},
    {"type":"link_list","id":"menu","label":"Main Menu"},
    {"type":"color","id":"bg_color","label":"Top Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Top Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Divider line","default":"#E5E5E5"},
    {"type":"color","id":"bottom_bg","label":"Bottom Nav Background","default":"#111111"},
    {"type":"color","id":"bottom_text","label":"Bottom Nav Text","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#B59A7A"}
  ],
  "presets": [{"name":"12 · Women's Header (v8)"}]
}
{% endschema %}
