<style>
.cf-cat-02-v3 {
  width: 100%;
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  display: flex;
  justify-content: center;
}

.cf-cat-02-v3-container {
  max-width: 1200px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cf-cat-02-v3-item {
  position: relative;
  overflow: hidden;
  background: #111;
  text-decoration: none;
  min-height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border: 1px solid rgba(255,255,255,0.1);
}

.cf-cat-02-v3-img {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease, filter 0.4s;
  filter: grayscale(100%) brightness(0.4);
  z-index: 1;
}

.cf-cat-02-v3-item:hover .cf-cat-02-v3-img {
  transform: scale(1.05);
  filter: grayscale(0%) brightness(0.8);
}

.cf-cat-02-v3-label {
  position: relative;
  z-index: 10;
  font-size: clamp(24px, 5vw, {{ section.settings.label_size }}px);
  font-weight: 900;
  color: {{ section.settings.text_color_base }};
  text-transform: uppercase;
  margin: 0;
  letter-spacing: 0.1em;
  transition: all 0.3s;
}

.cf-cat-02-v3-item:hover .cf-cat-02-v3-label {
  color: {{ section.settings.text_color_hover }};
  letter-spacing: 0.2em;
}

@media (min-width: 768px) {
  .cf-cat-02-v3-container {
    flex-direction: row;
    height: 600px;
  }
  .cf-cat-02-v3-item {
    flex: 1;
    min-height: auto;
  }
  .cf-cat-02-v3-item:hover {
    flex: 2;
  }
}
</style>

<div class="cf-cat-02-v3">
  <div class="cf-cat-02-v3-container">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-02-v3-item">
        {% if block.settings.image != blank %}
          <img class="cf-cat-02-v3-img" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.label | strip_html | escape }}">
        {% else %}
          <div class="cf-cat-02-v3-img" style="background: #222;"></div>
        {% endif %}
        <h3 class="cf-cat-02-v3-label">{{ block.settings.label }}</h3>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "03 · Expansion Slices",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color_base",
      "label": "Label Base Color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "text_color_hover",
      "label": "Label Hover Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label Size",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Outerwear"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "03 · Expansion Slices Gri",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
