<style>
.cf-promo-01-v9{width:100%;height:100vh;min-height:700px;position:relative;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;overflow:hidden;color:{{ section.settings.text_color }};font-family:serif}
.cf-promo-01-v9-bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;background:#111}
.cf-promo-01-v9-bg img{width:100%;height:100%;object-fit:cover;opacity:0.6}
.cf-promo-01-v9-content{position:relative;z-index:2;max-width:1200px;display:flex;flex-direction:column;align-items:center}
.cf-promo-01-v9-quote{font-size:clamp(40px, 6vw, 90px);font-weight:400;line-height:1.1;letter-spacing:0.02em;margin:0 0 40px 0}
.cf-promo-01-v9-author{font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;margin:0;opacity:0.8}
.cf-promo-01-v9-btn{margin-top:50px;display:inline-block;padding-bottom:5px;border-bottom:1px solid {{ section.settings.text_color }};font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:inherit;transition:0.3s}
.cf-promo-01-v9-btn:hover{color:{{ section.settings.accent_color }};border-bottom-color:{{ section.settings.accent_color }}}
</style>

<div class="cf-promo-01-v9">
  <div class="cf-promo-01-v9-bg">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="">
    {% else %}
      <div style="width:100%;height:100%;background:#333;"></div>
    {% endif %}
  </div>
  <div class="cf-promo-01-v9-content">
    <h2 class="cf-promo-01-v9-quote">"{{ section.settings.quote }}"</h2>
    <p class="cf-promo-01-v9-author">— {{ section.settings.author }}</p>
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="cf-promo-01-v9-btn">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Promo (v9)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Immersive Background Image"},
    {"type":"textarea","id":"quote","label":"Quote Text","default":"True luxury is the absence of the unnecessary. It is finding the essential balance between form and absolute function."},
    {"type":"text","id":"author","label":"Author / Brand","default":"THE CREATIVE DIRECTOR"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Read The Manifesto"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#D4AF37"}
  ],
  "presets": [{"name":"01 · Luxury Promo (v9)"}]
}
{% endschema %}
