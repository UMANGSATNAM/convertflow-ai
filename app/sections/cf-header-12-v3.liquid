<style>
.cf-header-12-v3{width:100%;background:{{ section.settings.bg_color }};font-family:'Helvetica Neue', sans-serif;color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 20px;}
.cf-header-12-v3-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}
.cf-header-12-v3-logo{flex:0 0 auto;text-decoration:none}
.cf-header-12-v3-logo img{max-height:{{ section.settings.logo_height }}px;height:auto}
.cf-header-12-v3-logo h1{font-size:26px;font-weight:300;margin:0;letter-spacing:0.1em;text-transform:uppercase;color:{{ section.settings.text_color }}}
.cf-header-12-v3-nav{display:flex;align-items:center;gap:40px}
.cf-header-12-v3-link{font-size:13px;color:{{ section.settings.text_color }};text-decoration:none;text-transform:uppercase;letter-spacing:0.15em;transition:0.3s;opacity:0.8}
.cf-header-12-v3-link:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-header-12-v3-icons{display:flex;align-items:center;gap:20px;margin-left:20px;border-left:1px solid {{ section.settings.text_color | color_modify: 'alpha', 0.1 }};padding-left:20px}
.cf-header-12-v3-icon{color:{{ section.settings.text_color }};cursor:pointer;transition:0.3s;opacity:0.8}
.cf-header-12-v3-icon:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-header-12-v3-badge{position:absolute;top:-5px;right:-8px;background:{{ section.settings.accent_color }};color:#fff;font-size:9px;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;font-weight:bold}
.cf-header-12-v3-mobile-toggle{display:none}
@media(max-width:900px){.cf-header-12-v3-nav{display:none}.cf-header-12-v3-mobile-toggle{display:block;cursor:pointer}}
</style>

<div class="cf-header-12-v3">
  <div class="cf-header-12-v3-inner">
    <a href="/" class="cf-header-12-v3-logo">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}">
      {% else %}
        <h1>{{ section.settings.logo_text }}</h1>
      {% endif %}
    </a>
    
    <div class="cf-header-12-v3-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="cf-header-12-v3-link">{{ link.title }}</a>
      {% else %}
        <a href="#" class="cf-header-12-v3-link">Shop</a>
        <a href="#" class="cf-header-12-v3-link">Collections</a>
        <a href="#" class="cf-header-12-v3-link">Editorial</a>
        <a href="#" class="cf-header-12-v3-link">About</a>
      {% endfor %}
      
      <div class="cf-header-12-v3-icons">
        <div class="cf-header-12-v3-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <div class="cf-header-12-v3-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div class="cf-header-12-v3-icon" style="position:relative;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span class="cf-header-12-v3-badge">2</span>
        </div>
      </div>
    </div>
    
    <div class="cf-header-12-v3-mobile-toggle">
       <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Header (v3)",
  "settings": [
    {"type":"image_picker","id":"logo","label":"Logo Image"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"ELEVATE"},
    {"type":"range","id":"logo_height","label":"Logo Height","min":20,"max":100,"step":5,"default":35},
    {"type":"link_list","id":"menu","label":"Main Menu"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#C5A387"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20}
  ],
  "presets": [{"name":"12 · Women's Header (v3)"}]
}
{% endschema %}
