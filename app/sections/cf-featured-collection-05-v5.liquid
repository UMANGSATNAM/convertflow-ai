<style>
.cf-fc-05-v5 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-fc-05-v5-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-fc-05-v5-header { text-align: center; margin-bottom: 50px; }
.cf-fc-05-v5-title { font-size: 34px; font-weight: 700; color: {{ section.settings.text_color }}; margin: 0; }
.cf-fc-05-v5-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 20px; }
.cf-fc-05-v5-card { text-decoration: none; display: flex; flex-direction: column; }
.cf-fc-05-v5-img { aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: #fce7f3; margin-bottom: 18px; position: relative; }
.cf-fc-05-v5-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.cf-fc-05-v5-card:hover .cf-fc-05-v5-img img { transform: scale(1.06); }
.cf-fc-05-v5-name { color: {{ section.settings.text_color }}; font-size: 16px; font-weight: 700; text-align: center; margin-bottom: 5px; }
.cf-fc-05-v5-price { color: {{ section.settings.accent_color }}; font-size: 15px; font-weight: 600; text-align: center; }
.cf-fc-05-v5-footer { text-align: center; margin-top: 50px; }
.cf-fc-05-v5-btn { display: inline-block; background: {{ section.settings.accent_color }}; color: #fff; text-decoration: none; padding: 14px 32px; border-radius: 50px; font-weight: 700; font-size: 14px; transition: opacity 0.2s; }
.cf-fc-05-v5-btn:hover { opacity: 0.85; }
@media (max-width: 900px) { .cf-fc-05-v5-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-fc-05-v5">
  <div class="cf-fc-05-v5-inner">
    <div class="cf-fc-05-v5-header"><h2 class="cf-fc-05-v5-title">{{ section.settings.title }}</h2></div>
    <div class="cf-fc-05-v5-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.url }}" class="cf-fc-05-v5-card">
        <div class="cf-fc-05-v5-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-fc-05-v5-name">{{ block.settings.title }}</div>
        <div class="cf-fc-05-v5-price">{{ block.settings.price }}</div>
      </a>
      {% endfor %}
    </div>
    <div class="cf-fc-05-v5-footer"><a href="{{ section.settings.btn_link }}" class="cf-fc-05-v5-btn">{{ section.settings.btn_text }}</a></div>
  </div>
</div>
{% schema %}{"name": "05 · K-Beauty Products","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#fff8f9"},{"type":"color","id":"text_color","label":"Text Color","default":"#2d2d2d"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#fb7185"},{"type":"text","id":"title","label":"Title","default":"Glass Skin Essentials"},{"type":"text","id":"btn_text","label":"Button Text","default":"Shop Routine"},{"type":"url","id":"btn_link","label":"Button Link"},{"type":"range","id":"cols","label":"Columns","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "product","name": "Product","settings": [{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Hydra Serum"},{"type":"text","id":"price","label":"Price","default":"$29.00"},{"type":"url","id":"url","label":"Link"}]}],"presets": [{"name": "05 · K-Beauty Products","blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}{% endschema %}
