<style>
.cf-header-03-v10 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  position: relative;
  font-family: 'Inter', sans-serif;
  padding-bottom: 4px; /* Space for RGB border */
}

/* Animated RGB Border */
.cf-header-03-v10::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; width: 100%; height: 4px;
  background: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
  background-size: 200% 100%;
  animation: cf-h3-v10-rgb 4s linear infinite;
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
}

@keyframes cf-h3-v10-rgb {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

.cf-header-03-v10-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-header-03-v10-logo {
  font-size: {{ section.settings.logo_size }}px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  letter-spacing: -0.05em;
  font-style: italic;
  display: flex;
  align-items: center;
  gap: 10px;
}

.cf-header-03-v10-logo svg {
  width: 30px; height: 30px;
  fill: url(#cf-h3-v10-grad);
}

.cf-header-03-v10-nav {
  display: none;
  align-items: center;
  gap: 30px;
}

.cf-header-03-v10-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  transition: 0.3s;
  text-shadow: 3px 3px 0 rgba(0,0,0,0.5);
}

.cf-header-03-v10-nav a:hover {
  color: {{ section.settings.accent_color }};
  text-shadow: 0 0 10px {{ section.settings.accent_color }};
}

.cf-header-03-v10-actions {
  display: flex;
  gap: 15px;
}

.cf-header-03-v10-btn {
  background: transparent;
  color: {{ section.settings.text_color }};
  border: 2px solid {{ section.settings.text_color }};
  padding: 8px 24px;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  text-decoration: none;
  transform: skewX(-15deg);
  transition: 0.3s;
}

.cf-header-03-v10-btn span {
  display: block;
  transform: skewX(15deg);
}

.cf-header-03-v10-btn:hover {
  background: {{ section.settings.text_color }};
  color: #000;
  box-shadow: 0 0 15px {{ section.settings.text_color }};
}


@media (min-width: 768px) {
  .cf-header-03-v10-nav { display: flex; }
  .cf-header-03-v10-inner { padding: {{ section.settings.padding_y }}px 40px; }
}
</style>

<svg width="0" height="0">
  <linearGradient id="cf-h3-v10-grad" x1="0%" y1="0%" x2="100%" y2="100%">
    <stop offset="0%" stop-color="#ff00ff" />
    <stop offset="100%" stop-color="#00ffff" />
  </linearGradient>
</svg>

<div class="cf-header-03-v10">
  <div class="cf-header-03-v10-inner">
    
    <a href="/" class="cf-header-03-v10-logo">
      <svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13.5h-13L12 6.5z"/></svg>
      {{ section.settings.logo_text }}
    </a>

    <nav class="cf-header-03-v10-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="cf-header-03-v10-actions">
      <a href="/cart" class="cf-header-03-v10-btn">
        <span>CART</span>
      </a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "10 · Gamer RGB",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"OMNIGEAR"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":16,"max":48,"step":2,"default":28},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#0b0b0f"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#00ffff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":50,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1800,"step":100,"default":1200}
  ],
  "presets": [{"name":"10 · Gamer RGB Header"}]
}
{% endschema %}
