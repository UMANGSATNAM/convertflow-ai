<style>
.cf-cat-05-v6 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-cat-05-v6-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-cat-05-v6-header { margin-bottom: 40px; display: flex; justify-content: space-between; align-items: flex-end; }
.cf-cat-05-v6-title { font-size: 32px; font-weight: 900; color: {{ section.settings.text_color }}; margin: 0; }
.cf-cat-05-v6-link { color: {{ section.settings.accent_color }}; text-decoration: none; font-weight: 600; font-size: 14px; }
.cf-cat-05-v6-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 15px; }
.cf-cat-05-v6-card { display: block; text-decoration: none; background: {{ section.settings.card_bg }}; border-radius: 12px; overflow: hidden; transition: transform 0.2s; }
.cf-cat-05-v6-card:hover { transform: translateY(-5px); }
.cf-cat-05-v6-img { aspect-ratio: 1; overflow: hidden; background: #f5f3ff; position: relative; }
.cf-cat-05-v6-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; position: absolute; }
.cf-cat-05-v6-card:hover .cf-cat-05-v6-img img { transform: scale(1.08); }
.cf-cat-05-v6-name { padding: 15px; font-size: 15px; font-weight: 700; color: {{ section.settings.text_color }}; }
@media (max-width: 900px) { .cf-cat-05-v6-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-cat-05-v6">
  <div class="cf-cat-05-v6-inner">
    <div class="cf-cat-05-v6-header">
      <h2 class="cf-cat-05-v6-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.link }}" class="cf-cat-05-v6-link">{{ section.settings.link_text }}</a>
    </div>
    <div class="cf-cat-05-v6-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-05-v6-card">
        <div class="cf-cat-05-v6-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-cat-05-v6-name">{{ block.settings.title }}</div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "06 · Indie Beauty Grid","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#fffbf5"},{"type":"color","id":"card_bg","label":"Card BG","default":"#fff"},{"type":"color","id":"text_color","label":"Text Color","default":"#18181b"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#7c3aed"},{"type":"text","id":"title","label":"Title","default":"Shop by Vibe"},{"type":"text","id":"link_text","label":"View All Link Text","default":"All Categories"},{"type":"url","id":"link","label":"View All Link"},{"type":"range","id":"cols","label":"Columns","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "category","name": "Category","settings": [{"type":"text","id":"title","label":"Name","default":"Natural"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets": [{"name": "06 · Indie Grid","blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
