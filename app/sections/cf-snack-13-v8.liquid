<style>
.cf-snack-13-v8{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:monospace;font-size:11px;letter-spacing:0.05em;text-transform:uppercase;padding:12px 20px;border-bottom:1px solid {{ section.settings.border_color }};display:flex;justify-content:space-between;align-items:center}
.cf-snack-13-v8-left{display:flex;align-items:center;gap:15px}
.cf-snack-13-v8-dot{width:8px;height:8px;border-radius:50%;background:{{ section.settings.accent_color }};animation:cf-snack-blink-13-v8 2s infinite}
@keyframes cf-snack-blink-13-v8{0%, 100%{opacity:1} 50%{opacity:0.3}}
.cf-snack-13-v8-right{display:flex;gap:30px}
.cf-snack-13-v8-link{color:inherit;text-decoration:none;transition:0.3s;opacity:0.7}
.cf-snack-13-v8-link:hover{opacity:1;color:{{ section.settings.accent_color }}}
@media(max-width:600px){
  .cf-snack-13-v8{flex-direction:column;gap:10px}
  .cf-snack-13-v8-right{width:100%;justify-content:space-between}
}
</style>

<div class="cf-snack-13-v8">
  <div class="cf-snack-13-v8-left">
    <div class="cf-snack-13-v8-dot"></div>
    <span>{{ section.settings.system_text }}</span>
  </div>
  
  <div class="cf-snack-13-v8-right">
    <a href="#" class="cf-snack-13-v8-link">LOC: {{ section.settings.loc_text }}</a>
    <a href="#" class="cf-snack-13-v8-link">STS: ALIVE</a>
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Snack (v8)",
  "settings": [
    {"type":"text","id":"system_text","label":"System Status Text","default":"SYSTEM_MCR: OPERATIONAL / 99.9% UPTIME"},
    {"type":"text","id":"loc_text","label":"Location ID","default":"LDN_HQ"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Blinking Dot Color","default":"#00FF41"},
    {"type":"color","id":"border_color","label":"Bottom Border Color","default":"#333333"}
  ],
  "presets": [{"name":"13 · Brand Snack (v8)"}]
}
{% endschema %}
