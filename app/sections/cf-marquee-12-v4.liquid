<style>
.cf-marquee-12-v4{width:100%;height:{{ section.settings.height }}px;position:relative;overflow:hidden;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }}}
.cf-marquee-12-v4-track{position:absolute;top:50%;left:0;transform:translateY(-50%);display:flex;white-space:nowrap;animation:cf-scroll-12-v4 {{ section.settings.speed }}s linear infinite}
.cf-marquee-12-v4-content{display:flex;align-items:center;padding-right:20px}
.cf-marquee-12-v4-text{font-size:{{ section.settings.font_size }}px;line-height:1;margin:0;letter-spacing:-0.05em;white-space:nowrap}
.cf-marquee-12-v4-text-outline{color:transparent;-webkit-text-stroke:1px {{ section.settings.text_color }}}
@keyframes cf-scroll-12-v4{0%{transform:translate(0,-50%)}100%{transform:translate(-50%,-50%)}}
</style>

<div class="cf-marquee-12-v4">
  <div class="cf-marquee-12-v4-track">
    <div class="cf-marquee-12-v4-content">
      {% for i in (1..3) %}
        <span class="cf-marquee-12-v4-text">{{ section.settings.text }}&nbsp;</span>
        <span class="cf-marquee-12-v4-text cf-marquee-12-v4-text-outline">{{ section.settings.text }}&nbsp;</span>
      {% endfor %}
    </div>
    <div class="cf-marquee-12-v4-content">
      {% for i in (1..3) %}
         <span class="cf-marquee-12-v4-text">{{ section.settings.text }}&nbsp;</span>
         <span class="cf-marquee-12-v4-text cf-marquee-12-v4-text-outline">{{ section.settings.text }}&nbsp;</span>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Marquee (v4)",
  "settings": [
    {"type":"text","id":"text","label":"Marquee Text","default":"NEW ARRIVALS"},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":30},
    {"type":"range","id":"font_size","label":"Font Size (px)","min":60,"max":200,"step":10,"default":120},
    {"type":"range","id":"height","label":"Container Height (px)","min":100,"max":300,"step":10,"default":140},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F8F3EC"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#C5A387"}
  ],
  "presets": [{"name":"12 · Women's Marquee (v4)"}]
}
{% endschema %}
