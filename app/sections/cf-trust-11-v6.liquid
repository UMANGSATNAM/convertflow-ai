<style>
.cf-trust-11-v6{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-trust-11-v6-inner{max-width:1400px;margin:0 auto}
.cf-trust-11-v6-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:2px;background:{{ section.settings.border_color }};border:2px solid {{ section.settings.border_color }}}
.cf-trust-11-v6-card{background:{{ section.settings.bg_color }};padding:50px 30px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:20px;transition:0.3s}
.cf-trust-11-v6-card:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
.cf-trust-11-v6-icon{width:60px;height:60px;transition:0.3s}
.cf-trust-11-v6-card:hover .cf-trust-11-v6-icon{color:{{ section.settings.bg_color }}}
.cf-trust-11-v6-title{font-size:18px;font-weight:900;text-transform:uppercase;margin:0;letter-spacing:0.05em}
.cf-trust-11-v6-desc{font-size:14px;opacity:0.8;margin:0;line-height:1.6}
@media(max-width:900px){.cf-trust-11-v6-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.cf-trust-11-v6-grid{grid-template-columns:1fr}}
</style>

<div class="cf-trust-11-v6">
  <div class="cf-trust-11-v6-inner">
    <div class="cf-trust-11-v6-grid">
      {% for i in (1..3) %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture desc_key %}desc_{{ i }}{% endcapture %}
        {% capture icon_key %}icon_{{ i }}{% endcapture %}
        
        <div class="cf-trust-11-v6-card">
          <div class="cf-trust-11-v6-icon">{{ section.settings[icon_key] }}</div>
          <h3 class="cf-trust-11-v6-title">{{ section.settings[title_key] }}</h3>
          <p class="cf-trust-11-v6-desc">{{ section.settings[desc_key] }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Trust (v6)",
  "settings": [
    {"type":"html","id":"icon_1","label":"Icon 1 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'></path></svg>"},
    {"type":"text","id":"title_1","label":"Title 1","default":"IRONCLAD WARRANTY"},
    {"type":"textarea","id":"desc_1","label":"Desc 1","default":"Every stitch is guaranteed. We stand by our craftsmanship for the lifetime of the garment."},
    
    {"type":"html","id":"icon_2","label":"Icon 2 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><rect x='3' y='11' width='18' height='11' rx='2' ry='2'></rect><path d='M7 11V7a5 5 0 0 1 10 0v4'></path></svg>"},
    {"type":"text","id":"title_2","label":"Title 2","default":"SECURE PAYMENTS"},
    {"type":"textarea","id":"desc_2","label":"Desc 2","default":"Shop with confidence using our 256-bit encrypted checkout system."},
    
    {"type":"html","id":"icon_3","label":"Icon 3 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line><polyline points='10 9 9 9 8 9'></polyline></svg>"},
    {"type":"text","id":"title_3","label":"Title 3","default":"ETHICAL PRODUCTION"},
    {"type":"textarea","id":"desc_3","label":"Desc 3","default":"Fair wages and safe conditions across our entire supply chain. Certified by independent auditors."},
    
    {"type":"color","id":"bg_color","label":"Background/Card","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Text & Hover Background","default":"#111111"},
    {"type":"color","id":"border_color","label":"Grid Border Lines","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Trust (v6)"}]
}
{% endschema %}
