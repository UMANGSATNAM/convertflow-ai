<style>
.cf-head-13-v5{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;border-bottom:1px solid {{ section.settings.border_color }};padding:0 40px}
.cf-head-13-v5-inner{max-width:1800px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;height:80px}
.cf-head-13-v5-left{display:flex;align-items:center;gap:40px}
.cf-head-13-v5-logo{font-size:24px;font-weight:900;text-transform:uppercase;letter-spacing:0.05em;color:inherit;text-decoration:none;display:flex;align-items:center;gap:10px}
.cf-head-13-v5-logo-dot{width:8px;height:8px;background:{{ section.settings.accent_color }};border-radius:50%}
.cf-head-13-v5-search{display:flex;align-items:center;gap:10px;background:{{ section.settings.input_bg }};padding:10px 20px;border-radius:30px;width:300px}
.cf-head-13-v5-search input{background:transparent;border:none;outline:none;font-family:sans-serif;font-size:12px;color:{{ section.settings.text_color }};width:100%}
.cf-head-13-v5-search input::placeholder{color:{{ section.settings.text_color }};opacity:0.5}
.cf-head-13-v5-right{display:flex;gap:40px;align-items:center}
.cf-head-13-v5-nav{display:flex;gap:30px}
.cf-head-13-v5-link{font-size:13px;font-weight:600;color:inherit;text-decoration:none;transition:0.3s}
.cf-head-13-v5-link:hover{color:{{ section.settings.accent_color }}}
.cf-head-13-v5-actions{display:flex;gap:20px;align-items:center}
.cf-head-13-v5-action-btn{position:relative;cursor:pointer}
.cf-head-13-v5-badge{position:absolute;top:-5px;right:-8px;background:{{ section.settings.accent_color }};color:{{ section.settings.bg_color }};font-size:9px;font-weight:700;width:16px;height:16px;display:flex;align-items:center;justify-content:center;border-radius:50%}
.cf-head-13-v5-menu-toggle{display:none}
@media(max-width:1100px){
  .cf-head-13-v5-search{display:none}
}
@media(max-width:900px){
  .cf-head-13-v5{padding:0 20px}
  .cf-head-13-v5-nav{display:none}
  .cf-head-13-v5-menu-toggle{display:block}
}
</style>

<div class="cf-head-13-v5">
  <div class="cf-head-13-v5-inner">
    
    <div class="cf-head-13-v5-left">
      <div class="cf-head-13-v5-menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </div>
      <a href="/" class="cf-head-13-v5-logo">
        <div class="cf-head-13-v5-logo-dot"></div>
        {{ section.settings.logo_text }}
      </a>
      <div class="cf-head-13-v5-search">
        <svg fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Search products, styles...">
      </div>
    </div>

    <div class="cf-head-13-v5-right">
      <div class="cf-head-13-v5-nav">
        {% for link in linklists[section.settings.menu].links limit:4 %}
          <a href="{{ link.url }}" class="cf-head-13-v5-link">{{ link.title }}</a>
        {% else %}
          <a href="#" class="cf-head-13-v5-link">Tops</a>
          <a href="#" class="cf-head-13-v5-link">Bottoms</a>
          <a href="#" class="cf-head-13-v5-link">Outwear</a>
          <a href="#" class="cf-head-13-v5-link">Objects</a>
        {% endfor %}
      </div>
      <div class="cf-head-13-v5-actions">
        <div class="cf-head-13-v5-action-btn">
          <svg fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </div>
        <div class="cf-head-13-v5-action-btn">
          <svg fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <div class="cf-head-13-v5-badge">2</div>
        </div>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Header (v5)",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"KINETIC"},
    {"type":"link_list","id":"menu","label":"Navigation Menu"},
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#FF3300"},
    {"type":"color","id":"input_bg","label":"Search Input Background","default":"#F5F5F5"},
    {"type":"color","id":"border_color","label":"Bottom Border","default":"#EAEAEE"}
  ],
  "presets": [{"name":"13 · Brand Header (v5)"}]
}
{% endschema %}
