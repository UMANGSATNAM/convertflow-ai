<style>
.cf-feat-11-v8{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-11-v8-inner{max-width:1400px;margin:0 auto;display:flex;flex-direction:column;align-items:center}
.cf-feat-11-v8-title{font-size:48px;font-weight:900;text-transform:uppercase;margin:0 0 50px 0;letter-spacing:-0.03em;text-align:center}
.cf-feat-11-v8-grid{width:100%;display:grid;grid-template-columns:1fr;gap:40px}
.cf-feat-11-v8-row{display:flex;align-items:center;background:{{ section.settings.card_bg }};text-decoration:none;transition:0.3s;box-shadow:6px 6px 0 {{ section.settings.shadow_color }};border:2px solid {{ section.settings.text_color }}}
.cf-feat-11-v8-row:hover{transform:translate(-4px, -4px);box-shadow:10px 10px 0 {{ section.settings.shadow_color }}}
.cf-feat-11-v8-img-wrap{flex:0 0 300px;height:300px;background:#e5e5e5;position:relative;border-right:2px solid {{ section.settings.text_color }}}
.cf-feat-11-v8-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover}
.cf-feat-11-v8-info{flex:1;padding:40px;display:flex;flex-direction:column;justify-content:center;gap:15px}
.cf-feat-11-v8-name{font-size:32px;font-weight:900;text-transform:uppercase;color:{{ section.settings.text_color }};margin:0;letter-spacing:-0.02em}
.cf-feat-11-v8-desc{font-size:16px;opacity:0.8;margin:0;max-width:600px;line-height:1.5}
.cf-feat-11-v8-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:20px}
.cf-feat-11-v8-price{font-size:24px;font-weight:900;color:{{ section.settings.text_color }};margin:0}
.cf-feat-11-v8-btn{padding:12px 24px;background:{{ section.settings.text_color }};color:{{ section.settings.card_bg }};font-weight:800;font-size:14px;text-transform:uppercase;letter-spacing:0.05em;border-radius:2px;display:flex;align-items:center;gap:10px;border:none}
@media(max-width:900px){.cf-feat-11-v8-row{flex-direction:column}.cf-feat-11-v8-img-wrap{flex:none;width:100%;height:350px;border-right:none;border-bottom:2px solid {{ section.settings.text_color }}}.cf-feat-11-v8-info{padding:30px}.cf-feat-11-v8-name{font-size:24px}}
</style>

<div class="cf-feat-11-v8">
  <div class="cf-feat-11-v8-inner">
    <h2 class="cf-feat-11-v8-title">{{ section.settings.title }}</h2>
    
    <div class="cf-feat-11-v8-grid">
      {% for i in (1..3) %}
         {% capture img_key %}img_{{ i }}{% endcapture %}
         {% capture title_key %}title_{{ i }}{% endcapture %}
         {% capture desc_key %}desc_{{ i }}{% endcapture %}
         {% capture price_key %}price_{{ i }}{% endcapture %}
         {% capture link_key %}link_{{ i }}{% endcapture %}
         
         <a href="{{ section.settings[link_key] }}" class="cf-feat-11-v8-row">
           <div class="cf-feat-11-v8-img-wrap">
              {% if section.settings[img_key] %}
                <img src="{{ section.settings[img_key] | image_url: width: 800 }}" class="cf-feat-11-v8-img">
              {% else %}
                <div style="background:#555;width:100%;height:100%"></div>
              {% endif %}
           </div>
           <div class="cf-feat-11-v8-info">
             <h3 class="cf-feat-11-v8-name">{{ section.settings[title_key] }}</h3>
             <p class="cf-feat-11-v8-desc">{{ section.settings[desc_key] }}</p>
             <div class="cf-feat-11-v8-bottom">
               <span class="cf-feat-11-v8-price">{{ section.settings[price_key] }}</span>
               <button class="cf-feat-11-v8-btn">
                 SHOP NOW
                 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
               </button>
             </div>
           </div>
         </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Featured (v8)",
  "settings": [
    {"type":"text","id":"title","label":"Section Title","default":"PREMIUM OUTERWEAR"},
    
    {"type":"image_picker","id":"img_1","label":"Product 1 Image"},
    {"type":"text","id":"title_1","label":"Product 1 Title","default":"THE MOUNTAIN PARKA"},
    {"type":"textarea","id":"desc_1","label":"Product 1 Desc","default":"Engineered for extremes. Fully waterproof, heavily insulated, and features multiple storm-sealed pockets."},
    {"type":"text","id":"price_1","label":"Product 1 Price","default":"$495"},
    {"type":"url","id":"link_1","label":"Product 1 Link"},
    
    {"type":"image_picker","id":"img_2","label":"Product 2 Image"},
    {"type":"text","id":"title_2","label":"Product 2 Title","default":"LEATHER MOTORCYCLE JACKET"},
    {"type":"textarea","id":"desc_2","label":"Product 2 Desc","default":"Heavyweight full-grain leather that breaks in beautifully over time. Asymmetric zip and belted waist."},
    {"type":"text","id":"price_2","label":"Product 2 Price","default":"$650"},
    {"type":"url","id":"link_2","label":"Product 2 Link"},
    
    {"type":"image_picker","id":"img_3","label":"Product 3 Image"},
    {"type":"text","id":"title_3","label":"Product 3 Title","default":"WOOL PEACOAT"},
    {"type":"textarea","id":"desc_3","label":"Product 3 Desc","default":"A timeless maritime classic. Thick, warming wool blend with broad lapels and double-breasted closure."},
    {"type":"text","id":"price_3","label":"Product 3 Price","default":"$380"},
    {"type":"url","id":"link_3","label":"Product 3 Link"},
    
    {"type":"color","id":"bg_color","label":"Background","default":"#F4F4F4"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"shadow_color","label":"Drop Shadow Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Featured (v8)"}]
}
{% endschema %}
