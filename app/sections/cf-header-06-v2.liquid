<div class="cf-auto-header-v2" style="background: {{ section.settings.bg_color }}; border-bottom: 2px solid {{ section.settings.accent_color }};">
  <div class="cf-auto-header-v2-container" style="max-width: 1400px; margin: 0 auto; padding: 15px 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
    
    <!-- Logo -->
    <div class="cf-auto-header-v2-logo" style="flex: 0 0 auto;">
      <a href="/" style="text-decoration: none;">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <span style="font-family: 'Arial Black', sans-serif; font-size: 28px; font-weight: 900; color: {{ section.settings.text_color }}; letter-spacing: -1px; text-transform: uppercase;">
            {{ shop.name }}
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Search Bar -->
    <div class="cf-auto-header-v2-search" style="flex: 1 1 auto; max-width: 600px; position: relative;">
      <form action="/search" method="get" style="display: flex; width: 100%; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.5); border-radius: 4px; overflow: hidden;">
        <input type="text" name="q" placeholder="Enter vehicle make, model, or part number..." style="flex: 1; padding: 12px 16px; border: none; background: transparent; color: {{ section.settings.text_color }}; font-size: 14px; outline: none; font-family: 'Roboto', sans-serif;">
        <button type="submit" style="padding: 0 20px; background: {{ section.settings.accent_color }}; border: none; color: #000; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>
      </form>
    </div>

    <!-- Right Icons & Vehicle Selector -->
    <div class="cf-auto-header-v2-actions" style="display: flex; align-items: center; gap: 24px;">
      
      <!-- Garage/Vehicle -->
      <a href="#" style="display: flex; align-items: center; gap: 8px; text-decoration: none; color: {{ section.settings.text_color }}; transition: color 0.2s;">
        <div style="background: rgba(255,255,255,0.1); padding: 8px; border-radius: 4px; display: flex;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="7" cy="15" r="1"></circle><circle cx="17" cy="15" r="1"></circle><path d="M14 6h-4l-3 5h10l-3-5z"></path></svg>
        </div>
        <div style="display: flex; flex-direction: column;">
          <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.7; font-family: 'Roboto', sans-serif;">My Garage</span>
          <span style="font-size: 13px; font-weight: 700; color: {{ section.settings.accent_color }}; font-family: 'Roboto', sans-serif;">Add Vehicle</span>
        </div>
      </a>

      <!-- Account -->
      <a href="/account" style="color: {{ section.settings.text_color }}; display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1); transition: background 0.2s;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>

      <!-- Cart -->
      <a href="/cart" style="color: {{ section.settings.text_color }}; position: relative; display: flex; align-items: center; justify-content: center; padding: 8px; border-radius: 4px; border: 1px solid rgba(255,255,255,0.1); transition: background 0.2s;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span style="position: absolute; top: -5px; right: -5px; background: {{ section.settings.accent_color }}; color: #000; font-size: 11px; font-weight: 800; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>

  <!-- Bottom Navigation Row -->
  <div class="cf-auto-header-v2-nav" style="border-top: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2);">
    <div style="max-width: 1400px; margin: 0 auto; padding: 0 30px; display: flex;">
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 30px; overflow-x: auto; scrollbar-width: none;">
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a href="{{ link.url }}" style="color: {{ section.settings.text_color }}; text-decoration: none; font-size: 14px; font-weight: 600; font-family: 'Roboto', sans-serif; text-transform: uppercase; letter-spacing: 1px; padding: 15px 0; display: inline-block; white-space: nowrap; transition: color 0.2s;">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<style>
  .cf-auto-header-v2 .cf-auto-header-v2-actions a:hover {
    background: rgba(255,255,255,0.1);
  }
  .cf-auto-header-v2 .cf-auto-header-v2-search button:hover {
    filter: brightness(1.1);
  }
  .cf-auto-header-v2 .cf-auto-header-v2-nav a:hover {
    color: {{ section.settings.accent_color }} !important;
  }
  @media (max-width: 768px) {
    .cf-auto-header-v2-container {
      padding: 15px !important;
      flex-direction: column;
    }
    .cf-auto-header-v2-search {
      order: 3;
      width: 100%;
      max-width: 100% !important;
    }
    .cf-auto-header-v2-nav {
      padding: 0 15px !important;
    }
  }
</style>

{% schema %}
{
  "name": "06 · Performance Parts Head",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (e.g. Red)",
      "default": "#ff3b30"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 40
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
