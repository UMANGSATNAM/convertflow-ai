<style>
.cf-marquee-01-v3{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;padding:3px 0;border-top:1px solid {{ section.settings.text_color }};border-bottom:1px solid {{ section.settings.text_color }}}
.cf-marquee-01-v3-track{display:flex;white-space:nowrap;animation:cf-marquee-01-v3-scroll {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v3-item{display:inline-flex;align-items:center;padding:0 30px}
.cf-marquee-01-v3-text{font-size:10px;font-weight:700;letter-spacing:0.3em;text-transform:uppercase;opacity:0.8}
.cf-marquee-01-v3-separator{margin:0 30px;width:3px;height:3px;background:{{ section.settings.text_color }};border-radius:50%;opacity:0.5}
@keyframes cf-marquee-01-v3-scroll{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-01-v3">
  <div class="cf-marquee-01-v3-track">
    {% for j in (1..3) %}
      {% for i in (1..6) %}
        <div class="cf-marquee-01-v3-item">
          <span class="cf-marquee-01-v3-text">{{ section.settings.text }}</span>
          <span class="cf-marquee-01-v3-separator"></span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v3)",
  "settings": [
    {"type":"text","id":"text","label":"Marquee Text","default":"DISCOVER THE NEW COLLECTION"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":50},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v3)"}]
}
{% endschema %}
