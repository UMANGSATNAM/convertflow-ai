<style>
.cf-cat-13-v9{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif}
.cf-cat-13-v9-inner{max-width:1400px;margin:0 auto}
.cf-cat-13-v9-header{text-align:center;margin-bottom:60px}
.cf-cat-13-v9-title{font-size:clamp(32px, 5vw, 64px);line-height:1;margin:0;font-weight:900;text-transform:uppercase;letter-spacing:-0.02em;color:{{ section.settings.text_color }}}
.cf-cat-13-v9-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:30px}
.cf-cat-13-v9-card{background:{{ section.settings.card_bg }};color:{{ section.settings.card_text }};padding:40px;aspect-ratio:1/1;display:flex;flex-direction:column;justify-content:space-between;text-decoration:none;transition:0.4s;border:1px solid transparent;position:relative;overflow:hidden}
.cf-cat-13-v9-card::after{content:"";position:absolute;top:0;left:0;width:100%;height:100%;background:{{ section.settings.card_text }};transform:translateY(100%);transition:0.4s;z-index:1}
.cf-cat-13-v9-card:hover{border-color:{{ section.settings.card_text }};box-shadow:0 20px 40px rgba(0,0,0,0.1);transform:translateY(-10px)}
.cf-cat-13-v9-card:hover::after{transform:translateY(0)}
.cf-cat-13-v9-content{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:space-between;transition:0.4s}
.cf-cat-13-v9-card:hover .cf-cat-13-v9-content{color:{{ section.settings.card_bg }}}
.cf-cat-13-v9-num{font-size:14px;font-weight:700;letter-spacing:0.1em}
.cf-cat-13-v9-label{font-size:clamp(24px, 3vw, 40px);font-weight:900;text-transform:uppercase;margin:0;letter-spacing:-0.01em;line-height:1}
@media(max-width:900px){
  .cf-cat-13-v9-grid{grid-template-columns:1fr;gap:20px}
  .cf-cat-13-v9-card{aspect-ratio:auto;min-height:250px;padding:30px}
}
</style>

<div class="cf-cat-13-v9">
  <div class="cf-cat-13-v9-inner">
    <div class="cf-cat-13-v9-header">
      <h2 class="cf-cat-13-v9-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="cf-cat-13-v9-grid">
      {% for i in (1..6) %}
        <a href="#" class="cf-cat-13-v9-card">
          <div class="cf-cat-13-v9-content">
            <span class="cf-cat-13-v9-num">0{{ i }}</span>
            <h3 class="cf-cat-13-v9-label">
              {% if i == 1 %}Denim{% elsif i == 2 %}Knitwear{% elsif i == 3 %}T-Shirts{% elsif i == 4 %}Sweats{% elsif i == 5 %}Outerwear{% else %}Footwear{% endif %}
            </h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Category (v9)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"COLLECTIONS"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Header Text Color","default":"#111111"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#111111"},
    {"type":"color","id":"card_text","label":"Card Text & Hover Fill","default":"#CCFF00"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":100}
  ],
  "presets": [{"name":"13 · Brand Category (v9)"}]
}
{% endschema %}
