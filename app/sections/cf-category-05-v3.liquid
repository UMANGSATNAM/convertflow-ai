<style>
.cf-cat-05-v3 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-cat-05-v3-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-cat-05-v3-header { margin-bottom: 40px; }
.cf-cat-05-v3-title { font-size: 32px; font-weight: 700; color: {{ section.settings.text_color }}; margin: 0; }
.cf-cat-05-v3-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 15px; }
.cf-cat-05-v3-card { display: block; text-decoration: none; position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 1; background: #f0fdf4; }
.cf-cat-05-v3-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; transition: transform 0.5s; }
.cf-cat-05-v3-card:hover img { transform: scale(1.08); }
.cf-cat-05-v3-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, {{ section.settings.text_color | color_modify: 'alpha', 0.7 }}, transparent 60%);
  display: flex; align-items: flex-end; padding: 20px;
}
.cf-cat-05-v3-name { color: #fff; font-size: 18px; font-weight: 700; }
@media (max-width: 900px) { .cf-cat-05-v3-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-cat-05-v3">
  <div class="cf-cat-05-v3-inner">
    <div class="cf-cat-05-v3-header"><h2 class="cf-cat-05-v3-title">{{ section.settings.title }}</h2></div>
    <div class="cf-cat-05-v3-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-05-v3-card">
        <div class="cf-cat-05-v3-img">
          {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}
        </div>
        <div class="cf-cat-05-v3-overlay"><span class="cf-cat-05-v3-name">{{ block.settings.title }}</span></div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "03 · Clean Beauty Grid","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#f0fdf4"},{"type":"color","id":"text_color","label":"Overlay Text BG","default":"#14532d"},{"type":"text","id":"title","label":"Title","default":"Shop Clean"},{"type":"range","id":"cols","label":"Columns","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "category","name": "Category","settings": [{"type":"text","id":"title","label":"Name","default":"Serums"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets": [{"name": "03 · Clean Grid","blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
