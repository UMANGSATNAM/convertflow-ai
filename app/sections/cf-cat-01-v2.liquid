<style>
.cf-cat-01-v2{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif}
.cf-cat-01-v2-inner{max-width:1400px;margin:0 auto}
.cf-cat-01-v2-header{text-align:center;margin-bottom:80px}
.cf-cat-01-v2-title{font-size:clamp(40px, 6vw, 72px);font-weight:400;margin:0;letter-spacing:0.02em;text-transform:uppercase}
.cf-cat-01-v2-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:40px;align-items:start}
.cf-cat-01-v2-col{display:flex;flex-direction:column;gap:40px}
.cf-cat-01-v2-col:nth-child(2){margin-top:80px}
.cf-cat-01-v2-card{text-decoration:none;color:inherit;display:block;position:relative}
.cf-cat-01-v2-img-wrap{width:100%;background:#ececec;overflow:hidden;position:relative}
.cf-cat-01-v2-card:nth-child(odd) .cf-cat-01-v2-img-wrap{aspect-ratio:3/4}
.cf-cat-01-v2-card:nth-child(even) .cf-cat-01-v2-img-wrap{aspect-ratio:4/5}
.cf-cat-01-v2-img{width:100%;height:100%;object-fit:cover;transition:1.2s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-cat-01-v2-card:hover .cf-cat-01-v2-img{transform:scale(1.05)}
.cf-cat-01-v2-info{position:absolute;bottom:-20px;left:20px;background:{{ section.settings.bg_color }};padding:25px 40px;box-shadow:0 20px 40px rgba(0,0,0,0.05);transition:0.4s}
.cf-cat-01-v2-card:hover .cf-cat-01-v2-info{transform:translateY(-10px)}
.cf-cat-01-v2-name{font-size:18px;font-weight:400;letter-spacing:0.02em;margin:0 0 5px 0;text-transform:uppercase}
.cf-cat-01-v2-count{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;opacity:0.6}
@media(max-width:1024px){
  .cf-cat-01-v2-grid{grid-template-columns:1fr 1fr}
  .cf-cat-01-v2-col:nth-child(2){margin-top:0}
}
@media(max-width:600px){
  .cf-cat-01-v2-grid{grid-template-columns:1fr;gap:60px}
}
</style>

<div class="cf-cat-01-v2">
  <div class="cf-cat-01-v2-inner">
    <div class="cf-cat-01-v2-header">
      <h2 class="cf-cat-01-v2-title">{{ section.settings.title }}</h2>
    </div>
    <div class="cf-cat-01-v2-grid">
      <div class="cf-cat-01-v2-col">
        {% for i in (1..2) %}
          <a href="#" class="cf-cat-01-v2-card">
            <div class="cf-cat-01-v2-img-wrap"><div class="cf-cat-01-v2-img" style="background:#444;"></div></div>
            <div class="cf-cat-01-v2-info">
              <h3 class="cf-cat-01-v2-name">Category 0{{ i }}</h3>
              <span class="cf-cat-01-v2-count">Explore</span>
            </div>
          </a>
        {% endfor %}
      </div>
      <div class="cf-cat-01-v2-col">
        {% for i in (3..4) %}
          <a href="#" class="cf-cat-01-v2-card">
            <div class="cf-cat-01-v2-img-wrap"><div class="cf-cat-01-v2-img" style="background:#555;"></div></div>
            <div class="cf-cat-01-v2-info">
              <h3 class="cf-cat-01-v2-name">Category 0{{ i }}</h3>
              <span class="cf-cat-01-v2-count">Explore</span>
            </div>
          </a>
        {% endfor %}
      </div>
      <div class="cf-cat-01-v2-col">
        {% for i in (5..6) %}
          <a href="#" class="cf-cat-01-v2-card">
            <div class="cf-cat-01-v2-img-wrap"><div class="cf-cat-01-v2-img" style="background:#666;"></div></div>
            <div class="cf-cat-01-v2-info">
              <h3 class="cf-cat-01-v2-name">Category 0{{ i }}</h3>
              <span class="cf-cat-01-v2-count">Explore</span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v2)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"CURATIONS"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Category (v2)"}]
}
{% endschema %}
