<style>
.cf-fc-03-v4 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  position: relative;
  overflow: hidden;
}

/* Abstract blobs */
.cf-fc-03-v4::before, .cf-fc-03-v4::after {
  content: '';
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  filter: blur(150px);
  z-index: 1;
  pointer-events: none;
}
.cf-fc-03-v4::before { top: -200px; left: -200px; background: rgba(59, 130, 246, 0.3); }
.cf-fc-03-v4::after { bottom: -200px; right: -200px; background: rgba(147, 51, 234, 0.3); }

.cf-fc-03-v4-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.cf-fc-03-v4-header {
  text-align: center;
  margin-bottom: 60px;
}

.cf-fc-03-v4-heading {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 700;
  color: {{ section.settings.text_color }};
  margin: 0;
  letter-spacing: -0.02em;
}

.cf-fc-03-v4-grid {
  display: flex;
  flex-wrap: nowrap;
  gap: 30px;
  overflow-x: auto;
  padding-bottom: 40px;
  /* Hide scrollbar for cleaner look */
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.cf-fc-03-v4-grid::-webkit-scrollbar { display: none; }

.cf-fc-03-v4-card {
  flex: 0 0 300px;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 24px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: 0.4s;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.cf-fc-03-v4-card:hover {
  transform: translateY(-10px);
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  border-color: rgba(255, 255, 255, 0.2);
}

.cf-fc-03-v4-img-wrap {
  width: 100%;
  aspect-ratio: 1/1;
  border-radius: 16px;
  background: rgba(0,0,0,0.2);
  margin-bottom: 24px;
  overflow: hidden;
}

.cf-fc-03-v4-img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: 0.5s;
}

.cf-fc-03-v4-card:hover .cf-fc-03-v4-img {
  transform: scale(1.05);
}

.cf-fc-03-v4-title {
  color: {{ section.settings.text_color }};
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 10px 0;
  line-height: 1.3;
}

.cf-fc-03-v4-price {
  color: {{ section.settings.accent_color }};
  font-size: 18px;
  font-weight: 700;
  margin-top: auto;
}

.cf-fc-03-v4-btn {
  margin-top: 20px;
  background: transparent;
  color: {{ section.settings.text_color }};
  border: 1px solid rgba(255,255,255,0.2);
  padding: 12px 20px;
  border-radius: 12px;
  text-align: center;
  font-weight: 600;
  transition: 0.3s;
}

.cf-fc-03-v4-card:hover .cf-fc-03-v4-btn {
  background: {{ section.settings.text_color }};
  color: #000;
}
</style>

<div class="cf-fc-03-v4">
  <div class="cf-fc-03-v4-inner">
    <div class="cf-fc-03-v4-header">
      <h2 class="cf-fc-03-v4-heading">{{ section.settings.heading }}</h2>
    </div>
    
    <div class="cf-fc-03-v4-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="cf-fc-03-v4-card">
            <div class="cf-fc-03-v4-img-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="cf-fc-03-v4-img">
            </div>
            <h3 class="cf-fc-03-v4-title">{{ product.title }}</h3>
            <div class="cf-fc-03-v4-price">{{ product.price | money }}</div>
            <div class="cf-fc-03-v4-btn">View Details</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..5) %}
          <a href="#" class="cf-fc-03-v4-card">
            <div class="cf-fc-03-v4-img-wrap">
              <div style="width:100%; height:100%; background:rgba(255,255,255,0.05);"></div>
            </div>
            <h3 class="cf-fc-03-v4-title">Pro Audio Interface</h3>
            <div class="cf-fc-03-v4-price">$199.00</div>
            <div class="cf-fc-03-v4-btn">View Details</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "04 · Glassmorphism Shelf",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ecosystem Lineup"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#60a5fa"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1400
    }
  ],
  "presets": [
    {
      "name": "04 · Glass Shelf Collecti"
    }
  ]
}
{% endschema %}
