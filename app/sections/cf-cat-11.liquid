<style>
.cf-cat-11{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif}
.cf-cat-11-inner{max-width:1400px;margin:0 auto}
.cf-cat-11-header{text-align:center;margin-bottom:60px}
.cf-cat-11-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:300;letter-spacing:0.05em;text-transform:uppercase;margin:0}
.cf-cat-11-grid{display:grid;grid-template-columns:repeat({{ section.settings.cols }}, 1fr);gap:4px;background:{{ section.settings.border_color }};border:4px solid {{ section.settings.border_color }}}
.cf-cat-11-card{text-decoration:none;display:block;background:{{ section.settings.bg_color }};position:relative;overflow:hidden;aspect-ratio:3/4}
.cf-cat-11-img{width:100%;height:100%;object-fit:cover;transition:0.8s filter, 0.8s transform;filter:brightness(0.9) grayscale(20%)}
.cf-cat-11-card:hover .cf-cat-11-img{transform:scale(1.05);filter:brightness(1) grayscale(0%)}
.cf-cat-11-info{position:absolute;bottom:0;left:0;right:0;padding:30px;background:linear-gradient(to top, rgba(15,23,42,0.8), transparent)}
.cf-cat-11-name{font-size:18px;color:#fff;font-weight:400;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:8px}
.cf-cat-11-link{font-size:12px;color:#cbd5e1;text-transform:uppercase;letter-spacing:0.15em;transition:0.3s}
.cf-cat-11-card:hover .cf-cat-11-link{color:#fff}
@media(max-width:900px){.cf-cat-11-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.cf-cat-11-grid{grid-template-columns:1fr}}
</style>

<div class="cf-cat-11">
  <div class="cf-cat-11-inner">
    <div class="cf-cat-11-header">
      <h2 class="cf-cat-11-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="cf-cat-11-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-11-card">
          {% if block.settings.image %}
            <img class="cf-cat-11-img" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
          {% else %}
            <div style="width:100%;height:100%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:12px;letter-spacing:0.1em">IMAGE</div>
          {% endif %}
          <div class="cf-cat-11-info">
            <div class="cf-cat-11-name">{{ block.settings.title }}</div>
            <div class="cf-cat-11-link">Explore Collection</div>
          </div>
        </a>
      {% endfor %}
      
      {% if section.blocks.size == 0 %}
        {% for i in (1..section.settings.cols) %}
          <a href="#" class="cf-cat-11-card">
            <div style="width:100%;height:100%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:12px;letter-spacing:0.1em">MENSWEAR</div>
            <div class="cf-cat-11-info">
              <div class="cf-cat-11-name">Suiting {{ i }}</div>
              <div class="cf-cat-11-link">Explore Collection</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Categories",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"THE COLLECTIONS"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":64,"step":2,"default":42},
    {"type":"range","id":"cols","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":3},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Title Color","default":"#0f172a"},
    {"type":"color","id":"border_color","label":"Grid Separator","default":"#0f172a"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 6,
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Outerwear"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "11 · Men's Categories",
      "blocks": [
        {"type":"category","settings":{"title":"Tailoring"}},
        {"type":"category","settings":{"title":"Outerwear"}},
        {"type":"category","settings":{"title":"Footwear"}}
      ]
    }
  ]
}
{% endschema %}
