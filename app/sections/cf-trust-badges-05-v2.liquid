<style>
.cf-tb-05-v2 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-tb-05-v2-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
.cf-tb-05-v2-badge { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; }
.cf-tb-05-v2-icon-wrap { width: 64px; height: 64px; border-radius: 50%; background: {{ section.settings.accent_color | color_modify: 'alpha', 0.15 }}; display: flex; align-items: center; justify-content: center; }
.cf-tb-05-v2-icon { font-size: 28px; }
.cf-tb-05-v2-label { font-size: 13px; font-weight: 700; color: {{ section.settings.text_color }}; max-width: 100px; line-height: 1.4; }
</style>
<div class="cf-tb-05-v2">
  <div class="cf-tb-05-v2-inner">
    {% for block in section.blocks %}
    <div class="cf-tb-05-v2-badge">
      <div class="cf-tb-05-v2-icon-wrap"><span class="cf-tb-05-v2-icon">{{ block.settings.icon }}</span></div>
      <div class="cf-tb-05-v2-label">{{ block.settings.label }}</div>
    </div>
    {% endfor %}
  </div>
</div>
{% schema %}{"name": "02 · Glam Trust Badges","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#fff0f6"},{"type":"color","id":"text_color","label":"Text Color","default":"#1e1b4b"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#ec4899"},{"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":50},{"type":"range","id":"max_width","label":"Max Width","min":600,"max":1400,"step":50,"default":1000}],"blocks": [{"type": "badge","name": "Badge","settings": [{"type":"text","id":"icon","label":"Icon (Emoji)","default":"✨"},{"type":"text","id":"label","label":"Label","default":"Glow Guaranteed"}]}],"presets": [{"name": "02 · Glam Trust Badges","blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]}]}{% endschema %}
