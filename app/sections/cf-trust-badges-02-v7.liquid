<style>
.cf-tb-02-v7 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-tb-02-v7-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-tb-02-v7-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.cf-tb-02-v7-item {
  position: relative;
  background: #111;
  padding: 40px 20px;
  text-align: center;
  overflow: hidden;
  border: 4px solid #000;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cf-tb-02-v7-barcode-bg {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  display: flex;
  opacity: 0.15;
  z-index: 1;
}

.cf-tb-02-v7-bar {
  background: #fff;
  height: 100%;
}

.cf-tb-02-v7-content {
  position: relative;
  z-index: 10;
}

.cf-tb-02-v7-icon {
  width: 48px; height: 48px;
  color: {{ section.settings.accent_color }};
  margin: 0 auto 20px;
}

.cf-tb-02-v7-icon svg {
  width: 100%; height: 100%;
  fill: currentColor;
}

.cf-tb-02-v7-title {
  font-family: ui-monospace, SFMono-Regular, Monaco, monospace;
  font-size: 16px;
  font-weight: bold;
  color: #fff;
  margin: 0 0 10px 0;
  letter-spacing: 0.1em;
}

.cf-tb-02-v7-desc {
  font-size: 13px;
  color: #aaa;
  margin: 0;
  letter-spacing: 0.05em;
}

@media (min-width: 768px) {
  .cf-tb-02-v7-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>

<div class="cf-tb-02-v7">
  <div class="cf-tb-02-v7-inner">
    <div class="cf-tb-02-v7-grid">
      {% for block in section.blocks %}
        <div class="cf-tb-02-v7-item">
          <div class="cf-tb-02-v7-barcode-bg">
            <div class="cf-tb-02-v7-bar" style="width: 2px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 6px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 2px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 12px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 4px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 8px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 2px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 20px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 2px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 6px;"></div>
            <div class="cf-tb-02-v7-bar" style="width: 4px;"></div>
          </div>
          
          <div class="cf-tb-02-v7-content">
            <div class="cf-tb-02-v7-icon">
              {% if block.settings.icon_svg != blank %}
                {{ block.settings.icon_svg }}
              {% else %}
                <svg viewBox="0 0 24 24"><path d="M11 15h2v2h-2zm0-8h2v6h-2zm.99-5C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"/></svg>
              {% endif %}
            </div>
            <h3 class="cf-tb-02-v7-title">{{ block.settings.title }}</h3>
            <p class="cf-tb-02-v7-desc">{{ block.settings.desc }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "07 · Barcode Trust",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#F8F8F8"},
    {"type":"color","id":"accent_color","label":"Icon Color","default":"#ffffff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "limit": 3,
      "settings": [
        {"type":"html","id":"icon_svg","label":"Icon SVG"},
        {"type":"text","id":"title","label":"Title","default":"SCAN & VERIFY"},
        {"type":"text","id":"desc","label":"Description","default":"Code embedded authenticity on all apparel."}
      ]
    }
  ],
  "presets": [
    {
      "name": "07 · Barcode Trust Badges",
      "blocks": [
        {"type": "badge"},
        {"type": "badge"},
        {"type": "badge"}
      ]
    }
  ]
}
{% endschema %}
