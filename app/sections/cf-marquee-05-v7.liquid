<style>
.cf-mq-05-v7 { overflow: hidden; background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 0; border-top: 2px solid {{ section.settings.accent_color }}; border-bottom: 2px solid {{ section.settings.accent_color }}; }
.cf-mq-05-v7-track { display: flex; animation: mq05v7s {{ section.settings.speed }}s linear infinite; }
.cf-mq-05-v7-track:hover { animation-play-state: paused; }
@keyframes mq05v7s { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.cf-mq-05-v7-item {
  display: inline-flex; align-items: center; gap: 15px;
  padding: 0 40px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 600;
  color: {{ section.settings.text_color }};
  white-space: nowrap;
}
.cf-mq-05-v7-icon { color: {{ section.settings.accent_color }}; }
.cf-mq-05-v7-icon svg { width: 16px; height: 16px; stroke-width: 2; }
</style>

<div class="cf-mq-05-v7">
  <div class="cf-mq-05-v7-track">
    {% for i in (1..4) %}{% for block in section.blocks %}
      <span class="cf-mq-05-v7-item">
        <span class="cf-mq-05-v7-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        {{ block.settings.text }}
      </span>
    {% endfor %}{% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "07 · Dermatology Marquee",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f0fdfa"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#134e4a"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#0d9488"},
    {"type":"range","id":"font_size","label":"Font Size","min":12,"max":24,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":12},
    {"type":"range","id":"speed","label":"Speed (seconds)","min":10,"max":80,"step":5,"default":35}
  ],
  "blocks": [
    {"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Dermatologist Tested"}]}
  ],
  "presets": [{"name": "07 · Dermatology Marquee","blocks": [{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]
}
{% endschema %}
