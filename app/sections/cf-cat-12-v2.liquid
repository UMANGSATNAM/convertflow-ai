<style>
.cf-cat-12-v2{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:serif;color:{{ section.settings.text_color }}}
.cf-cat-12-v2-inner{max-width:1400px;margin:0 auto}
.cf-cat-12-v2-header{text-align:center;margin-bottom:50px}
.cf-cat-12-v2-sub{font-family:sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:0.15em;color:{{ section.settings.accent_color }};margin-bottom:15px;display:block}
.cf-cat-12-v2-title{font-size:clamp(32px, 4vw, 56px);font-weight:300;margin:0;letter-spacing:0.02em}
.cf-cat-12-v2-grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:20px}
.cf-cat-12-v2-card{text-decoration:none;display:flex;flex-direction:column;align-items:center;group}
.cf-cat-12-v2-img-wrap{width:100%;aspect-ratio:3/4;overflow:hidden;border-radius:{{ section.settings.border_radius }}px;margin-bottom:20px;background:{{ section.settings.card_bg }}}
.cf-cat-12-v2-img{width:100%;height:100%;object-fit:cover;transition:0.8s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-cat-12-v2-card:hover .cf-cat-12-v2-img{transform:scale(1.05)}
.cf-cat-12-v2-label{font-size:18px;color:{{ section.settings.text_color }};font-style:italic;transition:0.3s}
.cf-cat-12-v2-card:hover .cf-cat-12-v2-label{color:{{ section.settings.accent_color }}}
@media(max-width:1024px){.cf-cat-12-v2-grid{grid-template-columns:repeat(2, 1fr)}}
@media(max-width:600px){.cf-cat-12-v2-grid{grid-template-columns:1fr;gap:30px}}
</style>

<div class="cf-cat-12-v2">
  <div class="cf-cat-12-v2-inner">
    <div class="cf-cat-12-v2-header">
      <span class="cf-cat-12-v2-sub">{{ section.settings.subtitle }}</span>
      <h2 class="cf-cat-12-v2-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="cf-cat-12-v2-grid">
      {% for i in (1..4) %}
        <a href="#" class="cf-cat-12-v2-card">
          <div class="cf-cat-12-v2-img-wrap">
            <div class="cf-cat-12-v2-img" style="background:#e8e8e8;display:flex;align-items:center;justify-content:center;color:#999">Image {{ i }}</div>
          </div>
          <span class="cf-cat-12-v2-label">Category {{ i }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Category (v2",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CURATED EDITS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Image Placeholder Base",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Hover Accent Color",
      "default": "#A38971"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image Rounding",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 40,
      "max": 160,
      "step": 10,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "12 · Women's Category (v2"
    }
  ]
}
{% endschema %}
