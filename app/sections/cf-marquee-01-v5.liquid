<style>
.cf-marquee-01-v5{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 0}
.cf-marquee-01-v5-track{display:flex;white-space:nowrap;animation:cf-marquee-01-v5-scroll {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v5-item{display:inline-flex;align-items:center;padding:0 60px}
.cf-marquee-01-v5-symbol{font-family:serif;font-size:clamp(40px, 6vw, 64px);line-height:1;margin-right:60px;opacity:0.2}
.cf-marquee-01-v5-text{font-family:sans-serif;font-size:14px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase}
@keyframes cf-marquee-01-v5-scroll{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-01-v5">
  <div class="cf-marquee-01-v5-track">
    {% for j in (1..3) %}
      {% for i in (1..4) %}
        <div class="cf-marquee-01-v5-item">
          <div class="cf-marquee-01-v5-symbol">{{ section.settings.monogram }}</div>
          <span class="cf-marquee-01-v5-text">{{ section.settings.text }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v5)",
  "settings": [
    {"type":"text","id":"monogram","label":"Brand Monogram","default":"O"},
    {"type":"text","id":"text","label":"Marquee Text","default":"Opulence Defined"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":45},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#222222"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":60}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v5)"}]
}
{% endschema %}
