<style>
.cf-feat-11-v3{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-11-v3-inner{max-width:1400px;margin:0 auto;display:flex;gap:40px;align-items:center}
.cf-feat-11-v3-text{flex:1;max-width:400px}
.cf-feat-11-v3-tag{font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:{{ section.settings.accent_color }};margin-bottom:15px;display:block}
.cf-feat-11-v3-title{font-size:clamp(40px,5vw,60px);font-weight:900;text-transform:uppercase;margin:0 0 20px 0;line-height:1;letter-spacing:-0.03em}
.cf-feat-11-v3-desc{font-size:15px;opacity:0.8;line-height:1.6;margin-bottom:30px}
.cf-feat-11-v3-btn{display:inline-block;padding:15px 30px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};text-decoration:none;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:0.05em;border-radius:4px;transition:0.3s}
.cf-feat-11-v3-btn:hover{background:{{ section.settings.accent_color }}}
.cf-feat-11-v3-grid{flex:2;display:grid;grid-template-columns:repeat(2, 1fr);gap:20px}
.cf-feat-11-v3-card{text-decoration:none;display:flex;flex-direction:column;gap:10px}
.cf-feat-11-v3-img-wrap{width:100%;aspect-ratio:3/4;position:relative;overflow:hidden;background:#e5e5e5;border-radius:8px}
.cf-feat-11-v3-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:0.6s}
.cf-feat-11-v3-card:hover .cf-feat-11-v3-img{transform:scale(1.05)}
.cf-feat-11-v3-info{text-align:center}
.cf-feat-11-v3-name{font-size:14px;font-weight:800;text-transform:uppercase;color:{{ section.settings.text_color }};margin:0 0 5px 0}
.cf-feat-11-v3-price{font-size:14px;font-weight:500;color:{{ section.settings.text_color }};opacity:0.7;margin:0}
@media(max-width:900px){.cf-feat-11-v3-inner{flex-direction:column;text-align:center}.cf-feat-11-v3-text{max-width:100%}}
</style>

<div class="cf-feat-11-v3">
  <div class="cf-feat-11-v3-inner">
    <div class="cf-feat-11-v3-text">
       <span class="cf-feat-11-v3-tag">{{ section.settings.tag }}</span>
       <h2 class="cf-feat-11-v3-title">{{ section.settings.title }}</h2>
       <p class="cf-feat-11-v3-desc">{{ section.settings.desc }}</p>
       <a href="{{ section.settings.btn_link }}" class="cf-feat-11-v3-btn">{{ section.settings.btn_label }}</a>
    </div>
    <div class="cf-feat-11-v3-grid">
      {% for i in (1..2) %}
        {% capture img_key %}img_{{ i }}{% endcapture %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture price_key %}price_{{ i }}{% endcapture %}
        {% capture link_key %}link_{{ i }}{% endcapture %}
        <a href="{{ section.settings[link_key] }}" class="cf-feat-11-v3-card">
          <div class="cf-feat-11-v3-img-wrap">
            {% if section.settings[img_key] %}
              <img src="{{ section.settings[img_key] | image_url: width: 600 }}" class="cf-feat-11-v3-img">
            {% else %}
               <div style="background:#555;width:100%;height:100%"></div>
            {% endif %}
          </div>
          <div class="cf-feat-11-v3-info">
            <h3 class="cf-feat-11-v3-name">{{ section.settings[title_key] }}</h3>
            <p class="cf-feat-11-v3-price">{{ section.settings[price_key] }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Featured (v3)",
  "settings": [
    {"type":"text","id":"tag","label":"Tag","default":"EDITOR'S PICKS"},
    {"type":"text","id":"title","label":"Title","default":"THE CAPSULE WARDROBE"},
    {"type":"textarea","id":"desc","label":"Description","default":"Build your foundation with these meticulously crafted essentials designed for everyday rotation."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"SHOP THE COLLECTION"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"image_picker","id":"img_1","label":"Product 1 Image"},
    {"type":"text","id":"title_1","label":"Product 1 Title","default":"HEAVYWEIGHT TEE"},
    {"type":"text","id":"price_1","label":"Product 1 Price","default":"$45"},
    {"type":"url","id":"link_1","label":"Product 1 Link"},
    {"type":"image_picker","id":"img_2","label":"Product 2 Image"},
    {"type":"text","id":"title_2","label":"Product 2 Title","default":"EVERYDAY CHINO"},
    {"type":"text","id":"price_2","label":"Product 2 Price","default":"$110"},
    {"type":"url","id":"link_2","label":"Product 2 Link"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F8F8F8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#A37B5C"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Featured (v3)"}]
}
{% endschema %}
