<style>
.cf-header-03-v6 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  border-bottom: 2px solid {{ section.settings.border_color }};
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-header-03-v6-topbar {
  background: {{ section.settings.title_bar_bg }};
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 15px;
  border-bottom: 1px solid {{ section.settings.border_color }};
}

.cf-header-03-v6-dots {
  display: flex;
  gap: 8px;
}

.cf-header-03-v6-dot {
  width: 12px; height: 12px;
  border-radius: 50%;
}
.cf-header-03-v6-dot-r { background: #ff5f56; }
.cf-header-03-v6-dot-y { background: #ffbd2e; }
.cf-header-03-v6-dot-g { background: #27c93f; }

.cf-header-03-v6-title {
  font-size: 12px;
  color: {{ section.settings.title_bar_text }};
  font-weight: bold;
}

.cf-header-03-v6-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-header-03-v6-logo {
  font-size: {{ section.settings.logo_size }}px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 10px;
}

.cf-header-03-v6-logo::before {
  content: '~/';
  color: {{ section.settings.accent_color }};
}
.cf-header-03-v6-logo::after {
  content: '_';
  color: {{ section.settings.text_color }};
  animation: cf-h3-v6-blink 1s step-end infinite;
}

@keyframes cf-h3-v6-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.cf-header-03-v6-nav {
  display: none;
  align-items: center;
  gap: 25px;
}

.cf-header-03-v6-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: 0.2s;
  position: relative;
}

.cf-header-03-v6-nav a:hover {
  color: {{ section.settings.accent_color }};
}

.cf-header-03-v6-nav a::before {
  content: './';
  color: {{ section.settings.border_color }};
  opacity: 0.5;
  transition: 0.2s;
}

.cf-header-03-v6-nav a:hover::before {
  color: {{ section.settings.accent_color }};
  opacity: 1;
}

.cf-header-03-v6-actions {
  display: flex;
  gap: 15px;
}

.cf-header-03-v6-actions a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  transition: 0.2s;
}
.cf-header-03-v6-actions a:hover {
  color: {{ section.settings.accent_color }};
}
.cf-header-03-v6-actions svg {
  width: 20px; height: 20px;
}

@media (min-width: 768px) {
  .cf-header-03-v6-nav { display: flex; }
  .cf-header-03-v6-inner { padding: {{ section.settings.padding_y }}px 40px; }
}
</style>

<div class="cf-header-03-v6">
  <div class="cf-header-03-v6-topbar">
    <div class="cf-header-03-v6-dots">
      <div class="cf-header-03-v6-dot cf-header-03-v6-dot-r"></div>
      <div class="cf-header-03-v6-dot cf-header-03-v6-dot-y"></div>
      <div class="cf-header-03-v6-dot cf-header-03-v6-dot-g"></div>
    </div>
    <div class="cf-header-03-v6-title">{{ section.settings.top_title }}</div>
    <div style="width: 52px;"></div> <!-- Spacer -->
  </div>

  <div class="cf-header-03-v6-inner">
    <a href="/" class="cf-header-03-v6-logo">{{ section.settings.logo_text }}</a>
    
    <nav class="cf-header-03-v6-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title | downcase }}</a>
      {% endfor %}
    </nav>

    <div class="cf-header-03-v6-actions">
      <a href="/search" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <a href="/cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Terminal Window",
  "settings": [
    {
      "type": "text",
      "id": "top_title",
      "label": "Terminal Title",
      "default": "bash - 80x24"
    },
    {
      "type": "color",
      "id": "title_bar_bg",
      "label": "Title Bar BG",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "title_bar_text",
      "label": "Title Text",
      "default": "#aaaaaa"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "store"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo Size",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#1e1e1e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#d4d4d4"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Terminal Green Accent",
      "default": "#4af626"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 1000,
      "max": 1800,
      "step": 100,
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "06 · Terminal Window Head"
    }
  ]
}
{% endschema %}
