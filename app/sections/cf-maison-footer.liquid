<style>
  .cf-maison-footer {
    --bg: #1a1a1a;
    --text: #f5f2ec;
    --border: #333;
    --font-serif: 'Cormorant Garamond', serif;
    --font-mono: 'DM Mono', monospace;
    background: var(--bg);
    color: var(--text);
    padding: 6rem 5% 2rem;
  }
  .cf-maison-footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 6rem;
  }
  .cf-maison-footer-brand { max-width: 400px; }
  .cf-maison-footer-logo {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 300;
    font-style: italic;
    margin-bottom: 1.5rem;
    display: block;
    text-decoration: none;
    color: var(--text);
  }
  .cf-maison-footer-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    color: #999;
  }
  .cf-maison-footer-links {
    display: flex;
    gap: 4rem;
  }
  .cf-maison-footer-col { display: flex; flex-direction: column; gap: 1rem; }
  .cf-maison-footer-col span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin-bottom: 1rem;
  }
  .cf-maison-footer-col a {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--text);
    transition: color 0.3s ease;
  }
  .cf-maison-footer-col a:hover { color: #999; }
  .cf-maison-footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 900px) {
    .cf-maison-footer-top { flex-direction: column; gap: 4rem; }
    .cf-maison-footer-links { width: 100%; justify-content: space-between; }
  }
  @media (max-width: 600px) {
    .cf-maison-footer-links { flex-direction: column; gap: 2rem; }
    .cf-maison-footer-bottom { flex-direction: column; gap: 1rem; align-items: center; text-align: center; }
  }
</style>

<div class="cf-maison-footer">
  <div class="cf-maison-footer-top">
    <div class="cf-maison-footer-brand">
      <a href="{{ routes.root_url }}" class="cf-maison-footer-logo">{{ section.settings.logo_text | default: 'Maison' }}</a>
      <p class="cf-maison-footer-text">{{ section.settings.text | default: 'A digital space for analog living.<br>Objects of permanence.' }}</p>
    </div>
    <div class="cf-maison-footer-links">
      <div class="cf-maison-footer-col">
        <span>Explore</span>
        <a href="{{ routes.collections_url }}">Shop</a>
        <a href="/pages/about">Journal</a>
        <a href="/collections/all">Archives</a>
      </div>
      <div class="cf-maison-footer-col">
        <span>Support</span>
        <a href="/pages/contact">Contact</a>
        <a href="/pages/shipping">Shipping</a>
        <a href="/pages/returns">Returns</a>
      </div>
      <div class="cf-maison-footer-col">
        <span>Social</span>
        <a href="#">Instagram</a>
        <a href="#">Pinterest</a>
        <a href="#">Newsletter</a>
      </div>
    </div>
  </div>
  <div class="cf-maison-footer-bottom">
    <span>&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All Rights Reserved.</span>
    <span>Designed by ConvertFlow AI</span>
  </div>
</div>

{% schema %}
{
  "name": "Maison Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "Maison"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A digital space for analog living.<br>Objects of permanence."
    }
  ],
  "presets": [
    {
      "name": "Maison Footer"
    }
  ]
}
{% endschema %}
