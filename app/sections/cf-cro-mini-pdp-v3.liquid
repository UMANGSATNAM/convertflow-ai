<style>
.cf-cro-pdp3{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-pdp3-inner{max-width:1200px;margin:0 auto}
.cf-cro-pdp3-hero{position:relative;border-radius:24px;overflow:hidden;min-height:500px;display:flex;align-items:flex-end}
.cf-cro-pdp3-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.cf-cro-pdp3-hero>div.ph{position:absolute;inset:0;background:linear-gradient(135deg,{{ section.settings.accent_color }}20,{{ section.settings.accent_color }}08)}
.cf-cro-pdp3-overlay{position:absolute;inset:0;background:linear-gradient(0deg,{{ section.settings.bg_color }} 0%,transparent 60%)}
.cf-cro-pdp3-content{position:relative;z-index:1;width:100%;padding:40px 36px;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end}
.cf-cro-pdp3-info{display:flex;flex-direction:column;gap:8px}
.cf-cro-pdp3-badge{display:inline-flex;align-items:center;gap:6px;background:{{ section.settings.accent_color }};color:#fff;padding:6px 14px;border-radius:8px;font-size:11px;font-weight:700;width:fit-content;text-transform:uppercase;letter-spacing:0.05em}
.cf-cro-pdp3-name{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};line-height:1.2}
.cf-cro-pdp3-stars{color:#F59E0B;font-size:16px}
.cf-cro-pdp3-stars small{color:{{ section.settings.text_color }};opacity:0.5;font-size:13px;margin-left:6px}
.cf-cro-pdp3-desc{font-size:15px;color:{{ section.settings.text_color }};opacity:0.7;max-width:500px;line-height:1.6}
.cf-cro-pdp3-buy{display:flex;flex-direction:column;align-items:flex-end;gap:12px}
.cf-cro-pdp3-price{display:flex;align-items:baseline;gap:10px}
.cf-cro-pdp3-price b{font-size:32px;font-weight:900;color:{{ section.settings.text_color }}}
.cf-cro-pdp3-price s{font-size:18px;color:{{ section.settings.text_color }};opacity:0.35}
.cf-cro-pdp3-btn{padding:16px 40px;background:{{ section.settings.accent_color }};color:#fff;border-radius:12px;font-size:16px;font-weight:700;text-decoration:none;transition:0.2s;box-shadow:0 4px 14px {{ section.settings.accent_color }}40;white-space:nowrap}
.cf-cro-pdp3-btn:hover{transform:translateY(-2px)}
.cf-cro-pdp3-trust{display:flex;gap:16px;justify-content:flex-end}
.cf-cro-pdp3-trust span{font-size:11px;color:{{ section.settings.text_color }};opacity:0.4}
@media(max-width:768px){.cf-cro-pdp3-content{grid-template-columns:1fr;text-align:center}.cf-cro-pdp3-buy{align-items:center}.cf-cro-pdp3-trust{justify-content:center}}
</style>

<div class="cf-cro-pdp3">
  <div class="cf-cro-pdp3-inner">
    <div class="cf-cro-pdp3-hero">
      {% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.product_name }}" loading="lazy">{% else %}<div class="ph"></div>{% endif %}
      <div class="cf-cro-pdp3-overlay"></div>
      <div class="cf-cro-pdp3-content">
        <div class="cf-cro-pdp3-info">
          <div class="cf-cro-pdp3-badge">{{ section.settings.badge }}</div>
          <div class="cf-cro-pdp3-name">{{ section.settings.product_name }}</div>
          <div class="cf-cro-pdp3-stars">★★★★★ <small>{{ section.settings.rating }} ({{ section.settings.reviews }})</small></div>
          <p class="cf-cro-pdp3-desc">{{ section.settings.description }}</p>
        </div>
        <div class="cf-cro-pdp3-buy">
          <div class="cf-cro-pdp3-price"><b>{{ section.settings.price }}</b>{% if section.settings.compare != blank %}<s>{{ section.settings.compare }}</s>{% endif %}</div>
          <a href="{{ section.settings.cta_link }}" class="cf-cro-pdp3-btn">{{ section.settings.cta_text }}</a>
          <div class="cf-cro-pdp3-trust"><span>🔒 Secure</span><span>🚚 Free Ship</span><span>↩ 30-Day</span></div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Product Showcase v3",
  "settings": [
    {"type":"image_picker","id":"image","label":"Product Image"},
    {"type":"text","id":"badge","label":"Badge","default":"BEST SELLER"},
    {"type":"text","id":"product_name","label":"Product Name","default":"Ultra Performance Sneaker"},
    {"type":"text","id":"rating","label":"Rating","default":"4.9"},
    {"type":"text","id":"reviews","label":"Reviews","default":"5,200+"},
    {"type":"textarea","id":"description","label":"Description","default":"Engineered for all-day comfort with our patented CloudFoam sole. Looks sharp, feels amazing."},
    {"type":"text","id":"price","label":"Price","default":"$129.99"},
    {"type":"text","id":"compare","label":"Compare Price","default":"$199.99"},
    {"type":"text","id":"cta_text","label":"CTA","default":"Add to Cart →"},
    {"type":"text","id":"cta_link","label":"CTA Link","default":"/cart/add"},
    {"type":"color","id":"bg_color","label":"Background","default":"#f5f5f5"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Padding","min":20,"max":100,"step":10,"default":40}
  ],
  "presets": [{"name":"CRO · Product Showcase v3"}]
}
{% endschema %}
