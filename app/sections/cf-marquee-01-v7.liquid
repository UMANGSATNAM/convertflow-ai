<style>
.cf-marquee-01-v7{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 0}
.cf-marquee-01-v7-track{display:flex;white-space:nowrap;animation:cf-marquee-01-v7-scroll {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v7-item{display:inline-flex;align-items:center;padding:0 30px}
.cf-marquee-01-v7-text{font-family:serif;font-size:clamp(40px, 8vw, 100px);font-weight:400;letter-spacing:0.1em;text-transform:uppercase;color:transparent;-webkit-text-stroke:1px {{ section.settings.text_color }}}
.cf-marquee-01-v7-separator{margin:0 40px;width:15px;height:15px;background:{{ section.settings.text_color }};transform:rotate(45deg);opacity:0.6}
@keyframes cf-marquee-01-v7-scroll{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-01-v7">
  <div class="cf-marquee-01-v7-track">
    {% for j in (1..3) %}
      {% for i in (1..3) %}
        <div class="cf-marquee-01-v7-item">
          <span class="cf-marquee-01-v7-text">{{ section.settings.text }}</span>
          <span class="cf-marquee-01-v7-separator"></span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v7)",
  "settings": [
    {"type":"text","id":"text","label":"Marquee Text","default":"SIGNATURE COLLECTION"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":50},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text & Outline Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":150,"step":10,"default":80}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v7)"}]
}
{% endschema %}
