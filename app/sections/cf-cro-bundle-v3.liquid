<style>
.cf-cro-bun3{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-bun3-inner{max-width:1000px;margin:0 auto}
.cf-cro-bun3-head{text-align:center;margin-bottom:32px}
.cf-cro-bun3 h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-bun3-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-cro-bun3-card{background:#fff;border:2px solid {{ section.settings.accent_color }}15;border-radius:24px;padding:32px;display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:center;box-shadow:0 4px 20px rgba(0,0,0,0.04)}
.cf-cro-bun3-products{display:flex;gap:8px}
.cf-cro-bun3-img{width:100px;height:100px;border-radius:16px;overflow:hidden;background:{{ section.settings.text_color }}04;display:flex;align-items:center;justify-content:center;font-size:32px}
.cf-cro-bun3-img img{width:100%;height:100%;object-fit:cover}
.cf-cro-bun3-details{display:flex;flex-direction:column;gap:8px}
.cf-cro-bun3-tag{font-size:12px;font-weight:700;color:{{ section.settings.accent_color }};text-transform:uppercase;letter-spacing:0.06em}
.cf-cro-bun3-name{font-size:18px;font-weight:700;color:{{ section.settings.text_color }}}
.cf-cro-bun3-items{font-size:14px;color:{{ section.settings.text_color }};opacity:0.6;line-height:1.6}
.cf-cro-bun3-right{display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.cf-cro-bun3-price b{font-size:28px;font-weight:900;color:{{ section.settings.accent_color }}}
.cf-cro-bun3-price s{font-size:16px;color:{{ section.settings.text_color }};opacity:0.35;margin-left:8px}
.cf-cro-bun3-save{background:{{ section.settings.accent_color }};color:#fff;padding:4px 12px;border-radius:100px;font-size:12px;font-weight:700}
.cf-cro-bun3-btn{padding:14px 32px;background:{{ section.settings.accent_color }};color:#fff;border-radius:10px;font-size:15px;font-weight:700;text-decoration:none;transition:0.2s;white-space:nowrap}
.cf-cro-bun3-btn:hover{opacity:0.9}
.cf-cro-bun3-perks{display:flex;justify-content:center;gap:24px;margin-top:20px;flex-wrap:wrap}
.cf-cro-bun3-perks span{font-size:13px;color:{{ section.settings.text_color }};opacity:0.5;display:flex;align-items:center;gap:4px}
@media(max-width:768px){.cf-cro-bun3-card{grid-template-columns:1fr;text-align:center}.cf-cro-bun3-products{justify-content:center}.cf-cro-bun3-right{align-items:center}}
</style>

<div class="cf-cro-bun3">
  <div class="cf-cro-bun3-inner">
    <div class="cf-cro-bun3-head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="cf-cro-bun3-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="cf-cro-bun3-card">
      <div class="cf-cro-bun3-products">
        {% if section.settings.img_1 != blank %}<div class="cf-cro-bun3-img"><img src="{{ section.settings.img_1 | image_url: width: 200 }}" alt="" loading="lazy"></div>{% else %}<div class="cf-cro-bun3-img"><svg width=\'32\' height=\'32\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><path d=\'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\'></path><polyline points=\'3.27 6.96 12 12.01 20.73 6.96\'></polyline><line x1=\'12\' y1=\'22.08\' x2=\'12\' y2=\'12\'></line></svg></div>{% endif %}
        {% if section.settings.img_2 != blank %}<div class="cf-cro-bun3-img"><img src="{{ section.settings.img_2 | image_url: width: 200 }}" alt="" loading="lazy"></div>{% else %}<div class="cf-cro-bun3-img"><svg width=\'32\' height=\'32\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><path d=\'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\'></path><polyline points=\'3.27 6.96 12 12.01 20.73 6.96\'></polyline><line x1=\'12\' y1=\'22.08\' x2=\'12\' y2=\'12\'></line></svg></div>{% endif %}
        {% if section.settings.img_3 != blank %}<div class="cf-cro-bun3-img"><img src="{{ section.settings.img_3 | image_url: width: 200 }}" alt="" loading="lazy"></div>{% else %}<div class="cf-cro-bun3-img"><svg width=\'32\' height=\'32\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><path d=\'M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\'></path><polyline points=\'3.27 6.96 12 12.01 20.73 6.96\'></polyline><line x1=\'12\' y1=\'22.08\' x2=\'12\' y2=\'12\'></line></svg></div>{% endif %}
      </div>
      <div class="cf-cro-bun3-details">
        <div class="cf-cro-bun3-tag">🎁 BUNDLE</div>
        <div class="cf-cro-bun3-name">{{ section.settings.bundle_name }}</div>
        <div class="cf-cro-bun3-items">{{ section.settings.item_list }}</div>
      </div>
      <div class="cf-cro-bun3-right">
        <div class="cf-cro-bun3-price"><b>{{ section.settings.price }}</b><s>{{ section.settings.orig }}</s></div>
        <div class="cf-cro-bun3-save">SAVE {{ section.settings.save_pct }}</div>
        <a href="{{ section.settings.cta_link }}" class="cf-cro-bun3-btn">{{ section.settings.cta_text }}</a>
      </div>
    </div>
    <div class="cf-cro-bun3-perks">
      <span>🚚 Free shipping</span><span>🔄 Easy returns</span><span>🔒 Secure checkout</span><span>⭐ 4.9/5 rated</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Compact Bundle v3",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Complete the Set & Save"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Our most popular combination — hand-picked by customers"},
    {"type":"image_picker","id":"img_1","label":"Product 1 Image"},
    {"type":"image_picker","id":"img_2","label":"Product 2 Image"},
    {"type":"image_picker","id":"img_3","label":"Product 3 Image"},
    {"type":"text","id":"bundle_name","label":"Bundle Name","default":"The Essentials Trio"},
    {"type":"textarea","id":"item_list","label":"Items List","default":"Daily Cleanser + Hydra Serum + Night Cream"},
    {"type":"text","id":"price","label":"Price","default":"$79.99"},
    {"type":"text","id":"orig","label":"Original","default":"$124.97"},
    {"type":"text","id":"save_pct","label":"Save %","default":"36%"},
    {"type":"text","id":"cta_text","label":"CTA","default":"Add Bundle"},
    {"type":"text","id":"cta_link","label":"Link","default":"/cart"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#E53E3E"},
    {"type":"range","id":"padding_y","label":"Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Compact Bundle v3"}]
}
{% endschema %}
