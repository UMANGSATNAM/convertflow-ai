<style>
  .cf-maison-hero {
    --bg-alt: #ece8e1;
    --text: #1a1a1a;
    --font-serif: 'Cormorant Garamond', serif;
    --font-mono: 'DM Mono', monospace;
    background: var(--bg-alt);
    height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 5%;
    position: relative;
    overflow: hidden;
  }
  .cf-maison-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 800px;
  }
  .cf-maison-hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    display: block;
  }
  .cf-maison-hero-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    color: var(--text);
  }
  .cf-maison-hero-title i { font-style: italic; }
  .cf-maison-hero-btn {
    display: inline-block;
    padding: 1rem 3rem;
    background: var(--text);
    color: #f5f2ec;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border: 1px solid var(--text);
    transition: all 0.3s ease;
  }
  .cf-maison-hero-btn:hover { background: transparent; color: var(--text); }
  .cf-maison-hero-img-left, .cf-maison-hero-img-right {
    position: absolute;
    width: 25vw;
    height: 40vw;
    max-width: 300px;
    max-height: 450px;
    object-fit: cover;
    z-index: 1;
    filter: grayscale(20%) contrast(110%);
  }
  .cf-maison-hero-img-left { left: 5%; top: 15%; }
  .cf-maison-hero-img-right { right: 5%; bottom: 10%; }

  @media (max-width: 768px) {
    .cf-maison-hero-img-left, .cf-maison-hero-img-right { display: none; }
    .cf-maison-hero { height: 70vh; }
  }
</style>

<div class="cf-maison-hero">
  {% if section.settings.image_left %}
    <img src="{{ section.settings.image_left | img_url: '600x' }}" alt="Hero left" class="cf-maison-hero-img-left">
  {% else %}
    <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&q=80" alt="Fashion" class="cf-maison-hero-img-left">
  {% endif %}
  
  <div class="cf-maison-hero-content">
    <span class="cf-maison-hero-kicker">{{ section.settings.kicker | default: 'Maison Collection 01' }}</span>
    <h1 class="cf-maison-hero-title">{{ section.settings.title | default: 'Elevated <i>Essentials</i><br>for Modern Living' }}</h1>
    <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="cf-maison-hero-btn">{{ section.settings.button_label | default: 'Discover the Edit' }}</a>
  </div>

  {% if section.settings.image_right %}
    <img src="{{ section.settings.image_right | img_url: '600x' }}" alt="Hero right" class="cf-maison-hero-img-right">
  {% else %}
    <img src="https://images.unsplash.com/photo-1618220179428-22790b46a0eb?w=800&q=80" alt="Interior" class="cf-maison-hero-img-right">
  {% endif %}
</div>

{% schema %}
{
  "name": "Maison Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Maison Collection 01"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title (HTML allowed)",
      "default": "Elevated <i>Essentials</i><br>for Modern Living"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Discover the Edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right Image"
    }
  ],
  "presets": [
    {
      "name": "Maison Hero"
    }
  ]
}
{% endschema %}
