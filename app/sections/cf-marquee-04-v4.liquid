<style>
.cf-mq-04-v4 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-mq-04-v4-track {
  display: inline-flex;
  animation: cf-mq-04-v4-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v4-item {
  display: inline-flex;
  align-items: center;
  padding: 0 40px;
  font-size: {{ section.settings.font_size }}px;
  font-weight: 600;
  letter-spacing: -0.01em;
}

.cf-mq-04-v4-stat {
  color: {{ section.settings.accent_color }};
  font-weight: 800;
  margin-right: 8px;
}

.cf-mq-04-v4-icon {
  margin: 0 40px;
  color: {{ section.settings.border_color }};
  display: flex;
  align-items: center;
}

.cf-mq-04-v4-icon svg {
  width: 20px; height: 20px; stroke-width: 2.5;
}

@keyframes cf-mq-04-v4-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v4">
  <div class="cf-mq-04-v4-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v4-item">
          {% if block.settings.stat != blank %}
            <span class="cf-mq-04-v4-stat">{{ block.settings.stat }}</span>
          {% endif %}
          <span>{{ block.settings.text }}</span>
          <div class="cf-mq-04-v4-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "04 · Clinical Stats",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f0fdf4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"accent_color","label":"Accent Color (Number)","default":"#16a34a"},
    {"type":"color","id":"border_color","label":"Checkmark Color","default":"#86efac"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":30,"step":2,"default":16},
    {"type":"range","id":"font_size","label":"Font Size","min":14,"max":24,"step":1,"default":16},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":2,"default":25}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Stat Block",
      "settings": [
        {"type":"text","id":"stat","label":"Number/Stat","default":"99%"},
        {"type":"text","id":"text","label":"Text","default":"Clinically Proven"}
      ]
    }
  ],
  "presets": [
    {
      "name": "04 · Clinical Stats",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
