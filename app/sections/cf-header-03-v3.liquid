<style>
.cf-header-03-v3 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  border-bottom: 2px solid {{ section.settings.neon_color }};
  box-shadow: 0 4px 15px {{ section.settings.neon_color }}40;
  position: relative;
  z-index: 100;
}

.cf-header-03-v3-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  gap: 20px;
}

.cf-header-03-v3-logo {
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: {{ section.settings.logo_size }}px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  text-transform: uppercase;
  text-shadow: 0 0 8px {{ section.settings.neon_color }}80;
}

.cf-header-03-v3-search {
  flex: 1;
  max-width: 500px;
  display: none;
  position: relative;
}

.cf-header-03-v3-search::before {
  content: '>';
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: {{ section.settings.neon_color }};
  font-family: monospace;
  font-weight: bold;
}

.cf-header-03-v3-search input {
  width: 100%;
  background: #000;
  border: 1px solid {{ section.settings.neon_color }}60;
  color: {{ section.settings.text_color }};
  padding: 12px 15px 12px 35px;
  border-radius: 4px;
  font-family: inherit;
  font-size: 14px;
  outline: none;
  transition: box-shadow 0.2s, border-color 0.2s;
}

.cf-header-03-v3-search input:focus {
  border-color: {{ section.settings.neon_color }};
  box-shadow: 0 0 10px {{ section.settings.neon_color }}40 inset;
}

.cf-header-03-v3-nav {
  display: flex;
  align-items: center;
  gap: 15px;
}

.cf-header-03-v3-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 14px;
  text-transform: uppercase;
  font-weight: bold;
  opacity: 0.8;
  padding: 8px 12px;
  border-radius: 4px;
  transition: 0.2s;
}

.cf-header-03-v3-nav a:hover {
  opacity: 1;
  background: {{ section.settings.neon_color }}20;
  color: {{ section.settings.neon_color }};
}

.cf-header-03-v3-icons {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cf-header-03-v3-icons a {
  color: {{ section.settings.text_color }};
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px; height: 40px;
  border-radius: 4px;
  background: #000;
  border: 1px solid #333;
  transition: 0.2s;
}

.cf-header-03-v3-icons a:hover {
  border-color: {{ section.settings.neon_color }};
  color: {{ section.settings.neon_color }};
  box-shadow: 0 0 10px {{ section.settings.neon_color }}40;
}

.cf-header-03-v3-icons svg {
  width: 18px; height: 18px;
}

@media (min-width: 768px) {
  .cf-header-03-v3-inner { padding: {{ section.settings.padding_y }}px 40px; }
  .cf-header-03-v3-search { display: block; }
}
@media (max-width: 1024px) {
  .cf-header-03-v3-nav { display: none; }
}
</style>

<header class="cf-header-03-v3">
  <div class="cf-header-03-v3-inner">
    <a href="/" class="cf-header-03-v3-logo">{{ section.settings.logo_text }}</a>
    
    <div class="cf-header-03-v3-search">
      <form action="/search" method="get">
        <input type="text" name="q" placeholder="{{ section.settings.search_placeholder }}">
      </form>
    </div>

    <nav class="cf-header-03-v3-nav">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="cf-header-03-v3-icons">
      <a href="/account" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "03 · Neon Cyber Deck",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"CYBER_DECK"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":16,"max":48,"step":2,"default":28},
    {"type":"text","id":"search_placeholder","label":"Search Placeholder","default":"Initialize search protocol..."},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#080808"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"neon_color","label":"Neon Accent","default":"#0ff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1800,"step":100,"default":1400}
  ],
  "presets": [{"name":"03 · Neon Cyber Deck"}]
}
{% endschema %}
