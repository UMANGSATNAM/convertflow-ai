<style>
.cf-tb-04-v10 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-tb-04-v10-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}
.cf-tb-04-v10-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols }}, 1fr);
  gap: 20px;
}
.cf-tb-04-v10-item {
  display: flex;
  align-items: flex-start;
  gap: 15px;
  background: #fff;
  border: 1px solid {{ section.settings.border_color }};
  border-top: 3px solid {{ section.settings.accent_color }};
  border-radius: 4px;
  padding: 20px;
  transition: box-shadow 0.2s;
}
.cf-tb-04-v10-item:hover {
  box-shadow: 0 5px 15px rgba(0,0,0,0.06);
}
.cf-tb-04-v10-icon-wrap {
  background: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  color: {{ section.settings.accent_color }};
  width: 44px; height: 44px;
  border-radius: 4px;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.cf-tb-04-v10-icon-wrap svg { width: 22px; height: 22px; stroke-width: 2; }
.cf-tb-04-v10-content {}
.cf-tb-04-v10-title {
  color: {{ section.settings.text_color }};
  font-size: 15px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 5px 0;
}
.cf-tb-04-v10-desc {
  color: #64748b;
  font-size: 13px;
  margin: 0;
  line-height: 1.5;
}
@media (max-width: 900px) { .cf-tb-04-v10-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 500px) { .cf-tb-04-v10-grid { grid-template-columns: 1fr; } }
</style>

<div class="cf-tb-04-v10">
  <div class="cf-tb-04-v10-inner">
    <div class="cf-tb-04-v10-grid">
      {% for block in section.blocks %}
        <div class="cf-tb-04-v10-item">
          <div class="cf-tb-04-v10-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="cf-tb-04-v10-content">
            <h4 class="cf-tb-04-v10-title">{{ block.settings.title }}</h4>
            <p class="cf-tb-04-v10-desc">{{ block.settings.desc }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "10 · Med-Tech Badges",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f8fafc"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"accent_color","label":"Accent Color (Blue)","default":"#1d4ed8"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},
    {"type":"range","id":"cols","label":"Columns","min":2,"max":4,"step":1,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge", "name": "Badge", "limit": 4,
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"ISO Certified"},
        {"type":"text","id":"desc","label":"Description","default":"Meets international standards"}
      ]
    }
  ],
  "presets": [{"name": "10 · Med-Tech Badges","blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]}]
}
{% endschema %}
