<style>
.cf-fc-04-v8 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.cf-fc-04-v8-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-04-v8-header {
  text-align: center;
  margin-bottom: 60px;
}

.cf-fc-04-v8-title {
  color: {{ section.settings.text_color }};
  font-size: 40px;
  font-weight: 300;
  letter-spacing: 0.05em;
  margin: 0 0 15px 0;
}

.cf-fc-04-v8-subtitle {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  opacity: 0.6;
}

.cf-fc-04-v8-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 40px;
}

.cf-fc-04-v8-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  text-align: center;
}

.cf-fc-04-v8-image-wrap {
  width: 100%;
  aspect-ratio: 3/4;
  position: relative;
  margin-bottom: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cf-fc-04-v8-image-wrap::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 90%; height: 90%;
  border-radius: 50%;
  background: {{ section.settings.accent_color }};
  filter: blur(25px);
  opacity: 0;
  transition: opacity 0.5s, width 0.5s, height 0.5s;
}

.cf-fc-04-v8-card:hover .cf-fc-04-v8-image-wrap::before {
  opacity: 0.6;
  width: 105%; height: 105%;
}

.cf-fc-04-v8-image-wrap img {
  width: 90%; height: 90%;
  object-fit: cover;
  border-radius: 100px 100px 0 0;
  position: relative;
  z-index: 1;
  transition: transform 0.6s ease;
}

.cf-fc-04-v8-card:hover .cf-fc-04-v8-image-wrap img {
  transform: scale(1.03);
}

.cf-fc-04-v8-name {
  color: {{ section.settings.text_color }};
  font-size: 18px;
  font-weight: 400;
  letter-spacing: 0.1em;
  margin: 0 0 5px 0;
}

.cf-fc-04-v8-price {
  color: {{ section.settings.text_color }};
  opacity: 0.7;
  font-size: 14px;
  letter-spacing: 0.05em;
}

.cf-fc-04-v8-footer {
  text-align: center;
  margin-top: 50px;
}

.cf-fc-04-v8-btn {
  display: inline-block;
  background-color: transparent;
  color: {{ section.settings.text_color }};
  border: 1px solid {{ section.settings.text_color }};
  padding: 14px 40px;
  border-radius: 50px;
  text-decoration: none;
  font-size: 13px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: all 0.3s;
}

.cf-fc-04-v8-btn:hover {
  background-color: {{ section.settings.text_color }};
  color: {{ section.settings.bg_color }};
}

@media (max-width: 900px) {
  .cf-fc-04-v8-grid { grid-template-columns: repeat(2, 1fr); gap: 30px; }
}
@media (max-width: 600px) {
  .cf-fc-04-v8-grid { grid-template-columns: repeat(2, 1fr); gap: 15px;}
  .cf-fc-04-v8-title { font-size: 30px; }
}
</style>

<div class="cf-fc-04-v8">
  <div class="cf-fc-04-v8-inner">
    <div class="cf-fc-04-v8-header">
      <h2 class="cf-fc-04-v8-title">{{ section.settings.title }}</h2>
      <div class="cf-fc-04-v8-subtitle">{{ section.settings.subtitle }}</div>
    </div>

    <div class="cf-fc-04-v8-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.url }}" class="cf-fc-04-v8-card">
          <div class="cf-fc-04-v8-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:90%;height:90%;border-radius:100px 100px 0 0;background:#e5e5e5;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;color:#999;">Image</div>
            {% endif %}
          </div>
          <h3 class="cf-fc-04-v8-name">{{ block.settings.title }}</h3>
          <div class="cf-fc-04-v8-price">{{ block.settings.price }}</div>
        </a>
      {% endfor %}
    </div>

    <div class="cf-fc-04-v8-footer">
      <a href="{{ section.settings.btn_link }}" class="cf-fc-04-v8-btn">{{ section.settings.btn_text }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "08 · Holistic Aura Collect",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F9F9F9"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#5B5B5B"},
    {"type":"color","id":"accent_color","label":"Glow Color","default":"#CBD5CF"},
    {"type":"text","id":"title","label":"Title","default":"Cultivate Balance"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Harmonious Blends"},
    {"type":"text","id":"btn_text","label":"Button Name","default":"Discover More"},
    {"type":"url","id":"btn_link","label":"Link"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":5,"step":1,"default":3},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1100}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Product Title","default":"Matcha Ritual"},
        {"type":"text","id":"price","label":"Price","default":"$45.00"},
        {"type":"url","id":"url","label":"Product Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "08 · Holistic Products",
      "blocks": [{"type":"product"},{"type":"product"},{"type":"product"}]
    }
  ]
}
{% endschema %}
