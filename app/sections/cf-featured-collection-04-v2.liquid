<style>
.cf-fc-04-v2 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-fc-04-v2-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-fc-04-v2-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40px;
}

.cf-fc-04-v2-title {
  color: {{ section.settings.text_color }};
  font-size: 32px;
  font-weight: 700;
  margin: 0;
  letter-spacing: -0.02em;
}

.cf-fc-04-v2-link {
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  transition: opacity 0.2s;
}

.cf-fc-04-v2-link:hover { opacity: 0.8; }

.cf-fc-04-v2-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 30px;
}

.cf-fc-04-v2-card {
  background: #fff;
  border-radius: 12px;
  padding: 15px;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  transition: transform 0.3s, box-shadow 0.3s;
  display: flex;
  flex-direction: column;
}

.cf-fc-04-v2-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

.cf-fc-04-v2-image {
  width: 100%;
  aspect-ratio: 1;
  background: #f9fafb;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  margin-bottom: 20px;
}

.cf-fc-04-v2-image img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.6s ease;
}

.cf-fc-04-v2-card:hover .cf-fc-04-v2-image img {
  transform: scale(1.05);
}

.cf-fc-04-v2-badge {
  position: absolute;
  top: 10px; left: 10px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.cf-fc-04-v2-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.cf-fc-04-v2-name {
  color: {{ section.settings.text_color }};
  font-size: 16px;
  font-weight: 600;
  margin: 0 0 8px 0;
  line-height: 1.4;
}

.cf-fc-04-v2-price {
  color: #4b5563;
  font-size: 15px;
  font-weight: 500;
  margin-top: auto;
}

@media (max-width: 900px) {
  .cf-fc-04-v2-grid { grid-template-columns: repeat(2, 1fr); gap: 20px;}
}
@media (max-width: 600px) {
  .cf-fc-04-v2-header { flex-direction: column; align-items: flex-start; gap: 15px; }
  .cf-fc-04-v2-grid { grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .cf-fc-04-v2-title { font-size: 26px; }
}
</style>

<div class="cf-fc-04-v2">
  <div class="cf-fc-04-v2-inner">
    <div class="cf-fc-04-v2-header">
      <h2 class="cf-fc-04-v2-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-fc-04-v2-link">{{ section.settings.btn_text }} &rarr;</a>
    </div>

    <div class="cf-fc-04-v2-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.url }}" class="cf-fc-04-v2-card">
          <div class="cf-fc-04-v2-image">
            {% if block.settings.badge != blank %}
              <div class="cf-fc-04-v2-badge">{{ block.settings.badge }}</div>
            {% endif %}
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#9ca3af;">Product Image</div>
            {% endif %}
          </div>
          <div class="cf-fc-04-v2-info">
            <h3 class="cf-fc-04-v2-name">{{ block.settings.title }}</h3>
            <div class="cf-fc-04-v2-price">{{ block.settings.price }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "02 · Minimal Collection",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#f9fafb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111827"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#10b981"},
    {"type":"text","id":"title","label":"Title","default":"Daily Essentials"},
    {"type":"text","id":"btn_text","label":"View All Link","default":"Shop All Products"},
    {"type":"url","id":"btn_link","label":"Link"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Product Title","default":"Daily Multivitamin"},
        {"type":"text","id":"price","label":"Price","default":"$29.00"},
        {"type":"text","id":"badge","label":"Badge","default":"Bestseller"},
        {"type":"url","id":"url","label":"Product Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "02 · Minimal Wellness Products",
      "blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]
    }
  ]
}
{% endschema %}
