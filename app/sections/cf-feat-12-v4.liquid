<style>
.cf-feat-12-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-12-v4-inner{max-width:1400px;margin:0 auto}
.cf-feat-12-v4-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:50px}
.cf-feat-12-v4-title{font-size:clamp(32px, 4vw, 56px);font-family:serif;font-weight:400;margin:0;line-height:1}
.cf-feat-12-v4-link{font-size:12px;text-transform:uppercase;letter-spacing:0.1em;font-weight:600;color:{{ section.settings.text_color }};text-decoration:none;border-bottom:1px solid {{ section.settings.text_color }};padding-bottom:4px;transition:0.3s}
.cf-feat-12-v4-link:hover{color:{{ section.settings.accent_color }};border-color:{{ section.settings.accent_color }}}
.cf-feat-12-v4-grid{display:grid;grid-template-columns:repeat(3, 1fr);gap:30px}
.cf-feat-12-v4-card{text-decoration:none;display:block;group;position:relative}
.cf-feat-12-v4-img-wrap{width:100%;aspect-ratio:4/5;background:#f0f0f0;overflow:hidden;border-radius:{{ section.settings.border_radius }}px;position:relative}
.cf-feat-12-v4-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-feat-12-v4-img-alt{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:0.5s}
.cf-feat-12-v4-card:hover .cf-feat-12-v4-img-alt{opacity:1}
.cf-feat-12-v4-info{padding:20px 0;text-align:center}
.cf-feat-12-v4-title-product{font-family:serif;font-size:20px;font-style:italic;color:{{ section.settings.text_color }};margin:0 0 10px 0}
.cf-feat-12-v4-price{font-size:13px;font-weight:600;color:{{ section.settings.accent_color }};margin:0}
@media(max-width:900px){.cf-feat-12-v4-grid{grid-template-columns:repeat(2, 1fr)}}
@media(max-width:600px){.cf-feat-12-v4-grid{grid-template-columns:1fr}.cf-feat-12-v4-header{flex-direction:column;align-items:flex-start;gap:20px}}
</style>

<div class="cf-feat-12-v4">
  <div class="cf-feat-12-v4-inner">
    <div class="cf-feat-12-v4-header">
      <h2 class="cf-feat-12-v4-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-feat-12-v4-link">{{ section.settings.btn_label }}</a>
    </div>
    
    <div class="cf-cat-12-v4-grid" style="display:grid;grid-template-columns:repeat(3, 1fr);gap:30px">
      {% for i in (1..3) %}
        <a href="#" class="cf-feat-12-v4-card">
          <div class="cf-feat-12-v4-img-wrap">
            <div class="cf-feat-12-v4-img" style="background:#e5e5e5;display:flex;align-items:center;justify-content:center;color:#999;">Front Image</div>
            <div class="cf-feat-12-v4-img-alt" style="background:#d8d8d8;display:flex;align-items:center;justify-content:center;color:#666;">Back Image Reveal</div>
          </div>
          <div class="cf-feat-12-v4-info">
            <h3 class="cf-feat-12-v4-title-product">Classic Knit Sweater</h3>
            <p class="cf-feat-12-v4-price">$120.00</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Featured (v4)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"Most Loved"},
    {"type":"text","id":"btn_label","label":"Link Label","default":"SHOP ALL BESTSELLERS"},
    {"type":"url","id":"btn_link","label":"Link URL"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover / Price Color","default":"#A88A70"},
    {"type":"range","id":"border_radius","label":"Image Rounding","min":0,"max":20,"step":2,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":10,"default":80}
  ],
  "presets": [{"name":"12 · Women's Featured (v4)"}]
}
{% endschema %}
