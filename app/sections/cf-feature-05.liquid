<style>
.cf-ft-05{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:'Georgia',serif}
.cf-ft-05-inner{max-width:1200px;margin:0 auto}
.cf-ft-05-header{text-align:center;margin-bottom:60px;position:relative}
.cf-ft-05-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};margin-bottom:15px;font-style:italic}
.cf-ft-05-sub{font-family:sans-serif;text-transform:uppercase;letter-spacing:0.1em;font-size:12px;color:#888;margin-bottom:10px}
.cf-ft-05-grid{display:grid;grid-template-columns:repeat({{ section.settings.cols }}, 1fr);gap:40px}
.cf-ft-05-card{text-decoration:none;display:flex;flex-direction:column;align-items:center;text-align:center;group}
.cf-ft-05-img-wrap{width:100%;aspect-ratio:3/4;border-radius:100px 100px 0 0;overflow:hidden;margin-bottom:24px;position:relative;background:#fcf8f7;box-shadow:0 15px 30px rgba(0,0,0,0.03)}
.cf-ft-05-img{width:100%;height:100%;object-fit:cover;transition:0.8s filter, 0.8s transform;filter:brightness(0.95)}
.cf-ft-05-card:hover .cf-ft-05-img{transform:scale(1.05);filter:brightness(1)}
.cf-ft-05-name{font-size:18px;color:{{ section.settings.text_color }};margin-bottom:8px}
.cf-ft-05-price{font-family:sans-serif;font-weight:600;color:{{ section.settings.accent_color }};font-size:15px;margin-bottom:20px}
.cf-ft-05-btn{display:inline-block;padding:12px 30px;background:#fff;border:1px solid {{ section.settings.accent_color }};color:{{ section.settings.accent_color }};border-radius:30px;font-family:sans-serif;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;transition:0.3s;max-width:200px;width:100%}
.cf-ft-05-card:hover .cf-ft-05-btn{background:{{ section.settings.accent_color }};color:#fff}
@media(max-width:900px){.cf-ft-05-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.cf-ft-05-grid{grid-template-columns:1fr}}
</style>

<div class="cf-ft-05">
  <div class="cf-ft-05-inner">
    <div class="cf-ft-05-header">
      <div class="cf-ft-05-sub">{{ section.settings.subtitle }}</div>
      <h2 class="cf-ft-05-title">{{ section.settings.title }}</h2>
    </div>
    
    <div class="cf-ft-05-grid">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="cf-ft-05-card">
            <div class="cf-ft-05-img-wrap">
              <img class="cf-ft-05-img" src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title }}">
            </div>
            <div class="cf-ft-05-name">{{ product.title }}</div>
            <div class="cf-ft-05-price">{{ product.price | money }}</div>
            <div class="cf-ft-05-btn">Quick Add</div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <a href="#" class="cf-ft-05-card">
            <div class="cf-ft-05-img-wrap">
               <div style="width:100%;height:100%;background:#f4ecea;display:flex;align-items:center;justify-content:center;color:#b19d98;font-family:sans-serif;font-size:12px;letter-spacing:0.1em;text-transform:uppercase">Cosmetics</div>
            </div>
            <div class="cf-ft-05-name">Radiant Serum {{ i }}</div>
            <div class="cf-ft-05-price">$48.00</div>
            <div class="cf-ft-05-btn">Quick Add</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "05 · Beauty Picks",
  "settings": [
    {"type":"text","id":"subtitle","label":"Subtitle","default":"CULT FAVORITES"},
    {"type":"text","id":"title","label":"Title","default":"Shop the Classics"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":64,"step":2,"default":42},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product Limit","min":2,"max":12,"step":1,"default":3},
    {"type":"range","id":"cols","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":3},
    {"type":"color","id":"bg_color","label":"Background","default":"#fffbfb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4a3c31"},
    {"type":"color","id":"accent_color","label":"Accent on Hover","default":"#d4aba0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"05 · Beauty Picks"}]
}
{% endschema %}
