<style>
.cf-head-01{position:absolute;top:0;left:0;width:100%;z-index:100;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;display:flex;align-items:center;justify-content:space-between;transition:0.3s}
.cf-head-01.scrolled{position:fixed;background:{{ section.settings.bg_scrolled }};box-shadow:0 10px 30px rgba(0,0,0,0.05)}
.cf-head-01-logo{font-family:'Playfair Display',serif;font-size:clamp(20px,2vw,{{ section.settings.logo_size }}px);font-weight:600;color:{{ section.settings.text_color }};text-decoration:none;letter-spacing:0.05em;text-transform:uppercase}
.cf-head-01-nav{display:none;align-items:center;gap:32px}
.cf-head-01-link{font-size:13px;font-weight:500;color:{{ section.settings.text_color }};text-decoration:none;letter-spacing:0.1em;text-transform:uppercase;position:relative}
.cf-head-01-link::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:{{ section.settings.text_color }};transition:0.3s}
.cf-head-01-link:hover::after{width:100%}
.cf-head-01-icons{display:flex;align-items:center;gap:16px;color:{{ section.settings.text_color }}}
.cf-head-01-icons a{color:inherit;text-decoration:none;transition:0.2s}
.cf-head-01-icons a:hover{opacity:0.6}
@media(min-width:1024px){.cf-head-01-nav{display:flex}.cf-head-01{padding:{{ section.settings.padding_y }}px 60px}}
</style>

<header class="cf-head-01" id="cf-head-01-{{ section.id }}">
  <div class="cf-head-01-nav">
    <a href="{{ section.settings.link_1_url }}" class="cf-head-01-link">{{ section.settings.link_1 }}</a>
    <a href="{{ section.settings.link_2_url }}" class="cf-head-01-link">{{ section.settings.link_2 }}</a>
  </div>
  <a href="/" class="cf-head-01-logo">{{ section.settings.logo_text }}</a>
  <div class="cf-head-01-icons">
    <a href="/search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></a>
    <a href="/account"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
    <a href="/cart"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></a>
  </div>
</header>
<script>
window.addEventListener('scroll',()=>document.getElementById('cf-head-01-{{ section.id }}').classList.toggle('scrolled',window.scrollY>50));
</script>

{% schema %}
{
  "name": "01 · Luxury Header",
  "settings": [
    {"type":"text","id":"logo_text","label":"Logo Text","default":"LUMINA"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":20,"max":48,"step":2,"default":28},
    {"type":"text","id":"link_1","label":"Link 1","default":"Collections"},
    {"type":"text","id":"link_1_url","label":"Link 1 URL","default":"/collections/all"},
    {"type":"text","id":"link_2","label":"Link 2","default":"Journal"},
    {"type":"text","id":"link_2_url","label":"Link 2 URL","default":"/blogs/news"},
    {"type":"color","id":"bg_color","label":"Background (Top)","default":"transparent"},
    {"type":"color","id":"bg_scrolled","label":"Background (Scrolled)","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text/Icon Color","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":12,"max":40,"step":2,"default":24}
  ],
  "presets": [{"name":"01 · Luxury Header"}]
}
{% endschema %}
