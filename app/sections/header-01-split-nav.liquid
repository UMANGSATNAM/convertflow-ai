{%- style -%}
  :root {
    --myapp-header-bg: {{ section.settings.bg_color }};
    --myapp-header-text: {{ section.settings.text_color }};
    --myapp-header-height-desktop: {{ section.settings.desktop_height }}px;
    --myapp-logo-width: {{ section.settings.logo_width }}px;
    --myapp-font-size: {{ section.settings.menu_font_size }}px;
  }

  .myapp-header-01 {
    background-color: var(--myapp-header-bg);
    color: var(--myapp-header-text);
    padding: 0 {{ section.settings.horizontal_padding }}px;
    position: {% if section.settings.sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: all 0.3s ease;
  }

  .myapp-header-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--myapp-header-height-desktop);
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .myapp-nav-left, .myapp-nav-right {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .myapp-nav-right { justify-content: flex-end; align-items: center; }

  .myapp-menu-item {
    text-decoration: none;
    color: inherit;
    font-size: var(--myapp-font-size);
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }

  .myapp-menu-item:hover { opacity: 0.7; }

  .myapp-logo-wrapper {
    display: flex;
    justify-content: center;
  }

  .myapp-logo-img {
    width: var(--myapp-logo-width);
    display: block;
  }

  .myapp-icon-group {
    display: flex;
    gap: 15px;
    margin-left: 20px;
  }

  .myapp-icon-link {
    color: inherit;
    width: 20px;
    display: flex;
    align-items: center;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .myapp-header-container {
      grid-template-columns: auto 1fr auto;
      height: 60px;
    }
    .myapp-nav-left { display: none; }
    .myapp-logo-wrapper { justify-content: flex-start; }
    .myapp-logo-img { width: {{ section.settings.logo_width_mobile }}px; }
  }
{%- endstyle -%}

<div class="myapp-header-01" data-section-id="{{ section.id }}">
  <div class="myapp-header-container">
    
    <nav class="myapp-nav-left">
      {% for link in linklists[section.settings.menu_left].links %}
        <a href="{{ link.url }}" class="myapp-menu-item">{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="myapp-logo-wrapper">
      <a href="/">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" 
               alt="{{ shop.name }}" 
               class="myapp-logo-img"
               loading="lazy">
        {% else %}
          <span style="font-weight: bold; font-size: 1.5rem;">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div class="myapp-nav-right">
      <nav class="myapp-nav-left" style="display: flex;">
        {% for link in linklists[section.settings.menu_right].links %}
          <a href="{{ link.url }}" class="myapp-menu-item">{{ link.title }}</a>
        {% endfor %}
      </nav>

      <div class="myapp-icon-group">
        {% if section.settings.show_search %}
          <a href="/search" class="myapp-icon-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </a>
        {% endif %}
        
        {% if section.settings.show_cart %}
          <a href="/cart" class="myapp-icon-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Header 01: Split Nav",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Header",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 60,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Header Height",
      "default": 80
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width (Desktop)",
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo Width (Mobile)",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Left Menu"
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Right Menu"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Menu Font Size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Colors & Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text/Icon Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    }
  ]
}
{% endschema %}
