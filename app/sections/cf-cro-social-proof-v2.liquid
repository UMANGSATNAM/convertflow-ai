<style>
.cf-cro-sp2{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;overflow:hidden}
.cf-cro-sp2-inner{max-width:1200px;margin:0 auto}
.cf-cro-sp2-head{text-align:center;margin-bottom:40px}
.cf-cro-sp2 h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-sp2-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6}
@keyframes cf-scroll2{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.cf-cro-sp2-track{display:flex;gap:24px;width:max-content;animation:cf-scroll2 {{ section.settings.speed }}s linear infinite}
.cf-cro-sp2-track:hover{animation-play-state:paused}
.cf-cro-sp2-card{flex-shrink:0;width:340px;background:#fff;border:1px solid {{ section.settings.text_color }}08;border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:16px;transition:0.3s}
.cf-cro-sp2-card:hover{box-shadow:0 12px 40px rgba(0,0,0,0.08)}
.cf-cro-sp2-top{display:flex;align-items:center;gap:12px}
.cf-cro-sp2-avatar{width:48px;height:48px;border-radius:50%;background:{{ section.settings.accent_color }}15;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:{{ section.settings.accent_color }}}
.cf-cro-sp2-meta{flex:1}
.cf-cro-sp2-name{font-size:14px;font-weight:700;color:{{ section.settings.text_color }}}
.cf-cro-sp2-date{font-size:12px;color:{{ section.settings.text_color }};opacity:0.4}
.cf-cro-sp2-stars{color:#F59E0B;font-size:14px;letter-spacing:2px}
.cf-cro-sp2-text{font-size:15px;line-height:1.7;color:{{ section.settings.text_color }};opacity:0.8}
.cf-cro-sp2-product{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;background:{{ section.settings.accent_color }}08;border-radius:10px;font-size:13px;color:{{ section.settings.accent_color }};font-weight:600}
</style>

<div class="cf-cro-sp2">
  <div class="cf-cro-sp2-inner">
    <div class="cf-cro-sp2-head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="cf-cro-sp2-sub">{{ section.settings.subheading }}</p>
    </div>
  </div>
  <div class="cf-cro-sp2-track">
    {%- for i in (1..6) -%}
      {%- assign idx = i | modulo: 3 | plus: 1 -%}
      {%- assign n_key = 'name_' | append: idx -%}
      {%- assign t_key = 'text_' | append: idx -%}
      {%- assign p_key = 'product_' | append: idx -%}
      {%- assign d_key = 'date_' | append: idx -%}
      <div class="cf-cro-sp2-card">
        <div class="cf-cro-sp2-top">
          <div class="cf-cro-sp2-avatar">{{ section.settings[n_key] | slice: 0 }}</div>
          <div class="cf-cro-sp2-meta">
            <div class="cf-cro-sp2-name">{{ section.settings[n_key] }}</div>
            <div class="cf-cro-sp2-date">{{ section.settings[d_key] }}</div>
          </div>
          <div class="cf-cro-sp2-stars">★★★★★</div>
        </div>
        <div class="cf-cro-sp2-text">"{{ section.settings[t_key] }}"</div>
        <div class="cf-cro-sp2-product">🛍 Purchased: {{ section.settings[p_key] }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "CRO · Reviews Carousel v2",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"What Customers Are Saying"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Hover to pause · Auto-scrolling testimonials"},
    {"type":"text","id":"name_1","label":"Name 1","default":"Alex T."},
    {"type":"text","id":"date_1","label":"Date 1","default":"2 days ago"},
    {"type":"textarea","id":"text_1","label":"Review 1","default":"Honestly blown away. The quality is 10x better than what I expected at this price point. Already bought a second one for my partner!"},
    {"type":"text","id":"product_1","label":"Product 1","default":"Signature Hoodie"},
    {"type":"text","id":"name_2","label":"Name 2","default":"Maya S."},
    {"type":"text","id":"date_2","label":"Date 2","default":"1 week ago"},
    {"type":"textarea","id":"text_2","label":"Review 2","default":"Fast shipping, gorgeous packaging, and the product itself is chef's kiss. This brand gets it. Will be a customer for life."},
    {"type":"text","id":"product_2","label":"Product 2","default":"Glow Serum"},
    {"type":"text","id":"name_3","label":"Name 3","default":"Jordan K."},
    {"type":"text","id":"date_3","label":"Date 3","default":"3 days ago"},
    {"type":"textarea","id":"text_3","label":"Review 3","default":"I was skeptical about buying online but this exceeded every expectation. The material is premium and the fit is perfect."},
    {"type":"text","id":"product_3","label":"Product 3","default":"Essential Tee"},
    {"type":"range","id":"speed","label":"Scroll Speed (sec)","min":15,"max":60,"step":5,"default":30},
    {"type":"color","id":"bg_color","label":"Background","default":"#f8f9fa"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#6C3CE1"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Reviews Carousel v2"}]
}
{% endschema %}
