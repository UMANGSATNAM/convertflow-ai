<style>
.cf-hero-02{width:100%;display:flex;min-height:{{ section.settings.height }}px;background:{{ section.settings.bg_color }};overflow:hidden}
.cf-hero-02-text{flex:1;display:flex;flex-direction:column;justify-content:center;padding:80px 60px;max-width:600px}
.cf-hero-02-tag{font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:{{ section.settings.accent_color }};margin-bottom:20px}
.cf-hero-02 h1{font-size:clamp(32px,4vw,{{ section.settings.heading_size }}px);font-weight:800;line-height:1.08;color:{{ section.settings.heading_color }};margin:0 0 20px;letter-spacing:-0.03em}
.cf-hero-02 p{font-size:17px;line-height:1.7;color:{{ section.settings.text_color }};margin:0 0 36px;opacity:0.8}
.cf-hero-02-actions{display:flex;gap:12px;flex-wrap:wrap}
.cf-hero-02-primary{padding:14px 32px;border-radius:6px;font-weight:600;font-size:15px;text-decoration:none;background:{{ section.settings.accent_color }};color:#fff;border:none;cursor:pointer;transition:0.2s}
.cf-hero-02-primary:hover{opacity:0.9;transform:translateY(-1px)}
.cf-hero-02-secondary{padding:14px 32px;border-radius:6px;font-weight:600;font-size:15px;text-decoration:none;background:transparent;color:{{ section.settings.heading_color }};border:2px solid {{ section.settings.heading_color }};cursor:pointer;transition:0.2s}
.cf-hero-02-img{flex:1;position:relative;min-height:400px}
.cf-hero-02-img img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
@media(max-width:768px){.cf-hero-02{flex-direction:column}.cf-hero-02-text{padding:40px 24px}.cf-hero-02-img{min-height:300px;position:relative}}
</style>

<section class="cf-hero-02">
  <div class="cf-hero-02-text">
    {% if section.settings.tag != blank %}<span class="cf-hero-02-tag">{{ section.settings.tag }}</span>{% endif %}
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <div class="cf-hero-02-actions">
      <a href="{{ section.settings.btn_link }}" class="cf-hero-02-primary">{{ section.settings.btn_text }}</a>
      {% if section.settings.btn2_text != blank %}<a href="{{ section.settings.btn2_link }}" class="cf-hero-02-secondary">{{ section.settings.btn2_text }}</a>{% endif %}
    </div>
  </div>
  <div class="cf-hero-02-img">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}" loading="eager">
    {% else %}
      <div style="position:absolute;inset:0;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%)"></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "02 · Split Hero",
  "settings": [
    {"type":"text","id":"tag","label":"Tag Line","default":"SUMMER 2025"},
    {"type":"text","id":"heading","label":"Heading","default":"The New Collection Has Arrived"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Explore our latest range of premium essentials crafted with the finest materials for ultimate comfort."},
    {"type":"text","id":"btn_text","label":"Primary Button","default":"Shop Collection"},
    {"type":"text","id":"btn_link","label":"Primary Link","default":"/collections/all"},
    {"type":"text","id":"btn2_text","label":"Secondary Button","default":"Learn More"},
    {"type":"text","id":"btn2_link","label":"Secondary Link","default":"/pages/about"},
    {"type":"image_picker","id":"image","label":"Hero Image"},
    {"type":"color","id":"bg_color","label":"Background","default":"#fafafa"},
    {"type":"color","id":"heading_color","label":"Heading Color","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#555555"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#111111"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":32,"max":72,"step":2,"default":48},
    {"type":"range","id":"height","label":"Min Height","min":400,"max":800,"step":50,"default":600}
  ],
  "presets": [{"name":"02 · Split Hero"}]
}
{% endschema %}
