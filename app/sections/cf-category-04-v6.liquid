<style>
.cf-cat-04-v6 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Baskerville', 'Times New Roman', serif;
}

.cf-cat-04-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v6-header {
  text-align: center;
  margin-bottom: 50px;
}

.cf-cat-04-v6-tag {
  color: {{ section.settings.accent_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 15px;
}

.cf-cat-04-v6-title {
  color: {{ section.settings.text_color }};
  font-size: 40px;
  font-weight: normal;
  margin: 0;
}

.cf-cat-04-v6-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 30px;
}

.cf-cat-04-v6-item {
  text-decoration: none;
  background: {{ section.settings.card_bg }};
  border: 1px solid {{ section.settings.border_color }};
  padding: 15px;
  display: block;
  transition: border-color 0.3s;
}

.cf-cat-04-v6-item:hover {
  border-color: {{ section.settings.accent_color }};
}

.cf-cat-04-v6-image-wrap {
  width: 100%;
  aspect-ratio: 4/3;
  position: relative;
  overflow: hidden;
  border: 1px solid {{ section.settings.border_color }};
  background: rgba(255,255,255,0.05);
}

.cf-cat-04-v6-image-wrap img {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.5s ease;
  filter: sepia(0.2);
}

.cf-cat-04-v6-item:hover .cf-cat-04-v6-image-wrap img {
  transform: scale(1.05);
}

.cf-cat-04-v6-content {
  text-align: center;
  padding: 20px 10px 10px;
}

.cf-cat-04-v6-name {
  color: {{ section.settings.text_color }};
  font-size: 20px;
  font-weight: normal;
  margin: 0;
}

@media (max-width: 900px) {
  .cf-cat-04-v6-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .cf-cat-04-v6-grid { grid-template-columns: 1fr; }
  .cf-cat-04-v6-title { font-size: 32px; }
}
</style>

<div class="cf-cat-04-v6">
  <div class="cf-cat-04-v6-inner">
    <div class="cf-cat-04-v6-header">
      <div class="cf-cat-04-v6-tag">{{ section.settings.tag }}</div>
      <h2 class="cf-cat-04-v6-title">{{ section.settings.title }}</h2>
    </div>

    <div class="cf-cat-04-v6-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v6-item">
          <div class="cf-cat-04-v6-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#6A7870;">Image</div>
            {% endif %}
          </div>
          <div class="cf-cat-04-v6-content">
            <h3 class="cf-cat-04-v6-name">{{ block.settings.title }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Apothecary Vintage",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F4F1EA"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#2d3a33"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#f4f1ea"},
    {"type":"color","id":"border_color","label":"Border Lines","default":"#4a5c52"},
    {"type":"color","id":"accent_color","label":"Accent Label","default":"#6A7870"},
    {"type":"text","id":"tag","label":"Tag","default":"OUR REMEDIES"},
    {"type":"text","id":"title","label":"Title","default":"Apothecary Collections"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Category Name","default":"Tinctures"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "06 · Apothecary Grid",
      "blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]
    }
  ]
}
{% endschema %}
