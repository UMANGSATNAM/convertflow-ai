<style>
.cf-promo-01-v4{width:100%;height:80vh;min-height:600px;position:relative;display:flex;align-items:flex-end;padding:60px 40px;color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-promo-01-v4-bg{position:absolute;top:0;left:0;width:100%;height:100%;z-index:1;background:#222}
.cf-promo-01-v4-bg img{width:100%;height:100%;object-fit:cover;opacity:0.9}
.cf-promo-01-v4-content{position:relative;z-index:2;background:{{ section.settings.box_bg }};backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px);padding:50px;max-width:550px}
.cf-promo-01-v4-title{font-size:clamp(32px, 5vw, 56px);font-weight:400;margin:0 0 20px 0;line-height:1.1;letter-spacing:0.02em}
.cf-promo-01-v4-desc{font-family:sans-serif;font-size:14px;line-height:1.6;opacity:0.8;margin:0 0 40px 0}
.cf-promo-01-v4-btn{display:inline-block;padding:15px 40px;background:{{ section.settings.text_color }};color:{{ section.settings.btn_text_color }};font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;transition:0.3s}
.cf-promo-01-v4-btn:hover{background:{{ section.settings.accent_color }};color:#fff}
@media(max-width:768px){
  .cf-promo-01-v4{padding:20px;height:auto;min-height:500px}
  .cf-promo-01-v4-content{padding:30px;width:100%;max-width:none}
}
</style>

<div class="cf-promo-01-v4">
  <div class="cf-promo-01-v4-bg">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="">
    {% else %}
      <div style="width:100%;height:100%;background:#333;"></div>
    {% endif %}
  </div>
  <div class="cf-promo-01-v4-content">
    <h2 class="cf-promo-01-v4-title">{{ section.settings.title }}</h2>
    <p class="cf-promo-01-v4-desc">{{ section.settings.desc }}</p>
    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="cf-promo-01-v4-btn">{{ section.settings.btn_text }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Promo (v4)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Full Width Background Image"},
    {"type":"text","id":"title","label":"Header Title","default":"The Essential Wardrobe"},
    {"type":"textarea","id":"desc","label":"Description","default":"Curated silhouettes designed to stand the test of time. Explore our foundational garments."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop The Collection"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"box_bg","label":"Text Box Background (With Alpha)","default":"#FDFBF7D9"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"btn_text_color","label":"Button Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Button Hover Color","default":"#888888"}
  ],
  "presets": [{"name":"01 · Luxury Promo (v4)"}]
}
{% endschema %}
