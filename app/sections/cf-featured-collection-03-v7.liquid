<style>
.cf-fc-03-v7 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
}

.cf-fc-03-v7-header {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto 30px auto;
  padding: 0 20px;
}

.cf-fc-03-v7-heading {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: clamp(32px, 5vw, 48px);
  color: {{ section.settings.text_color }};
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  text-shadow: 2px 2px 0 {{ section.settings.accent_color }};
}

.cf-fc-03-v7-track {
  display: flex;
  gap: 20px;
  padding: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}
.cf-fc-03-v7-track::-webkit-scrollbar { display: none; }

.cf-fc-03-v7-card {
  flex: 0 0 85%;
  max-width: 400px;
  scroll-snap-align: center;
  position: relative;
  background: {{ section.settings.panel_bg }};
  padding: 30px;
  /* Cyber Slant */
  clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);
  display: flex;
  flex-direction: column;
  text-decoration: none;
  transition: 0.3s;
}

.cf-fc-03-v7-card::before {
  content: '';
  position: absolute;
  top: 1px; left: 1px; right: 1px; bottom: 1px;
  background: {{ section.settings.panel_bg }};
  clip-path: polygon(29px 0, 100% 0, 100% calc(100% - 29px), calc(100% - 29px) 100%, 0 100%, 0 29px);
  z-index: 1;
}

.cf-fc-03-v7-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: {{ section.settings.accent_color }};
  /* Outline effect via background peeking */
  clip-path: polygon(30px 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%, 0 30px);
  z-index: 0;
  transition: 0.3s;
}

.cf-fc-03-v7-card:hover::after {
  background: {{ section.settings.text_color }};
}

.cf-fc-03-v7-content-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.cf-fc-03-v7-img-wrap {
  width: 100%;
  aspect-ratio: 4/3;
  background: #000;
  margin-bottom: 20px;
  clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  overflow: hidden;
}

.cf-fc-03-v7-img {
  width: 100%; height: 100%; object-fit: cover;
  opacity: 0.7; filter: grayscale(0.5);
  transition: 0.3s;
}

.cf-fc-03-v7-card:hover .cf-fc-03-v7-img {
  opacity: 1; filter: grayscale(0);
  transform: scale(1.1);
}

.cf-fc-03-v7-title {
  color: {{ section.settings.text_color }};
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: 24px;
  text-transform: uppercase;
  margin: 0 0 10px 0;
  text-shadow: 2px 2px 0 #000;
  line-height: 1.1;
}

.cf-fc-03-v7-price {
  color: {{ section.settings.accent_color }};
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 18px;
  font-weight: 700;
  margin-top: auto;
}
</style>

<div class="cf-fc-03-v7">
  <div class="cf-fc-03-v7-header">
    <h2 class="cf-fc-03-v7-heading">{{ section.settings.heading }}</h2>
  </div>
  
  <div class="cf-fc-03-v7-track">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank %}
      {% for product in collection.products limit: section.settings.limit %}
        <a href="{{ product.url }}" class="cf-fc-03-v7-card">
          <div class="cf-fc-03-v7-content-wrap">
            <div class="cf-fc-03-v7-img-wrap">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="cf-fc-03-v7-img">
            </div>
            <h3 class="cf-fc-03-v7-title">{{ product.title }}</h3>
            <div class="cf-fc-03-v7-price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..5) %}
        <a href="#" class="cf-fc-03-v7-card">
          <div class="cf-fc-03-v7-content-wrap">
            <div class="cf-fc-03-v7-img-wrap">
              <div style="width:100%; height:100%; background: linear-gradient(45deg, #111, {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }});"></div>
            </div>
            <h3 class="cf-fc-03-v7-title">Cyber Deck {{ i }}</h3>
            <div class="cf-fc-03-v7-price">$1,499.00</div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "07 · Cyber Slanted Slider",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"NEW EQUIPMENT"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products to show","min":2,"max":12,"step":1,"default":5},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#08080c"},
    {"type":"color","id":"panel_bg","label":"Panel Base","default":"#16161c"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Cyber Accent","default":"#ff003c"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "presets": [{"name":"07 · Cyber Slanted Slider"}]
}
{% endschema %}
