<style>
.cf-cat-01-v9{width:100%;padding:{{ section.settings.padding_y }}px 0;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-cat-01-v9-header{text-align:center;margin-bottom:80px;padding:0 20px}
.cf-cat-01-v9-title{font-size:clamp(32px, 5vw, 64px);font-weight:400;margin:0;letter-spacing:0.02em}
.cf-cat-01-v9-track-wrapper{position:relative;width:100%;max-width:1800px;margin:0 auto;padding-bottom:40px}
.cf-cat-01-v9-track{display:flex;gap:20px;padding:0 40px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;align-items:center}
.cf-cat-01-v9-track::-webkit-scrollbar{display:none}
.cf-cat-01-v9-card{flex:0 0 320px;scroll-snap-align:center;position:relative;text-decoration:none;color:inherit;display:block;transition:all 0.5s}
.cf-cat-01-v9-card:hover{transform:translateY(-15px)}
.cf-cat-01-v9-img-wrap{width:100%;aspect-ratio:1/1;background:#ececec;border-radius:100%;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.05);padding:10px;border:1px solid {{ section.settings.border_color }}}
.cf-cat-01-v9-img-inner{width:100%;height:100%;border-radius:100%;overflow:hidden}
.cf-cat-01-v9-img{width:100%;height:100%;object-fit:cover;transform:scale(1.05);transition:1s}
.cf-cat-01-v9-card:hover .cf-cat-01-v9-img{transform:scale(1)}
.cf-cat-01-v9-content{text-align:center;margin-top:30px}
.cf-cat-01-v9-name{font-size:20px;font-style:italic;margin:0 0 10px 0}
.cf-cat-01-v9-link{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;opacity:0.6;transition:0.3s}
.cf-cat-01-v9-card:hover .cf-cat-01-v9-link{opacity:1;color:{{ section.settings.accent_color }}}
@media(max-width:768px){
  .cf-cat-01-v9-card{flex:0 0 250px}
}
</style>

<div class="cf-cat-01-v9">
  <div class="cf-cat-01-v9-header">
    <h2 class="cf-cat-01-v9-title">{{ section.settings.title }}</h2>
  </div>
  <div class="cf-cat-01-v9-track-wrapper">
    <div class="cf-cat-01-v9-track">
      {% for i in (1..6) %}
        <a href="#" class="cf-cat-01-v9-card">
          <div class="cf-cat-01-v9-img-wrap">
            <div class="cf-cat-01-v9-img-inner">
              <div class="cf-cat-01-v9-img" style="background:#555;"></div>
            </div>
          </div>
          <div class="cf-cat-01-v9-content">
            <h3 class="cf-cat-01-v9-name">Category 0{{ i }}</h3>
            <div class="cf-cat-01-v9-link">Explore</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v9)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"The Spheres"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Image Border","default":"#E2DFD8"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#D4AF37"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":100}
  ],
  "presets": [{"name":"01 · Luxury Category (v9)"}]
}
{% endschema %}
