<style>
.cf-snack-01-v7{position:fixed;bottom:40px;right:40px;width:120px;height:120px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;box-shadow:0 20px 40px rgba(0,0,0,0.1);z-index:99;text-decoration:none;transition:transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s;border:1px solid {{ section.settings.border_color }}}
.cf-snack-01-v7:hover{transform:scale(1.1) rotate(5deg)}
.cf-snack-01-v7-inner{padding:15px;display:flex;flex-direction:column;align-items:center;gap:5px}
.cf-snack-01-v7-icon svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.5}
.cf-snack-01-v7-text{font-family:sans-serif;font-size:9px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;line-height:1.4}
@media(max-width:768px){
  .cf-snack-01-v7{bottom:20px;right:20px;width:100px;height:100px}
  .cf-snack-01-v7-text{font-size:8px}
}
</style>

<a href="{{ section.settings.link }}" class="cf-snack-01-v7">
  <div class="cf-snack-01-v7-inner">
    <div class="cf-snack-01-v7-icon">
      <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
    </div>
    <span class="cf-snack-01-v7-text">{{ section.settings.text }}</span>
  </div>
</a>

{% schema %}
{
  "name": "01 · Luxury Snack (v7)",
  "settings": [
    {"type":"text","id":"text","label":"Badge Text","default":"JOIN THE LEAGUE"},
    {"type":"url","id":"link","label":"Badge Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#E2DFD8"}
  ],
  "presets": [{"name":"01 · Luxury Snack (v7)"}]
}
{% endschema %}
