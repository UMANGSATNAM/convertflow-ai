<style>
.cf-ps-04-v6 {
  width: 100%;
  background-color: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: 'Baskerville', 'Times New Roman', serif;
  display: flex;
  justify-content: center;
}

.cf-ps-04-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  background: transparent;
  border: 1px solid {{ section.settings.border_color }};
  padding: 10px 30px;
  display: inline-flex;
  align-items: center;
  gap: 15px;
}

.cf-ps-04-v6-icon {
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5em; /* asterisk */
  font-weight: 300;
  line-height: 1;
  padding-top: 8px; /* centering adjust */
}

.cf-ps-04-v6-text {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0;
}

@media (max-width: 600px) {
  .cf-ps-04-v6-inner { padding: 10px 15px; gap: 10px; }
  .cf-ps-04-v6-text { font-size: 12px; }
}
</style>

<div class="cf-ps-04-v6">
  <div class="cf-ps-04-v6-inner">
    <div class="cf-ps-04-v6-icon">*</div>
    <p class="cf-ps-04-v6-text">
      {{ section.settings.text }}
    </p>
    <div class="cf-ps-04-v6-icon">*</div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Apothecary Seal",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#F4F1EA"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#2d3a33"},
    {"type":"color","id":"accent_color","label":"Asterisk Color","default":"#6A7870"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#DAD4C8"},
    {"type":"text","id":"text","label":"Text","default":"Subscribe & Save 20% on Tinctures"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":60,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":400,"max":1200,"step":50,"default":700}
  ],
  "presets": [{"name":"06 · Apothecary Snack"}]
}
{% endschema %}
