<style>
.cf-snack-12-v7{position:fixed;bottom:0;left:0;width:100%;z-index:99;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:15px 20px;font-family:serif;display:flex;align-items:center;justify-content:center;gap:30px;box-shadow:0 -10px 40px rgba(0,0,0,0.05);transform:translateY(100%);animation:cf-slide-up-12-v7 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 1s}
.cf-snack-12-v7-text{font-size:16px;font-style:italic;margin:0;letter-spacing:0.02em}
.cf-snack-12-v7-copy{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};border:none;padding:10px 25px;font-family:sans-serif;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.2em;cursor:pointer;transition:0.3s;border-radius:4px}
.cf-snack-12-v7-copy:hover{opacity:0.8}
.cf-snack-12-v7-close{position:absolute;right:20px;top:50%;transform:translateY(-50%);background:none;border:none;color:{{ section.settings.text_color }};cursor:pointer;opacity:0.5;transition:0.3s;padding:5px}
.cf-snack-12-v7-close:hover{opacity:1}
@keyframes cf-slide-up-12-v7{to{transform:translateY(0)}}
@media(max-width:600px){.cf-snack-12-v7{flex-direction:column;gap:15px;padding:20px 20px 30px 20px;text-align:center}.cf-snack-12-v7-close{top:15px;right:15px;transform:none}}
</style>

<div class="cf-snack-12-v7" id="cf-snack-12-v7-{{ section.id }}">
  <p class="cf-snack-12-v7-text">{{ section.settings.text }}</p>
  <button class="cf-snack-12-v7-copy" onclick="navigator.clipboard.writeText('{{ section.settings.code }}'); this.innerText='COPIED!'">
    COPY CODE: {{ section.settings.code }}
  </button>
  <button class="cf-snack-12-v7-close" onclick="document.getElementById('cf-snack-12-v7-{{ section.id }}').style.display='none'">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
</div>

{% schema %}
{
  "name": "12 · Women's Snack (v7)",
  "settings": [
    {"type":"text","id":"text","label":"Announcement","default":"Take an extra 10% off your first purchase."},
    {"type":"text","id":"code","label":"Promo Code","default":"WELCOME10"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F8F3EC"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"}
  ],
  "presets": [{"name":"12 · Women's Snack (v7)"}]
}
{% endschema %}
