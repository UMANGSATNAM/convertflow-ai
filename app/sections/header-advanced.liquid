{%- style -%}
  :root {
    --myapp-bg: {{ section.settings.bg_color }};
    --myapp-text: {{ section.settings.text_color }};
  }

  .myapp-header-adv {
    background-color: var(--myapp-bg);
    color: var(--myapp-text);
    padding: 0 {{ section.settings.padding_x }}px;
    height: {{ section.settings.desktop_height }}px;
    position: {% if section.settings.sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  .myapp-logo a {
    text-decoration: none;
    color: inherit;
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
  }

  .myapp-logo img {
    width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
  }

  .myapp-nav {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .myapp-nav a {
    text-decoration: none;
    color: inherit;
    font-size: 15px;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .myapp-nav a:hover { opacity: 0.6; }

  .myapp-icons {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .myapp-icon-btn {
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 4px;
    position: relative;
    transition: transform 0.2s;
  }

  .myapp-icon-btn:hover { transform: scale(1.1); }
  .myapp-icon-btn svg { width: 22px; height: 22px; stroke-width: 1.5; }

  .myapp-cart-count {
    position: absolute;
    top: -4px;
    right: -8px;
    background: #000;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  @media (max-width: 768px) {
    .myapp-header-adv {
      height: 64px;
      padding: 0 16px;
    }
    .myapp-nav { display: none; } /* Hide menu on mobile for this demo */
    .myapp-logo img { width: {{ section.settings.logo_width_mobile }}px; }
  }
{%- endstyle -%}

<header class="myapp-header-adv" data-section-id="{{ section.id }}">
  
  <!-- LOGO -->
  <div class="myapp-logo">
    <a href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" loading="lazy">
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
  </div>

  <!-- NAVIGATION -->
  <nav>
    <ul class="myapp-nav">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- else -%}
        <li><a href="#">Home</a></li>
        <li><a href="#">Catalog</a></li>
        <li><a href="#">About</a></li>
        <li><a href="#">Contact</a></li>
      {%- endfor -%}
    </ul>
  </nav>

  <!-- ICONS -->
  <div class="myapp-icons">
    {%- if section.settings.show_search -%}
      <a href="{{ routes.search_url }}" class="myapp-icon-btn">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </a>
    {%- endif -%}

    {%- if section.settings.show_account -%}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="myapp-icon-btn">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
      </a>
    {%- endif -%}

    {%- if section.settings.show_cart -%}
      <a href="{{ routes.cart_url }}" class="myapp-icon-btn">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        {%- if cart.item_count > 0 -%}
          <span class="myapp-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

</header>

{% schema %}
{
  "name": "Advanced SaaS Header",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Header",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 60,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Header height",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Horizontal Padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo width on Desktop",
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 50,
      "max": 150,
      "step": 10,
      "unit": "px",
      "label": "Logo width on Mobile",
      "default": 100
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Primary Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Icons",
      "default": "#111827"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart",
      "default": true
    }
  ]
}
{% endschema %}