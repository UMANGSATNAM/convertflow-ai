<style>
.cf-ft-11{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif;overflow:hidden}
.cf-ft-11-inner{max-width:1400px;margin:0 auto}
.cf-ft-11-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:60px;padding-bottom:20px;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-ft-11-title{font-size:clamp(28px,4vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:300;text-transform:uppercase;letter-spacing:0.05em;margin:0}
.cf-ft-11-link{font-size:12px;color:{{ section.settings.text_color }};text-decoration:none;text-transform:uppercase;letter-spacing:0.1em;transition:0.3s}
.cf-ft-11-link:hover{color:#888}
.cf-ft-11-slider{display:flex;gap:40px;overflow-x:auto;padding-bottom:20px;scroll-snap-type:x mandatory;scrollbar-width:none}
.cf-ft-11-slider::-webkit-scrollbar{display:none}
.cf-ft-11-card{min-width:calc(100% / {{ section.settings.cols }} - 40px);scroll-snap-align:start;text-decoration:none;display:flex;flex-direction:column;group}
.cf-ft-11-img-wrap{aspect-ratio:3/4;background:#f8fafc;margin-bottom:24px;overflow:hidden}
.cf-ft-11-img{width:100%;height:100%;object-fit:cover;transition:transform 0.8s cubic-bezier(0.2,0.8,0.2,1);filter:grayscale(30%)}
.cf-ft-11-card:hover .cf-ft-11-img{transform:scale(1.05);filter:grayscale(0%)}
.cf-ft-11-info{display:flex;justify-content:space-between;align-items:flex-start}
.cf-ft-11-name{font-size:16px;color:{{ section.settings.text_color }};font-weight:400;text-transform:uppercase;letter-spacing:0.05em}
.cf-ft-11-price{font-size:15px;color:#64748b;font-weight:400}
@media(max-width:900px){.cf-ft-11-card{min-width:calc(50% - 20px)}}
@media(max-width:500px){.cf-ft-11-card{min-width:85%}.cf-ft-11-header{flex-direction:column;align-items:flex-start;gap:15px}}
</style>

<div class="cf-ft-11">
  <div class="cf-ft-11-inner">
    <div class="cf-ft-11-header">
      <h2 class="cf-ft-11-title">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.link }}" class="cf-ft-11-link">VIEW ALL PIECES</a>
    </div>
    
    <div class="cf-ft-11-slider">
      {% assign coll = collections[section.settings.collection] %}
      {% if coll != blank and coll.products_count > 0 %}
        {% for product in coll.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="cf-ft-11-card">
            <div class="cf-ft-11-img-wrap">
              <img class="cf-ft-11-img" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
            </div>
            <div class="cf-ft-11-info">
              <div class="cf-ft-11-name">{{ product.title }}</div>
              <div class="cf-ft-11-price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <a href="#" class="cf-ft-11-card">
            <div class="cf-ft-11-img-wrap">
               <div style="width:100%;height:100%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:12px;letter-spacing:0.1em">ESSENTIAL {{ i }}</div>
            </div>
            <div class="cf-ft-11-info">
              <div class="cf-ft-11-name">Structured Blazer</div>
              <div class="cf-ft-11-price">$350.00</div>
            </div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Featured",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"NEW ARRIVALS"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":64,"step":2,"default":36},
    {"type":"text","id":"link","label":"Link","default":"/collections/all"},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product Limit","min":4,"max":12,"step":1,"default":6},
    {"type":"range","id":"cols","label":"Visible Columns (Desktop)","min":2,"max":5,"step":1,"default":4},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},
    {"type":"color","id":"border_color","label":"Border Base","default":"#e2e8f0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Featured"}]
}
{% endschema %}
