<style>
.cf-cat-01-v10{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;display:flex;height:90vh;min-height:700px}
.cf-cat-01-v10-half{flex:1;position:relative;display:flex;align-items:center;justify-content:center;text-decoration:none;color:inherit;transition:0.5s;border-right:1px solid {{ section.settings.border_color }}}
.cf-cat-01-v10-half:last-child{border-right:none}
.cf-cat-01-v10-portal{width:60%;aspect-ratio:2/3;border-radius:200px 200px 0 0;overflow:hidden;position:relative;box-shadow:0 30px 60px rgba(0,0,0,0.1);transition:transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);background:#ececec}
.cf-cat-01-v10-img{width:100%;height:100%;object-fit:cover;transition:1.2s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-cat-01-v10-half:hover .cf-cat-01-v10-portal{transform:translateY(-20px)}
.cf-cat-01-v10-half:hover .cf-cat-01-v10-img{transform:scale(1.05)}
.cf-cat-01-v10-content{position:absolute;bottom:calc(10% - 20px);text-align:center;width:100%;transition:0.6s}
.cf-cat-01-v10-half:hover .cf-cat-01-v10-content{transform:translateY(10px)}
.cf-cat-01-v10-name{font-size:clamp(36px, 4vw, 56px);font-weight:400;margin:0 0 10px 0;letter-spacing:0.02em;background:{{ section.settings.bg_color }};display:inline-block;padding:0 20px}
.cf-cat-01-v10-btn{display:inline-block;margin-top:10px;font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;opacity:0;transform:translateY(10px);transition:0.4s}
.cf-cat-01-v10-half:hover .cf-cat-01-v10-btn{opacity:1;transform:translateY(0)}
@media(max-width:900px){
  .cf-cat-01-v10{flex-direction:column;height:auto}
  .cf-cat-01-v10-half{padding:60px 20px;border-right:none;border-bottom:1px solid {{ section.settings.border_color }}}
  .cf-cat-01-v10-portal{width:80%}
  .cf-cat-01-v10-btn{opacity:1;transform:translateY(0)}
}
</style>

<div class="cf-cat-01-v10">
  <a href="#" class="cf-cat-01-v10-half">
    <div class="cf-cat-01-v10-portal">
      <div class="cf-cat-01-v10-img" style="background:#444;"></div>
    </div>
    <div class="cf-cat-01-v10-content">
      <h3 class="cf-cat-01-v10-name">Womenswear</h3>
      <div class="cf-cat-01-v10-btn">Enter Sector</div>
    </div>
  </a>
  <a href="#" class="cf-cat-01-v10-half">
    <div class="cf-cat-01-v10-portal">
      <div class="cf-cat-01-v10-img" style="background:#555;"></div>
    </div>
    <div class="cf-cat-01-v10-content">
      <h3 class="cf-cat-01-v10-name">Menswear</h3>
      <div class="cf-cat-01-v10-btn">Enter Sector</div>
    </div>
  </a>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v10",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Canvas",
      "default": "#FDFBF7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Split Divider",
      "default": "#EAEAEE"
    }
  ],
  "presets": [
    {
      "name": "01 · Luxury Category (v10"
    }
  ]
}
{% endschema %}
