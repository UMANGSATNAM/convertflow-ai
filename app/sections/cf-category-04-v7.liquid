<style>
.cf-cat-04-v7 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  overflow: hidden;
}

.cf-cat-04-v7-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v7-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 50px;
}

.cf-cat-04-v7-title {
  color: {{ section.settings.text_color }};
  font-size: 46px;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  margin: 0;
  letter-spacing: -0.02em;
}

.cf-cat-04-v7-title span {
  color: {{ section.settings.accent_color }};
}

.cf-cat-04-v7-link {
  color: {{ section.settings.accent_color }};
  text-decoration: none;
  font-weight: 800;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: transform 0.2s;
}

.cf-cat-04-v7-link:hover {
  transform: translateX(5px);
}

.cf-cat-04-v7-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 20px;
}

.cf-cat-04-v7-item {
  position: relative;
  text-decoration: none;
  display: block;
  background: {{ section.settings.card_bg }};
  border-radius: 12px;
  overflow: hidden;
  padding: 30px;
  transition: transform 0.3s;
}

.cf-cat-04-v7-item:hover {
  transform: translateY(-10px);
}

.cf-cat-04-v7-image-wrap {
  width: 100%;
  aspect-ratio: 1;
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  margin-bottom: 25px;
  clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);
  background: #1f2937;
}

.cf-cat-04-v7-image-wrap img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.5s;
}

.cf-cat-04-v7-item:hover .cf-cat-04-v7-image-wrap img {
  transform: scale(1.1);
}

.cf-cat-04-v7-name {
  color: {{ section.settings.text_color }};
  font-size: 22px;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  margin: 0;
}

@media (max-width: 900px) {
  .cf-cat-04-v7-grid { grid-template-columns: repeat(2, 1fr); }
  .cf-cat-04-v7-header { flex-direction: column; align-items: flex-start; gap: 20px; }
}
@media (max-width: 600px) {
  .cf-cat-04-v7-grid { grid-template-columns: 1fr; }
  .cf-cat-04-v7-title { font-size: 32px; }
}
</style>

<div class="cf-cat-04-v7">
  <div class="cf-cat-04-v7-inner">
    <div class="cf-cat-04-v7-header">
      <h2 class="cf-cat-04-v7-title">{{ section.settings.title | replace: '[', '<span>' | replace: ']', '</span>' }}</h2>
      <a href="{{ section.settings.btn_link }}" class="cf-cat-04-v7-link">{{ section.settings.btn_text }} &rarr;</a>
    </div>

    <div class="cf-cat-04-v7-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v7-item">
          <div class="cf-cat-04-v7-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#475569;">Img</div>
            {% endif %}
          </div>
          <h3 class="cf-cat-04-v7-name">{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "07 · Active Pulse Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#f97316"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SHOP BY [GOAL]"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Name",
      "default": "View All Goals"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columns (Desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "default": 1200
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Recovery"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "07 · Active Pulse Categor",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
