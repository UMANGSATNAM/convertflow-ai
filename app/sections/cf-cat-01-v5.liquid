<style>
.cf-cat-01-v5{width:100%;padding:{{ section.settings.padding_y }}px 0;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;overflow:hidden}
.cf-cat-01-v5-header{padding:0 40px;margin-bottom:60px;display:flex;justify-content:space-between;align-items:flex-end}
.cf-cat-01-v5-title{font-size:clamp(32px, 5vw, 64px);font-weight:400;margin:0;letter-spacing:0.02em;text-transform:uppercase}
.cf-cat-01-v5-track{display:flex;gap:30px;padding:0 40px 40px 40px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.cf-cat-01-v5-track::-webkit-scrollbar{display:none}
.cf-cat-01-v5-card{flex:0 0 350px;scroll-snap-align:start;text-decoration:none;color:inherit;display:block}
.cf-cat-01-v5-img-wrap{width:100%;aspect-ratio:3/5;background:#f0f0f0;margin-bottom:20px;overflow:hidden;border:1px solid {{ section.settings.border_color }}}
.cf-cat-01-v5-img{width:100%;height:100%;object-fit:cover;transition:1s cubic-bezier(0.2, 0.8, 0.2, 1)}
.cf-cat-01-v5-card:hover .cf-cat-01-v5-img{transform:scale(1.05)}
.cf-cat-01-v5-info{text-align:center}
.cf-cat-01-v5-name{font-size:18px;font-weight:400;text-transform:uppercase;margin:0 0 10px 0;letter-spacing:0.02em}
.cf-cat-01-v5-link{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;opacity:0.6;transition:0.3s}
.cf-cat-01-v5-card:hover .cf-cat-01-v5-link{opacity:1;color:{{ section.settings.accent_color }}}
@media(max-width:768px){
  .cf-cat-01-v5-card{flex:0 0 280px}
  .cf-cat-01-v5-header{flex-direction:column;align-items:flex-start;gap:20px}
}
</style>

<div class="cf-cat-01-v5">
  <div class="cf-cat-01-v5-header">
    <h2 class="cf-cat-01-v5-title">{{ section.settings.title }}</h2>
  </div>
  
  <div class="cf-cat-01-v5-track">
    {% for i in (1..6) %}
      <a href="#" class="cf-cat-01-v5-card">
        <div class="cf-cat-01-v5-img-wrap">
          <div class="cf-cat-01-v5-img" style="background:#444;"></div>
        </div>
        <div class="cf-cat-01-v5-info">
          <h3 class="cf-cat-01-v5-name">Curated Object 0{{ i }}</h3>
          <div class="cf-cat-01-v5-link">Explore Area</div>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Category (v5)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"DEPARTMENTS"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#D4AF37"},
    {"type":"color","id":"border_color","label":"Card Border","default":"#EEEEEE"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Category (v5)"}]
}
{% endschema %}
