<style>
.cf-cro-faq{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-faq-inner{max-width:800px;margin:0 auto}
.cf-cro-faq-head{text-align:center;margin-bottom:40px}
.cf-cro-faq h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-faq-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-cro-faq-list{display:flex;flex-direction:column;gap:12px}
.cf-cro-faq-item{border:1px solid {{ section.settings.text_color }}12;border-radius:12px;overflow:hidden;transition:all 0.3s}
.cf-cro-faq-item:hover{border-color:{{ section.settings.accent_color }}40}
.cf-cro-faq-q{display:flex;align-items:center;justify-content:space-between;padding:20px 24px;cursor:pointer;background:transparent;border:none;width:100%;text-align:left;gap:16px;font-size:16px;font-weight:600;color:{{ section.settings.text_color }}}
.cf-cro-faq-q::after{content:'+';font-size:24px;font-weight:300;color:{{ section.settings.accent_color }};transition:transform 0.3s;flex-shrink:0}
.cf-cro-faq-item.open .cf-cro-faq-q::after{content:'−'}
.cf-cro-faq-item.open{border-color:{{ section.settings.accent_color }}30;background:{{ section.settings.accent_color }}05}
.cf-cro-faq-a{max-height:0;overflow:hidden;transition:max-height 0.4s ease,padding 0.3s;padding:0 24px}
.cf-cro-faq-item.open .cf-cro-faq-a{max-height:300px;padding:0 24px 20px}
.cf-cro-faq-a p{font-size:15px;line-height:1.7;color:{{ section.settings.text_color }};opacity:0.7;margin:0}
.cf-cro-faq-cta{text-align:center;margin-top:32px;padding:24px;background:{{ section.settings.accent_color }}08;border-radius:12px}
.cf-cro-faq-cta p{font-size:15px;color:{{ section.settings.text_color }};opacity:0.7;margin:0 0 12px}
.cf-cro-faq-cta a{color:{{ section.settings.accent_color }};font-weight:700;text-decoration:none;font-size:15px}
</style>

<div class="cf-cro-faq">
  <div class="cf-cro-faq-inner">
    <div class="cf-cro-faq-head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="cf-cro-faq-sub">{{ section.settings.subheading }}</p>
    </div>
    <div class="cf-cro-faq-list">
      {%- for i in (1..5) -%}
        {%- assign q_key = 'q_' | append: i -%}
        {%- assign a_key = 'a_' | append: i -%}
        {% if section.settings[q_key] != blank %}
          <div class="cf-cro-faq-item{% if i == 1 %} open{% endif %}">
            <button class="cf-cro-faq-q" onclick="this.parentElement.classList.toggle('open')">{{ section.settings[q_key] }}</button>
            <div class="cf-cro-faq-a"><p>{{ section.settings[a_key] }}</p></div>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
    {% if section.settings.cta_text != blank %}
      <div class="cf-cro-faq-cta">
        <p>{{ section.settings.cta_prefix }}</p>
        <a href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }} →</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "CRO · FAQ Accordion",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Frequently Asked Questions"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Everything you need to know before you buy"},
    {"type":"text","id":"q_1","label":"Question 1","default":"How fast is shipping?"},
    {"type":"textarea","id":"a_1","label":"Answer 1","default":"We offer free standard shipping (3-5 business days) on all orders over $50. Express shipping (1-2 days) is available for $9.99."},
    {"type":"text","id":"q_2","label":"Question 2","default":"What's your return policy?"},
    {"type":"textarea","id":"a_2","label":"Answer 2","default":"We offer a no-questions-asked 30-day money-back guarantee. If you're not 100% satisfied, simply return it for a full refund."},
    {"type":"text","id":"q_3","label":"Question 3","default":"How do I find my size?"},
    {"type":"textarea","id":"a_3","label":"Answer 3","default":"Use our interactive size guide to find your perfect fit. Our products are true-to-size, but we recommend sizing up if you're between sizes."},
    {"type":"text","id":"q_4","label":"Question 4","default":"Is this product worth the price?"},
    {"type":"textarea","id":"a_4","label":"Answer 4","default":"Absolutely! Our products use premium ingredients/materials and have a 4.9/5 star rating from 12,000+ verified buyers. Most customers see results within 14 days."},
    {"type":"text","id":"q_5","label":"Question 5","default":"Do you ship internationally?"},
    {"type":"textarea","id":"a_5","label":"Answer 5","default":"Yes! We ship to 40+ countries worldwide. International shipping typically takes 7-14 business days. Duties and taxes may apply for non-US orders."},
    {"type":"text","id":"cta_prefix","label":"Still have questions?","default":"Still have questions? We're here to help!"},
    {"type":"text","id":"cta_text","label":"CTA Text","default":"Contact Support"},
    {"type":"text","id":"cta_link","label":"CTA Link","default":"/pages/contact"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#6C3CE1"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · FAQ Accordion"}]
}
{% endschema %}
