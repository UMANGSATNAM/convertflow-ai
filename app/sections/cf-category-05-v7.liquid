<style>
.cf-cat-05-v7 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-cat-05-v7-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-cat-05-v7-title { font-size: 30px; font-weight: 800; color: {{ section.settings.text_color }}; margin: 0 0 30px 0; text-transform: uppercase; letter-spacing: 0.05em; }
.cf-cat-05-v7-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 20px; }
.cf-cat-05-v7-card { display: block; text-decoration: none; background: #fff; border: 1px solid {{ section.settings.border_color }}; border-radius: 4px; overflow: hidden; }
.cf-cat-05-v7-img { aspect-ratio: 4/3; overflow: hidden; background: #f8fafc; position: relative; }
.cf-cat-05-v7-img img { width: 100%; height: 100%; object-fit: cover; position: absolute; transition: transform 0.3s; }
.cf-cat-05-v7-card:hover .cf-cat-05-v7-img img { transform: scale(1.04); }
.cf-cat-05-v7-name { padding: 15px 20px; font-size: 15px; font-weight: 700; color: {{ section.settings.text_color }}; text-transform: uppercase; letter-spacing: 0.05em; border-top: 3px solid transparent; transition: border-color 0.2s; }
.cf-cat-05-v7-card:hover .cf-cat-05-v7-name { border-top-color: {{ section.settings.accent_color }}; }
@media (max-width: 900px) { .cf-cat-05-v7-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-cat-05-v7">
  <div class="cf-cat-05-v7-inner">
    <h2 class="cf-cat-05-v7-title">{{ section.settings.title }}</h2>
    <div class="cf-cat-05-v7-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cf-cat-05-v7-card">
        <div class="cf-cat-05-v7-img">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}</div>
        <div class="cf-cat-05-v7-name">{{ block.settings.title }}</div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "07 · Dermatology Grid","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#f8fafc"},{"type":"color","id":"text_color","label":"Text Color","default":"#0f172a"},{"type":"color","id":"border_color","label":"Border Color","default":"#e2e8f0"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#0d9488"},{"type":"text","id":"title","label":"Title","default":"Shop by Concern"},{"type":"range","id":"cols","label":"Columns","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "category","name": "Category","settings": [{"type":"text","id":"title","label":"Name","default":"Anti-Aging"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"presets": [{"name": "07 · Dermatology Grid","blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}
