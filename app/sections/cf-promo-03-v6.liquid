<style>
.cf-pr-03-v6 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-pr-03-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  background: #000;
  border: 1px solid {{ section.settings.grid_color }};
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 0 20px {{ section.settings.grid_color }}40;
}

/* Neon Grid Background Overlay */
.cf-pr-03-v6-inner::before {
  content: '';
  position: absolute;
  top: -50%; left: -50%; width: 200%; height: 200%;
  background-image: 
    linear-gradient({{ section.settings.grid_color }}30 1px, transparent 1px),
    linear-gradient(90deg, {{ section.settings.grid_color }}30 1px, transparent 1px);
  background-size: 40px 40px;
  transform: perspective(500px) rotateX(60deg) translateY(-100px);
  pointer-events: none;
  z-index: 1;
  animation: cf-pr-03-v6-grid-move 10s linear infinite;
}

@keyframes cf-pr-03-v6-grid-move {
  0% { transform: perspective(500px) rotateX(60deg) translateY(-100px); }
  100% { transform: perspective(500px) rotateX(60deg) translateY(0px); }
}

.cf-pr-03-v6-content {
  padding: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  z-index: 2;
}

.cf-pr-03-v6-icon {
  width: 48px; height: 48px;
  color: {{ section.settings.grid_color }};
  margin-bottom: 20px;
  filter: drop-shadow(0 0 8px {{ section.settings.grid_color }});
}

.cf-pr-03-v6-icon svg {
  width: 100%; height: 100%;
  fill: currentColor;
}

.cf-pr-03-v6-label {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  font-weight: bold;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 20px;
  background: rgba(255,255,255,0.1);
  padding: 4px 16px;
  border-radius: 2px;
}

.cf-pr-03-v6-heading {
  font-size: clamp(32px, 5vw, {{ section.settings.title_size }}px);
  font-weight: 900;
  color: {{ section.settings.grid_color }};
  text-transform: uppercase;
  margin: 0 0 20px 0;
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-shadow: 0 0 10px {{ section.settings.grid_color }}80;
}

.cf-pr-03-v6-desc {
  font-size: 16px;
  color: {{ section.settings.text_color }};
  max-width: 600px;
  margin: 0 0 40px 0;
  line-height: 1.6;
}

.cf-pr-03-v6-btn {
  display: inline-block;
  background: transparent;
  color: {{ section.settings.grid_color }};
  border: 1px solid {{ section.settings.grid_color }};
  padding: 14px 32px;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  text-decoration: none;
  transition: 0.3s;
  box-shadow: 0 0 10px {{ section.settings.grid_color }}40 inset, 0 0 10px {{ section.settings.grid_color }}40;
}

.cf-pr-03-v6-btn:hover {
  background: {{ section.settings.grid_color }};
  color: #000;
  box-shadow: 0 0 20px {{ section.settings.grid_color }} inset, 0 0 20px {{ section.settings.grid_color }};
}

@media (min-width: 768px) {
  .cf-pr-03-v6-content {
    padding: 80px 40px;
  }
}
</style>

<div class="cf-pr-03-v6">
  <div class="cf-pr-03-v6-inner">
    <div class="cf-pr-03-v6-content">
      <div class="cf-pr-03-v6-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13.5h-13L12 6.5z"/></svg>
      </div>
      <div class="cf-pr-03-v6-label">{{ section.settings.label }}</div>
      <h2 class="cf-pr-03-v6-heading">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="cf-pr-03-v6-desc">{{ section.settings.subheading }}</p>
      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url }}" class="cf-pr-03-v6-btn">{{ section.settings.link_text }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "06 · Neon Grid Frame",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small Label",
      "default": "VIRTUAL LAUNCH"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "ENTER THE\nMETAVERSE"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 32,
      "max": 80,
      "step": 2,
      "default": 56
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Equip yourself with the latest VR headsets and haptic accessories to fully immerse in the next generation of gaming."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "INITIATE LINK"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Base",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "grid_color",
      "label": "Neon Grid/Accent",
      "default": "#eab308"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max Width",
      "min": 800,
      "max": 1600,
      "step": 100,
      "default": 1000
    }
  ],
  "presets": [
    {
      "name": "06 · Neon Grid Frame Prom"
    }
  ]
}
{% endschema %}
