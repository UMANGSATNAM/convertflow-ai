<style>
.cf-snack-05-v8 {
  padding: {{ section.settings.padding_y }}px 20px;
  background: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
.cf-snack-05-v8-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap;
}
.cf-snack-05-v8-emoji { font-size: 22px; }
.cf-snack-05-v8-text { font-size: 14px; color: {{ section.settings.text_color }}; font-weight: 600; font-style: italic; }
.cf-snack-05-v8-btn {
  background: {{ section.settings.accent_color }}; color: #fff;
  text-decoration: none; padding: 9px 20px; border-radius: 50px;
  font-size: 13px; font-weight: 700; white-space: nowrap; transition: box-shadow 0.2s;
}
.cf-snack-05-v8-btn:hover { box-shadow: 0 6px 15px {{ section.settings.accent_color | color_modify: 'alpha', 0.5 }}; }
</style>

<div class="cf-snack-05-v8">
  <div class="cf-snack-05-v8-inner">
    <span class="cf-snack-05-v8-emoji">💅</span>
    <span class="cf-snack-05-v8-text">{{ section.settings.text }}</span>
    <a href="{{ section.settings.btn_link }}" class="cf-snack-05-v8-btn">{{ section.settings.btn_text }}</a>
  </div>
</div>

{% schema %}
{
  "name": "08 · Nail Art Snack",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#fdf2f8"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#831843"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#ec4899"},
    {"type":"text","id":"text","label":"Message Text","default":"Buy 3 polishes, get 1 FREE — mix and match your manicure"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Choose Shades"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":60,"step":5,"default":18},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1000}
  ],
  "presets": [{"name": "08 · Nail Art Snack"}]
}
{% endschema %}
