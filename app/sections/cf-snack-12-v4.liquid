<style>
.cf-snack-12-v4{position:fixed;top:20px;right:20px;z-index:99;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:20px;width:320px;box-shadow:0 10px 40px rgba(0,0,0,0.1);font-family:serif;border:1px solid {{ section.settings.border_color }}}
.cf-snack-12-v4-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:15px}
.cf-snack-12-v4-title{font-size:18px;margin:0;font-style:italic}
.cf-snack-12-v4-close{background:none;border:none;color:{{ section.settings.text_color }};cursor:pointer;opacity:0.5;transition:0.3s;padding:0}
.cf-snack-12-v4-close:hover{opacity:1}
.cf-snack-12-v4-desc{font-family:sans-serif;font-size:13px;line-height:1.5;margin:0 0 20px 0;opacity:0.8}
.cf-snack-12-v4-copy{width:100%;background:transparent;border:1px dashed {{ section.settings.text_color }};color:{{ section.settings.text_color }};padding:12px;font-family:sans-serif;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;cursor:pointer;transition:0.3s;display:flex;justify-content:space-between;align-items:center}
.cf-snack-12-v4-copy:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
@media(max-width:600px){.cf-snack-12-v4{top:auto;bottom:0;right:0;width:100%;border-radius:20px 20px 0 0}}
</style>

<div class="cf-snack-12-v4" id="cf-snack-12-v4-{{ section.id }}">
  <div class="cf-snack-12-v4-header">
    <h3 class="cf-snack-12-v4-title">{{ section.settings.title }}</h3>
    <button class="cf-snack-12-v4-close" onclick="document.getElementById('cf-snack-12-v4-{{ section.id }}').style.display='none'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <p class="cf-snack-12-v4-desc">{{ section.settings.desc }}</p>
  <button class="cf-snack-12-v4-copy" onclick="navigator.clipboard.writeText('{{ section.settings.code }}'); this.innerHTML='<span>COPIED SUCCESSFULLY</span><svg width=\'16\' height=\'16\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\'><polyline points=\'20 6 9 17 4 12\'></polyline></svg>'">
    <span>{{ section.settings.code }}</span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
  </button>
</div>

{% schema %}
{
  "name": "12 · Women's Snack (v4)",
  "settings": [
    {"type":"text","id":"title","label":"Popup Title","default":"A Gift For You"},
    {"type":"textarea","id":"desc","label":"Description","default":"Enjoy 20% off our new fall arrivals. Simply apply the code at checkout."},
    {"type":"text","id":"code","label":"Promo Code","default":"FALL20"},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#222222"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#E5E5E5"}
  ],
  "presets": [{"name":"12 · Women's Snack (v4)"}]
}
{% endschema %}
