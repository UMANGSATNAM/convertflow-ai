<style>
.cf-trust-11-v9{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-trust-11-v9-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;border-top:1px solid {{ section.settings.border_color }};padding-top:20px}
.cf-trust-11-v9-grid{flex:1;display:flex;justify-content:space-between;align-items:center}
.cf-trust-11-v9-item{display:flex;align-items:center;gap:15px;padding:10px 0}
.cf-trust-11-v9-icon{width:20px;height:20px;color:{{ section.settings.accent_color }}}
.cf-trust-11-v9-title{font-size:13px;font-weight:800;text-transform:uppercase;margin:0;letter-spacing:0.1em}
.cf-trust-11-v9-divider{height:20px;width:1px;background:{{ section.settings.border_color }}}
@media(max-width:900px){.cf-trust-11-v9-grid{flex-wrap:wrap;justify-content:center;gap:20px}.cf-trust-11-v9-divider{display:none}.cf-trust-11-v9-item{flex:0 0 45%;justify-content:center}}
@media(max-width:600px){.cf-trust-11-v9-item{flex:0 0 100%}}
</style>

<div class="cf-trust-11-v9">
  <div class="cf-trust-11-v9-inner">
    <div class="cf-trust-11-v9-grid">
      {% for i in (1..4) %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture icon_key %}icon_{{ i }}{% endcapture %}
        
        <div class="cf-trust-11-v9-item">
          <div class="cf-trust-11-v9-icon">{{ section.settings[icon_key] }}</div>
          <h3 class="cf-trust-11-v9-title">{{ section.settings[title_key] }}</h3>
        </div>
        
        {% if i < 4 %}
          <div class="cf-trust-11-v9-divider"></div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Trust (v9)",
  "settings": [
    {"type":"html","id":"icon_1","label":"Icon 1 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'></path><polyline points='22 4 12 14.01 9 11.01'></polyline></svg>"},
    {"type":"text","id":"title_1","label":"Title 1","default":"FREE SHIPPING"},
    
    {"type":"html","id":"icon_2","label":"Icon 2 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'></path><polyline points='9 22 9 12 15 12 15 22'></polyline></svg>"},
    {"type":"text","id":"title_2","label":"Title 2","default":"IN-STORE PICKUP"},
    
    {"type":"html","id":"icon_3","label":"Icon 3 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z'></path><polyline points='3.27 6.96 12 12.01 20.73 6.96'></polyline><line x1='12' y1='22.08' x2='12' y2='12'></line></svg>"},
    {"type":"text","id":"title_3","label":"Title 3","default":"FREE RETURNS"},
    
    {"type":"html","id":"icon_4","label":"Icon 4 (SVG)","default":"<svg width='100%' height='100%' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='10'></circle><polyline points='12 6 12 12 16 14'></polyline></svg>"},
    {"type":"text","id":"title_4","label":"Title 4","default":"LIFETIME GUARANTEE"},
    
    {"type":"color","id":"bg_color","label":"Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon Color","default":"#5A5A5A"},
    {"type":"color","id":"border_color","label":"Border Dividers","default":"#E2E2E2"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":0,"max":60,"step":5,"default":0}
  ],
  "presets": [{"name":"11 · Men's Trust (v9)"}]
}
{% endschema %}
