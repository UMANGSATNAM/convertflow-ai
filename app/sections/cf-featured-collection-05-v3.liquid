<style>
.cf-fc-05-v3 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
.cf-fc-05-v3-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }
.cf-fc-05-v3-header { text-align: center; margin-bottom: 50px; }
.cf-fc-05-v3-title { font-size: 36px; font-weight: 700; color: {{ section.settings.text_color }}; margin: 0 0 10px 0; }
.cf-fc-05-v3-subtitle { color: #6b7280; font-size: 16px; }
.cf-fc-05-v3-grid { display: grid; grid-template-columns: repeat({{ section.settings.cols }}, 1fr); gap: 25px; }
.cf-fc-05-v3-card { text-decoration: none; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.04); transition: transform 0.3s, box-shadow 0.3s; display: flex; flex-direction: column; }
.cf-fc-05-v3-card:hover { transform: translateY(-6px); box-shadow: 0 12px 30px rgba(0,0,0,0.1); }
.cf-fc-05-v3-img { width: 100%; aspect-ratio: 1; background: #f0fdf4; position: relative; overflow: hidden; }
.cf-fc-05-v3-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
.cf-fc-05-v3-card:hover .cf-fc-05-v3-img img { transform: scale(1.05); }
.cf-fc-05-v3-badge { position: absolute; top: 12px; left: 12px; background: {{ section.settings.accent_color }}; color: #fff; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; }
.cf-fc-05-v3-info { padding: 18px; flex: 1; display: flex; flex-direction: column; }
.cf-fc-05-v3-name { color: {{ section.settings.text_color }}; font-size: 16px; font-weight: 600; margin: 0 0 8px 0; }
.cf-fc-05-v3-price { color: {{ section.settings.accent_color }}; font-size: 16px; font-weight: 700; margin-top: auto; }
@media (max-width: 900px) { .cf-fc-05-v3-grid { grid-template-columns: repeat(2,1fr); } }
</style>
<div class="cf-fc-05-v3">
  <div class="cf-fc-05-v3-inner">
    <div class="cf-fc-05-v3-header">
      <h2 class="cf-fc-05-v3-title">{{ section.settings.title }}</h2>
      <p class="cf-fc-05-v3-subtitle">{{ section.settings.subtitle }}</p>
    </div>
    <div class="cf-fc-05-v3-grid">
      {% for block in section.blocks %}
      <a href="{{ block.settings.url }}" class="cf-fc-05-v3-card">
        <div class="cf-fc-05-v3-img">
          {% if block.settings.badge != blank %}<div class="cf-fc-05-v3-badge">{{ block.settings.badge }}</div>{% endif %}
          {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">{% endif %}
        </div>
        <div class="cf-fc-05-v3-info">
          <div class="cf-fc-05-v3-name">{{ block.settings.title }}</div>
          <div class="cf-fc-05-v3-price">{{ block.settings.price }}</div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}{"name": "03 · Clean Beauty Products","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#f0fdf4"},{"type":"color","id":"text_color","label":"Text Color","default":"#14532d"},{"type":"color","id":"accent_color","label":"Accent Color","default":"#22c55e"},{"type":"text","id":"title","label":"Title","default":"Clean Picks"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Made with ingredients you can trust."},{"type":"range","id":"cols","label":"Columns","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},{"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}],"blocks": [{"type": "product","name": "Product","settings": [{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Face Oil"},{"type":"text","id":"price","label":"Price","default":"$38.00"},{"type":"text","id":"badge","label":"Badge","default":"Organic"},{"type":"url","id":"url","label":"Link"}]}],"presets": [{"name": "03 · Clean Products","blocks": [{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}{% endschema %}
