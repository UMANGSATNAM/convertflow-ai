<style>
.cf-sn-05{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:'Georgia',serif}
.cf-sn-05-inner{max-width:700px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:20px;background:#fff;border-radius:12px;padding:20px 30px;box-shadow:0 10px 30px rgba(0,0,0,0.03)}
.cf-sn-05-content{flex:1;text-align:center}
.cf-sn-05-title{color:{{ section.settings.text_color }};font-size:{{ section.settings.text_size }}px;margin-bottom:8px}
.cf-sn-05-code{display:inline-block;font-family:sans-serif;font-weight:600;font-size:12px;letter-spacing:0.15em;color:{{ section.settings.accent_color }};padding:6px 20px;border:1px dashed {{ section.settings.accent_color }};border-radius:4px;cursor:pointer;transition:0.2s}
.cf-sn-05-code:hover{background:{{ section.settings.accent_color | color_modify: 'alpha', 0.05 }}}
@media(max-width:600px){.cf-sn-05-inner{flex-direction:column}}
</style>

<div class="cf-sn-05">
  <div class="cf-sn-05-inner">
    <div class="cf-sn-05-content">
      <div class="cf-sn-05-title">{{ section.settings.text }}</div>
      <div class="cf-sn-05-code" onclick="navigator.clipboard.writeText('{{ section.settings.code }}');alert('Copied to clipboard. Enjoy!')">USE CODE: {{ section.settings.code }}</div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "05 · Beauty Snack",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"Your secret to glowing skin for less."},
    {"type":"text","id":"code","label":"Promo Code","default":"GLOWUP20"},
    {"type":"range","id":"text_size","label":"Text Size","min":14,"max":32,"step":1,"default":18},
    {"type":"color","id":"bg_color","label":"Outer Background","default":"#fffbfb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4a3c31"},
    {"type":"color","id":"accent_color","label":"Accent (Gold/Pink)","default":"#d4aba0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":60,"step":5,"default":30}
  ],
  "presets": [{"name":"05 · Beauty Snack"}]
}
{% endschema %}
