<style>
.cf-hero-10{width:100%;min-height:{{ section.settings.height }}px;background:{{ section.settings.bg_color }};overflow:hidden;position:relative}
.cf-hero-10-grid{display:grid;grid-template-columns:1fr 1fr;min-height:{{ section.settings.height }}px}
.cf-hero-10-content{display:flex;flex-direction:column;justify-content:center;padding:80px 60px}
.cf-hero-10-breadcrumb{font-size:12px;color:{{ section.settings.text_color }};margin-bottom:20px;opacity:0.6}
.cf-hero-10-breadcrumb a{color:inherit;text-decoration:none}
.cf-hero-10 h1{font-size:clamp(32px,4vw,{{ section.settings.heading_size }}px);font-weight:800;color:{{ section.settings.heading_color }};margin:0 0 16px;line-height:1.1;letter-spacing:-0.02em}
.cf-hero-10-rating{display:flex;align-items:center;gap:8px;margin-bottom:20px}
.cf-hero-10-stars{color:#f59e0b;font-size:16px}
.cf-hero-10-review{font-size:13px;color:{{ section.settings.text_color }}}
.cf-hero-10 p{font-size:16px;color:{{ section.settings.text_color }};line-height:1.7;margin:0 0 28px;max-width:480px}
.cf-hero-10-sizes{display:flex;gap:8px;margin-bottom:28px}
.cf-hero-10-size{width:40px;height:40px;border-radius:8px;border:2px solid #e5e7eb;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;color:{{ section.settings.heading_color }};cursor:pointer;transition:0.15s;background:transparent}
.cf-hero-10-size:hover,.cf-hero-10-size.active{border-color:{{ section.settings.heading_color }};background:{{ section.settings.heading_color }};color:{{ section.settings.bg_color }}}
.cf-hero-10-actions{display:flex;gap:12px}
.cf-hero-10-add{flex:1;padding:16px 32px;border-radius:8px;font-size:15px;font-weight:600;background:{{ section.settings.heading_color }};color:{{ section.settings.bg_color }};border:none;cursor:pointer;transition:0.2s;font-family:inherit}
.cf-hero-10-add:hover{opacity:0.9}
.cf-hero-10-wish{width:52px;height:52px;border-radius:8px;border:2px solid #e5e7eb;background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:0.2s;color:{{ section.settings.text_color }}}
.cf-hero-10-wish:hover{border-color:#ef4444;color:#ef4444}
.cf-hero-10-images{position:relative;display:flex;align-items:center;justify-content:center;background:{{ section.settings.img_bg }}}
.cf-hero-10-images img{width:80%;max-height:80%;object-fit:contain}
.cf-hero-10-thumbs{position:absolute;right:20px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:8px}
.cf-hero-10-thumb{width:56px;height:56px;border-radius:8px;border:2px solid transparent;overflow:hidden;cursor:pointer;opacity:0.5;transition:0.2s}
.cf-hero-10-thumb:hover,.cf-hero-10-thumb.active{opacity:1;border-color:{{ section.settings.heading_color }}}
.cf-hero-10-thumb img{width:100%;height:100%;object-fit:cover}
@media(max-width:768px){.cf-hero-10-grid{grid-template-columns:1fr}.cf-hero-10-content{padding:40px 24px}}
</style>

<section class="cf-hero-10">
  <div class="cf-hero-10-grid">
    <div class="cf-hero-10-content">
      <div class="cf-hero-10-breadcrumb"><a href="/">Home</a> / <a href="/collections/all">Shop</a> / {{ section.settings.heading }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <div class="cf-hero-10-rating">
        <span class="cf-hero-10-stars">★★★★★</span>
        <span class="cf-hero-10-review">{{ section.settings.reviews }} reviews</span>
      </div>
      <p>{{ section.settings.description }}</p>
      <div class="cf-hero-10-sizes">
        {%- assign sizes = section.settings.sizes | split: '|' -%}
        {%- for size in sizes -%}
          <div class="cf-hero-10-size {% if forloop.first %}active{% endif %}">{{ size | strip }}</div>
        {%- endfor -%}
      </div>
      <div class="cf-hero-10-actions">
        <button class="cf-hero-10-add">{{ section.settings.btn_text }} — {{ section.settings.price }}</button>
        <button class="cf-hero-10-wish">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
        </button>
      </div>
    </div>
    <div class="cf-hero-10-images">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading }}" loading="eager">
      {% else %}
        <div style="width:60%;aspect-ratio:3/4;background:linear-gradient(135deg,#e0e7ff,#c7d2fe);border-radius:16px"></div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "10 · Product Showcase Hero",
  "settings": [
    {"type":"text","id":"heading","label":"Product Name","default":"Premium Silk Kurta Set"},
    {"type":"textarea","id":"description","label":"Description","default":"Handwoven with 100% pure silk. This luxurious kurta set features intricate embroidery and a contemporary silhouette."},
    {"type":"text","id":"price","label":"Price","default":"₹3,499"},
    {"type":"text","id":"reviews","label":"Reviews Count","default":"2,847"},
    {"type":"text","id":"sizes","label":"Sizes (| separated)","default":"XS|S|M|L|XL|XXL"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Add to Cart"},
    {"type":"image_picker","id":"image","label":"Product Image"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"img_bg","label":"Image Background","default":"#f5f5f4"},
    {"type":"color","id":"heading_color","label":"Heading Color","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#6b7280"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":28,"max":60,"step":2,"default":40},
    {"type":"range","id":"height","label":"Min Height","min":400,"max":700,"step":50,"default":550}
  ],
  "presets": [{"name":"10 · Product Showcase Hero"}]
}
{% endschema %}
