<style>
.cf-pr-12{width:100%;height:{{ section.settings.height }}vh;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#f5eef0}
.cf-pr-12-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:0.85;transition:transform 3s ease}
.cf-pr-12:hover .cf-pr-12-img{transform:scale(1.03)}
.cf-pr-12-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:linear-gradient(to top, {{ section.settings.overlay_color | color_modify: 'alpha', 0.6 }}, transparent 50%)}
.cf-pr-12-content{position:relative;z-index:2;text-align:center;padding:40px;max-width:800px;background:rgba(255,255,255,0.1);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.2)}
.cf-pr-12-sub{font-family:sans-serif;font-size:12px;color:{{ section.settings.text_color }};letter-spacing:0.2em;text-transform:uppercase;margin-bottom:15px}
.cf-pr-12-title{font-family:'Playfair Display',serif;font-size:clamp(40px,8vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:400;font-style:italic;line-height:1.1;margin-bottom:30px;letter-spacing:-0.01em}
.cf-pr-12-btn{font-family:sans-serif;display:inline-block;padding:14px 40px;background:none;border:1px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-size:11px;letter-spacing:0.2em;text-transform:uppercase;transition:0.3s}
.cf-pr-12-btn:hover{background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }}}
@media(max-width:768px){.cf-pr-12-content{padding:30px 20px;margin:20px}}
</style>

<div class="cf-pr-12">
  {% if section.settings.image %}
    <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="Promo" class="cf-pr-12-img">
  {% else %}
    <div style="position:absolute;top:0;left:0;width:100%;height:100%;background:#e2cbd1;display:flex;align-items:center;justify-content:center;color:#bca1a8;font-size:24px">BRAND MAGAZINE</div>
  {% endif %}
  <div class="cf-pr-12-overlay"></div>
  <div class="cf-pr-12-content">
    <div class="cf-pr-12-sub">{{ section.settings.subtitle }}</div>
    <h2 class="cf-pr-12-title">{{ section.settings.title }}</h2>
    <a href="{{ section.settings.btn_link }}" class="cf-pr-12-btn">{{ section.settings.btn_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Promo",
  "settings": [
    {"type":"image_picker","id":"image","label":"Background Image"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"SUMMER EDIT"},
    {"type":"text","id":"title","label":"Title","default":"The Art of Dressing Well"},
    {"type":"range","id":"title_size","label":"Title Size","min":40,"max":120,"step":4,"default":80},
    {"type":"text","id":"btn_label","label":"Button Label","default":"Discover the collection"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Inside Btn Text Color on Hover","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#332a26"},
    {"type":"color","id":"overlay_color","label":"Gradient Overlay","default":"#ffffff"},
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":90}
  ],
  "presets": [{"name":"12 · Women's Promo"}]
}
{% endschema %}
