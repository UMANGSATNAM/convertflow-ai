<style>
.cf-feat-13-v10{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;position:relative}
.cf-feat-13-v10-inner{max-width:1800px;margin:0 auto}
.cf-feat-13-v10-header{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:80px;border-bottom:1px solid {{ section.settings.text_color }};padding-bottom:30px}
.cf-feat-13-v10-title{font-family:serif;font-style:italic;font-size:clamp(40px, 6vw, 84px);line-height:1;margin:0;font-weight:400}
.cf-feat-13-v10-btn{font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;color:{{ section.settings.text_color }};transition:0.3s;display:flex;align-items:center;gap:10px}
.cf-feat-13-v10-btn:hover{gap:15px;color:{{ section.settings.accent_color }}}
.cf-feat-13-v10-layout{display:grid;grid-template-columns:repeat(12, 1fr);row-gap:80px}
.cf-feat-13-v10-card{text-decoration:none;color:inherit;display:block}
.cf-feat-13-v10-card:nth-child(1){grid-column:1 / span 5}
.cf-feat-13-v10-card:nth-child(2){grid-column:8 / span 4;margin-top:200px}
.cf-feat-13-v10-card:nth-child(3){grid-column:2 / span 6}
.cf-feat-13-v10-card:nth-child(4){grid-column:9 / span 3;margin-top:-100px}
.cf-feat-13-v10-img-wrap{width:100%;aspect-ratio:3/4;background:#f4f4f4;margin-bottom:20px;overflow:hidden}
.cf-feat-13-v10-img{width:100%;height:100%;object-fit:cover;transition:0.8s}
.cf-feat-13-v10-card:hover .cf-feat-13-v10-img{transform:scale(1.05)}
.cf-feat-13-v10-info{text-align:center}
.cf-feat-13-v10-name{font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:0.05em;margin:0 0 5px 0}
.cf-feat-13-v10-price{font-size:13px;opacity:0.7}
@media(max-width:1024px){
  .cf-feat-13-v10-layout{grid-template-columns:1fr 1fr;column-gap:40px;row-gap:60px}
  .cf-feat-13-v10-card:nth-child(n){grid-column:span 1;margin-top:0}
  .cf-feat-13-v10-card:nth-child(2n){margin-top:100px}
}
@media(max-width:600px){
  .cf-feat-13-v10-layout{grid-template-columns:1fr;row-gap:40px}
  .cf-feat-13-v10-card:nth-child(n){grid-column:span 1;margin-top:0}
  .cf-feat-13-v10-header{flex-direction:column;align-items:flex-start;gap:20px}
}
</style>

<div class="cf-feat-13-v10">
  <div class="cf-feat-13-v10-inner">
    <div class="cf-feat-13-v10-header">
      <h2 class="cf-feat-13-v10-title">{{ section.settings.title }}</h2>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-feat-13-v10-btn">
          {{ section.settings.btn_text }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      {% endif %}
    </div>
    
    <div class="cf-feat-13-v10-layout">
      {% for i in (1..4) %}
        <a href="#" class="cf-feat-13-v10-card">
          <div class="cf-feat-13-v10-img-wrap">
            <div class="cf-feat-13-v10-img" style="background:#555;"></div>
          </div>
          <div class="cf-feat-13-v10-info">
            <h3 class="cf-feat-13-v10-name">Editorial Garment 0{{ i }}</h3>
            <div class="cf-feat-13-v10-price">$220</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Featured (v10)",
  "settings": [
    {"type":"text","id":"title","label":"Header Title","default":"Curated Selection"},
    {"type":"text","id":"btn_text","label":"Button Text","default":"View Editorial"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#A38971"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Featured (v10)"}]
}
{% endschema %}
