<style>
.cf-pr-02{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:sans-serif}
.cf-pr-02-inner{max-width:1400px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;min-height:{{ section.settings.height }}px;border:4px solid {{ section.settings.border_color }};position:relative;background:#000}
.cf-pr-02-tape{position:absolute;top:20px;left:-20px;background:{{ section.settings.accent_color }};color:#000;font-weight:900;text-transform:uppercase;padding:5px 40px;transform:rotate(-5deg);font-size:14px;letter-spacing:0.1em;border-top:2px dashed #000;border-bottom:2px dashed #000;box-shadow:0 4px 10px rgba(0,0,0,0.5);z-index:10}
.cf-pr-02-img{flex:1;min-width:300px;height:100%;min-height:400px;object-fit:cover;filter:contrast(1.2) grayscale(0.2)}
.cf-pr-02-content{flex:1;min-width:300px;padding:60px;text-align:left;position:relative}
.cf-pr-02-glitch{font-size:clamp(40px,6vw,{{ section.settings.title_size }}px);font-weight:900;color:{{ section.settings.text_color }};text-transform:uppercase;line-height:0.9;margin-bottom:20px;letter-spacing:-0.03em;position:relative}
.cf-pr-02-glitch::before{content:attr(data-text);position:absolute;left:-2px;text-shadow:2px 0 blue;top:0;color:white;background:black;overflow:hidden;clip:rect(0,900px,0,0);animation:cf-pr-02-g 3s infinite linear alternate-reverse}
.cf-pr-02-desc{font-size:16px;color:#a3a3a3;margin-bottom:40px;max-width:400px;line-height:1.5;font-weight:500}
.cf-pr-02-btn{display:inline-block;padding:16px 40px;background:{{ section.settings.accent_color }};color:#000;text-decoration:none;font-weight:900;font-size:16px;text-transform:uppercase;transition:0.2s;box-shadow:4px 4px 0 {{ section.settings.border_color }}}
.cf-pr-02-btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 {{ section.settings.border_color }}}
@keyframes cf-pr-02-g{0%{clip:rect(40px,9999px,45px,0)}5%{clip:rect(9px,9999px,90px,0)}10%{clip:rect(30px,9999px,12px,0)}15%{clip:rect(66px,9999px,11px,0)}20%{clip:rect(2px,9999px,88px,0)}100%{clip:rect(10px,9999px,90px,0)}}
@media(max-width:768px){.cf-pr-02-content{padding:40px 20px}}
</style>

<div class="cf-pr-02">
  <div class="cf-pr-02-inner">
    <div class="cf-pr-02-tape">{{ section.settings.tape_text }}</div>
    
    {% if section.settings.image != blank %}
      <img class="cf-pr-02-img" src="{{ section.settings.image | image_url: width: 1000 }}" alt="Promo">
    {% else %}
      <div class="cf-pr-02-img" style="background:#222"></div>
    {% endif %}
    
    <div class="cf-pr-02-content">
      <h2 class="cf-pr-02-glitch" data-text="{{ section.settings.title }}">{{ section.settings.title }}</h2>
      <p class="cf-pr-02-desc">{{ section.settings.desc }}</p>
      <a href="{{ section.settings.btn_link }}" class="cf-pr-02-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "02 · Streetwear Promo",
  "settings": [
    {"type":"image_picker","id":"image","label":"Side Image"},
    {"type":"text","id":"tape_text","label":"Yellow Tape Text","default":"AUTHORISED PERSONNEL ONLY"},
    {"type":"text","id":"title","label":"Title","default":"THE OUTLAW COLLECTION"},
    {"type":"range","id":"title_size","label":"Title Size","min":32,"max":100,"step":4,"default":72},
    {"type":"textarea","id":"desc","label":"Description","default":"Restricted archive pieces are now available for exactly 24 hours. Don't sleep."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"ENTER ARCHIVE"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Outer Background","default":"#ffffff"},
    {"type":"color","id":"border_color","label":"Border/Box Shadow","default":"#ef4444"},
    {"type":"color","id":"text_color","label":"Title Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Tape/Btn Color","default":"#eab308"},
    {"type":"range","id":"height","label":"Min Height","min":400,"max":800,"step":50,"default":600},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":0,"max":100,"step":10,"default":40}
  ],
  "presets": [{"name":"02 · Streetwear Promo"}]
}
{% endschema %}
