<style>
.cf-marquee-01-v4{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};display:flex;flex-direction:column}
.cf-marquee-01-v4-band{width:100%;overflow:hidden;padding:25px 0;border-bottom:1px solid {{ section.settings.border_color }}}
.cf-marquee-01-v4-band:last-child{border-bottom:none}
.cf-marquee-01-v4-track-1{display:flex;white-space:nowrap;animation:cf-marquee-01-v4-scroll-1 {{ section.settings.speed }}s linear infinite}
.cf-marquee-01-v4-track-2{display:flex;white-space:nowrap;animation:cf-marquee-01-v4-scroll-2 {{ section.settings.speed_2 }}s linear infinite}
.cf-marquee-01-v4-item-1{display:inline-flex;align-items:center;padding:0 50px;font-family:serif;font-size:24px;font-weight:400;letter-spacing:0.05em;text-transform:uppercase}
.cf-marquee-01-v4-item-2{display:inline-flex;align-items:center;padding:0 50px;font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:{{ section.settings.accent_text }}}
@keyframes cf-marquee-01-v4-scroll-1{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
@keyframes cf-marquee-01-v4-scroll-2{0%{transform:translateX(-50%)} 100%{transform:translateX(0)}}
</style>

<div class="cf-marquee-01-v4">
  <div class="cf-marquee-01-v4-band">
    <div class="cf-marquee-01-v4-track-1">
      {% for j in (1..3) %}
        {% for i in (1..5) %}
          <div class="cf-marquee-01-v4-item-1">{{ section.settings.text_1 }}</div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="cf-marquee-01-v4-band" style="background:{{ section.settings.accent_bg }}">
    <div class="cf-marquee-01-v4-track-2">
      {% for j in (1..3) %}
        {% for i in (1..6) %}
          <div class="cf-marquee-01-v4-item-2">{{ section.settings.text_2 }}</div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v4)",
  "settings": [
    {"type":"text","id":"text_1","label":"Top Row Text","default":"PERMANENT COLLECTION"},
    {"type":"text","id":"text_2","label":"Bottom Row Text","default":"READY TO WEAR / LEATHER GOODS / ACCESSORIES"},
    {"type":"range","id":"speed","label":"Top Scroll Speed","min":10,"max":100,"step":5,"default":40},
    {"type":"range","id":"speed_2","label":"Bottom Scroll Speed","min":10,"max":100,"step":5,"default":55},
    {"type":"color","id":"bg_color","label":"Top Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Top Text Color","default":"#111111"},
    {"type":"color","id":"accent_bg","label":"Bottom Canvas","default":"#111111"},
    {"type":"color","id":"accent_text","label":"Bottom Text Color","default":"#FFFFFF"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#111111"}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v4)"}]
}
{% endschema %}
