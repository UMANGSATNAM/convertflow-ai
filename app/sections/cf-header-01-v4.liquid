<style>
.cf-header-01-v4{width:100%;position:absolute;top:0;left:0;z-index:100;background:rgba(0,0,0,0.1);padding:30px 40px;color:#FFFFFF;font-family:serif;transition:background 0.4s}
.cf-header-01-v4:hover{background:rgba(0,0,0,0.7)}
.cf-header-01-v4-inner{max-width:1800px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}
.cf-header-01-v4-nav{display:flex;gap:40px;flex:1}
.cf-header-01-v4-link{font-size:14px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;color:inherit;position:relative;padding-bottom:5px}
.cf-header-01-v4-link::after{content:"";position:absolute;bottom:0;left:0;width:0;height:1px;background:#FFFFFF;transition:width 0.3s}
.cf-header-01-v4-link:hover::after{width:100%}
.cf-header-01-v4-logo{font-size:40px;font-style:italic;letter-spacing:0.1em;text-decoration:none;color:inherit;text-align:center;flex:1}
.cf-header-01-v4-actions{display:flex;gap:30px;justify-content:flex-end;flex:1}
.cf-header-01-v4-icon{text-decoration:none;color:inherit;font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;padding-bottom:5px;border-bottom:1px solid transparent;transition:0.3s}
.cf-header-01-v4-icon:hover{border-color:#FFFFFF}
@media(max-width:1024px){
  .cf-header-01-v4-nav{display:none}
  .cf-header-01-v4-inner{justify-content:space-between}
  .cf-header-01-v4-logo{text-align:left;font-size:28px;}
}
</style>

<div class="cf-header-01-v4">
  <div class="cf-header-01-v4-inner">
    <nav class="cf-header-01-v4-nav">
      {% for link in linklists[section.settings.menu].links limit: 4 %}
        <a href="{{ link.url }}" class="cf-header-01-v4-link">{{ link.title }}</a>
      {% endfor %}
    </nav>
    
    <a href="/" class="cf-header-01-v4-logo">{{ shop.name }}</a>
    
    <div class="cf-header-01-v4-actions">
      <a href="/search" class="cf-header-01-v4-icon">Search</a>
      <a href="/cart" class="cf-header-01-v4-icon">Cart (0)</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Header (v4)",
  "settings": [
    {"type":"link_list","id":"menu","label":"Header Menu","default":"main-menu"}
  ],
  "presets": [{"name":"01 · Luxury Header (v4)"}]
}
{% endschema %}
