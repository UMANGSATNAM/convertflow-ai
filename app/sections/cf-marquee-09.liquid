<style>
.cf-mq-09{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;border-top:1px solid {{ section.settings.border_color }};border-bottom:1px solid {{ section.settings.border_color }}}
.cf-mq-09-wrap{display:flex;white-space:nowrap;animation:cf-mq-09-s {{ section.settings.speed }}s linear infinite}
.cf-mq-09-item{font-family:serif;color:{{ section.settings.text_color }};font-size:{{ section.settings.text_size }}px;padding:0 50px;display:flex;align-items:center;gap:50px;opacity:0.8}
.cf-mq-09-sep{width:6px;height:6px;border-radius:50%;background:{{ section.settings.accent_color }}}
@keyframes cf-mq-09-s{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>
<div class="cf-mq-09">
  <div class="cf-mq-09-wrap">
    {% assign reps = (1..15) %}
    {% for i in reps %}
      <div class="cf-mq-09-item">
        <span>{{ section.settings.text }}</span>
        <div class="cf-mq-09-sep"></div>
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "09 · Furniture Marquee",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"Sustainably Crafted — Designed for Life"},
    {"type":"color","id":"bg_color","label":"Background","default":"#f5f5f4"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#e7e5e4"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#57534e"},
    {"type":"color","id":"accent_color","label":"Dot Color","default":"#a8a29e"},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":60,"step":2,"default":40},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":32,"step":1,"default":14},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":16}
  ],
  "presets": [{"name":"09 · Furniture Marquee"}]
}
{% endschema %}
