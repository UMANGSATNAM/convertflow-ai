<style>
.cf-cro-cmp{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-cmp-inner{max-width:900px;margin:0 auto}
.cf-cro-cmp-head{text-align:center;margin-bottom:40px}
.cf-cro-cmp h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-cmp-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-cro-cmp-table{width:100%;border-collapse:separate;border-spacing:0;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06)}
.cf-cro-cmp-table th,.cf-cro-cmp-table td{padding:16px 24px;text-align:center;font-size:15px}
.cf-cro-cmp-table th{font-weight:700;font-size:16px}
.cf-cro-cmp-table th:first-child{text-align:left;width:40%}
.cf-cro-cmp-table td:first-child{text-align:left;font-weight:600;color:{{ section.settings.text_color }}}
.cf-cro-cmp-thead th{background:{{ section.settings.text_color }}08;color:{{ section.settings.text_color }}}
.cf-cro-cmp-thead th:nth-child(2){background:{{ section.settings.accent_color }};color:#fff;border-radius:12px 12px 0 0;position:relative}
.cf-cro-cmp-thead th:nth-child(2)::before{content:'⭐ RECOMMENDED';position:absolute;top:-28px;left:50%;transform:translateX(-50%);background:{{ section.settings.accent_color }};color:#fff;padding:4px 14px;border-radius:100px;font-size:10px;letter-spacing:0.08em;white-space:nowrap}
.cf-cro-cmp-table tbody tr{border-bottom:1px solid {{ section.settings.text_color }}08}
.cf-cro-cmp-table tbody tr:nth-child(even){background:{{ section.settings.text_color }}03}
.cf-cro-cmp-table tbody td:nth-child(2){background:{{ section.settings.accent_color }}05;font-weight:700}
.cf-cro-cmp-yes{color:{{ section.settings.accent_color }};font-size:20px}
.cf-cro-cmp-no{color:#E53E3E;font-size:20px}
.cf-cro-cmp-text{color:{{ section.settings.text_color }};opacity:0.7}
.cf-cro-cmp-cta{text-align:center;margin-top:32px}
.cf-cro-cmp-btn{display:inline-flex;align-items:center;gap:8px;padding:16px 40px;background:{{ section.settings.accent_color }};color:#fff;border-radius:12px;font-size:16px;font-weight:700;text-decoration:none;transition:0.2s;box-shadow:0 4px 14px {{ section.settings.accent_color }}40}
.cf-cro-cmp-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px {{ section.settings.accent_color }}50}
@media(max-width:600px){.cf-cro-cmp-table th,.cf-cro-cmp-table td{padding:12px 10px;font-size:13px}}
</style>

<div class="cf-cro-cmp">
  <div class="cf-cro-cmp-inner">
    <div class="cf-cro-cmp-head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="cf-cro-cmp-sub">{{ section.settings.subheading }}</p>
    </div>
    <table class="cf-cro-cmp-table">
      <thead class="cf-cro-cmp-thead">
        <tr>
          <th>Feature</th>
          <th>{{ section.settings.brand_name }}</th>
          <th>{{ section.settings.competitor_name }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for i in (1..6) -%}
          {%- assign feat_key = 'feature_' | append: i -%}
          {%- assign us_key = 'us_' | append: i -%}
          {%- assign them_key = 'them_' | append: i -%}
          {% if section.settings[feat_key] != blank %}
            <tr>
              <td>{{ section.settings[feat_key] }}</td>
              <td>{% if section.settings[us_key] == 'yes' %}<span class="cf-cro-cmp-yes">✓</span>{% elsif section.settings[us_key] == 'no' %}<span class="cf-cro-cmp-no">✗</span>{% else %}<span class="cf-cro-cmp-text">{{ section.settings[us_key] }}</span>{% endif %}</td>
              <td>{% if section.settings[them_key] == 'yes' %}<span class="cf-cro-cmp-yes">✓</span>{% elsif section.settings[them_key] == 'no' %}<span class="cf-cro-cmp-no">✗</span>{% else %}<span class="cf-cro-cmp-text">{{ section.settings[them_key] }}</span>{% endif %}</td>
            </tr>
          {% endif %}
        {%- endfor -%}
      </tbody>
    </table>
    <div class="cf-cro-cmp-cta">
      <a href="{{ section.settings.cta_link }}" class="cf-cro-cmp-btn">{{ section.settings.cta_text }} →</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Us vs Them",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Why Choose Us?"},
    {"type":"text","id":"subheading","label":"Subheading","default":"See how we compare to the competition"},
    {"type":"text","id":"brand_name","label":"Your Brand","default":"Our Brand"},
    {"type":"text","id":"competitor_name","label":"Competitor","default":"Others"},
    {"type":"text","id":"feature_1","label":"Feature 1","default":"Premium Quality Materials"},
    {"type":"text","id":"us_1","label":"Us 1 (yes/no/text)","default":"yes"},
    {"type":"text","id":"them_1","label":"Them 1 (yes/no/text)","default":"no"},
    {"type":"text","id":"feature_2","label":"Feature 2","default":"30-Day Money-Back Guarantee"},
    {"type":"text","id":"us_2","label":"Us 2","default":"yes"},
    {"type":"text","id":"them_2","label":"Them 2","default":"no"},
    {"type":"text","id":"feature_3","label":"Feature 3","default":"Free Shipping Worldwide"},
    {"type":"text","id":"us_3","label":"Us 3","default":"yes"},
    {"type":"text","id":"them_3","label":"Them 3","default":"$9.99+"},
    {"type":"text","id":"feature_4","label":"Feature 4","default":"24/7 Customer Support"},
    {"type":"text","id":"us_4","label":"Us 4","default":"yes"},
    {"type":"text","id":"them_4","label":"Them 4","default":"no"},
    {"type":"text","id":"feature_5","label":"Feature 5","default":"Sustainably Sourced"},
    {"type":"text","id":"us_5","label":"Us 5","default":"yes"},
    {"type":"text","id":"them_5","label":"Them 5","default":"no"},
    {"type":"text","id":"feature_6","label":"Feature 6","default":"Average Rating"},
    {"type":"text","id":"us_6","label":"Us 6","default":"4.9/5 ★"},
    {"type":"text","id":"them_6","label":"Them 6","default":"3.8/5"},
    {"type":"text","id":"cta_text","label":"CTA Text","default":"Shop Now"},
    {"type":"text","id":"cta_link","label":"CTA Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#16A34A"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Us vs Them"}]
}
{% endschema %}
