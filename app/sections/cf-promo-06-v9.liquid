<div class="cf-auto-promo-v9" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 80px 20px; overflow: hidden;">
  <div class="cf-auto-promo-v9-container" style="max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: center;">

    <div style="width: 100%; border: 3px solid {{ section.settings.accent_color }}; position: relative; padding: 60px 40px; display: flex; justify-content: space-between; align-items: center; gap: 40px; background: rgba(0,0,0,0.5);">
      
      <!-- BG Image behind border box if needed, or inside -->
      {% if section.settings.bg_image %}
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;">
          <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.4;" alt="Promo">
        </div>
      {% endif %}

      <div style="flex: 1; max-width: 600px; position: relative; z-index: 2;">
        <h2 style="font-family: 'Oswald', sans-serif; font-weight: 700; font-size: {{ section.settings.title_size }}px; line-height: 1; margin: 0 0 15px 0; text-transform: uppercase;">
          {{ section.settings.title }}
        </h2>
        <p style="font-family: 'Roboto', sans-serif; font-size: 18px; margin: 0; color: {{ section.settings.accent_color }}; font-weight: 500;">
          {{ section.settings.subtitle }}
        </p>
      </div>

      <div style="flex: 0 0 auto; position: relative; z-index: 2;">
        <a href="{{ section.settings.btn_link }}" class="cf-btn-v9" style="display: inline-block; background: {{ section.settings.accent_color }}; color: #000; padding: 18px 45px; font-family: 'Oswald', sans-serif; font-size: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; text-decoration: none; border: 3px solid {{ section.settings.accent_color }}; transition: all 0.2s; box-shadow: 8px 8px 0 {{ section.settings.text_color }};">
          {{ section.settings.btn_text }}
        </a>
      </div>

      <!-- Accent elements -->
      <div style="position: absolute; top: -3px; left: 40px; width: 50px; height: 6px; background: {{ section.settings.bg_color }};"></div>
      <div style="position: absolute; bottom: -3px; right: 40px; width: 50px; height: 6px; background: {{ section.settings.bg_color }};"></div>

    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap');
  
  .cf-btn-v9:hover {
    box-shadow: 4px 4px 0 {{ section.settings.text_color }};
    transform: translate(4px, 4px);
  }

  @media (max-width: 900px) {
    .cf-auto-promo-v9-container > div {
      flex-direction: column;
      text-align: center;
      padding: 40px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "06 · Boxed Racing Promo",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e60000"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Pattern/Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "CLEARANCE SALE"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 80
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "UP TO 50% OFF EXHAUST SYSTEMS"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP CLEARANCE"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
