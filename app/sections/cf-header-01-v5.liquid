<style>
.cf-header-01-v5{width:100%;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;border-bottom:1px solid {{ section.settings.border_color }};position:relative;z-index:50}
.cf-header-01-v5-inner{max-width:1600px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;padding:20px 40px}
.cf-header-01-v5-left{display:flex;align-items:center;gap:60px;flex:1}
.cf-header-01-v5-logo{font-size:28px;font-style:italic;letter-spacing:0.1em;text-decoration:none;color:inherit;flex-shrink:0}
.cf-header-01-v5-nav{display:flex;gap:35px}
.cf-header-01-v5-link{font-family:sans-serif;font-size:12px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;text-decoration:none;color:inherit;transition:0.3s;opacity:0.75}
.cf-header-01-v5-link:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-header-01-v5-right{display:flex;justify-content:flex-end;gap:30px;flex:1}
.cf-header-01-v5-icon{display:flex;align-items:center;text-decoration:none;color:inherit;transition:0.3s;opacity:0.75}
.cf-header-01-v5-icon:hover{opacity:1;color:{{ section.settings.accent_color }}}
.cf-header-01-v5-icon svg{width:18px;height:18px;stroke-width:1.5;fill:none;stroke:currentColor}
@media(max-width:1024px){
  .cf-header-01-v5-nav{display:none}
  .cf-header-01-v5-inner{padding:20px}
}
</style>

<div class="cf-header-01-v5">
  <div class="cf-header-01-v5-inner">
    <div class="cf-header-01-v5-left">
      <a href="/" class="cf-header-01-v5-logo">{{ shop.name }}</a>
      <nav class="cf-header-01-v5-nav">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}" class="cf-header-01-v5-link">{{ link.title }}</a>
        {% endfor %}
      </nav>
    </div>
    
    <div class="cf-header-01-v5-right">
      <a href="/search" class="cf-header-01-v5-icon">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </a>
      <a href="/account" class="cf-header-01-v5-icon">
        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>
      <a href="/cart" class="cf-header-01-v5-icon">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Header (v5)",
  "settings": [
    {"type":"link_list","id":"menu","label":"Header Menu","default":"main-menu"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#333333"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#D4AF37"}
  ],
  "presets": [{"name":"01 · Luxury Header (v5)"}]
}
{% endschema %}
