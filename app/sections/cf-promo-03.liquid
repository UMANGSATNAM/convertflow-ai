<style>
.cf-pr-03{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:system-ui,-apple-system,sans-serif}
.cf-pr-03-inner{max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;border-radius:24px;overflow:hidden;background:linear-gradient(135deg, #1e293b, #0f172a);box-shadow:0 20px 40px rgba(0,0,0,0.4);border:1px solid rgba(255,255,255,0.05)}
.cf-pr-03-left{flex:1;min-width:300px;padding:60px;display:flex;flex-direction:column;justify-content:center;position:relative}
.cf-pr-03-left::before{content:'';position:absolute;top:0;left:0;width:100%;height:100%;background:url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMCIgaGVpZ2h0PSIyMCI+PHBhdGggZD0iTTAgMGgyMHYyMEgwVjB6IiBmaWxsPSJub25lIi8+PGNpcmNsZSBjeD0iMSIgY3k9IjEiIHI9IjEiIGZpbGw9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiLz48L3N2Zz4=');z-index:0;opacity:0.5}
.cf-pr-03-content{position:relative;z-index:1}
.cf-pr-03-badge{display:inline-block;padding:6px 12px;background:rgba(16, 185, 129, 0.1);color:{{ section.settings.accent_color }};border:1px solid rgba(16, 185, 129, 0.2);border-radius:100px;font-size:12px;font-weight:700;letter-spacing:0.05em;margin-bottom:20px}
.cf-pr-03-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};line-height:1.1;font-weight:800;margin-bottom:20px}
.cf-pr-03-desc{font-size:16px;color:#94a3b8;margin-bottom:40px;line-height:1.6}
.cf-pr-03-right{flex:1;min-width:300px;background:#020617;display:flex;align-items:center;justify-content:center;padding:40px}
.cf-pr-03-timer{display:flex;gap:20px}
.cf-pr-03-time-block{display:flex;flex-direction:column;align-items:center;background:#0f172a;padding:20px;border-radius:16px;border:1px solid rgba(255,255,255,0.05)}
.cf-pr-03-time-val{font-family:monospace;font-size:40px;font-weight:700;color:{{ section.settings.accent_color }};line-height:1;margin-bottom:8px}
.cf-pr-03-time-lbl{font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:0.1em;font-weight:600}
.cf-pr-03-btn{display:inline-flex;padding:16px 32px;background:{{ section.settings.accent_color }};color:#fff;text-decoration:none;font-weight:600;font-size:15px;border-radius:8px;transition:0.2s}
.cf-pr-03-btn:hover{filter:brightness(1.1);box-shadow:0 0 20px rgba(16, 185, 129, 0.4)}
@media(max-width:768px){.cf-pr-03-left{padding:40px 20px}.cf-pr-03-timer{gap:10px}.cf-pr-03-time-block{padding:15px}.cf-pr-03-time-val{font-size:28px}}
</style>

<div class="cf-pr-03">
  <div class="cf-pr-03-inner">
    <div class="cf-pr-03-left">
      <div class="cf-pr-03-content">
        <div class="cf-pr-03-badge">LIMITED TIME OFFER</div>
        <h2 class="cf-pr-03-title">{{ section.settings.title }}</h2>
        <p class="cf-pr-03-desc">{{ section.settings.desc }}</p>
        <a href="{{ section.settings.btn_link }}" class="cf-pr-03-btn">{{ section.settings.btn_label }}</a>
      </div>
    </div>
    <div class="cf-pr-03-right">
      <div class="cf-pr-03-timer">
        <div class="cf-pr-03-time-block"><span class="cf-pr-03-time-val">12</span><span class="cf-pr-03-time-lbl">Hours</span></div>
        <div class="cf-pr-03-time-block"><span class="cf-pr-03-time-val">45</span><span class="cf-pr-03-time-lbl">Mins</span></div>
        <div class="cf-pr-03-time-block"><span class="cf-pr-03-time-val">30</span><span class="cf-pr-03-time-lbl">Secs</span></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Tech Promo",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Early Access Developer Deal💳"},
    {"type":"range","id":"title_size","label":"Title Size","min":32,"max":64,"step":2,"default":48},
    {"type":"textarea","id":"desc","label":"Description","default":"Upgrade your rig before the offer expires. Discount applies directly at checkout."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"Claim 30% Off Now"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Outer Background","default":"#0f172a"},
    {"type":"color","id":"text_color","label":"Title Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Accent (Green) Color","default":"#10b981"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":0,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"03 · Tech Promo"}]
}
{% endschema %}
