<style>
.cf-header-03-v8 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  position: relative;
  overflow: hidden;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

/* Rain Effect Background */
.cf-header-03-v8::before {
  content: '';
  position: absolute;
  top: -100%; left: 0; width: 100%; height: 300%;
  background-image: 
    linear-gradient(0deg, transparent 95%, {{ section.settings.accent_color }}40 100%),
    repeating-linear-gradient(90deg, transparent, transparent 10px, {{ section.settings.accent_color }}10 10px, {{ section.settings.accent_color }}10 11px);
  background-size: 100% 50px, 100% 100%;
  animation: cf-h3-v8-rain 2s linear infinite;
  z-index: 1;
  pointer-events: none;
}

@keyframes cf-h3-v8-rain {
  0% { transform: translateY(0); }
  100% { transform: translateY(50px); }
}

.cf-header-03-v8-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  padding: {{ section.settings.padding_y }}px 20px;
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  z-index: 2;
}

.cf-header-03-v8-logo {
  font-size: {{ section.settings.logo_size }}px;
  font-weight: 900;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: #000;
  padding: 5px 15px;
  border: 1px solid {{ section.settings.accent_color }};
  box-shadow: 0 0 10px {{ section.settings.accent_color }} inset;
}

.cf-header-03-v8-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: rgba(0,0,0,0.8);
  border-top: 1px solid {{ section.settings.accent_color }}50;
  padding-top: 15px;
}

.cf-header-03-v8-nav {
  display: none;
  align-items: center;
  gap: 20px;
}

.cf-header-03-v8-nav a {
  color: {{ section.settings.text_color }};
  text-decoration: none;
  font-size: 13px;
  text-transform: uppercase;
  transition: 0.2s;
}

.cf-header-03-v8-nav a:hover {
  color: {{ section.settings.accent_color }};
  text-shadow: 0 0 5px {{ section.settings.accent_color }};
}

.cf-header-03-v8-nav a::before {
  content: '>';
  color: {{ section.settings.accent_color }};
  margin-right: 5px;
  opacity: 0;
  transition: 0.2s;
}

.cf-header-03-v8-nav a:hover::before {
  opacity: 1;
}

.cf-header-03-v8-actions {
  display: flex;
  gap: 15px;
  align-items: center;
}

.cf-header-03-v8-actions a {
  color: {{ section.settings.text_color }};
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  text-decoration: none;
  text-transform: uppercase;
  transition: 0.2s;
}

.cf-header-03-v8-actions a:hover {
  color: {{ section.settings.accent_color }};
}

.cf-header-03-v8-actions svg {
  width: 16px; height: 16px;
}

@media (min-width: 768px) {
  .cf-header-03-v8-nav { display: flex; }
}
</style>

<div class="cf-header-03-v8">
  <div class="cf-header-03-v8-inner">
    
    <a href="/" class="cf-header-03-v8-logo">{{ section.settings.logo_text }}</a>

    <div class="cf-header-03-v8-bot">
      <nav class="cf-header-03-v8-nav">
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>

      <div class="cf-header-03-v8-actions">
        <a href="/search" aria-label="Search">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
           <span>SCAN</span>
        </a>
        <a href="/cart" aria-label="Cart">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
           <span>LOAD</span>
        </a>
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "08 · Hacker Matrix",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#050505"},
    {"type":"text","id":"logo_text","label":"Logo Text","default":"0xDATA_CORE"},
    {"type":"range","id":"logo_size","label":"Logo Size","min":16,"max":48,"step":2,"default":28},
    {"type":"link_list","id":"menu","label":"Menu","default":"main-menu"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#aaaaaa"},
    {"type":"color","id":"accent_color","label":"Matrix Green Accent","default":"#00ff41"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":50,"step":2,"default":20},
    {"type":"range","id":"max_width","label":"Max Width","min":1000,"max":1800,"step":100,"default":1200}
  ],
  "presets": [{"name":"08 · Hacker Matrix Header"}]
}
{% endschema %}
