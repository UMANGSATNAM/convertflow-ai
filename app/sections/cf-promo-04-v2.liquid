<style>
.cf-pr-04-v2 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.cf-pr-04-v2-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.03);
}

.cf-pr-04-v2-content {
  flex: 1;
  padding: 80px 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.cf-pr-04-v2-tag {
  background-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  color: {{ section.settings.accent_color }};
  padding: 6px 16px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 25px;
}

.cf-pr-04-v2-title {
  color: {{ section.settings.text_color }};
  font-size: 42px;
  font-weight: 700;
  line-height: 1.1;
  margin: 0 0 20px 0;
  letter-spacing: -0.02em;
}

.cf-pr-04-v2-desc {
  color: #6b7280;
  font-size: 16px;
  line-height: 1.6;
  margin: 0 0 35px 0;
  max-width: 400px;
}

.cf-pr-04-v2-btn {
  display: inline-block;
  background-color: {{ section.settings.accent_color }};
  color: #fff;
  padding: 16px 36px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.cf-pr-04-v2-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};
}

.cf-pr-04-v2-image {
  flex: 1;
  position: relative;
  min-height: 400px;
}

.cf-pr-04-v2-image img {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  object-fit: cover;
}

@media (max-width: 900px) {
  .cf-pr-04-v2-inner { flex-direction: column; }
  .cf-pr-04-v2-content { padding: 50px 30px; align-items: center; text-align: center; }
  .cf-pr-04-v2-image { min-height: 300px; }
}
</style>

<div class="cf-pr-04-v2">
  <div class="cf-pr-04-v2-inner">
    <div class="cf-pr-04-v2-content">
      <div class="cf-pr-04-v2-tag">{{ section.settings.tag }}</div>
      <h2 class="cf-pr-04-v2-title">{{ section.settings.title }}</h2>
      <p class="cf-pr-04-v2-desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-pr-04-v2-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    <div class="cf-pr-04-v2-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title }}">
      {% else %}
        <div style="width:100%;height:100%;background:#e5e7eb;display:flex;align-items:center;justify-content:center;color:#9ca3af;">1000x800 Image</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "02 · Minimal Wellness",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Frame","default":"#f9fafb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#1f2937"},
    {"type":"color","id":"accent_color","label":"Accent Color (Green)","default":"#10b981"},
    {"type":"text","id":"tag","label":"Tag","default":"DAILY ESSENTIALS"},
    {"type":"text","id":"title","label":"Title","default":"Nourish your body from within."},
    {"type":"textarea","id":"desc","label":"Description","default":"Discover our new line of plant-based supplements designed to support your natural vitality."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Collection"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "presets": [{"name":"02 · Minimal Wellness Promo"}]
}
{% endschema %}
