<style>
.cf-mq-13{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;display:flex}
.cf-mq-13-track{display:flex;white-space:nowrap;animation:cf-mq-13-scroll {{ section.settings.speed }}s linear infinite}
.cf-mq-13-item{display:inline-flex;align-items:center;padding:0 30px;font-family:sans-serif;font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;letter-spacing:-0.02em}
.cf-mq-13-motto{color:{{ section.settings.accent_color }};font-weight:400;margin:0 30px}
@keyframes cf-mq-13-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<div class="cf-mq-13">
  <div class="cf-mq-13-track">
    {% for i in (1..8) %}
      <div class="cf-mq-13-item">
        {{ section.settings.brand_text }}
        <span class="cf-mq-13-motto">{{ section.settings.motto_text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "13 · Brand Marquee",
  "settings": [
    {"type":"text","id":"brand_text","label":"Brand Name","default":"VERVE STUDIOS"},
    {"type":"text","id":"motto_text","label":"Motto / Slogan","default":"NOTHING TO HIDE."},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":64,"step":2,"default":32},
    {"type":"color","id":"bg_color","label":"Background","default":"#000000"},
    {"type":"color","id":"text_color","label":"Brand Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Motto Color","default":"#dc2626"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":40,"step":1,"default":15},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":100,"step":5,"default":35}
  ],
  "presets": [{"name":"13 · Brand Marquee"}]
}
{% endschema %}
