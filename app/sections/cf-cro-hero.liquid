<style>
.cf-cro-hero{width:100%;background:{{ section.settings.bg_color }};overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-hero-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;min-height:{{ section.settings.height }}px;align-items:center;gap:40px;padding:60px 24px}
.cf-cro-hero-content{display:flex;flex-direction:column;gap:24px}
.cf-cro-hero-badge{display:inline-flex;align-items:center;gap:6px;background:{{ section.settings.accent_color }}20;color:{{ section.settings.accent_color }};padding:6px 14px;border-radius:100px;font-size:13px;font-weight:600;width:fit-content;letter-spacing:0.02em}
.cf-cro-hero-problem{font-size:15px;color:{{ section.settings.text_color }};opacity:0.7;line-height:1.6}
.cf-cro-hero-title{font-size:clamp(28px,4vw,{{ section.settings.title_size }}px);font-weight:800;color:{{ section.settings.text_color }};line-height:1.15;letter-spacing:-0.02em}
.cf-cro-hero-title span{color:{{ section.settings.accent_color }}}
.cf-cro-hero-subtitle{font-size:17px;color:{{ section.settings.text_color }};opacity:0.8;line-height:1.7;max-width:480px}
.cf-cro-hero-ctas{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.cf-cro-hero-cta{display:inline-flex;align-items:center;gap:8px;padding:16px 32px;background:{{ section.settings.accent_color }};color:#fff;border-radius:{{ section.settings.btn_radius }}px;font-size:16px;font-weight:700;text-decoration:none;transition:all 0.2s;box-shadow:0 4px 14px {{ section.settings.accent_color }}40}
.cf-cro-hero-cta:hover{transform:translateY(-2px);box-shadow:0 8px 20px {{ section.settings.accent_color }}50}
.cf-cro-hero-cta2{display:inline-flex;align-items:center;gap:8px;padding:16px 28px;background:transparent;color:{{ section.settings.text_color }};border:2px solid {{ section.settings.text_color }}20;border-radius:{{ section.settings.btn_radius }}px;font-size:15px;font-weight:600;text-decoration:none;transition:all 0.2s}
.cf-cro-hero-cta2:hover{border-color:{{ section.settings.accent_color }};color:{{ section.settings.accent_color }}}
.cf-cro-hero-stats{display:flex;gap:32px;margin-top:8px}
.cf-cro-hero-stat b{display:block;font-size:24px;color:{{ section.settings.text_color }}}
.cf-cro-hero-stat span{font-size:13px;color:{{ section.settings.text_color }};opacity:0.6}
.cf-cro-hero-img{position:relative;border-radius:16px;overflow:hidden;aspect-ratio:4/3}
.cf-cro-hero-img img{width:100%;height:100%;object-fit:cover}
.cf-cro-hero-img::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,{{ section.settings.accent_color }}15,transparent);pointer-events:none}
@media(max-width:768px){.cf-cro-hero-inner{grid-template-columns:1fr;text-align:center;padding:40px 20px}.cf-cro-hero-content{align-items:center}.cf-cro-hero-ctas{justify-content:center}.cf-cro-hero-stats{justify-content:center}}
</style>

<div class="cf-cro-hero">
  <div class="cf-cro-hero-inner">
    <div class="cf-cro-hero-content">
      <div class="cf-cro-hero-badge"><svg width=\'24\' height=\'24\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\' stroke-width=\'2\' stroke-linecap=\'round\' stroke-linejoin=\'round\'><polygon points=\'13 2 3 14 12 14 11 22 21 10 12 10 13 2\'></polygon></svg> {{ section.settings.badge_text }}</div>
      {% if section.settings.problem_text != blank %}
        <p class="cf-cro-hero-problem">{{ section.settings.problem_text }}</p>
      {% endif %}
      <h1 class="cf-cro-hero-title">{{ section.settings.title }} <span>{{ section.settings.highlight_word }}</span></h1>
      <p class="cf-cro-hero-subtitle">{{ section.settings.subtitle }}</p>
      <div class="cf-cro-hero-ctas">
        <a href="{{ section.settings.cta_link }}" class="cf-cro-hero-cta">{{ section.settings.cta_text }} →</a>
        {% if section.settings.cta2_text != blank %}
          <a href="{{ section.settings.cta2_link }}" class="cf-cro-hero-cta2">▶ {{ section.settings.cta2_text }}</a>
        {% endif %}
      </div>
      <div class="cf-cro-hero-stats">
        <div class="cf-cro-hero-stat"><b>{{ section.settings.stat1_num }}</b><span>{{ section.settings.stat1_label }}</span></div>
        <div class="cf-cro-hero-stat"><b>{{ section.settings.stat2_num }}</b><span>{{ section.settings.stat2_label }}</span></div>
        <div class="cf-cro-hero-stat"><b>{{ section.settings.stat3_num }}</b><span>{{ section.settings.stat3_label }}</span></div>
      </div>
    </div>
    <div class="cf-cro-hero-img">
      {% if section.settings.hero_image != blank %}
        <img src="{{ section.settings.hero_image | image_url: width: 1200 }}" alt="{{ section.settings.title }}" loading="lazy">
      {% else %}
        <div style="width:100%;height:100%;min-height:400px;background:linear-gradient(135deg,{{ section.settings.accent_color }}30,{{ section.settings.accent_color }}10)"></div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Problem/Solution Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Trusted by 50,000+ Customers"
    },
    {
      "type": "text",
      "id": "problem_text",
      "label": "Problem Statement",
      "default": "Tired of products that don't deliver on their promises?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Finally, a solution that actually"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlight Word",
      "default": "works."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join thousands who've transformed their routine with our science-backed formula. See results in 14 days or your money back."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary CTA",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Primary CTA Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta2_text",
      "label": "Secondary CTA",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "cta2_link",
      "label": "Secondary CTA Link",
      "default": "#how-it-works"
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 Number",
      "default": "50K+"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Stat 1 Label",
      "default": "Happy Customers"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 Number",
      "default": "4.9/5"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 Label",
      "default": "Star Rating"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Stat 3 Number",
      "default": "14-Day"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Stat 3 Label",
      "default": "Money-Back"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#6C3CE1"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 32,
      "max": 72,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "height",
      "label": "Min Height",
      "min": 400,
      "max": 800,
      "step": 50,
      "default": 600
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button Radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Problem/Solution Hero"
    }
  ]
}
{% endschema %}
