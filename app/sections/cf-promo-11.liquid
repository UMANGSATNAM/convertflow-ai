<style>
.cf-pr-11{width:100%;height:{{ section.settings.height }}vh;background:{{ section.settings.bg_color }};display:flex;font-family:sans-serif;overflow:hidden}
.cf-pr-11-img-wrap{flex:1;position:relative;height:100%}
.cf-pr-11-img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%)}
.cf-pr-11-content{flex:1;display:flex;flex-direction:column;justify-content:center;padding:10%;background:{{ section.settings.bg_color }}}
.cf-pr-11-sub{font-size:12px;color:#888;letter-spacing:0.2em;text-transform:uppercase;margin-bottom:20px}
.cf-pr-11-title{font-size:clamp(40px,6vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};font-weight:300;line-height:1.1;letter-spacing:-0.02em;margin-bottom:30px}
.cf-pr-11-desc{font-size:15px;color:#666;line-height:1.6;margin-bottom:40px;max-width:400px}
.cf-pr-11-btn{display:inline-flex;padding:15px 40px;background:{{ section.settings.text_color }};color:{{ section.settings.bg_color }};text-decoration:none;font-size:12px;letter-spacing:0.15em;text-transform:uppercase;transition:0.3s}
.cf-pr-11-btn:hover{opacity:0.8}
@media(max-width:900px){.cf-pr-11{flex-direction:column;height:auto}.cf-pr-11-img-wrap{height:50vh}.cf-pr-11-content{padding:10% 20px}}
</style>

<div class="cf-pr-11">
  <div class="cf-pr-11-img-wrap">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="Promo" class="cf-pr-11-img">
    {% else %}
      <div style="width:100%;height:100%;background:#e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8">IMAGE</div>
    {% endif %}
  </div>
  <div class="cf-pr-11-content">
    <div class="cf-pr-11-sub">{{ section.settings.subtitle }}</div>
    <h2 class="cf-pr-11-title">{{ section.settings.title }}</h2>
    <p class="cf-pr-11-desc">{{ section.settings.desc }}</p>
    <div>
      <a href="{{ section.settings.btn_link }}" class="cf-pr-11-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Promo",
  "settings": [
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"ESSENTIALS"},
    {"type":"text","id":"title","label":"Title","default":"Define Your Wardrobe"},
    {"type":"range","id":"title_size","label":"Title Size","min":32,"max":100,"step":2,"default":72},
    {"type":"textarea","id":"desc","label":"Description","default":"Elevate your everyday style with our premium basics collection, crafted for the modern man."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"Shop The Look"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"color","id":"bg_color","label":"Background","default":"#0f172a"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Promo"}]
}
{% endschema %}
