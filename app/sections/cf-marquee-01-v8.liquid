<style>
.cf-marquee-01-v8{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};padding:{{ section.settings.padding_y }}px 0;position:relative;display:flex;align-items:center;justify-content:center}
.cf-marquee-01-v8-center{position:absolute;z-index:10;background:rgba(255,255,255,{{ section.settings.glass_opacity }});backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:20px 60px;border-radius:100px;border:1px solid rgba(0,0,0,0.05);font-family:serif;font-size:24px;font-weight:400;letter-spacing:0.2em;text-transform:uppercase;box-shadow:0 20px 40px rgba(0,0,0,0.05)}
.cf-marquee-01-v8-track{display:flex;white-space:nowrap;animation:cf-marquee-01-v8-scroll {{ section.settings.speed }}s linear infinite;opacity:0.4}
.cf-marquee-01-v8-item{display:inline-flex;align-items:center;padding:0 50px}
.cf-marquee-01-v8-text{font-family:sans-serif;font-size:12px;font-weight:800;letter-spacing:0.2em;text-transform:uppercase}
@keyframes cf-marquee-01-v8-scroll{0%{transform:translateX(0)} 100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-01-v8">
  <div class="cf-marquee-01-v8-center">{{ shop.name }}</div>
  <div class="cf-marquee-01-v8-track">
    {% for j in (1..3) %}
      {% for i in (1..6) %}
        <div class="cf-marquee-01-v8-item">
          <span class="cf-marquee-01-v8-text">{{ section.settings.text }}</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Marquee (v8)",
  "settings": [
    {"type":"text","id":"text","label":"Background Marquee Text","default":"NOW AVAILABLE WORLDWIDE"},
    {"type":"range","id":"speed","label":"Scroll Duration (s)","min":10,"max":100,"step":5,"default":45},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"range","id":"glass_opacity","label":"Pill Opacity (%)","min":0,"max":100,"step":5,"default":80},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":150,"step":10,"default":60}
  ],
  "presets": [{"name":"01 · Luxury Marquee (v8)"}]
}
{% endschema %}
