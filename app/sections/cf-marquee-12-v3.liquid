<style>
.cf-marquee-12-v3{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;overflow:hidden;font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-marquee-12-v3-track{display:flex;white-space:nowrap;animation:cf-scroll-12-v3 {{ section.settings.speed }}s linear infinite}
.cf-marquee-12-v3-content{display:flex;align-items:center;gap:60px;padding-right:60px}
.cf-marquee-12-v3-text{font-size:{{ section.settings.font_size }}px;font-weight:300;text-transform:uppercase;letter-spacing:0.3em;margin:0}
@keyframes cf-scroll-12-v3{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<div class="cf-marquee-12-v3">
  <div class="cf-marquee-12-v3-track">
    <div class="cf-marquee-12-v3-content">
      {% for i in (1..6) %}
        <span class="cf-marquee-12-v3-text">{{ section.settings.text }}</span>
      {% endfor %}
    </div>
    <div class="cf-marquee-12-v3-content">
      {% for i in (1..6) %}
        <span class="cf-marquee-12-v3-text">{{ section.settings.text }}</span>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Marquee (v3)",
  "settings": [
    {"type":"text","id":"text","label":"Marquee Text","default":"COMPLIMENTARY SHIPPING GLOBALLY"},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":5,"default":40},
    {"type":"range","id":"font_size","label":"Font Size (px)","min":10,"max":30,"step":1,"default":13},
    {"type":"color","id":"bg_color","label":"Background Color","default":"#111111"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":5,"max":30,"step":1,"default":15}
  ],
  "presets": [{"name":"12 · Women's Marquee (v3)"}]
}
{% endschema %}
