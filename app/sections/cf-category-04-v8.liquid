<style>
.cf-cat-04-v8 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.cf-cat-04-v8-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-cat-04-v8-header {
  text-align: center;
  margin-bottom: 60px;
}

.cf-cat-04-v8-title {
  color: {{ section.settings.text_color }};
  font-size: 36px;
  font-weight: 300;
  letter-spacing: 0.05em;
  margin: 0 0 15px 0;
}

.cf-cat-04-v8-subtitle {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  opacity: 0.6;
}

.cf-cat-04-v8-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.cols_desktop }}, 1fr);
  gap: 50px;
}

.cf-cat-04-v8-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  text-align: center;
}

.cf-cat-04-v8-image-wrap {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  position: relative;
  margin-bottom: 25px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cf-cat-04-v8-image-wrap::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 90%; height: 90%;
  border-radius: 50%;
  background: {{ section.settings.accent_color }};
  filter: blur(20px);
  opacity: 0.5;
  transition: opacity 0.5s, width 0.5s, height 0.5s;
}

.cf-cat-04-v8-item:hover .cf-cat-04-v8-image-wrap::before {
  opacity: 0.8;
  width: 100%; height: 100%;
}

.cf-cat-04-v8-image-wrap img {
  width: 80%; height: 80%;
  object-fit: cover;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  transition: transform 0.6s ease;
}

.cf-cat-04-v8-item:hover .cf-cat-04-v8-image-wrap img {
  transform: scale(1.05);
}

.cf-cat-04-v8-name {
  color: {{ section.settings.text_color }};
  font-size: 18px;
  font-weight: 400;
  letter-spacing: 0.1em;
  margin: 0;
}

@media (max-width: 900px) {
  .cf-cat-04-v8-grid { grid-template-columns: repeat(2, 1fr); gap: 30px; }
}
</style>

<div class="cf-cat-04-v8">
  <div class="cf-cat-04-v8-inner">
    <div class="cf-cat-04-v8-header">
      <h2 class="cf-cat-04-v8-title">{{ section.settings.title }}</h2>
      <div class="cf-cat-04-v8-subtitle">{{ section.settings.subtitle }}</div>
    </div>

    <div class="cf-cat-04-v8-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-04-v8-item">
          <div class="cf-cat-04-v8-image-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
            {% else %}
               <div style="width:80%;height:80%;border-radius:50%;background:#e5e5e5;position:relative;z-index:1;display:flex;align-items:center;justify-content:center;color:#999;">Image</div>
            {% endif %}
          </div>
          <h3 class="cf-cat-04-v8-name">{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "08 · Holistic Aura Grid",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F9F9F9"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#5B5B5B"},
    {"type":"color","id":"accent_color","label":"Glow Color","default":"#CBD5CF"},
    {"type":"text","id":"title","label":"Title","default":"Holistic Categories"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Nurture Your Needs"},
    {"type":"range","id":"cols_desktop","label":"Columns (Desktop)","min":2,"max":6,"step":1,"default":4},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1000}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"title","label":"Category Name","default":"Mindfulness"},
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "08 · Holistic Aura Categories",
      "blocks": [{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]
    }
  ]
}
{% endschema %}
