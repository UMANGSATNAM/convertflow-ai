<style>
.cf-trust-01-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif;text-align:center}
.cf-trust-01-v4-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(3, 1fr);gap:60px}
.cf-trust-01-v4-item{display:flex;flex-direction:column;align-items:center}
.cf-trust-01-v4-numeral{font-size:36px;font-style:italic;color:{{ section.settings.accent_color }};margin-bottom:20px;line-height:1}
.cf-trust-01-v4-title{font-size:24px;margin:0 0 15px 0;font-weight:400;letter-spacing:0.02em}
.cf-trust-01-v4-desc{font-family:sans-serif;font-size:12px;opacity:0.75;line-height:1.6;margin:0}
@media(max-width:768px){
  .cf-trust-01-v4-inner{grid-template-columns:1fr;gap:50px}
}
</style>

<div class="cf-trust-01-v4">
  <div class="cf-trust-01-v4-inner">
    {% for i in (1..3) %}
      <div class="cf-trust-01-v4-item">
        <div class="cf-trust-01-v4-numeral">{% if i == 1 %}I.{% elsif i == 2 %}II.{% else %}III.{% endif %}</div>
        <h4 class="cf-trust-01-v4-title">
          {% if i == 1 %}The Origin{% elsif i == 2 %}The Method{% else %}The Promise{% endif %}
        </h4>
        <p class="cf-trust-01-v4-desc">
          {% if i == 1 %}We travel the globe securing only the most exceptional raw elements.{% elsif i == 2 %}Traditional artisanship fused flawlessly with modern technology.{% else %}A resolute commitment to perfection in every garment we produce.{% endif %}
        </p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Trust (v4)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Numeral Color","default":"#A38971"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":100}
  ],
  "presets": [{"name":"01 · Luxury Trust (v4)"}]
}
{% endschema %}
