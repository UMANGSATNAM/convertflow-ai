<style>
.cf-tb-03-v6 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.cf-tb-03-v6-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
}

.cf-tb-03-v6-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 15px;
  flex: 1;
  min-width: 150px;
  padding: 20px;
  border: 1px solid transparent;
  transition: 0.3s;
}

.cf-tb-03-v6-item:hover {
  border-color: {{ section.settings.accent_color }};
  background: rgba(0,255,255,0.05); /* very faint neon tint */
  box-shadow: 0 0 15px {{ section.settings.accent_color }}40 inset;
}

.cf-tb-03-v6-icon {
  color: {{ section.settings.accent_color }};
  /* Glow effect */
  filter: drop-shadow(0 0 5px {{ section.settings.accent_color }});
  transition: 0.3s;
}

.cf-tb-03-v6-item:hover .cf-tb-03-v6-icon {
  filter: drop-shadow(0 0 10px {{ section.settings.accent_color }});
  transform: scale(1.1);
}

.cf-tb-03-v6-icon svg {
  width: 40px; height: 40px;
}

.cf-tb-03-v6-title {
  color: {{ section.settings.text_color }};
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0;
}

.cf-tb-03-v6-item:hover .cf-tb-03-v6-title {
  color: {{ section.settings.accent_color }};
  text-shadow: 0 0 5px {{ section.settings.accent_color }};
}
</style>

<div class="cf-tb-03-v6">
  <div class="cf-tb-03-v6-inner">
    {% for block in section.blocks %}
      <div class="cf-tb-03-v6-item">
        <div class="cf-tb-03-v6-icon">
          {% if block.settings.icon == 'shield' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {% elsif block.settings.icon == 'cpu' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
          {% elsif block.settings.icon == 'battery' %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="18" height="12" rx="2" ry="2"/><line x1="23" y1="13" x2="23" y2="11"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {% endif %}
        </div>
        <h3 class="cf-tb-03-v6-title">{{ block.settings.title }}</h3>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "06 · Neon Outline Badges",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Base","default":"#000000"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Neon Outline Color","default":"#0ff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {"value": "shield", "label": "Shield"},
            {"value": "cpu", "label": "CPU"},
            {"value": "battery", "label": "Battery"},
            {"value": "clock", "label": "Clock"}
          ],
          "default": "cpu"
        },
        {"type":"text","id":"title","label":"Title","default":"NEXT-GEN TECH"}
      ]
    }
  ],
  "presets": [
    {
      "name": "06 · Neon Outline Badges",
      "blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]
    }
  ]
}
{% endschema %}
