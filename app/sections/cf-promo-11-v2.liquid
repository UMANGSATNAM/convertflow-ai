<style>
.cf-pr-11-v2{width:100%;height:{{ section.settings.height }}vh;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;position:relative;font-family:sans-serif;padding:20px}
.cf-pr-11-v2-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }})}
.cf-pr-11-v2-card{background:{{ section.settings.card_bg }};padding:50px 40px;max-width:500px;width:100%;position:relative;z-index:2;box-shadow:20px 20px 0 {{ section.settings.accent_color }};border:1px solid {{ section.settings.border_color }}}
.cf-pr-11-v2-sub{font-size:12px;color:{{ section.settings.text_color }};font-weight:700;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:15px;display:block}
.cf-pr-11-v2-title{font-size:36px;color:{{ section.settings.text_color }};font-weight:900;text-transform:uppercase;line-height:1.1;margin:0 0 20px 0;letter-spacing:-0.02em}
.cf-pr-11-v2-desc{font-size:15px;color:{{ section.settings.text_color }};opacity:0.8;line-height:1.6;margin-bottom:30px}
.cf-pr-11-v2-btn{display:inline-block;padding:15px 30px;background:{{ section.settings.text_color }};color:{{ section.settings.card_bg }};text-decoration:none;font-size:13px;font-weight:800;letter-spacing:0.05em;text-transform:uppercase;transition:0.3s}
.cf-pr-11-v2-btn:hover{background:{{ section.settings.accent_color }};color:{{ section.settings.text_color }}}
@media(max-width:600px){.cf-pr-11-v2-card{padding:30px;box-shadow:10px 10px 0 {{ section.settings.accent_color }}}.cf-pr-11-v2-title{font-size:28px}}
</style>

<div class="cf-pr-11-v2">
  <div class="cf-pr-11-v2-overlay"></div>
  <div class="cf-pr-11-v2-card">
    <span class="cf-pr-11-v2-sub">{{ section.settings.subtitle }}</span>
    <h2 class="cf-pr-11-v2-title">{{ section.settings.title }}</h2>
    <p class="cf-pr-11-v2-desc">{{ section.settings.desc }}</p>
    <a href="{{ section.settings.btn_link }}" class="cf-pr-11-v2-btn">{{ section.settings.btn_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Promo (v2)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Image"},
    {"type":"range","id":"overlay_opacity","label":"Overlay Opacity","min":0,"max":100,"step":5,"default":30},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"NEW ARRIVALS"},
    {"type":"text","id":"title","label":"Title","default":"THE FALL EDIT"},
    {"type":"textarea","id":"desc","label":"Description","default":"Discover our latest collection of premium outerwear, tailored for the modern element."},
    {"type":"text","id":"btn_label","label":"Button Label","default":"SHOP THE COLLECTION"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent (Shadow)","default":"#E2E2E2"},
    {"type":"color","id":"border_color","label":"Border","default":"#111111"},
    {"type":"range","id":"height","label":"Height (vh)","min":40,"max":100,"step":5,"default":80}
  ],
  "presets": [{"name":"11 · Men's Promo (v2)"}]
}
{% endschema %}
