<style>
.cf-trust-01-v3{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif}
.cf-trust-01-v3-inner{max-width:1600px;margin:0 auto;display:grid;grid-template-columns:repeat(4, 1fr);border:1px solid {{ section.settings.border_color }}}
.cf-trust-01-v3-item{padding:50px 40px;border-right:1px solid {{ section.settings.border_color }};position:relative;text-align:center;transition:background 0.4s}
.cf-trust-01-v3-item:hover{background:rgba(0,0,0,0.02)}
.cf-trust-01-v3-item:last-child{border-right:none}
.cf-trust-01-v3-icon{font-size:28px;margin-bottom:20px;color:{{ section.settings.accent_color }}}
.cf-trust-01-v3-title{font-size:16px;font-style:italic;margin:0 0 10px 0;letter-spacing:0.02em}
.cf-trust-01-v3-desc{font-family:sans-serif;font-size:11px;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;margin:0;opacity:0.6;line-height:1.4}
@media(max-width:1024px){
  .cf-trust-01-v3-inner{grid-template-columns:repeat(2, 1fr)}
  .cf-trust-01-v3-item:nth-child(2){border-right:none}
  .cf-trust-01-v3-item:nth-child(1), .cf-trust-01-v3-item:nth-child(2){border-bottom:1px solid {{ section.settings.border_color }}}
}
@media(max-width:600px){
  .cf-trust-01-v3-inner{grid-template-columns:1fr}
  .cf-trust-01-v3-item{border-right:none;border-bottom:1px solid {{ section.settings.border_color }}}
  .cf-trust-01-v3-item:last-child{border-bottom:none}
}
</style>

<div class="cf-trust-01-v3">
  <div class="cf-trust-01-v3-inner">
    {% for i in (1..4) %}
      <div class="cf-trust-01-v3-item">
        <div class="cf-trust-01-v3-icon">✦</div>
        <h4 class="cf-trust-01-v3-title">
          {% if i == 1 %}Authenticity{% elsif i == 2 %}Heritage{% elsif i == 3 %}Sustainability{% else %}Dedication{% endif %}
        </h4>
        <p class="cf-trust-01-v3-desc">
          {% if i == 1 %}Guaranteed Orgins{% elsif i == 2 %}Since 1928{% elsif i == 3 %}Ethical Sourcing{% else %}Lifetime Care{% endif %}
        </p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "01 · Luxury Trust (v3)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Icon/Accent Color","default":"#D4AF37"},
    {"type":"color","id":"border_color","label":"Border Divider","default":"#E2DFD8"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":80}
  ],
  "presets": [{"name":"01 · Luxury Trust (v3)"}]
}
{% endschema %}
