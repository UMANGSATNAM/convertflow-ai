<style>
.cf-cat-05{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 20px;font-family:'Georgia',serif}
.cf-cat-05-inner{max-width:1200px;margin:0 auto}
.cf-cat-05-header{text-align:center;margin-bottom:50px}
.cf-cat-05-title{font-size:clamp(32px,5vw,{{ section.settings.title_size }}px);color:{{ section.settings.text_color }};margin-bottom:15px;font-style:italic}
.cf-cat-05-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:40px}
.cf-cat-05-item{text-decoration:none;display:flex;flex-direction:column;align-items:center;text-align:center;width:220px;group}
.cf-cat-05-img-wrap{width:100%;aspect-ratio:3/4;border-radius:100px;overflow:hidden;margin-bottom:24px;position:relative}
.cf-cat-05-img{width:100%;height:100%;object-fit:cover;transition:0.6s cubic-bezier(0.4, 0, 0.2, 1);transform:scale(1.02)}
.cf-cat-05-border{position:absolute;top:10px;left:10px;right:10px;bottom:10px;border:1px solid rgba(255,255,255,0.4);border-radius:90px;z-index:1;pointer-events:none;transition:0.4s}
.cf-cat-05-item:hover .cf-cat-05-img{transform:scale(1.1)}
.cf-cat-05-item:hover .cf-cat-05-border{border-color:#fff;top:15px;left:15px;right:15px;bottom:15px}
.cf-cat-05-label{font-size:18px;color:{{ section.settings.text_color }};letter-spacing:0.05em;transition:0.3s}
.cf-cat-05-item:hover .cf-cat-05-label{color:{{ section.settings.accent_color }}}
@media(max-width:600px){.cf-cat-05-grid{gap:20px}.cf-cat-05-item{width:140px}}
</style>

<div class="cf-cat-05">
  <div class="cf-cat-05-inner">
    <div class="cf-cat-05-header">
      <h2 class="cf-cat-05-title">{{ section.settings.title }}</h2>
    </div>
    <div class="cf-cat-05-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cat-05-item">
          <div class="cf-cat-05-img-wrap">
            {% if block.settings.image != blank %}
              <img class="cf-cat-05-img" src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}">
            {% else %}
              <div class="cf-cat-05-img" style="background:#f4ecea"></div>
            {% endif %}
            <div class="cf-cat-05-border"></div>
          </div>
          <div class="cf-cat-05-label">{{ block.settings.title }}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "05 · Beauty Categories",
  "settings": [
    {"type":"text","id":"title","label":"Title","default":"Shop the Regimen"},
    {"type":"range","id":"title_size","label":"Title Size","min":24,"max":64,"step":2,"default":42},
    {"type":"color","id":"bg_color","label":"Background","default":"#fffbfb"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4a3c31"},
    {"type":"color","id":"accent_color","label":"Accent on Hover","default":"#d4aba0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 5,
      "settings": [
        {"type":"image_picker","id":"image","label":"Image (Vertical Portrait)"},
        {"type":"text","id":"title","label":"Title","default":"Cleansers"},
        {"type":"text","id":"link","label":"Link","default":"/collections/all"}
      ]
    }
  ],
  "presets": [
    {
      "name": "05 · Beauty Categories",
      "blocks": [
        {"type":"category","settings":{"title":"Cleanse"}},
        {"type":"category","settings":{"title":"Treat"}},
        {"type":"category","settings":{"title":"Moisturize"}},
        {"type":"category","settings":{"title":"Protect"}}
      ]
    }
  ]
}
{% endschema %}
