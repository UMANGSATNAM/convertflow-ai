<style>
.cf-promo-12-v3{width:100%;height:{{ section.settings.height }}vh;position:relative;overflow:hidden;font-family:serif;color:{{ section.settings.text_color }};display:flex;align-items:center;justify-content:center}
.cf-promo-12-v3-bg{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:0;animation:cf-zoom-12-v3 20s linear infinite alternate}
.cf-promo-12-v3-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});z-index:1}
.cf-promo-12-v3-content{position:relative;z-index:2;text-align:center;max-width:800px;padding:0 20px;display:flex;flex-direction:column;align-items:center}
.cf-promo-12-v3-sub{font-size:16px;font-style:italic;margin-bottom:15px;color:{{ section.settings.accent_color }}}
.cf-promo-12-v3-title{font-size:clamp(48px, 6vw, 96px);line-height:1;margin:0 0 30px 0;font-weight:300;text-transform:uppercase;letter-spacing:0.02em}
.cf-promo-12-v3-btn{display:inline-block;padding:14px 40px;background:transparent;border:1px solid {{ section.settings.text_color }};color:{{ section.settings.text_color }};text-decoration:none;font-family:sans-serif;font-size:11px;text-transform:uppercase;letter-spacing:0.2em;transition:0.3s}
.cf-promo-12-v3-btn:hover{background:{{ section.settings.text_color }};color:#000}
@keyframes cf-zoom-12-v3{0%{transform:scale(1)}100%{transform:scale(1.1)}}
</style>

<div class="cf-promo-12-v3">
  {% if section.settings.bg_image %}
    <img src="{{ section.settings.bg_image | image_url: width: 2400 }}" class="cf-promo-12-v3-bg" alt="Background">
  {% else %}
    <div class="cf-promo-12-v3-bg" style="background:#333;"></div>
  {% endif %}
  <div class="cf-promo-12-v3-overlay"></div>
  
  <div class="cf-promo-12-v3-content">
    <span class="cf-promo-12-v3-sub">{{ section.settings.subtitle }}</span>
    <h2 class="cf-promo-12-v3-title">{{ section.settings.title | newline_to_br }}</h2>
    <a href="{{ section.settings.btn_link }}" class="cf-promo-12-v3-btn">{{ section.settings.btn_label }}</a>
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Promo (v3)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Image"},
    {"type":"range","id":"overlay_opacity","label":"Overlay Opacity","min":0,"max":100,"step":5,"default":30},
    {"type":"text","id":"subtitle","label":"Script Subtitle","default":"The new season"},
    {"type":"textarea","id":"title","label":"Title","default":"SUMMER \nATELIER"},
    {"type":"text","id":"btn_label","label":"Button Label","default":"DISCOVER"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    
    {"type":"color","id":"text_color","label":"Text Color","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Subtitle Color","default":"#F8F3EC"},
    {"type":"range","id":"height","label":"Height (vh)","min":50,"max":100,"step":5,"default":85}
  ],
  "presets": [{"name":"12 · Women's Promo (v3)"}]
}
{% endschema %}
