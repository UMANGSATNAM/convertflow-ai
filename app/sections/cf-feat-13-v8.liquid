<style>
.cf-feat-13-v8{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:sans-serif;overflow:hidden}
.cf-feat-13-v8-inner{max-width:1600px;margin:0 auto;display:flex;align-items:center;position:relative}
.cf-feat-13-v8-poster{width:40%;height:600px;position:relative;z-index:2;background:#ccc;box-shadow:20px 20px 60px rgba(0,0,0,0.1)}
.cf-feat-13-v8-poster-img{width:100%;height:100%;object-fit:cover}
.cf-feat-13-v8-track-wrap{width:70%;position:absolute;right:0;z-index:1;padding:40px 0;background:{{ section.settings.accent_bg }}}
.cf-feat-13-v8-header{padding:0 40px;margin-bottom:30px;color:{{ section.settings.accent_text }}}
.cf-feat-13-v8-title{font-size:clamp(32px, 4vw, 56px);font-weight:900;text-transform:uppercase;margin:0;letter-spacing:-0.02em}
.cf-feat-13-v8-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 40px 40px 40px;scrollbar-width:none}
.cf-feat-13-v8-track::-webkit-scrollbar{display:none}
.cf-feat-13-v8-card{flex:0 0 280px;scroll-snap-align:start;text-decoration:none;color:{{ section.settings.accent_text }};display:block}
.cf-feat-13-v8-img-wrap{width:100%;aspect-ratio:3/4;background:#f0f0f0;margin-bottom:15px;overflow:hidden}
.cf-feat-13-v8-img{width:100%;height:100%;object-fit:cover;transition:0.5s}
.cf-feat-13-v8-card:hover .cf-feat-13-v8-img{transform:scale(1.05)}
.cf-feat-13-v8-name{font-size:12px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase;margin:0 0 5px 0}
.cf-feat-13-v8-price{font-size:12px;opacity:0.7}
@media(max-width:1024px){
  .cf-feat-13-v8-inner{flex-direction:column;align-items:stretch}
  .cf-feat-13-v8-poster{width:100%;height:400px;margin-bottom:-100px;z-index:2}
  .cf-feat-13-v8-track-wrap{width:100%;position:relative;right:auto;padding-top:140px;z-index:1}
}
</style>

<div class="cf-feat-13-v8">
  <div class="cf-feat-13-v8-inner">
    <div class="cf-feat-13-v8-poster">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | image_url: width: 800 }}" class="cf-feat-13-v8-poster-img">
      {% else %}
        <div class="cf-feat-13-v8-poster-img" style="background:#555;"></div>
      {% endif %}
    </div>
    
    <div class="cf-feat-13-v8-track-wrap">
      <div class="cf-feat-13-v8-header">
        <h2 class="cf-feat-13-v8-title">{{ section.settings.title }}</h2>
      </div>
      <div class="cf-feat-13-v8-track">
        {% for i in (1..6) %}
          <a href="#" class="cf-feat-13-v8-card">
            <div class="cf-feat-13-v8-img-wrap">
              <div class="cf-feat-13-v8-img" style="background:#888;"></div>
            </div>
            <h3 class="cf-feat-13-v8-name">Technical Piece 0{{ i }}</h3>
            <div class="cf-feat-13-v8-price">$290</div>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "13 · Featured (v8)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Poster Image"},
    {"type":"text","id":"title","label":"Header Title","default":"LATEST SEASON"},
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#EAEAEE"},
    {"type":"color","id":"accent_bg","label":"Scroll Track Background","default":"#111111"},
    {"type":"color","id":"accent_text","label":"Scroll Track Text","default":"#FFFFFF"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"13 · Featured (v8)"}]
}
{% endschema %}
