<style>
.cf-hero-03{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;position:relative;width:100%;min-height:{{ section.settings.height }}px;display:flex;align-items:center;justify-content:center;overflow:hidden}
.cf-hero-03-bg{position:absolute;inset:0;z-index:0}
.cf-hero-03-bg img{width:100%;height:100%;object-fit:cover}
.cf-hero-03-overlay{position:absolute;inset:0;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }});z-index:1}
.cf-hero-03-content{position:relative;z-index:2;text-align:center;padding:60px 24px;max-width:800px}
.cf-hero-03 h1{font-size:clamp(36px,5vw,{{ section.settings.heading_size }}px);font-weight:900;color:#fff;margin:0 0 16px;letter-spacing:-0.02em;line-height:1.05;text-shadow:0 2px 20px rgba(0,0,0,0.3)}
.cf-hero-03 p{font-size:18px;color:rgba(255,255,255,0.9);margin:0 0 36px;line-height:1.6;max-width:560px;margin-left:auto;margin-right:auto}
.cf-hero-03-cta{display:inline-flex;gap:8px;align-items:center;padding:16px 40px;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;border-radius:0;background:{{ section.settings.btn_bg }};color:{{ section.settings.btn_color }};text-decoration:none;border:none;cursor:pointer;transition:0.3s}
.cf-hero-03-cta:hover{opacity:0.9;transform:scale(1.02)}
.cf-hero-03-scroll{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);z-index:2;color:rgba(255,255,255,0.6);animation:cf-bounce 2s infinite}
@keyframes cf-bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(8px)}}
</style>

<section class="cf-hero-03">
  <div class="cf-hero-03-bg">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.heading }}" loading="eager">
    {% else %}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%)"></div>
    {% endif %}
  </div>
  <div class="cf-hero-03-overlay"></div>
  <div class="cf-hero-03-content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.btn_link }}" class="cf-hero-03-cta">{{ section.settings.btn_text }}</a>
  </div>
  <div class="cf-hero-03-scroll">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

{% schema %}
{
  "name": "03 · Fullscreen Hero",
  "settings": [
    {"type":"range","id":"padding_top","label":"Padding Top","min":0,"max":200,"step":5,"default":0},
    {"type":"range","id":"padding_bottom","label":"Padding Bottom","min":0,"max":200,"step":5,"default":0},
    {"type":"text","id":"heading","label":"Heading","default":"Where Luxury Meets Comfort"},
    {"type":"textarea","id":"subheading","label":"Subheading","default":"Handcrafted with the world's finest fabrics. Experience fashion that speaks to your soul."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"EXPLORE NOW"},
    {"type":"text","id":"btn_link","label":"Button Link","default":"/collections/all"},
    {"type":"image_picker","id":"image","label":"Background Image"},
    {"type":"range","id":"overlay_opacity","label":"Dark Overlay %","min":0,"max":80,"step":5,"default":40},
    {"type":"color","id":"btn_bg","label":"Button BG","default":"#ffffff"},
    {"type":"color","id":"btn_color","label":"Button Text","default":"#000000"},
    {"type":"range","id":"heading_size","label":"Heading Size","min":36,"max":80,"step":2,"default":60},
    {"type":"range","id":"height","label":"Min Height","min":500,"max":900,"step":50,"default":700}
  ],
  "presets": [{"name":"03 · Fullscreen Hero"}]
}
{% endschema %}
