<style>
.cf-pr-04-v7 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  overflow: hidden;
}

.cf-pr-04-v7-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  position: relative;
  display: flex;
  align-items: center;
  border-radius: 20px;
  background: {{ section.settings.card_bg }};
  box-shadow: 0 20px 50px rgba(0,0,0,0.2);
}

.cf-pr-04-v7-content {
  width: 50%;
  padding: 80px 60px;
  position: relative;
  z-index: 2;
}

.cf-pr-04-v7-title {
  color: {{ section.settings.text_color }};
  font-size: 50px;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  line-height: 1.05;
  margin: 0 0 20px 0;
  letter-spacing: -0.02em;
}

.cf-pr-04-v7-title span {
  color: {{ section.settings.accent_color }};
}

.cf-pr-04-v7-desc {
  color: rgba(255,255,255,0.8);
  font-size: 16px;
  line-height: 1.6;
  margin: 0 0 35px 0;
  max-width: 400px;
}

.cf-pr-04-v7-btn {
  display: inline-block;
  background-color: {{ section.settings.accent_color }};
  color: #fff;
  padding: 15px 35px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: 800;
  font-size: 15px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  transition: transform 0.2s, background-color 0.2s;
}

.cf-pr-04-v7-btn:hover {
  transform: translateY(-2px);
  background-color: #fff;
  color: {{ section.settings.card_bg }};
}

.cf-pr-04-v7-image {
  width: 55%; /* overlaps slightly */
  position: absolute;
  top: 0; right: 0; bottom: 0;
  clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
}

.cf-pr-04-v7-image img {
  width: 100%; height: 100%; object-fit: cover;
}

@media (max-width: 900px) {
  .cf-pr-04-v7-inner { flex-direction: column; }
  .cf-pr-04-v7-content { width: 100%; padding: 50px 30px; text-align: center; }
  .cf-pr-04-v7-desc { margin-left: auto; margin-right: auto; }
  .cf-pr-04-v7-image { position: relative; width: 100%; height: 400px; clip-path: none; }
}
</style>

<div class="cf-pr-04-v7">
  <div class="cf-pr-04-v7-inner">
    <div class="cf-pr-04-v7-content">
      <h2 class="cf-pr-04-v7-title">{{ section.settings.title | replace: '[', '<span>' | replace: ']', '</span>' }}</h2>
      <p class="cf-pr-04-v7-desc">{{ section.settings.desc }}</p>
      {% if section.settings.btn_text != blank %}
        <a href="{{ section.settings.btn_link }}" class="cf-pr-04-v7-btn">{{ section.settings.btn_text }}</a>
      {% endif %}
    </div>
    <div class="cf-pr-04-v7-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.title | strip_html }}">
      {% else %}
        <div style="width:100%;height:100%;background:#334155;display:flex;align-items:center;justify-content:center;color:#64748b;">Image Placeholder</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "07 · Active Pulse Banner",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Wrappper","default":"#000000"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#111827"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Accent Color (Orange)","default":"#f97316"},
    {"type":"text","id":"title","label":"Title (Use [brackets] to highlight)","default":"MAXIMIZE YOUR [RECOVERY]"},
    {"type":"textarea","id":"desc","label":"Description","default":"Premium hydration and muscle recovery supplements formulated for high performance athletes."},
    {"type":"text","id":"btn_text","label":"Button Text","default":"Shop Hydration"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    {"type":"image_picker","id":"image","label":"Image"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":160,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "presets": [{"name":"07 · Active Pulse Poster"}]
}
{% endschema %}
