<style>
.cf-trust-12-v8{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};position:relative;display:flex;align-items:center;justify-content:center}
.cf-trust-12-v8-bg{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:0}
.cf-trust-12-v8-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1}
.cf-trust-12-v8-inner{position:relative;z-index:2;width:100%;max-width:1400px;display:flex;gap:40px;justify-content:center;flex-wrap:wrap;color:#fff;font-family:serif;text-align:center}
.cf-trust-12-v8-card{flex:1;min-width:260px;padding:40px 20px;display:flex;flex-direction:column;align-items:center}
.cf-trust-12-v8-icon{width:70px;height:70px;border-radius:50%;border:1px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;margin-bottom:25px;transition:0.4s}
.cf-trust-12-v8-card:hover .cf-trust-12-v8-icon{background:#fff;color:#000;border-color:#fff}
.cf-trust-12-v8-title{font-size:26px;font-weight:400;margin:0 0 15px 0;font-style:italic}
.cf-trust-12-v8-desc{font-family:sans-serif;font-size:13px;line-height:1.6;opacity:0.8;margin:0;max-width:280px}
</style>

<div class="cf-trust-12-v8">
  {% if section.settings.image %}
    <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="Background" class="cf-trust-12-v8-bg">
  {% else %}
     <div class="cf-trust-12-v8-bg" style="background:#222"></div>
  {% endif %}
  <div class="cf-trust-12-v8-overlay"></div>
  
  <div class="cf-trust-12-v8-inner">
    {% for i in (1..4) %}
      <div class="cf-trust-12-v8-card">
        <div class="cf-trust-12-v8-icon">
          {% if i == 1 %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="30" height="30"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          {% elsif i == 2 %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="30" height="30"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          {% elsif i == 3 %}
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="30" height="30"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          {% else %}
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" width="30" height="30"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          {% endif %}
        </div>
        <h3 class="cf-trust-12-v8-title">
          {% if i == 1 %}Authentic Pieces{% elsif i == 2 %}Premium Craft{% elsif i == 3 %}Secure Data{% else %}Responsible{% endif %}
        </h3>
        <p class="cf-trust-12-v8-desc">
          {% if i == 1 %}Every item guarantees 100% authenticity.{% elsif i == 2 %}Expert craftsmanship with quality materials.{% elsif i == 3 %}Industry-leading checkout encryption.{% else %}Created with ethical practices globally.{% endif %}
        </p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Trust (v8)",
  "settings": [
    {"type":"image_picker","id":"image","label":"Background Image"},
    {"type":"color","id":"bg_color","label":"Fallback Background","default":"#111111"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":60,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"12 · Women's Trust (v8)"}]
}
{% endschema %}
