<div class="cf-auto-cat-v2" style="background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_y }}px 20px;">
  <div class="cf-auto-cat-v2-container" style="max-width: 1400px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 50px;">
      <h2 style="font-family: 'Syne', sans-serif; font-size: {{ section.settings.title_size }}px; font-weight: 800; color: {{ section.settings.title_color }}; text-transform: uppercase; margin: 0 0 10px 0; letter-spacing: -1px;">
        {{ section.settings.title }}
      </h2>
      <p style="font-family: 'Syne', sans-serif; font-size: 16px; color: {{ section.settings.title_color }}; opacity: 0.7; margin: 0; text-transform: uppercase; letter-spacing: 2px;">
        {{ section.settings.subtitle }}
      </p>
    </div>

    <div class="cf-auto-cat-v2-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: 20px;">
      {% for i in (1..section.settings.blocks) %}
        {% capture bg %}bg_{{i}}{% endcapture %}
        {% capture label %}label_{{i}}{% endcapture %}
        {% capture link %}link_{{i}}{% endcapture %}

        <a href="{{ section.settings[link] | default: '#' }}" class="cf-auto-cat-v2-item" style="display: block; position: relative; height: 350px; border-radius: {{ section.settings.border_radius }}px; overflow: hidden; text-decoration: none;">
          
          <div class="cf-auto-cat-v2-img" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);">
            {% if section.settings[bg] %}
              <img src="{{ section.settings[bg] | image_url: width: 600 }}" style="width: 100%; height: 100%; object-fit: cover;" alt="{{ section.settings[label] }}">
            {% else %}
              <div style="width: 100%; height: 100%; background: #222;"></div>
            {% endif %}
          </div>
          
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 60%);"></div>

          <div style="position: absolute; bottom: 30px; left: 30px; right: 30px; display: flex; align-items: flex-end; justify-content: space-between;">
            <h3 style="font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; color: #fff; margin: 0; text-transform: uppercase;">
              {{ section.settings[label] | default: 'Category' }}
            </h3>
            <div class="cf-auto-cat-v2-arrow" style="background: {{ section.settings.accent_color }}; color: #000; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 50%; opacity: 0; transform: translateX(-10px); transition: all 0.3s ease;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </div>
          </div>

        </a>
      {% endfor %}
    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&display=swap');
  
  .cf-auto-cat-v2-item:hover .cf-auto-cat-v2-img {
    transform: scale(1.05);
  }
  .cf-auto-cat-v2-item:hover .cf-auto-cat-v2-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 1024px) {
    .cf-auto-cat-v2-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 768px) {
    .cf-auto-cat-v2-grid { grid-template-columns: repeat(2, 1fr) !important; }
    .cf-auto-cat-v2-item { height: 280px !important; }
  }
  @media (max-width: 480px) {
    .cf-auto-cat-v2-grid { grid-template-columns: 1fr !important; }
  }
</style>

