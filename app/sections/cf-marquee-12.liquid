<style>
.cf-mq-12{width:100%;overflow:hidden;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 0;display:flex;border-top:1px solid {{ section.settings.border_color }};border-bottom:1px solid {{ section.settings.border_color }}}
.cf-mq-12-track{display:flex;white-space:nowrap;animation:cf-mq-12-scroll {{ section.settings.speed }}s linear infinite}
.cf-mq-12-item{display:inline-flex;align-items:center;padding:0 40px;font-family:'Playfair Display',serif;font-size:{{ section.settings.text_size }}px;color:{{ section.settings.text_color }};font-style:italic;letter-spacing:0.05em}
.cf-mq-12-icon{margin:0 40px;color:{{ section.settings.accent_color }}}
@keyframes cf-mq-12-scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
</style>

<div class="cf-mq-12">
  <div class="cf-mq-12-track">
    {% for i in (1..8) %}
      <div class="cf-mq-12-item">
        {{ section.settings.text }}
        <div class="cf-mq-12-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "12 · Women's Marquee",
  "settings": [
    {"type":"text","id":"text","label":"Text","default":"Discover our new spring arrivals"},
    {"type":"range","id":"text_size","label":"Text Size","min":12,"max":32,"step":1,"default":18},
    {"type":"color","id":"bg_color","label":"Background","default":"#faf5f3"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#4a3c31"},
    {"type":"color","id":"border_color","label":"Border","default":"#eeddd8"},
    {"type":"color","id":"accent_color","label":"Star Ext Color","default":"#d4aba0"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":50,"step":2,"default":20},
    {"type":"range","id":"speed","label":"Speed (Seconds)","min":10,"max":100,"step":5,"default":45}
  ],
  "presets": [{"name":"12 · Women's Marquee"}]
}
{% endschema %}
