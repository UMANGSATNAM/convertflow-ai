<style>
.cf-cro-faq3{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-faq3-inner{max-width:800px;margin:0 auto;text-align:center}
.cf-cro-faq3 h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px}
.cf-cro-faq3-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6;margin-bottom:32px}
.cf-cro-faq3-tabs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:24px}
.cf-cro-faq3-tab{padding:10px 20px;border-radius:100px;background:{{ section.settings.text_color }}06;color:{{ section.settings.text_color }};font-size:14px;font-weight:600;cursor:pointer;border:none;transition:0.2s}
.cf-cro-faq3-tab.active{background:{{ section.settings.accent_color }};color:#fff}
.cf-cro-faq3-list{display:flex;flex-direction:column;gap:8px;text-align:left}
.cf-cro-faq3-item{background:#fff;border:1px solid {{ section.settings.text_color }}08;border-radius:12px;overflow:hidden}
.cf-cro-faq3-q{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;cursor:pointer;background:none;border:none;width:100%;text-align:left;font-size:15px;font-weight:600;color:{{ section.settings.text_color }};gap:12px}
.cf-cro-faq3-q .num{width:28px;height:28px;border-radius:8px;background:{{ section.settings.accent_color }}10;color:{{ section.settings.accent_color }};display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;flex-shrink:0}
.cf-cro-faq3-q .arrow{transition:0.3s;font-size:18px;color:{{ section.settings.text_color }};opacity:0.3}
.cf-cro-faq3-item.open .arrow{transform:rotate(180deg);color:{{ section.settings.accent_color }};opacity:1}
.cf-cro-faq3-a{max-height:0;overflow:hidden;transition:max-height 0.4s ease}
.cf-cro-faq3-item.open .cf-cro-faq3-a{max-height:300px}
.cf-cro-faq3-a p{padding:0 20px 18px 60px;font-size:14px;line-height:1.7;color:{{ section.settings.text_color }};opacity:0.65;margin:0}
</style>

<div class="cf-cro-faq3">
  <div class="cf-cro-faq3-inner">
    <h2>{{ section.settings.heading }}</h2>
    <p class="cf-cro-faq3-sub">{{ section.settings.subheading }}</p>
    <div class="cf-cro-faq3-tabs">
      <button class="cf-cro-faq3-tab active">All</button>
      <button class="cf-cro-faq3-tab">Shipping</button>
      <button class="cf-cro-faq3-tab">Returns</button>
      <button class="cf-cro-faq3-tab">Product</button>
    </div>
    <div class="cf-cro-faq3-list">
      {%- for i in (1..6) -%}
        {%- assign q = 'q_' | append: i -%}
        {%- assign a = 'a_' | append: i -%}
        {% if section.settings[q] != blank %}
          <div class="cf-cro-faq3-item{% if i == 1 %} open{% endif %}">
            <button class="cf-cro-faq3-q" onclick="this.parentElement.classList.toggle('open')">
              <span class="num">{{ i }}</span>
              <span style="flex:1">{{ section.settings[q] }}</span>
              <span class="arrow">▾</span>
            </button>
            <div class="cf-cro-faq3-a"><p>{{ section.settings[a] }}</p></div>
          </div>
        {% endif %}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "CRO · Tabbed FAQ v3",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Common Questions"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Quick answers to help you decide"},
    {"type":"text","id":"q_1","label":"Q1","default":"How fast will I receive my order?"},
    {"type":"textarea","id":"a_1","label":"A1","default":"Standard shipping is 3-5 business days. Express (1-2 days) available for $9.99. Free shipping on all orders over $50."},
    {"type":"text","id":"q_2","label":"Q2","default":"What's your return policy?"},
    {"type":"textarea","id":"a_2","label":"A2","default":"30-day no-questions-asked returns. We'll even cover the return shipping. Your satisfaction is guaranteed."},
    {"type":"text","id":"q_3","label":"Q3","default":"How do I choose the right size?"},
    {"type":"textarea","id":"a_3","label":"A3","default":"Check our detailed size guide with measurements. Products are true-to-size. Between sizes? Go one up for comfort."},
    {"type":"text","id":"q_4","label":"Q4","default":"Is this actually worth the price?"},
    {"type":"textarea","id":"a_4","label":"A4","default":"Absolutely. Premium materials, 4.9★ rating from 12K+ buyers, and a 30-day guarantee means zero risk for you."},
    {"type":"text","id":"q_5","label":"Q5","default":"Do you offer international shipping?"},
    {"type":"textarea","id":"a_5","label":"A5","default":"Yes! We ship to 40+ countries. International orders arrive in 7-14 business days."},
    {"type":"text","id":"q_6","label":"Q6","default":"Can I cancel or modify my order?"},
    {"type":"textarea","id":"a_6","label":"A6","default":"Within 2 hours of placing? Absolutely. After that, reach out to our 24/7 support team."},
    {"type":"color","id":"bg_color","label":"Background","default":"#f8f9fa"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#6C3CE1"},
    {"type":"range","id":"padding_y","label":"Padding","min":20,"max":100,"step":10,"default":60}
  ],
  "presets": [{"name":"CRO · Tabbed FAQ v3"}]
}
{% endschema %}
