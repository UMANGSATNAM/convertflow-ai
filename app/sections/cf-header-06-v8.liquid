<div class="cf-auto-header-v8" style="background: {{ section.settings.bg_color }}; box-shadow: 0 4px 20px rgba(0,0,0,0.05); position: relative; z-index: 10;">
  
  <div class="cf-auto-header-v8-container" style="max-width: 1400px; margin: 0 auto; display: flex; align-items: stretch; height: {{ section.settings.height }}px;">

    <!-- Left: Logo -->
    <div class="cf-auto-header-v8-logo" style="flex: 0 0 auto; display: flex; align-items: center; padding: 0 30px; border-right: 1px solid rgba(0,0,0,0.08);">
      <a href="/" style="text-decoration: none;">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <span style="font-family: 'Syne', sans-serif; font-size: 24px; font-weight: 800; color: {{ section.settings.text_color }}; letter-spacing: -0.5px; text-transform: uppercase;">
            {{ shop.name }}
          </span>
        {% endif %}
      </a>
    </div>

    <!-- Center: Navigation Links (Inline) -->
    <div class="cf-auto-header-v8-nav" style="flex: 1; display: flex; align-items: center; justify-content: center;">
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 40px;">
        {% for link in linklists[section.settings.menu].links %}
          <li>
            <a href="{{ link.url }}" style="color: {{ section.settings.text_color }}; text-decoration: none; font-size: 14px; font-weight: 700; font-family: 'Syne', sans-serif; text-transform: uppercase; letter-spacing: 1px; transition: color 0.3s; padding: 10px 0; position: relative;" class="cf-modern-link">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- Right: Actions -->
    <div class="cf-auto-header-v8-actions" style="flex: 0 0 auto; display: flex; align-items: stretch;">
      
      <!-- Search Dropdown Trigger -->
      <button class="cf-action-box" style="width:{{ section.settings.height }}px; border: none; border-left: 1px solid rgba(0,0,0,0.08); background: transparent; color: {{ section.settings.text_color }}; display: flex; align-items: center; justify-content: center; cursor: pointer;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>

      <!-- Account Trigger -->
      <a href="/account" class="cf-action-box" style="width:{{ section.settings.height }}px; border-left: 1px solid rgba(0,0,0,0.08); background: transparent; color: {{ section.settings.text_color }}; display: flex; align-items: center; justify-content: center; text-decoration: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>

      <!-- Cart Trigger (Highlight) -->
      <a href="/cart" class="cf-action-box" style="width: {{ section.settings.height }}px; background: {{ section.settings.accent_color }}; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; position: relative;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span style="font-family: 'Syne', sans-serif; font-weight: 800; font-size: 11px; margin-top: 4px;">{{ cart.item_count }}</span>
      </a>

    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&display=swap');

  .cf-modern-link::after {
    content: '';
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 0;
    height: 6px;
    background: {{ section.settings.accent_color }};
    opacity: 0.3;
    transition: width 0.3s ease;
    z-index: -1;
  }
  .cf-modern-link:hover::after {
    width: 100%;
  }
  .cf-action-box { transition: background 0.2s; }
  .cf-action-box:hover { background: rgba(0,0,0,0.02) !important; }
  .cf-action-box[href="/cart"]:hover { filter: brightness(1.1); }

  @media (max-width: 990px) {
    .cf-auto-header-v8-nav { display: none !important; }
    .cf-auto-header-v8-logo { flex: 1; border-right: none; }
  }
</style>

{% schema %}
{
  "name": "06 · Modern Auto Header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#e63946"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Header Height",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Height",
      "default": 35
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
