<style>
.cf-cro-cmp2{width:100%;background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_y }}px 24px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
.cf-cro-cmp2-inner{max-width:900px;margin:0 auto}
.cf-cro-cmp2 h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:{{ section.settings.text_color }};margin:0 0 8px;text-align:center}
.cf-cro-cmp2-sub{font-size:16px;color:{{ section.settings.text_color }};opacity:0.6;text-align:center;margin-bottom:40px}
.cf-cro-cmp2-cols{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.cf-cro-cmp2-col{border-radius:20px;padding:32px 28px;display:flex;flex-direction:column;gap:0}
.cf-cro-cmp2-us{background:{{ section.settings.accent_color }};color:#fff;box-shadow:0 8px 30px {{ section.settings.accent_color }}30}
.cf-cro-cmp2-them{background:{{ section.settings.text_color }}06;border:1px solid {{ section.settings.text_color }}10}
.cf-cro-cmp2-col-head{font-size:20px;font-weight:800;margin-bottom:4px}
.cf-cro-cmp2-col-sub{font-size:13px;opacity:0.7;margin-bottom:24px}
.cf-cro-cmp2-row{display:flex;align-items:center;gap:12px;padding:14px 0;border-top:1px solid rgba(255,255,255,0.15);font-size:14px}
.cf-cro-cmp2-them .cf-cro-cmp2-row{border-color:{{ section.settings.text_color }}08;color:{{ section.settings.text_color }}}
.cf-cro-cmp2-icon{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0}
.cf-cro-cmp2-us .cf-cro-cmp2-icon{background:rgba(255,255,255,0.2);color:#fff}
.cf-cro-cmp2-them .cf-cro-cmp2-icon{background:#FEE2E2;color:#E53E3E}
.cf-cro-cmp2-cta{text-align:center;margin-top:32px}
.cf-cro-cmp2-btn{display:inline-flex;align-items:center;gap:8px;padding:16px 40px;background:{{ section.settings.accent_color }};color:#fff;border-radius:12px;font-size:16px;font-weight:700;text-decoration:none;transition:0.2s;box-shadow:0 4px 14px {{ section.settings.accent_color }}30}
.cf-cro-cmp2-btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px {{ section.settings.accent_color }}40}
@media(max-width:600px){.cf-cro-cmp2-cols{grid-template-columns:1fr}}
</style>

<div class="cf-cro-cmp2">
  <div class="cf-cro-cmp2-inner">
    <h2>{{ section.settings.heading }}</h2>
    <p class="cf-cro-cmp2-sub">{{ section.settings.subheading }}</p>
    <div class="cf-cro-cmp2-cols">
      <div class="cf-cro-cmp2-col cf-cro-cmp2-us">
        <div class="cf-cro-cmp2-col-head">{{ section.settings.brand_name }}</div>
        <div class="cf-cro-cmp2-col-sub">Why choose us</div>
        {%- assign us_feats = section.settings.us_features | split: '|' -%}
        {%- for feat in us_feats -%}
          <div class="cf-cro-cmp2-row"><span class="cf-cro-cmp2-icon">✓</span>{{ feat | strip }}</div>
        {%- endfor -%}
      </div>
      <div class="cf-cro-cmp2-col cf-cro-cmp2-them">
        <div class="cf-cro-cmp2-col-head">{{ section.settings.competitor_name }}</div>
        <div class="cf-cro-cmp2-col-sub">What you're missing</div>
        {%- assign them_feats = section.settings.them_features | split: '|' -%}
        {%- for feat in them_feats -%}
          <div class="cf-cro-cmp2-row"><span class="cf-cro-cmp2-icon">✗</span>{{ feat | strip }}</div>
        {%- endfor -%}
      </div>
    </div>
    <div class="cf-cro-cmp2-cta">
      <a href="{{ section.settings.cta_link }}" class="cf-cro-cmp2-btn">{{ section.settings.cta_text }} →</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Side-by-Side Cards v2",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Clear Choice"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See why 50,000+ customers switched to us"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Our Brand"
    },
    {
      "type": "textarea",
      "id": "us_features",
      "label": "Our Features (|)",
      "default": "Premium organic materials|Free shipping worldwide|30-day money-back guarantee|24/7 priority support|Sustainably sourced|4.9/5 star rating (12,000+ reviews)"
    },
    {
      "type": "text",
      "id": "competitor_name",
      "label": "Competitor",
      "default": "The Others"
    },
    {
      "type": "textarea",
      "id": "them_features",
      "label": "Their Drawbacks (|)",
      "default": "Synthetic cheap materials|$9.99+ shipping fees|No returns accepted|Email-only support (48h wait)|Unknown sourcing|3.5/5 average rating"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Make the Switch"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "CTA Link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#16A34A"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Side-by-Side Cards v2"
    }
  ]
}
{% endschema %}
