<style>
.cf-tb-04-v5 {
  padding: {{ section.settings.padding_y }}px 20px;
  background-color: {{ section.settings.bg_color }};
  font-family: 'Playfair Display', serif;
}

.cf-tb-04-v5-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
}

.cf-tb-04-v5-grid {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
}

.cf-tb-04-v5-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex: 1;
  min-width: 250px;
  padding: 20px;
}

.cf-tb-04-v5-icon {
  margin-bottom: 20px;
  color: {{ section.settings.accent_color }};
}

.cf-tb-04-v5-icon svg { width: 32px; height: 32px; stroke-width: 1; }

.cf-tb-04-v5-title {
  color: {{ section.settings.text_color }};
  font-size: 22px;
  font-weight: 400;
  font-style: italic;
  margin: 0 0 10px 0;
}

.cf-tb-04-v5-desc {
  color: #666;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  margin: 0;
  max-width: 250px;
  line-height: 1.6;
}

.cf-tb-04-v5-separator {
  color: {{ section.settings.accent_color | color_modify: 'alpha', 0.4 }};
  font-size: 10px;
  padding: 0 20px;
}

@media (max-width: 900px) {
  .cf-tb-04-v5-grid { flex-direction: column; }
  .cf-tb-04-v5-separator { display: none; }
  .cf-tb-04-v5-item { margin-bottom: 40px; }
  .cf-tb-04-v5-item:last-child { margin-bottom: 0; }
}
</style>

<div class="cf-tb-04-v5">
  <div class="cf-tb-04-v5-inner">
    <div class="cf-tb-04-v5-grid">
      {% for block in section.blocks %}
        <div class="cf-tb-04-v5-item">
          <div class="cf-tb-04-v5-icon">
             <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h4 class="cf-tb-04-v5-title">{{ block.settings.title }}</h4>
          <p class="cf-tb-04-v5-desc">{{ block.settings.desc }}</p>
        </div>
        {% unless forloop.last %}
          <div class="cf-tb-04-v5-separator">◆</div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "05 · Spa Serenity Badges",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F7F4F0"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#333333"},
    {"type":"color","id":"accent_color","label":"Accent Color","default":"#8c7c61"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":60},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":50,"default":1200}
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 3,
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"100% Vegan"},
        {"type":"text","id":"desc","label":"Description","default":"Cruelty-free formulas"}
      ]
    }
  ],
  "presets": [
    {
      "name": "05 · Spa Serenity Badges",
      "blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"}]
    }
  ]
}
{% endschema %}
