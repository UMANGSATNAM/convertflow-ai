<div class="cf-auto-header-v10" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; position: absolute; width: 100%; top: 0; left: 0; z-index: 100; border-bottom: 1px solid rgba(255,255,255,0.1);">
  <div class="cf-auto-header-v10-container" style="max-width: 1400px; margin: 0 auto; padding: 25px 40px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;">

    <!-- Left: Navigation -->
    <div class="cf-auto-header-v10-nav">
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; gap: 40px;">
        {% for link in linklists[section.settings.menu].links limit: 3 %}
          <li>
            <a href="{{ link.url }}" style="color: {{ section.settings.text_color }}; text-decoration: none; font-size: 13px; font-weight: 700; font-family: 'Space Grotesk', sans-serif; text-transform: uppercase; letter-spacing: 2px; transition: color 0.3s;" class="cf-hover-accent">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <!-- Center: Logo -->
    <div class="cf-auto-header-v10-logo" style="text-align: center;">
      <a href="/" style="text-decoration: none; display: inline-block;">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px; width: auto; display: block;">
        {% else %}
          <div style="font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; color: {{ section.settings.text_color }}; letter-spacing: 4px; text-transform: uppercase;">
            {{ shop.name }}
          </div>
        {% endif %}
      </a>
    </div>

    <!-- Right: Actions -->
    <div class="cf-auto-header-v10-actions" style="display: flex; justify-content: flex-end; align-items: center; gap: 30px;">
      
      <button class="cf-hover-accent" style="background: none; border: none; color: {{ section.settings.text_color }}; padding: 0; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: color 0.3s;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span style="font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Search</span>
      </button>

      <a href="/cart" class="cf-hover-accent" style="color: {{ section.settings.text_color }}; text-decoration: none; display: flex; align-items: center; gap: 8px; transition: color 0.3s;">
        <div style="position: relative;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span style="position: absolute; top: -8px; right: -8px; background: {{ section.settings.accent_color }}; color: #000; font-size: 9px; font-weight: 800; width: 15px; height: 15px; display: flex; align-items: center; justify-content: center; border-radius: 50%;">{{ cart.item_count }}</span>
        </div>
        <span style="font-family: 'Space Grotesk', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Cart</span>
      </a>

      <!-- Burger Menu (for mobile/full menu) -->
      <button class="cf-hover-accent" style="background: none; border: none; color: {{ section.settings.text_color }}; padding: 0; cursor: pointer; transition: color 0.3s;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>

    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&display=swap');

  .cf-hover-accent:hover { color: {{ section.settings.accent_color }} !important; }

  @media (max-width: 990px) {
    .cf-auto-header-v10-container { grid-template-columns: auto 1fr; padding: 20px; }
    .cf-auto-header-v10-nav { display: none; }
    .cf-auto-header-v10-logo { text-align: left; }
    .cf-auto-header-v10-actions span { display: none; }
  }
</style>

{% schema %}
{
  "name": "06 · Stealth Concept Head",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color (Transparent)",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#39ff14"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Logo Height",
      "default": 30
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
