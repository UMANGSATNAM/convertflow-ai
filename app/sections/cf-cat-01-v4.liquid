<style>
.cf-cat-01-v4{width:100%;padding:{{ section.settings.padding_y }}px 20px;background:{{ section.settings.bg_color }};color:{{ section.settings.text_color }};font-family:serif}
.cf-cat-01-v4-inner{max-width:1600px;margin:0 auto;display:flex;gap:80px;align-items:center}
.cf-cat-01-v4-list{flex:1;display:flex;flex-direction:column}
.cf-cat-01-v4-item{padding:30px 0;border-bottom:1px solid {{ section.settings.border_color }};text-decoration:none;color:inherit;display:flex;justify-content:space-between;align-items:center;transition:0.4s;cursor:pointer}
.cf-cat-01-v4-item:first-child{border-top:1px solid {{ section.settings.border_color }}}
.cf-cat-01-v4-name{font-size:clamp(32px, 5vw, 64px);font-weight:400;margin:0;letter-spacing:0.02em;text-transform:uppercase;transition:transform 0.4s}
.cf-cat-01-v4-count{font-family:sans-serif;font-size:12px;font-weight:700;opacity:0.6;letter-spacing:0.15em}
.cf-cat-01-v4-item:hover .cf-cat-01-v4-name{transform:translateX(20px);font-style:italic}
.cf-cat-01-v4-item:hover{color:{{ section.settings.accent_color }}}
.cf-cat-01-v4-preview{flex:1;aspect-ratio:4/5;background:#ececec;position:relative;overflow:hidden;box-shadow:0 30px 60px rgba(0,0,0,0.05)}
.cf-cat-01-v4-img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.6s, transform 1s}
.cf-cat-01-v4-img.active{opacity:1;transform:scale(1.05)}
@media(max-width:1024px){
  .cf-cat-01-v4-inner{flex-direction:column-reverse}
  .cf-cat-01-v4-list, .cf-cat-01-v4-preview{width:100%}
  .cf-cat-01-v4-preview{display:none} /* Optional: hide hover preview on mobile where hover doesnt exist */
}
</style>

<div class="cf-cat-01-v4">
  <div class="cf-cat-01-v4-inner">
    <div class="cf-cat-01-v4-list" id="cf-cat-01-v4-list-{{ section.id }}">
      {% for i in (1..5) %}
        <a href="#" class="cf-cat-01-v4-item" data-index="{{ i }}">
          <h3 class="cf-cat-01-v4-name">{% if i==1 %}Leather Goods{% elsif i==2 %}Ready To Wear{% elsif i==3 %}Footwear{% elsif i==4 %}Accessories{% else %}Fine Jewelry{% endif %}</h3>
          <span class="cf-cat-01-v4-count">0{{ i }}</span>
        </a>
      {% endfor %}
    </div>
    
    <div class="cf-cat-01-v4-preview" id="cf-cat-01-v4-preview-{{ section.id }}">
      <!-- Pseudo-images for demonstration -->
      {% for i in (1..5) %}
        <div class="cf-cat-01-v4-img {% if i == 1 %}active{% endif %}" id="cf-cat-01-v4-img-{{ section.id }}-{{ i }}" style="background:hsl({{ i | times: 40 }}, 20%, 50%);"></div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const listItems = document.querySelectorAll('#cf-cat-01-v4-list-{{ section.id }} .cf-cat-01-v4-item');
    const images = document.querySelectorAll('#cf-cat-01-v4-preview-{{ section.id }} .cf-cat-01-v4-img');
    
    listItems.forEach(item => {
      item.addEventListener('mouseenter', () => {
        const idx = item.getAttribute('data-index');
        images.forEach(img => img.classList.remove('active'));
        const target = document.getElementById(`cf-cat-01-v4-img-{{ section.id }}-${idx}`);
        if(target) target.classList.add('active');
      });
    });
  });
</script>

{% schema %}
{
  "name": "01 · Luxury Category (v4)",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Canvas","default":"#FDFBF7"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Hover Accent","default":"#A38971"},
    {"type":"color","id":"border_color","label":"Border Separator","default":"#EAEAEE"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":40,"max":200,"step":10,"default":120}
  ],
  "presets": [{"name":"01 · Luxury Category (v4)"}]
}
{% endschema %}
