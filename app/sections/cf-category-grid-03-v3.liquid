<style>
.cf-cg-03-v3 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-cg-03-v3-inner {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  text-align: center;
}

.cf-cg-03-v3-heading {
  font-family: 'Impact', 'Arial Black', sans-serif;
  font-size: clamp(32px, 5vw, 48px);
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 60px 0;
  text-shadow: 2px 2px 0 {{ section.settings.accent_color }};
}

.cf-cg-03-v3-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
  padding: 20px;
}

.cf-cg-03-v3-card {
  width: calc(33.333% - 20px);
  min-width: 250px;
  max-width: 350px;
  aspect-ratio: 1/1.1;
  background: #000;
  /* Hexagon Shape */
  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  position: relative;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* Inner border effect for hex */
.cf-cg-03-v3-card::before {
  content: '';
  position: absolute;
  top: 2px; left: 2px; right: 2px; bottom: 2px;
  background: {{ section.settings.panel_bg }};
  clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  z-index: 1;
  transition: 0.3s;
}

.cf-cg-03-v3-card:hover {
  transform: translateY(-10px) scale(1.05);
  background: {{ section.settings.accent_color }};
}

.cf-cg-03-v3-card:hover::before {
  background: rgba(0,0,0,0.8);
}

.cf-cg-03-v3-img-wrap {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  z-index: 2;
  opacity: 0.4;
  transition: 0.3s;
  mix-blend-mode: luminosity;
}

.cf-cg-03-v3-card:hover .cf-cg-03-v3-img-wrap {
  opacity: 0.8;
  mix-blend-mode: normal;
}

.cf-cg-03-v3-img {
  width: 100%; height: 100%; object-fit: cover;
}

.cf-cg-03-v3-title {
  position: relative;
  z-index: 3;
  color: {{ section.settings.text_color }};
  font-family: ui-monospace, SFMono-Regular, monospace;
  font-size: 18px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  background: rgba(0,0,0,0.8);
  padding: 8px 16px;
  border: 1px solid {{ section.settings.accent_color }};
  transition: 0.3s;
}

.cf-cg-03-v3-card:hover .cf-cg-03-v3-title {
  background: {{ section.settings.accent_color }};
  color: #000;
  border-color: #000;
}

/* Hex grid layout hack for rows */
@media (min-width: 900px) {
  .cf-cg-03-v3-card:nth-child(even) {
    transform: translateY(50%);
  }
  .cf-cg-03-v3-card:nth-child(even):hover {
    transform: translateY(calc(50% - 10px)) scale(1.05);
  }
  .cf-cg-03-v3-grid {
    padding-bottom: 100px; /* Space for offset even items */
  }
}
</style>

<div class="cf-cg-03-v3">
  <div class="cf-cg-03-v3-inner">
    <h2 class="cf-cg-03-v3-heading">{{ section.settings.heading }}</h2>
    
    <div class="cf-cg-03-v3-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="cf-cg-03-v3-card">
          <div class="cf-cg-03-v3-img-wrap">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}" class="cf-cg-03-v3-img">
            {% else %}
              <div class="cf-cg-03-v3-img" style="background:#222;"></div>
            {% endif %}
          </div>
          <h3 class="cf-cg-03-v3-title">{{ block.settings.title }}</h3>
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "03 · Cyber Hex Grid",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"CYBER_MODULES"},
    {"type":"color","id":"bg_color","label":"Background Base","default":"#08080c"},
    {"type":"color","id":"panel_bg","label":"Panel Base","default":"#111116"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#ffffff"},
    {"type":"color","id":"accent_color","label":"Cyber Accent","default":"#00ffff"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":120,"step":5,"default":80},
    {"type":"range","id":"max_width","label":"Max Width","min":800,"max":1600,"step":100,"default":1200}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Optical"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "03 · Cyber Hex Grid",
      "blocks": [
        {"type": "category"},
        {"type": "category"},
        {"type": "category"},
        {"type": "category"}
      ]
    }
  ]
}
{% endschema %}
