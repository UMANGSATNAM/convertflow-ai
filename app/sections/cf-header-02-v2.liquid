<style>
.cf-head-02-v2 {
  width: 100%;
  background: {{ section.settings.bg_color }};
  border-top: 4px solid {{ section.settings.border_color }};
  border-bottom: 4px solid {{ section.settings.border_color }};
  position: sticky;
  top: 0;
  z-index: 100;
  box-sizing: border-box;
}

.cf-head-02-v2-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.padding_y }}px 20px;
}

.cf-head-02-v2-logo {
  font-size: clamp(24px, 4vw, {{ section.settings.logo_size }}px);
  font-weight: 900;
  color: {{ section.settings.logo_color }};
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: -0.05em;
  line-height: 1;
  border: 2px solid transparent;
  padding: 4px 8px;
  transition: all 0.2s ease-in-out;
}

.cf-head-02-v2-logo:hover {
  background: {{ section.settings.accent_bg }};
  color: {{ section.settings.accent_text }};
  border-color: {{ section.settings.logo_color }};
  transform: translate(-2px, -2px);
  box-shadow: 4px 4px 0 {{ section.settings.logo_color }};
}

.cf-head-02-v2-nav {
  display: none;
  gap: 32px;
}

@media (min-width: 1024px) {
  .cf-head-02-v2-nav {
    display: flex;
    align-items: center;
  }
  .cf-head-02-v2-main {
    padding: {{ section.settings.padding_y }}px 50px;
  }
}

.cf-head-02-v2-link {
  font-size: 16px;
  font-weight: 800;
  color: {{ section.settings.text_color }};
  text-transform: uppercase;
  text-decoration: none;
  position: relative;
  letter-spacing: 0.02em;
  transition: 0.2s;
}

.cf-head-02-v2-link::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 4px;
  background: {{ section.settings.accent_bg }};
  bottom: -6px;
  left: 0;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.3s cubic-bezier(0.19, 1, 0.22, 1);
}

.cf-head-02-v2-link:hover {
  color: {{ section.settings.border_color }};
}

.cf-head-02-v2-link:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

.cf-head-02-v2-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.cf-head-02-v2-btn {
  background: {{ section.settings.border_color }};
  color: {{ section.settings.bg_color }};
  padding: 12px 24px;
  font-weight: 900;
  font-size: 14px;
  text-transform: uppercase;
  text-decoration: none;
  border: 2px solid {{ section.settings.border_color }};
  transition: all 0.2s ease;
  white-space: nowrap;
}

.cf-head-02-v2-btn:hover {
  background: {{ section.settings.accent_bg }};
  color: {{ section.settings.accent_text }};
  border-color: {{ section.settings.border_color }};
  transform: translateY(-2px);
  box-shadow: 4px 4px 0 {{ section.settings.border_color }};
}
</style>

<header class="cf-head-02-v2">
  <div class="cf-head-02-v2-main">
    <a href="/" class="cf-head-02-v2-logo">{{ section.settings.logo_text }}</a>
    <nav class="cf-head-02-v2-nav">
      <a href="{{ section.settings.link_1_url }}" class="cf-head-02-v2-link">{{ section.settings.link_1 }}</a>
      <a href="{{ section.settings.link_2_url }}" class="cf-head-02-v2-link">{{ section.settings.link_2 }}</a>
      <a href="{{ section.settings.link_3_url }}" class="cf-head-02-v2-link">{{ section.settings.link_3 }}</a>
      <a href="{{ section.settings.link_4_url }}" class="cf-head-02-v2-link">{{ section.settings.link_4 }}</a>
    </nav>
    <div class="cf-head-02-v2-actions">
      <a href="/cart" class="cf-head-02-v2-btn">Cart [0]</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "02 · Brutalist Split Head",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "BRUTAL"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo Size",
      "min": 20,
      "max": 64,
      "step": 2,
      "default": 48
    },
    {
      "type": "text",
      "id": "link_1",
      "label": "Link 1",
      "default": "Shop All"
    },
    {
      "type": "text",
      "id": "link_1_url",
      "label": "Link 1 URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "link_2",
      "label": "Link 2",
      "default": "Tops"
    },
    {
      "type": "text",
      "id": "link_2_url",
      "label": "Link 2 URL",
      "default": "/collections/tops"
    },
    {
      "type": "text",
      "id": "link_3",
      "label": "Link 3",
      "default": "Bottoms"
    },
    {
      "type": "text",
      "id": "link_3_url",
      "label": "Link 3 URL",
      "default": "/collections/bottoms"
    },
    {
      "type": "text",
      "id": "link_4",
      "label": "Link 4",
      "default": "Accessories"
    },
    {
      "type": "text",
      "id": "link_4_url",
      "label": "Link 4 URL",
      "default": "/collections/accessories"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Lines",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Link Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "accent_bg",
      "label": "Hover Accent BG",
      "default": "#ff4500"
    },
    {
      "type": "color",
      "id": "accent_text",
      "label": "Hover Accent Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "02 · Brutalist Split Head"
    }
  ]
}
{% endschema %}
