<style>
.cf-mq-04-v6 {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: {{ section.settings.padding_y }}px 0;
  overflow: hidden;
  white-space: nowrap;
  display: flex;
  align-items: center;
  font-family: 'Baskerville', 'Times New Roman', serif;
  border-top: 1px solid {{ section.settings.border_color }};
  border-bottom: 1px solid {{ section.settings.border_color }};
}

.cf-mq-04-v6-track {
  display: inline-flex;
  animation: cf-mq-04-v6-scroll {{ section.settings.speed }}s linear infinite;
}

.cf-mq-04-v6-item {
  display: inline-flex;
  align-items: center;
  padding: 0 40px;
  font-size: {{ section.settings.font_size }}px;
  text-transform: capitalize;
  letter-spacing: 0.05em;
}

.cf-mq-04-v6-icon {
  margin: 0 40px;
  color: {{ section.settings.accent_color }};
  font-size: 1.2em;
  font-weight: 300;
}

@keyframes cf-mq-04-v6-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="cf-mq-04-v6">
  <div class="cf-mq-04-v6-track">
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        <div class="cf-mq-04-v6-item">
          <span>{{ block.settings.text }}</span>
          <span class="cf-mq-04-v6-icon">*</span>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "06 · Apothecary Ingred.",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background Color","default":"#F4F1EA"},
    {"type":"color","id":"text_color","label":"Text Color","default":"#2d3a33"},
    {"type":"color","id":"accent_color","label":"Asterisk Color","default":"#A19C8B"},
    {"type":"color","id":"border_color","label":"Border Color","default":"#DAD4C8"},
    {"type":"range","id":"padding_y","label":"Vertical Padding","min":10,"max":40,"step":2,"default":15},
    {"type":"range","id":"font_size","label":"Font Size","min":14,"max":32,"step":1,"default":18},
    {"type":"range","id":"speed","label":"Scroll Speed (Seconds)","min":10,"max":60,"step":2,"default":30}
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Ingredient",
      "settings": [
        {"type":"text","id":"text","label":"Text","default":"Echinacea Purpurea"}
      ]
    }
  ],
  "presets": [
    {
      "name": "06 · Apothecary Ingredients",
      "blocks": [{"type":"text"},{"type":"text"},{"type":"text"},{"type":"text"}]
    }
  ]
}
{% endschema %}
