<div class="cf-auto-marquee-v5" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding_y }}px 0; overflow: hidden; white-space: nowrap; position: relative; {{ section.settings.angle }};">
  
  <div class="cf-marquee-track-v5" style="display: inline-block; animation: cf-scroll-v5 {{ section.settings.scroll_speed }}s linear infinite;">
    {% for i in (1..6) %}
      <div style="display: inline-flex; align-items: center; padding: 0 50px; font-family: 'Rajdhani', sans-serif;">
        <!-- Wrench/Tools icon -->
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 20px;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        <span style="font-size: {{ section.settings.font_size }}px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; -webkit-text-stroke: 1px {{ section.settings.text_color }}; color: transparent;">
          {{ section.settings.text }}
        </span>
      </div>
    {% endfor %}
  </div>

  <div class="cf-marquee-track-v5" style="display: inline-block; animation: cf-scroll-v5 {{ section.settings.scroll_speed }}s linear infinite;">
    {% for i in (1..6) %}
      <div style="display: inline-flex; align-items: center; padding: 0 50px; font-family: 'Rajdhani', sans-serif;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="{{ section.settings.accent_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 20px;"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        <span style="font-size: {{ section.settings.font_size }}px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; -webkit-text-stroke: 1px {{ section.settings.text_color }}; color: transparent;">
          {{ section.settings.text }}
        </span>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@700&display=swap');
  @keyframes cf-scroll-v5 {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

{% schema %}
{
  "name": "06 · Outline Garage Marqu",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Outline Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Icon)",
      "default": "#f59e0b"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Marquee Text",
      "default": "BUILT FOR THE GARAGE"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Font Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Speed",
      "default": 20
    },
    {
      "type": "select",
      "id": "angle",
      "label": "Rotation",
      "options": [
        {
          "value": "transform: none;",
          "label": "Flat"
        },
        {
          "value": "transform: rotate(-2deg); margin: 20px -20px;",
          "label": "Tilted Up"
        },
        {
          "value": "transform: rotate(2deg); margin: 20px -20px;",
          "label": "Tilted Down"
        }
      ],
      "default": "transform: none;"
    }
  ]
}
{% endschema %}
