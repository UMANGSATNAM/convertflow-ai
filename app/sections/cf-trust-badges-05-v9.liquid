<style>
.cf-tb-05-v9 { padding: {{ section.settings.padding_y }}px 20px; background: {{ section.settings.bg_color }}; font-family: 'Baskerville','Georgia',serif; }
.cf-tb-05-v9-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; display: flex; justify-content: center; gap: 60px; flex-wrap: wrap; }
.cf-tb-05-v9-badge { text-align: center; }
.cf-tb-05-v9-icon { font-size: 28px; margin-bottom: 10px; }
.cf-tb-05-v9-label { font-size: 16px; font-style: italic; color: {{ section.settings.text_color }}; font-weight: normal; }
.cf-tb-05-v9-sep { margin-top: 8px; width: 30px; height: 1px; background: {{ section.settings.accent_color }}; margin-left: auto; margin-right: auto; }
</style>
<div class="cf-tb-05-v9">
  <div class="cf-tb-05-v9-inner">
    {% for block in section.blocks %}
    <div class="cf-tb-05-v9-badge">
      <div class="cf-tb-05-v9-icon">{{ block.settings.icon }}</div>
      <div class="cf-tb-05-v9-label">{{ block.settings.label }}</div>
      <div class="cf-tb-05-v9-sep"></div>
    </div>
    {% endfor %}
  </div>
</div>
{% schema %}{"name": "09 · Fragrance Badges","settings": [{"type":"color","id":"bg_color","label":"Background","default":"#faf8f5"},{"type":"color","id":"text_color","label":"Text Color","default":"#2c2416"},{"type":"color","id":"accent_color","label":"Gold Accent","default":"#b8973a"},{"type":"range","id":"padding_y","label":"Vertical Padding","min":20,"max":100,"step":5,"default":50},{"type":"range","id":"max_width","label":"Max Width","min":600,"max":1400,"step":50,"default":1100}],"blocks": [{"type": "badge","name": "Badge","settings": [{"type":"text","id":"icon","label":"Icon","default":"🌹"},{"type":"text","id":"label","label":"Label","default":"Artisan Craftsmanship"}]}],"presets": [{"name": "09 · Fragrance Badges","blocks": [{"type":"badge"},{"type":"badge"},{"type":"badge"},{"type":"badge"}]}]}{% endschema %}
