<style>
.cf-feat-11-v10{width:100%;height:{{ section.settings.height }}vh;background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');background-size:cover;background-position:center;position:relative;display:flex;align-items:center;font-family:sans-serif;color:{{ section.settings.text_color }}}
.cf-feat-11-v10-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,{{ section.settings.overlay_opacity | divided_by: 100.0 }})}
.cf-feat-11-v10-inner{position:relative;z-index:2;max-width:1400px;margin:0 auto;width:100%;padding:40px;display:flex;align-items:center;gap:60px;justify-content:flex-end}
.cf-feat-11-v10-hotspots{flex:1;position:relative;height:100%;display:flex}
.cf-feat-11-v10-products{width:400px;background:{{ section.settings.card_bg }};padding:30px;color:{{ section.settings.card_text }};display:flex;flex-direction:column;gap:30px}
.cf-feat-11-v10-title{font-size:24px;font-weight:900;text-transform:uppercase;margin:0;letter-spacing:-0.01em;border-bottom:2px solid;padding-bottom:15px}
.cf-feat-11-v10-item{display:flex;gap:20px;text-decoration:none;align-items:center;transition:0.3s}
.cf-feat-11-v10-item:hover{transform:translateX(5px)}
.cf-feat-11-v10-img{width:80px;height:80px;object-fit:cover;background:#eee}
.cf-feat-11-v10-info{flex:1}
.cf-feat-11-v10-name{font-size:14px;font-weight:800;text-transform:uppercase;color:{{ section.settings.card_text }};margin:0 0 5px 0}
.cf-feat-11-v10-price{font-size:14px;color:{{ section.settings.card_text }};margin:0}
.cf-feat-11-v10-btn{align-self:flex-start;padding:12px 24px;background:{{ section.settings.card_text }};color:{{ section.settings.card_bg }};text-decoration:none;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:0.1em;margin-top:10px}
@media(max-width:900px){.cf-feat-11-v10-inner{flex-direction:column;justify-content:center}.cf-feat-11-v10-products{width:100%}}
</style>

<div class="cf-feat-11-v10">
  <div class="cf-feat-11-v10-overlay"></div>
  <div class="cf-feat-11-v10-inner">
    <div class="cf-feat-11-v10-hotspots">
      <!-- Optional: Could add absolute positioned hotspots here -->
    </div>
    
    <div class="cf-feat-11-v10-products">
      <h2 class="cf-feat-11-v10-title">{{ section.settings.title }}</h2>
      
      {% for i in (1..3) %}
        {% capture img_key %}img_{{ i }}{% endcapture %}
        {% capture title_key %}title_{{ i }}{% endcapture %}
        {% capture price_key %}price_{{ i }}{% endcapture %}
        {% capture link_key %}link_{{ i }}{% endcapture %}
        
        <a href="{{ section.settings[link_key] }}" class="cf-feat-11-v10-item">
          {% if section.settings[img_key] %}
            <img src="{{ section.settings[img_key] | image_url: width: 200 }}" class="cf-feat-11-v10-img">
          {% else %}
            <div style="background:#555;" class="cf-feat-11-v10-img"></div>
          {% endif %}
          <div class="cf-feat-11-v10-info">
             <h3 class="cf-feat-11-v10-name">{{ section.settings[title_key] }}</h3>
             <p class="cf-feat-11-v10-price">{{ section.settings[price_key] }}</p>
          </div>
        </a>
      {% endfor %}
      
      <a href="{{ section.settings.btn_link }}" class="cf-feat-11-v10-btn">{{ section.settings.btn_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "11 · Men's Featured (v10)",
  "settings": [
    {"type":"image_picker","id":"bg_image","label":"Background Lookbook Image"},
    {"type":"range","id":"overlay_opacity","label":"Overlay Opacity","min":0,"max":100,"step":5,"default":40},
    {"type":"text","id":"title","label":"Card Title","default":"SHOP THE LOOK"},
    {"type":"text","id":"btn_label","label":"Button Label","default":"VIEW ALL LOOKS"},
    {"type":"url","id":"btn_link","label":"Button Link"},
    
    {"type":"image_picker","id":"img_1","label":"Product 1 Image"},
    {"type":"text","id":"title_1","label":"Product 1 Title","default":"LEATHER BIKER"},
    {"type":"text","id":"price_1","label":"Product 1 Price","default":"$550"},
    {"type":"url","id":"link_1","label":"Product 1 Link"},
    
    {"type":"image_picker","id":"img_2","label":"Product 2 Image"},
    {"type":"text","id":"title_2","label":"Product 2 Title","default":"WHITE T-SHIRT"},
    {"type":"text","id":"price_2","label":"Product 2 Price","default":"$45"},
    {"type":"url","id":"link_2","label":"Product 2 Link"},
    
    {"type":"image_picker","id":"img_3","label":"Product 3 Image"},
    {"type":"text","id":"title_3","label":"Product 3 Title","default":"BLACK JEANS"},
    {"type":"text","id":"price_3","label":"Product 3 Price","default":"$120"},
    {"type":"url","id":"link_3","label":"Product 3 Link"},

    {"type":"color","id":"text_color","label":"Background Text Color","default":"#FFFFFF"},
    {"type":"color","id":"card_bg","label":"Card Background","default":"#FFFFFF"},
    {"type":"color","id":"card_text","label":"Card Text Color","default":"#111111"},
    {"type":"range","id":"height","label":"Height (vh)","min":60,"max":100,"step":5,"default":85}
  ],
  "presets": [{"name":"11 · Men's Featured (v10)"}]
}
{% endschema %}
